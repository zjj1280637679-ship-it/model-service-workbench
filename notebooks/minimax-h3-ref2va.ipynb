      "text/html": [
       "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>MiniMax-H3 控制台</title>\n<style>\n:root {\n  color-scheme: light dark;\n  --canvas: #f1f2f5;\n  --panel: #fff;\n  --surface: #f5f5f7;\n  --input: #f7f7f9;\n  --toolbar: #fafafc;\n  --ink: #1d1d1f;\n  --muted: #5f636d;\n  --line: #dedfe5;\n  --edge: #2226341a;\n  --accent: #0065d8;\n  --accent-hover: #005bc4;\n  --tint: #eaf2ff;\n  --ready: #187641;\n  --danger: #b32634;\n  --warn: #80540e;\n  --log: #f7f8fb;\n  --scroll-thumb: #bfc1ca;\n  --shadow: 0 1px 2px #20283a08, 0 5px 14px #20283a0b;\n  --mono: ui-monospace, \"SFMono-Regular\", Consolas, \"Microsoft YaHei\", monospace;\n}\n\n@media (prefers-color-scheme: dark) {\n  :root {\n    --canvas: #16171b;\n    --panel: #222327;\n    --surface: #2b2c31;\n    --input: #292a30;\n    --toolbar: #25262b;\n    --ink: #f2f2f5;\n    --muted: #b3b5bf;\n    --line: #3c3e46;\n    --edge: #ffffff20;\n    --accent: #78b6ff;\n    --accent-hover: #9ac9ff;\n    --tint: #263953;\n    --ready: #73d69a;\n    --danger: #ff9398;\n    --warn: #edc278;\n    --log: #1c1d22;\n    --scroll-thumb: #646773;\n    --shadow: 0 1px 2px #0004, 0 5px 14px #0003;\n  }\n}\n\n* { box-sizing: border-box; }\nbody {\n  margin: 0;\n  color: var(--ink);\n  font: 13px/1.5 -apple-system, BlinkMacSystemFont, \"Segoe UI Variable Text\", \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", system-ui, sans-serif;\n}\nh1, h2, p { margin: 0; }\nbutton, input, textarea, select { font: inherit; }\nbutton, input[type=\"checkbox\"], select, summary { cursor: pointer; }\nbutton {\n  min-height: 33px;\n  padding: 5px 10px;\n  border: 1px solid var(--edge);\n  border-radius: 9px;\n  background: var(--panel);\n  color: var(--ink);\n  font-weight: 600;\n  overflow-wrap: anywhere;\n}\nbutton:hover:not(:disabled) { background: var(--surface); }\nbutton:active:not(:disabled) { box-shadow: inset 0 1px 3px #0002; }\nbutton:disabled { cursor: default; color: var(--muted); opacity: .8; }\nbutton.primary { border-color: transparent; background: var(--accent); color: light-dark(#fff, #102640); }\nbutton.primary:hover:not(:disabled) { background: var(--accent-hover); }\nbutton.primary:disabled { background: var(--tint); color: var(--accent); opacity: 1; }\nbutton.danger { color: var(--danger); }\n:is(button, input, textarea, select, summary, a, .board, .control, .log-viewport):focus-visible {\n  outline: 2px solid var(--accent);\n  outline-offset: 2px;\n}\n:is(.board, .control, .log-viewport):focus-visible { outline-offset: -3px; }\ninput:not([type=\"checkbox\"]), textarea, select {\n  width: 100%;\n  min-width: 0;\n  min-height: 34px;\n  padding: 5px 8px;\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  background: var(--input);\n  color: var(--ink);\n}\ninput::placeholder, textarea::placeholder { color: var(--muted); opacity: 1; }\ntextarea { min-height: 52px; max-height: 112px; resize: vertical; }\ninput[type=\"checkbox\"] {\n  width: 15px;\n  height: 15px;\n  flex: 0 0 auto;\n  margin: 0;\n  accent-color: var(--accent);\n}\nlabel { display: block; color: var(--muted); font-size: 12px; }\nlabel > :is(input, textarea, select) { margin-top: 4px; }\n\n.app {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 12px;\n  width: 100%;\n  height: 686px;\n  padding: 10px;\n  border-radius: 22px;\n  background: var(--canvas);\n}\n.left {\n  display: grid;\n  grid-template-rows: 392px minmax(0, 1fr);\n  gap: 12px;\n  min-width: 0;\n  min-height: 0;\n}\n.panel {\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n  border: 1px solid var(--edge);\n  border-radius: 16px;\n  background: var(--panel);\n  box-shadow: var(--shadow);\n}\n.panel-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  flex-shrink: 0;\n  padding: 11px 15px;\n  border-bottom: 1px solid var(--line);\n}\n.panel-head h2 { font-size: 16px; line-height: 1.3; font-weight: 650; }\n.eyebrow { color: var(--muted); font-size: 11px; font-weight: 550; }\n:is(.board, .control, .log-viewport, .notice-zone) {\n  scrollbar-width: thin;\n  scrollbar-color: var(--scroll-thumb) transparent;\n}\n\n.board {\n  display: flex;\n  flex-direction: column;\n  padding: 12px 15px 10px;\n  overflow-y: auto;\n  overscroll-behavior: contain;\n  scrollbar-gutter: stable;\n}\n.board-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }\n.board-top > div { min-width: 0; }\n.board h1 { margin-top: 1px; font-size: 22px; line-height: 1.25; font-weight: 650; overflow-wrap: anywhere; }\n.board[data-tone=\"error\"] h1 { color: var(--danger); }\n.board[data-tone=\"warn\"] h1 { color: var(--warn); }\n.board[data-tone=\"ready\"] h1 { color: var(--ready); }\n.board-refresh { min-height: 26px; padding: 3px 8px; flex-shrink: 0; font-size: 11px; }\n.board-message { color: var(--muted); font-size: 11px; overflow-wrap: anywhere; }\n.capabilities {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 1px;\n  flex-shrink: 0;\n  margin: 9px 0;\n  overflow: hidden;\n  border: 1px solid var(--line);\n  border-radius: 10px;\n  background: var(--line);\n}\n.capability { min-width: 0; padding: 5px 8px; background: var(--surface); overflow-wrap: anywhere; }\n.capability span { display: block; color: var(--muted); font-size: 10px; line-height: 1.4; }\n.capability strong { display: block; font-size: 12px; line-height: 1.4; font-weight: 650; }\n.connection-box { flex-shrink: 0; }\n.connection-row {\n  display: grid;\n  grid-template-columns: 53px minmax(0, 1fr) auto;\n  gap: 5px;\n  align-items: center;\n  margin-bottom: 4px;\n}\n.connection-row.key-row { grid-template-columns: 53px minmax(0, 1fr) auto auto; }\n.connection-row label { font-size: 11px; white-space: nowrap; }\n.connection-row input { height: 27px; min-height: 27px; padding: 3px 7px; font: 11px/1.3 var(--mono); }\n.connection-row button { min-height: 27px; padding: 3px 7px; font-size: 11px; }\n.connection-hint { color: var(--muted); font-size: 10px; overflow-wrap: anywhere; }\n.transfers { flex-shrink: 0; margin: 7px 0 6px; border-top: 1px solid var(--line); }\n.transfer-row {\n  position: relative;\n  display: grid;\n  grid-template-columns: 69px minmax(0, 1fr) 40px;\n  gap: 0 5px;\n  min-height: 34px;\n  padding: 4px 0;\n  border-bottom: 1px solid var(--line);\n  overflow-wrap: anywhere;\n}\n.transfer-name { grid-row: 1 / 3; align-self: center; font-size: 11px; font-weight: 650; }\n.transfer-phase { font-size: 11px; line-height: 1.35; }\n.transfer-number { color: var(--muted); font-size: 10px; text-align: right; font-variant-numeric: tabular-nums; }\n.transfer-detail { grid-column: 2 / 4; color: var(--muted); font-size: 10px; line-height: 1.35; }\n.transfer-row progress {\n  appearance: none;\n  position: absolute;\n  inset: auto 0 0;\n  width: 100%;\n  height: 3px;\n  overflow: hidden;\n  border: 0;\n  border-radius: 99px;\n  background: var(--line);\n}\n.transfer-row progress::-webkit-progress-bar { background: var(--line); }\n.transfer-row progress::-webkit-progress-value { background: var(--accent); }\n.transfer-row progress::-moz-progress-bar { background: var(--accent); }\n.transfer-row[data-phase=\"failed\"] .transfer-phase { color: var(--danger); }\n.transfer-row[data-phase=\"disabled\"] .transfer-phase { color: var(--muted); }\n#resources { font-size: 10px; overflow-wrap: anywhere; }\n.board-bottom {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  flex: 0 0 auto;\n  flex-wrap: wrap;\n  gap: 4px 8px;\n  margin-top: auto;\n  padding-top: 5px;\n  font-size: 10px;\n}\n.queue { padding: 2px 7px; border-radius: 99px; background: var(--surface); font-variant-numeric: tabular-nums; }\n.stamp { color: var(--muted); }\n\n.control {\n  overflow: auto;\n  overscroll-behavior: contain;\n  scrollbar-gutter: stable;\n}\n.control-actions {\n  display: grid;\n  gap: 6px;\n  padding: 8px 12px;\n}\n.control-actions button { min-height: 31px; padding: 4px 6px; font-size: 12px; }\n.control-body { padding: 4px 12px 13px; }\n.button-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }\n.button-row.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n.checkline { display: flex; align-items: center; gap: 8px; margin: 3px 0 10px; color: var(--ink); }\n.checkline input { margin: 0; }\n#public {\n  appearance: none;\n  position: relative;\n  width: 31px;\n  height: 18px;\n  border: 1px solid var(--line);\n  border-radius: 99px;\n  background: var(--surface);\n}\n#public::before {\n  position: absolute;\n  inset: 2px auto 2px 2px;\n  aspect-ratio: 1;\n  border-radius: 50%;\n  background: #fff;\n  box-shadow: 0 1px 3px #0004;\n  content: \"\";\n}\n#public:checked { border-color: transparent; background: var(--accent); }\n#public:checked::before { inset-inline: auto 2px; }\n@media (forced-colors: active) {\n  #public { appearance: auto; width: 15px; height: 15px; }\n  #public::before { content: none; }\n}\n.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }\n.full { grid-column: 1 / -1; }\n.field-note { margin-top: 5px; color: var(--muted); font-size: 11px; overflow-wrap: anywhere; }\n#download-result { margin-top: 9px; }\n.advanced { margin-top: 10px; border-top: 1px solid var(--line); }\n.advanced summary { padding: 8px 0 4px; font-size: 12px; font-weight: 650; }\n.advanced h3 { margin: 10px 0 6px; font-size: 12px; font-weight: 650; }\n.advanced .checkline { margin: 8px 0; }\n\n.right { display: flex; flex-direction: column; }\n.right .panel-head > span { padding: 3px 8px; border-radius: 99px; background: var(--surface); }\n.status-dot { display: inline-block; width: 7px; height: 7px; margin-right: 6px; border-radius: 50%; background: var(--muted); }\n.status-dot.live { background: var(--ready); }\n.log-controls {\n  display: flex;\n  flex: 0 0 auto;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 6px;\n  padding: 8px 12px;\n  border-bottom: 1px solid var(--line);\n  background: var(--toolbar);\n}\n.log-controls :is(button, select) { min-height: 30px; padding: 4px 8px; font-size: 12px; }\n.log-controls .log-source { flex: 1 1 9rem; min-width: 0; max-width: 16rem; }\n.log-controls .log-lines { flex: 0 1 auto; width: auto; max-width: 100%; }\n.follow { display: flex; align-items: center; gap: 5px; margin-left: auto; white-space: nowrap; font-size: 11px; }\n.follow input { margin: 0; }\n.notice-zone { flex: 0 0 auto; max-height: 150px; padding: 0 12px; overflow: auto; overscroll-behavior: contain; }\n.notice { margin-top: 9px; padding: 9px 11px; border: 1px solid var(--line); border-left: 3px solid var(--accent); border-radius: 9px; background: var(--tint); }\n.notice[data-kind=\"error\"] { border-left-color: var(--danger); background: var(--surface); }\n.notice[data-kind=\"warning\"] { border-left-color: var(--warn); background: var(--surface); }\n.notice-title { font-size: 12px; font-weight: 650; }\n.notice-message { margin-top: 4px; color: var(--muted); font-size: 12px; white-space: pre-wrap; overflow-wrap: anywhere; }\n.notice-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 7px; margin-top: 7px; }\n.notice-actions :is(button, a) { min-height: 30px; padding: 4px 9px; font-size: 12px; }\n.notice-actions a { border: 1px solid var(--line); border-radius: 8px; color: var(--accent); background: var(--panel); text-decoration: none; }\n.notice-actions a:hover { text-decoration: underline; }\n.log-viewport {\n  flex: 1;\n  min-height: 0;\n  margin: 10px 12px 0;\n  overflow: auto;\n  overscroll-behavior: contain;\n  scrollbar-gutter: stable;\n  border: 1px solid var(--line);\n  border-radius: 11px;\n  background: var(--log);\n}\n.log-intro { padding: 12px 13px; border-bottom: 1px solid var(--line); background: var(--toolbar); font-size: 12px; overflow-wrap: anywhere; }\n.log-intro h3 { margin: 0 0 4px; font-size: 14px; font-weight: 650; }\n.log-intro p { color: var(--muted); }\n.log-viewport pre { margin: 0; padding: 11px 13px; color: var(--muted); font: 12px/1.65 var(--mono); white-space: pre-wrap; overflow-wrap: anywhere; }\n.log-footer { display: flex; justify-content: space-between; flex: 0 0 auto; flex-wrap: wrap; gap: 4px 8px; padding: 8px 13px; color: var(--muted); font-size: 10px; }\n.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }\n\n@media (max-width: 920px) {\n  .follow { margin-left: 0; }\n  .capability { padding-inline: 5px; }\n}\n@media (max-width: 759px) {\n  .app { height: auto; grid-template-columns: minmax(0, 1fr); padding: 8px; gap: 10px; }\n  .left { grid-template-rows: auto 390px; gap: 10px; }\n  .board { scrollbar-gutter: auto; }\n  .right { height: 440px; }\n  .log-controls .log-source { max-width: none; }\n}\n@media (max-width: 379px) {\n  .capabilities, .control-actions .button-row, .advanced .button-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  .form-grid { grid-template-columns: minmax(0, 1fr); }\n}\n</style>\n</head>\n<body>\n<main class=\"app\" id=\"h3-console\" aria-label=\"MiniMax-H3 控制台\">\n  <div class=\"left\">\n    <section class=\"panel board\" id=\"board\" aria-labelledby=\"headline\" tabindex=\"0\">\n      <div class=\"board-top\"><div><p class=\"eyebrow\">消息看板</p><h1 id=\"headline\">尚未读取状态</h1></div><button type=\"button\" class=\"board-refresh\" id=\"refresh-board\" title=\"只刷新状态，不执行控制命令\">刷新</button></div>\n      <p class=\"board-message\" id=\"next-step\">运行控制台单元后显示本次观察。</p>\n      <div class=\"capabilities\" aria-label=\"独立能力\">\n        <div class=\"capability\"><span>总管理</span><strong id=\"manager-state\">尚未读取</strong></div>\n        <div class=\"capability\"><span>API 后台</span><strong id=\"api-state\">尚未读取</strong></div>\n        <div class=\"capability\"><span>模型容器</span><strong id=\"model-state\">尚未读取</strong></div>\n        <div class=\"capability\"><span>公网 API</span><strong id=\"public-state\">尚未读取</strong></div>\n      </div>\n      <div class=\"connection-box\" aria-label=\"API 连接信息\">\n        <div class=\"connection-row\"><label for=\"api-url\">API URL</label><input id=\"api-url\" readonly value=\"尚未分配\" autocomplete=\"off\" spellcheck=\"false\" aria-describedby=\"connection-hint\"><button type=\"button\" id=\"copy-url\" disabled aria-label=\"复制 API URL\">复制</button></div>\n        <div class=\"connection-row key-row\"><label for=\"api-key\">API 密钥</label><input id=\"api-key\" readonly value=\"尚未生成\" autocomplete=\"off\" spellcheck=\"false\" aria-label=\"API 密钥\"><button type=\"button\" id=\"toggle-key\" disabled aria-label=\"显示 API 密钥\">显示</button><button type=\"button\" id=\"copy-key\" disabled aria-label=\"复制 API 密钥\">复制</button></div>\n        <p class=\"connection-hint\" id=\"connection-hint\">API 可达后可复制地址；密钥按需显示。</p>\n      </div>\n      <div class=\"transfers\" aria-label=\"模型与 LoRA 下载进度\">\n        <div class=\"transfer-row\" id=\"transfer-model\"><span class=\"transfer-name\">模型</span><span class=\"transfer-phase\" id=\"model-download-phase\">尚未观察</span><span class=\"transfer-number\" id=\"model-download-number\">—</span><span class=\"transfer-detail\" id=\"model-download-detail\">下载与加载分别显示</span><progress id=\"model-download-progress\" max=\"100\" aria-label=\"模型下载进度\"></progress></div>\n        <div class=\"transfer-row\" id=\"transfer-acceleration\"><span class=\"transfer-name\">加速 LoRA</span><span class=\"transfer-phase\" id=\"acceleration-download-phase\">尚未观察</span><span class=\"transfer-number\" id=\"acceleration-download-number\">—</span><span class=\"transfer-detail\" id=\"acceleration-download-detail\">未启用时不下载</span><progress id=\"acceleration-download-progress\" max=\"100\" aria-label=\"加速 LoRA 下载进度\"></progress></div>\n        <div class=\"transfer-row\" id=\"transfer-style\"><span class=\"transfer-name\">风格 LoRA</span><span class=\"transfer-phase\" id=\"style-download-phase\">尚未观察</span><span class=\"transfer-number\" id=\"style-download-number\">—</span><span class=\"transfer-detail\" id=\"style-download-detail\">未启用时不下载</span><progress id=\"style-download-progress\" max=\"100\" aria-label=\"风格 LoRA 下载进度\"></progress></div>\n      </div>\n      <p class=\"eyebrow\" id=\"resources\">配置：A100 · 原生 BF16</p>\n      <div class=\"board-bottom\"><span class=\"queue\" id=\"queue-state\">排队 —　执行 —</span><span class=\"stamp\" id=\"board-stamp\">尚无服务观察</span></div>\n    </section>\n    <section class=\"panel control\" id=\"control-scroll\" aria-labelledby=\"control-heading\" tabindex=\"0\">\n      <header class=\"panel-head\"><h2 id=\"control-heading\">常用控制</h2><span class=\"eyebrow\">启动后自动推进</span></header>\n      <div class=\"control-actions\">\n        <div class=\"button-row two\"><button type=\"button\" data-action=\"bootstrap\" class=\"primary\">一键启动</button><button type=\"button\" data-action=\"export_connection\">导出 API 连接</button></div>\n        <div class=\"button-row\"><button type=\"button\" data-action=\"generate\">提交 / 查询任务</button><button type=\"button\" data-action=\"stop\">停止服务</button><button type=\"button\" class=\"danger\" data-action=\"release\">释放云实例</button></div>\n      </div>\n      <div class=\"control-body\">\n        <label class=\"checkline\"><input id=\"public\" type=\"checkbox\" checked>开放临时公网 API</label>\n        <div class=\"form-grid\">\n          <label class=\"full\">本次参考图路径<input id=\"reference_file\" placeholder=\"/content/本次新参考图.png\" autocomplete=\"off\"></label>\n          <label class=\"full\">本次视频描述<textarea id=\"prompt\" rows=\"2\" placeholder=\"描述本次全新内容；按已有任务 ID 恢复时可留空\"></textarea></label>\n          <label>已有任务 ID<input id=\"resume_job_id\" placeholder=\"留空则创建新任务\" autocomplete=\"off\"></label>\n          <label>验收接口<select id=\"endpoint\"><option value=\"public\">临时公网</option><option value=\"local\">本机 API</option></select></label>\n        </div>\n        <button type=\"button\" data-action=\"download_result\" id=\"download-result\" disabled>下载最近结果</button>\n        <details class=\"advanced\" id=\"advanced-controls\"><summary>高级控制 · 不常用时收起</summary><div class=\"advanced-body\">\n          <h3>分步维护</h3>\n          <div class=\"button-row\"><button type=\"button\" data-action=\"preflight\">检查资源</button><button type=\"button\" data-action=\"install\">安装依赖</button><button type=\"button\" data-action=\"start\">单独启动</button></div>\n          <p class=\"field-note\">正常使用只需一键启动；检查、安装或启动失败时在日志区处理。</p>\n          <label class=\"checkline\"><input id=\"staged\" type=\"checkbox\">使用 40GB 分阶段驻留</label>\n          <label class=\"checkline\"><input id=\"cached\" type=\"checkbox\">权重已完整缓存</label>\n          <h3>性能与 LoRA</h3>\n          <div class=\"form-grid\">\n            <label>加速 LoRA<select id=\"acceleration\"><option value=\"none\">不启用</option><option value=\"lightx2v-ref2va-4step\">Ref2VA Turbo · 实验</option></select></label>\n            <label>风格 LoRA<select id=\"style\"><option value=\"none\">不启用</option><option value=\"fal-realism-people\">人物写实 · 实验</option></select></label>\n            <label>风格强度<input id=\"style_scale\" type=\"number\" min=\"0.1\" max=\"1\" step=\"0.1\" value=\"1\"></label>\n            <label>注意力后端<select id=\"attention\"><option value=\"auto\">自动</option><option value=\"native\">原生</option><option value=\"_native_flash\">原生 Flash · 实验</option></select></label>\n            <label>去噪卸载<select id=\"offload\"><option value=\"stream\">流式</option><option value=\"sync\">同步 · 实验</option></select></label>\n          </div><p class=\"field-note\">高级参数在安装与启动前设置；保持 BF16，LoRA 默认关闭。</p>\n          <h3>组件控制</h3>\n          <div class=\"form-grid\"><label>操作<select id=\"component-action\"><option value=\"drain\">暂停接收新任务</option><option value=\"resume\">恢复接收新任务</option><option value=\"stop_model\">停止模型</option><option value=\"start_model\">启动模型</option><option value=\"stop_api\">停止 API</option><option value=\"start_api\">启动 API</option></select></label><label>命令 ID<input id=\"command_id\" placeholder=\"查询已有命令\" autocomplete=\"off\"></label></div>\n          <label class=\"checkline\"><input id=\"force\" type=\"checkbox\">强制停止模型</label>\n          <div class=\"button-row two\"><button type=\"button\" id=\"send-control\">执行组件操作</button><button type=\"button\" id=\"query-command\">查询命令</button></div>\n          <p class=\"field-note\">暂停接收时，已有队列继续执行。命令接收不等于执行完成。</p>\n          <h3>客户端连接</h3><p class=\"field-note\">启动时自动生成 API 密钥，可用上方按钮导出。地址为空表示尚不可连接；API 可达后重新导出，密钥不变。模型准备期间接受排队，完整就绪后自动处理。</p>\n        </div></details>\n      </div>\n    </section>\n  </div>\n  <section class=\"panel right\" aria-labelledby=\"logs-heading\">\n    <header class=\"panel-head\"><h2 id=\"logs-heading\">动态日志</h2><span class=\"eyebrow\"><i class=\"status-dot\" id=\"live-dot\" aria-hidden=\"true\"></i><span id=\"connection-state\">等待连接</span></span></header>\n    <div class=\"log-controls\">\n      <label class=\"sr-only\" for=\"log-source\">日志来源</label>\n      <select id=\"log-source\" class=\"log-source\">\n        <option value=\"diagnostics\">操作与诊断</option><option value=\"preflight\">资源检查</option>\n        <option value=\"install\">安装依赖</option><option value=\"model\">模型容器</option>\n        <option value=\"api\">API 后台</option><option value=\"manager\">全局管理</option>\n        <option value=\"tunnel\">公网隧道</option><option value=\"events\">调度事件</option>\n        <option value=\"state\">状态详情</option><option value=\"smoke\">最近验收</option>\n      </select>\n      <label class=\"sr-only\" for=\"log-lines\">最新日志行数</label>\n      <select id=\"log-lines\" class=\"log-lines\">\n        <option value=\"20\">20 行</option><option value=\"40\">40 行</option><option value=\"60\">60 行</option>\n        <option value=\"80\">80 行</option><option value=\"100\" selected>100 行</option><option value=\"120\">120 行</option>\n        <option value=\"140\">140 行</option><option value=\"160\">160 行</option><option value=\"180\">180 行</option>\n        <option value=\"200\">200 行</option>\n      </select>\n      <button type=\"button\" id=\"toggle-logs\">暂停</button><button type=\"button\" id=\"refresh-logs\">刷新</button>\n      <label class=\"follow\"><input type=\"checkbox\" id=\"follow-logs\" checked>跟随新日志</label>\n    </div>\n    <div class=\"notice-zone\" id=\"notice-zone\" aria-live=\"polite\" aria-atomic=\"false\"></div>\n    <div class=\"log-viewport\" id=\"log-viewport\" tabindex=\"0\" aria-label=\"日志内容，可独立滚动\">\n      <header class=\"log-intro\" id=\"log-intro\">\n        <h3>MiniMax-H3 · 参考生视频</h3>\n        <p>A100 原生 BF16 · 仅 ref2va。点击 Colab「一键启动」单元的运行箭头后，自动检查资源、安装依赖并启动 API、公网和模型。API 可达后即可排队，模型就绪后自动处理。</p>\n      </header>\n      <pre id=\"log-text\">尚无本次运行日志。</pre>\n    </div>\n    <footer class=\"log-footer\"><span id=\"log-stamp\">只读 · 有限尾部 · 凭据脱敏</span><span id=\"log-mode\">每 2 秒读取</span></footer>\n  </section>\n</main>\n<script>\n(() => {\n  'use strict';\n  const CALLBACK_NAME = \"\";\n  const INITIAL_STATE = {\"ui\": {\"connected\": false, \"offline\": true}, \"state\": {}, \"resources\": {}, \"logs\": {\"text\": \"尚未连接控制台。运行本单元后，日志在这里持续更新。\", \"source\": \"diagnostics\"}};\n  const $ = id => document.getElementById(id);\n  const actionButtons = [...document.querySelectorAll('[data-action]')];\n  const activeActions = new Set();\n  const uncertainRequests = new Map();\n  const knownNotices = new Set();\n  const blobUrls = new Set();\n  let current = INITIAL_STATE && typeof INITIAL_STATE === 'object' ? INITIAL_STATE : {};\n  let timer = null, polling = false, paused = false, disposed = false;\n  let connectionLost = false, localNotice = null, shownNoticeId = null, failures = 0;\n  let lastText = '', lastSource = '', lastLogs = null, pendingConfirmation = null;\n  let revealedKey = '', keyVisible = false, secretBusy = false, secretEpoch = 0;\n  let observedCredentialId = null, observedInstanceId = null;\n  const hasTransport = () => typeof window.H3_TRANSPORT === 'function' || typeof window.google?.colab?.kernel?.invokeFunction === 'function';\n  const offline = () => current.ui?.offline === true || !hasTransport();\n  const closed = () => current.ui?.closed === true;\n  const delivering = () => current.ui?.startup_delivery?.active === true &&\n    Date.now() < Number(current.ui.startup_delivery.deadline_at || 0) * 1000 + 5000;\n  const text = (id, value) => { $(id).textContent = String(value ?? '—'); };\n  const nowText = value => {\n    if (!value) return '未记录';\n    const date = typeof value === 'number' ? new Date(value * 1000) : new Date(value);\n    if (!Number.isFinite(date.getTime())) return '未记录';\n    return new Intl.DateTimeFormat('zh-CN', {timeZone:'Asia/Shanghai', hour:'2-digit', minute:'2-digit', second:'2-digit', hour12:false}).format(date) + ' 北京时间';\n  };\n  const safeText = value => String(value ?? '').replace(/\\x1b\\[[0-?]*[ -/]*[@-~]/g, '').replace(/\\bBearer\\s+[^\\s\"'<>;,]+/gi,'Bearer [已隐藏]').replace(/([\"']?(?:H3_API_KEY|API_KEY|api[-_]?key|access_token)[\"']?\\s*[:=]\\s*)([\"'])(.*?)\\2/gi,'$1$2[已隐藏]$2');\n  const payload = () => ({staged:$('staged').checked,cached:$('cached').checked,public:$('public').checked,\n    reference_file:$('reference_file').value.trim(),prompt:$('prompt').value.trim(),resume_job_id:$('resume_job_id').value.trim(),\n    endpoint:$('endpoint').value,acceleration:$('acceleration').value,style:$('style').value,style_scale:Number($('style_scale').value),\n    attention:$('attention').value,offload:$('offload').value});\n  function uuid() {\n    if (window.crypto?.randomUUID) return window.crypto.randomUUID();\n    const bytes = new Uint8Array(16); window.crypto.getRandomValues(bytes);\n    return [...bytes].map(value=>value.toString(16).padStart(2,'0')).join('');\n  }\n  function setButtons() {\n    const unavailable = offline() || closed() || delivering();\n    const busy = current.ui?.busy === true;\n    const operations = current.ui?.operations || [];\n    const generationBusy = operations.some(item=>item.action==='generate');\n    const stopping = current.state?.phase==='stopping' || operations.some(item=>['stop','release'].includes(item.action));\n    const apiUsable = current.state?.api_ready===true && current.state?.observation_stale!==true && !connectionLost;\n    const connectionAvailable = current.ui?.connection_available===true || apiUsable;\n    for (const button of actionButtons) {\n      const action = button.dataset.action;\n      const setupBlocked = (busy || current.ui?.bootstrap_running===true) && ['bootstrap','preflight','install','start'].includes(action);\n      const generationBlocked = action==='generate' && (stopping || generationBusy || (busy && !apiUsable));\n      button.disabled = unavailable || activeActions.has(action) || setupBlocked || generationBlocked || (action==='export_connection' && !connectionAvailable) || (action==='download_result' && !current.result?.available);\n    }\n    $('send-control').disabled = unavailable || activeActions.has('control');\n    $('query-command').disabled = unavailable || activeActions.has('control');\n    $('refresh-board').disabled = unavailable || polling;\n    $('refresh-logs').disabled = unavailable || polling;\n    $('toggle-logs').disabled = unavailable;\n    const connection=current.connection||{};\n    const secretUnavailable=unavailable || connectionLost || document.hidden || !connection.key_available || !connection.credential_id;\n    $('toggle-key').disabled=secretUnavailable || secretBusy;\n    $('copy-key').disabled=secretUnavailable || secretBusy;\n    $('copy-url').disabled=unavailable || connectionLost || current.state?.observation_stale===true || !usableUrl(connection.url);\n  }\n  function usableUrl(value) {\n    if(typeof value!=='string'||!value)return null;\n    try {const url=new URL(value);return ['http:','https:'].includes(url.protocol)&&!url.username&&!url.password?value:null;}catch{return null;}\n  }\n  function clearSecret() {\n    revealedKey='';keyVisible=false;secretEpoch++;\n    $('api-key').value=current.connection?.key_available?'••••••••••••••••':'尚未生成';\n    text('toggle-key','显示');$('toggle-key').setAttribute('aria-label','显示 API 密钥');\n  }\n  function renderConnection() {\n    const connection=current.connection||{};\n    const credentialId=connection.credential_id||null, instanceId=current.state?.instance_id||null;\n    if(credentialId!==observedCredentialId || instanceId!==observedInstanceId || offline() || closed() || connectionLost || document.hidden){\n      clearSecret();observedCredentialId=credentialId;observedInstanceId=instanceId;\n    }\n    const stale=current.state?.observation_stale===true;\n    const readyUrl=stale?null:usableUrl(connection.url), candidate=usableUrl(connection.candidate_url)||(stale?usableUrl(connection.url):null);\n    const local=usableUrl(connection.local_url);\n    $('api-url').value=readyUrl||candidate||(offline()?'尚未连接运行时':'等待分配地址');\n    $('api-url').title=readyUrl||candidate||'';\n    let hint='密钥在启动初期生成；按需显示或复制。';\n    if(offline()||closed())hint='当前为离线界面，没有本次连接或密钥。';\n    else if(connectionLost)hint='连接中断；上次地址不代表当前可用，密钥已隐藏。';\n    else if(readyUrl)hint=(connection.public_requested?'公网 API 已通过探测':'本机 API 已可达')+' · 密钥默认隐藏';\n    else if(candidate)hint='地址已分配 · 尚未验证／当前不可用'+(local?' · 本机 API 可用':'');\n    else if(connection.public_requested&&local)hint='公网地址准备中 · 本机 API 已可用';\n    else if(current.ui?.bootstrap_running)hint='正在准备 API；密钥生成后即可显示或复制。';\n    text('connection-hint',hint);$('connection-hint').title=hint+(local?'\\n本机 API：'+local:'');\n    $('api-key').value=keyVisible&&revealedKey?revealedKey:connection.key_available?'••••••••••••••••':'尚未生成';\n    text('toggle-key',keyVisible?'隐藏':'显示');\n    $('toggle-key').setAttribute('aria-label',keyVisible?'隐藏 API 密钥':'显示 API 密钥');\n  }\n  function bytesText(value) {\n    if(typeof value!=='number'||!Number.isFinite(value)||value<0)return '—';\n    const units=['B','KiB','MiB','GiB','TiB'];let amount=value,index=0;\n    while(amount>=1024&&index<units.length-1){amount/=1024;index++;}\n    return (index?amount.toFixed(1):Math.round(amount))+' '+units[index];\n  }\n  function renderTransfers() {\n    const downloads=current.downloads||{}, items=downloads.items||{};\n    const stale=downloads.observation_stale===true || connectionLost || current.state?.observation_stale===true;\n    const phases={waiting:'等待下载',downloading:'下载中',verifying:'校验中',loading:'加载中',loaded:'已加载',disabled:'未启用',failed:'准备失败'};\n    for(const name of ['model','acceleration','style']) {\n      const item=items[name], row=$('transfer-'+name), progress=$(name+'-download-progress');\n      let phase='尚未观察', detail=name==='model'?'下载与加载分别显示':'未启用时不下载', percent=null;\n      if(item&&typeof item==='object') {\n        phase=phases[item.phase]||'等待可测进度';\n        if(name==='model'&&item.phase==='loaded')phase='已加载 · 等待就绪检查';\n        if(name==='model'&&current.state?.model_ready===true&&!stale)phase='可推理';\n        const bytesKnown=typeof item.bytes_completed==='number'&&Number.isFinite(item.bytes_completed)&&item.bytes_completed>=0;\n        const totalKnown=typeof item.bytes_total==='number'&&Number.isFinite(item.bytes_total)&&item.bytes_total>0;\n        const parts=[];\n        if(bytesKnown)parts.push((item.scope==='observed_transfers'?'已观察 ':'')+bytesText(item.bytes_completed)+(totalKnown?' / '+bytesText(item.bytes_total):' · 总量未知'));\n        if(Number.isInteger(item.files_completed)&&item.files_completed>=0)parts.push('文件 '+item.files_completed+' / '+(Number.isInteger(item.files_total)&&item.files_total>=0?item.files_total:'?'));\n        detail=parts.join(' · ')||item.detail||'等待可测进度';\n        if(bytesKnown&&item.scope==='observed_transfers')detail+='（含续传）';\n        if(item.phase==='disabled')detail='不下载，不占用加载资源';\n        else if(item.detail&&['loaded','loading','verifying','failed'].includes(item.phase))detail=item.detail;\n        if(!stale&&totalKnown&&typeof item.percent==='number'&&Number.isFinite(item.percent)&&item.percent>=0&&item.percent<=100)percent=item.percent;\n        if(['stopped','stopping','failed'].includes(downloads.lifecycle)&&item.phase!=='disabled'){\n          phase=({stopped:'已停止',stopping:'正在停止',failed:'已失败'})[downloads.lifecycle]+' · 上次'+phase;\n          detail='保留记录：'+detail;percent=null;\n        } else if(stale&&item.phase!=='disabled'){phase='待刷新 · 上次'+phase;detail='上次观察：'+detail;}\n        row.dataset.phase=item.phase||'waiting';\n      } else {row.dataset.phase='waiting';if(!offline()&&current.ui?.bootstrap_running)detail='下载观察尚未开始';}\n      if(offline()||closed()){phase='尚未观察';detail=name==='model'?'连接后显示真实下载与加载状态':'连接后显示实际启用状态';percent=null;}\n      text(name+'-download-phase',phase);$(name+'-download-phase').title=phase;\n      text(name+'-download-detail',safeText(detail));\n      $(name+'-download-detail').title=safeText([detail,item?.detail].filter(Boolean).join('\\n'));\n      text(name+'-download-number',percent===null?'—':percent.toFixed(percent===100?0:1)+'%');\n      progress.hidden=percent===null;\n      if(percent===null)progress.removeAttribute('value');else progress.value=percent;\n    }\n  }\n  function renderBoard() {\n    const state=current.state||{}, ui=current.ui||{}, resources=current.resources||{};\n    const cleanStop=!ui.bootstrap_running && state.phase==='stopped' && state.cleanup_complete===true && !state.manager_alive && !state.server_alive && !state.model_alive && !state.tunnel_alive;\n    const stale=(state.observation_stale===true || connectionLost || ui.observation_error===true) && !cleanStop;\n    let headline='等待一键启动', next='一键完成检查、安装与启动；API 就绪后可排队，模型就绪后自动处理。', tone='';\n    if (closed()) {headline='控制台连接已关闭';next='需要继续操作时，重新运行控制台单元。';}\n    else if (offline()) {headline='未连接运行时';next='运行本格即自动启动；正常无需再次点击。此处尚无实时状态。';}\n    else if(delivering()){headline='一键启动 · 交付 API';next='主单元正有限观察，状态由宿主推送；如需取消，请停止本单元，程序会回收已启动进程。';}\n    else if(cleanStop){headline='服务已停止';next='进程清理已确认；释放云实例需另行操作。';}\n    else if(stale){headline='状态需要刷新';next='当前观察无法确认；查看右侧日志，不据旧状态判断可用能力。';tone='warn';}\n    else if(state.phase==='stopping'){headline='正在停止与回收';next='等待进程退出与清理确认，请勿重复启动。';tone='warn';}\n    else if(state.error || ['failed','degraded'].includes(state.phase)){headline='有模块需要处理';next='仍可使用已就绪的能力；原因与处理提示在右侧日志。';tone='error';}\n    else if(ui.startup_stage==='failed'){headline='启动未完成';next='原因在右侧日志；处理后可再次一键启动，已就绪的模块仍可查询。';tone='error';}\n    else if(ui.startup_stage==='cancelled'){headline='自动启动已取消';next='查看各模块的真实状态；需要继续时可再次一键启动。';}\n    else if(state.draining){headline='已暂停接收新任务';next='已有队列继续执行；高级控制中可以恢复接收。';}\n    else if(state.ready){headline='可以生成';next='排队任务自动处理；API 可查询进度、失败原因和视频结果。';tone='ready';}\n    else if(state.api_ready && state.model_ready){headline='模型已就绪';next=state.public_requested&&!state.public_api_ready?'本机 API 已可处理任务；公网仍在准备，请以公网探测结果为准。':'任务自动处理；API 返回进度与视频结果。';tone='ready';}\n    else if(state.api_ready){headline=state.queue?.admission_open?'可排队 · 等待模型':'API 可查询 · 等待模型';next=state.queue?.admission_open?'已接收任务保持排队；模型完成加载并通过就绪检查后自动处理。':'API 可查询；任务接收状态以当前后台为准。';}\n    else if(ui.bootstrap_running){const stages={preflight:'检查资源',install:'安装依赖',start:'启动后台',awaiting_api:'等待 API',awaiting_model:'等待模型'};headline='一键启动 · '+(stages[ui.startup_stage]||'准备中');next='正在自动推进；API 密钥可用后可导出，异常会在右侧日志显示。';}\n    else if(ui.busy){headline=ui.operation || '操作进行中';next='详细过程只在右侧日志更新；不重复提交当前操作。';}\n    else if(state.phase && state.phase!=='new'){headline='服务正在准备';next='右侧日志持续更新；无需等待模型就绪才观察 API。';}\n    else if(ui.install_ok){headline='依赖已就绪';next='点击一键启动继续；需要分步维护时再展开高级控制。';}\n    else if(ui.preflight_ok){headline='资源检查通过';next='点击一键启动继续安装和启动，无需逐步点击。';}\n    text('headline',headline);text('next-step',next);$('board').dataset.tone=tone;\n    const module=(alive,ready)=>{\n      if(offline() || closed() || !Object.keys(state).length) return '尚未读取';\n      if(cleanStop) return '已停止';\n      if(stale) return '待刷新';\n      if(ready===true) return '可用';\n      if(alive===true) return ready===undefined?'运行中':'准备中';\n      return alive===false?'已停止':'未确认';\n    };\n    text('manager-state',module(state.manager_alive));text('api-state',module(state.server_alive,state.api_ready));text('model-state',module(state.model_alive,state.model_ready));\n    text('public-state', offline()||closed()||!Object.keys(state).length?'尚未读取':cleanStop?'已关闭':stale?'待刷新':!state.public_requested?'未启用':state.public_api_ready?'探测通过':state.tunnel_connected?'等待探测':'准备中');\n    const queue=state.queue||{};text('queue-state',stale||offline()?'排队 —　执行 —':`排队 ${queue.queued??'—'}　执行 ${queue.running??'—'}`);\n    const gpu=resources.gpu?String(resources.gpu).replace(/^NVIDIA\\s+/,''):'A100（配置）';\n    text('resources',`${gpu} · 原生 BF16${resources.available_ram_gib!==undefined?' · 可用内存 '+resources.available_ram_gib+' GiB（预检）':''}`);\n    text('board-stamp',state.observed_at?'观察 '+nowText(state.observed_at):'尚无服务观察');\n    renderConnection();renderTransfers();\n  }\n  function connectionLabel() {\n    const value=closed()?'连接已关闭':offline()?'离线占位':delivering()?'启动交付 · 宿主推送':connectionLost?'连接待确认':paused?'已暂停读取':document.hidden?'页面隐藏 · 暂停':'持续读取';\n    text('connection-state',value);$('live-dot').classList.toggle('live',!offline()&&!closed()&&!connectionLost&&!paused&&!document.hidden);\n    text('log-mode',delivering()?'宿主推送 · 停止本单元可取消':paused?'日志保持静止':offline()||closed()?'未自动读取':'每 2 秒读取');\n  }\n  function clearNotice() { $('notice-zone').replaceChildren(); shownNoticeId=null; }\n  function notice(value,buttons=[]) {\n    if(!value){clearNotice();return;}\n    clearNotice();\n    const card=document.createElement('section');card.className='notice';card.dataset.kind=value.kind||'info';\n    const heading=document.createElement('div');heading.className='notice-title';heading.textContent=safeText(value.title||'提示');\n    const message=document.createElement('div');message.className='notice-message';message.textContent=safeText(value.message||'').slice(0,3000);\n    card.append(heading,message);\n    const actions=document.createElement('div');actions.className='notice-actions';\n    for(const item of buttons){const button=document.createElement('button');button.type='button';button.textContent=item.label;if(item.primary)button.className='primary';button.addEventListener('click',item.click);actions.append(button);}\n    if(!buttons.length){const dismiss=document.createElement('button');dismiss.type='button';dismiss.textContent='收起';dismiss.addEventListener('click',()=>{if(value.id)knownNotices.add(String(value.id));localNotice=null;clearNotice();});actions.append(dismiss);}\n    card.append(actions);$('notice-zone').append(card);shownNoticeId=value.id?String(value.id):null;\n    return {card,actions};\n  }\n  function showLocal(value){localNotice=value;notice(value);}\n  function renderLogs(logs) {\n    if(!logs || typeof logs.text!=='string')return;\n    const selectedSource=$('log-source').value;\n    const source=logs.source||selectedSource;\n    if(source!==selectedSource)return;\n    lastLogs=logs;\n    const viewport=$('log-viewport');const nearBottom=viewport.scrollHeight-viewport.scrollTop-viewport.clientHeight<38;\n    const scrollTop=viewport.scrollTop;const changedSource=source!==lastSource;\n    const fullText=safeText(logs.text).slice(-64000);\n    const tail=source==='state'?fullText:fullText.replace(/\\r?\\n$/, '').split(/\\r?\\n/).slice(-Number($('log-lines').value)).join('\\n');\n    const next=tail||'该来源暂无日志。';\n    if(next!==lastText || changedSource){$('log-text').textContent=next;lastText=next;lastSource=source;\n      if($('follow-logs').checked&&(nearBottom||changedSource))viewport.scrollTop=viewport.scrollHeight;\n      else viewport.scrollTop=scrollTop;\n    }\n    text('log-stamp',`只读 · 已脱敏 · ${logs.observed_at?nowText(logs.observed_at):'最新读取'}`);\n  }\n  function apply(data) {\n    if(!data || typeof data!=='object')return;\n    for(const key of ['state','resources','ui','result','connection','downloads'])if(data[key]!==undefined)current[key]=data[key];\n    renderBoard();renderLogs(data.logs);connectionLabel();setButtons();\n    if(data.notice&&!pendingConfirmation&&!localNotice){const id=String(data.notice.id||JSON.stringify(data.notice));if(!knownNotices.has(id)&&shownNoticeId!==id)notice({...data.notice,id});}\n    if(closed()){clearTimeout(timer);timer=null;}\n  }\n  async function rpc(action,data) {\n    if(offline()||closed())throw new Error('当前未连接到控制台后台。');\n    if(delivering())throw new Error('启动交付观察期间由宿主推送状态；如需取消，请停止本单元。');\n    const request=typeof window.H3_TRANSPORT==='function'?window.H3_TRANSPORT(action,data):window.google.colab.kernel.invokeFunction(CALLBACK_NAME,[action,data],{});\n    let timeout;\n    try {\n      const raw=await Promise.race([Promise.resolve(request),new Promise((_,reject)=>{timeout=setTimeout(()=>reject(new Error('连接超时，操作结果尚未确认。')),20000);})]);\n      let value=raw?.data?.['application/json']??raw;\n      if(typeof value==='string')value=JSON.parse(value);\n      if(!value||typeof value!=='object')throw new Error('后台没有返回可识别的结果。');\n      if(value.accepted===false || value.ok===false || (value.error && !['snapshot','refresh_board'].includes(action)) || (value.error && !value.state)){\n        const error=new Error(typeof value.error==='string'?value.error:'后台拒绝了本次操作。');error.confirmed=true;throw error;\n      }\n      return value;\n    } finally {clearTimeout(timeout);}\n  }\n  async function requestSecret() {\n    const credentialId=current.connection?.credential_id, epoch=secretEpoch;\n    if(!credentialId||!current.connection?.key_available||connectionLost||document.hidden)throw new Error('当前密钥不可读取；先刷新连接状态。');\n    if(keyVisible&&revealedKey&&credentialId===observedCredentialId)return revealedKey;\n    const data=await rpc('reveal_connection',{credential_id:credentialId});\n    const secret=data.connection_secret;\n    if(epoch!==secretEpoch||credentialId!==current.connection?.credential_id||secret?.credential_id!==credentialId||offline()||closed()||connectionLost||document.hidden){\n      throw new Error('连接或页面状态已变化，密钥未显示；请重新读取。');\n    }\n    if(typeof secret.api_key!=='string'||secret.api_key.length<32||secret.api_key.length>4096)throw new Error('没有收到有效的 API 密钥。');\n    return secret.api_key;\n  }\n  async function toggleSecret() {\n    if(secretBusy)return;\n    if(keyVisible){clearSecret();renderConnection();setButtons();return;}\n    secretBusy=true;setButtons();\n    try {revealedKey=await requestSecret();keyVisible=true;renderConnection();}\n    catch {clearSecret();showLocal({kind:'warning',title:'密钥未显示',message:'当前连接无法确认或密钥已变化。刷新看板后可重新显示；密钥不会写入日志。'});}\n    finally{secretBusy=false;setButtons();}\n  }\n  async function copyConnection(kind) {\n    if(kind==='key'&&secretBusy)return;\n    let value='';const button=kind==='key'?$('copy-key'):$('copy-url');\n    if(kind==='key'){secretBusy=true;setButtons();}\n    try {\n      value=kind==='key'?await requestSecret():usableUrl(current.connection?.url);\n      if(!value)throw new Error('No confirmed value');\n      if(typeof navigator.clipboard?.writeText!=='function')throw new Error('Clipboard unavailable');\n      await navigator.clipboard.writeText(value);\n      text(button.id,'已复制');setTimeout(()=>{if(!disposed)text(button.id,'复制');},1500);\n    } catch {\n      showLocal({kind:'warning',title:'暂时无法复制',message:kind==='key'?'浏览器未允许复制或连接已变化。可先点击「显示」，再手动复制密钥。':'尚无已验证地址或浏览器未允许复制。确认 API 可用后，可从地址栏手动复制。'});\n    } finally {value='';if(kind==='key')secretBusy=false;setButtons();}\n  }\n  function schedule() {\n    clearTimeout(timer);timer=null;\n    if(disposed||offline()||closed()||paused||document.hidden)return;\n    if(delivering()){\n      const remaining=Number(current.ui.startup_delivery.deadline_at)*1000+5100-Date.now();\n      timer=setTimeout(()=>{connectionLabel();setButtons();readSnapshot(false);},Math.max(100,remaining));return;\n    }\n    timer=setTimeout(()=>readSnapshot(false),Math.min(10000,2000*Math.max(1,failures)));\n  }\n  async function readSnapshot(manual=false,action='snapshot') {\n    if(polling||disposed||offline()||closed()||delivering())return;\n    if(!manual&&(paused||document.hidden))return;\n    const source=$('log-source').value;\n    clearTimeout(timer);timer=null;polling=true;setButtons();\n    try {const data=await rpc(action,{source});connectionLost=false;failures=0;if(localNotice?.id==='connection-lost'){localNotice=null;clearNotice();}apply(data);}\n    catch(error){connectionLost=true;failures++;renderBoard();if(manual||failures===1)showLocal({id:'connection-lost',kind:'warning',title:'暂时无法读取状态',message:safeText(error.message)+'\\n日志保留在原位；不会自动重发业务操作。'});}\n    finally{polling=false;connectionLabel();setButtons();if(source!==$('log-source').value)readSnapshot(true);else schedule();}\n  }\n  function offerDownload(download) {\n    if(!download || typeof download.data_base64!=='string')return;\n    if(download.data_base64.length>Math.ceil(32*1024*1024*4/3)+8)throw new Error('下载文件超过控制台的 32 MiB 上限。');\n    const binary=atob(download.data_base64);const bytes=new Uint8Array(binary.length);for(let i=0;i<binary.length;i++)bytes[i]=binary.charCodeAt(i);\n    const url=URL.createObjectURL(new Blob([bytes],{type:download.mime||'application/octet-stream'}));blobUrls.add(url);\n    localNotice={kind:'info',title:'文件已准备',message:'点击保存文件。若为私密连接文件，请单独保管。'};\n    const view=notice(localNotice);const link=document.createElement('a');link.href=url;link.download=String(download.name||'result.bin').replace(/[\\\\/]/g,'_');link.textContent='保存文件';view.actions.prepend(link);\n    link.addEventListener('click',()=>{setTimeout(()=>{URL.revokeObjectURL(url);blobUrls.delete(url);},60000);});\n  }\n  async function dispatch(action,values) {\n    if(activeActions.has(action))return;\n    if(delivering()){showLocal({kind:'info',title:'启动交付观察中',message:'当前单元仍在执行，后台保持并行准备。如需取消，请使用 Colab 本单元的停止按钮，程序会回收已启动进程。'});return;}\n    if(offline()||closed()){showLocal({kind:'info',title:'尚未连接',message:'连接运行时并运行控制台单元后再操作。'});return;}\n    const fingerprint=action+':'+JSON.stringify(values);const requestId=uncertainRequests.get(fingerprint)||uuid();\n    activeActions.add(action);setButtons();localNotice=null;pendingConfirmation=null;clearNotice();\n    try {\n      const data=await rpc(action,{...values,request_id:requestId});uncertainRequests.delete(fingerprint);connectionLost=false;apply(data);\n      if(data.download)offerDownload(data.download);\n      else if(data.notice){localNotice=data.notice;notice(data.notice);}\n      // Ordinary accepted operations update the log and board without another notice card.\n    } catch(error) {\n      if(error.confirmed)uncertainRequests.delete(fingerprint);else uncertainRequests.set(fingerprint,requestId);\n      showLocal({kind:'error',title:error.confirmed?'操作未完成':'操作结果尚未确认',message:safeText(error.message)+(error.confirmed?'\\n请根据日志处理后再操作。':'\\n未自动重发。先查看状态；再次提交相同操作时会沿用本次请求编号。')});\n    } finally {activeActions.delete(action);setButtons();schedule();}\n  }\n  function requestAction(action,values) {\n    if(action==='release'||(action==='control'&&values.action==='stop_model'&&values.force)){\n      pendingConfirmation={action,values};localNotice=null;\n      notice({kind:'warning',title:action==='release'?'释放当前云实例？':'强制停止模型？',message:action==='release'?'释放后，Colab 临时文件将丢失。请确认已保存结果。':'这会中断模型进程中的任务。排队取消不需要强制停止。'},[\n        {label:'取消',click:()=>{pendingConfirmation=null;clearNotice();}},\n        {label:action==='release'?'确认释放':'确认强制停止',primary:true,click:()=>{const pending=pendingConfirmation;if(pending){pendingConfirmation=null;dispatch(pending.action,pending.values);}}}\n      ]);return;\n    }\n    dispatch(action,values);\n  }\n  for(const button of actionButtons)button.addEventListener('click',()=>requestAction(button.dataset.action,payload()));\n  $('send-control').addEventListener('click',()=>requestAction('control',{action:$('component-action').value,force:$('force').checked}));\n  $('query-command').addEventListener('click',()=>{const id=$('command_id').value.trim();if(!id){showLocal({kind:'info',title:'填写命令 ID',message:'在高级控制中填写需要查询的命令 ID。'});return;}dispatch('control',{action:'query',command_id:id});});\n  $('refresh-board').addEventListener('click',()=>readSnapshot(true,'refresh_board'));\n  $('toggle-key').addEventListener('click',toggleSecret);\n  $('copy-key').addEventListener('click',()=>copyConnection('key'));\n  $('copy-url').addEventListener('click',()=>copyConnection('url'));\n  $('refresh-logs').addEventListener('click',()=>readSnapshot(true));\n  $('log-source').addEventListener('change',()=>{\n    lastSource='';\n    $('log-lines').disabled=$('log-source').value==='state';\n    readSnapshot(true);\n  });\n  $('log-lines').addEventListener('change',()=>{if(!offline())renderLogs(lastLogs);});\n  $('toggle-logs').addEventListener('click',()=>{paused=!paused;clearTimeout(timer);timer=null;text('toggle-logs',paused?'继续':'暂停');connectionLabel();if(!paused)readSnapshot(true);});\n  $('follow-logs').addEventListener('change',()=>{if($('follow-logs').checked)$('log-viewport').scrollTop=$('log-viewport').scrollHeight;});\n  document.addEventListener('visibilitychange',()=>{clearTimeout(timer);timer=null;if(document.hidden)clearSecret();connectionLabel();setButtons();if(!document.hidden&&!paused)readSnapshot(false);});\n  function dispose(){disposed=true;clearSecret();clearTimeout(timer);timer=null;for(const url of blobUrls)URL.revokeObjectURL(url);blobUrls.clear();}\n  window.addEventListener('pagehide',dispose,{once:true});window.addEventListener('beforeunload',dispose,{once:true});\n  apply(current);if(offline())text('log-text','尚未连接运行时，没有实时日志。\\n连接后，提示、确认和下载入口只在此区域出现。');else schedule();\n})();\n</script>\n</body>\n</html>\n"
      ],
