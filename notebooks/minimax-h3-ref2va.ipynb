'info\\',title:\\'尚未连接\\',message:\\'连接运行时并运行控制台单元后再操作。\\'});return;}\\n    const fingerprint=action+\\':\\'+JSON.stringify(values);const requestId=uncertainRequests.get(fingerprint)||uuid();\\n    activeActions.add(action);setButtons();localNotice=null;pendingConfirmation=null;clearNotice();\\n    try {\\n      const data=await rpc(action,{...values,request_id:requestId});uncertainRequests.delete(fingerprint);connectionLost=false;apply(data);\\n      if(data.download)offerDownload(data.download);\\n      else if(data.notice){localNotice=data.notice;notice(data.notice);}\\n      // Ordinary accepted operations update the log and board without another notice card.\\n    } catch(error) {\\n      if(error.confirmed)uncertainRequests.delete(fingerprint);else uncertainRequests.set(fingerprint,requestId);\\n      showLocal({kind:\\'error\\',title:error.confirmed?\\'操作未完成\\':\\'操作结果尚未确认\\',message:safeText(error.message)+(error.confirmed?\\'\\\\n请根据日志处理后再操作。\\':\\'\\\\n未自动重发。先查看状态；再次提交相同操作时会沿用本次请求编号。\\')});\\n    } finally {activeActions.delete(action);setButtons();schedule();}\\n  }\\n  function requestAction(action,values) {\\n    if(action===\\'release\\'||(action===\\'control\\'&&values.action===\\'stop_model\\'&&values.force)){\\n      pendingConfirmation={action,values};localNotice=null;\\n      notice({kind:\\'warning\\',title:action===\\'release\\'?\\'释放当前云实例？\\':\\'强制停止模型？\\',message:action===\\'release\\'?\\'释放后，Colab 临时文件将丢失。请确认已保存结果。\\':\\'这会中断模型进程中的任务。排队取消不需要强制停止。\\'},[\\n        {label:\\'取消\\',click:()=>{pendingConfirmation=null;clearNotice();}},\\n        {label:action===\\'release\\'?\\'确认释放\\':\\'确认强制停止\\',primary:true,click:()=>{const pending=pendingConfirmation;if(pending){pendingConfirmation=null;dispatch(pending.action,pending.values);}}}\\n      ]);return;\\n    }\\n    dispatch(action,values);\\n  }\\n  for(const button of actionButtons)button.addEventListener(\\'click\\',()=>requestAction(button.dataset.action,payload()));\\n  $(\\'send-control\\').addEventListener(\\'click\\',()=>requestAction(\\'control\\',{action:$(\\'component-action\\').value,force:$(\\'force\\').checked}));\\n  $(\\'query-command\\').addEventListener(\\'click\\',()=>{const id=$(\\'command_id\\').value.trim();if(!id){showLocal({kind:\\'info\\',title:\\'填写命令 ID\\',message:\\'在高级控制中填写需要查询的命令 ID。\\'});return;}dispatch(\\'control\\',{action:\\'query\\',command_id:id});});\\n  $(\\'refresh-board\\').addEventListener(\\'click\\',()=>readSnapshot(true,\\'refresh_board\\'));\\n  $(\\'toggle-key\\').addEventListener(\\'click\\',toggleSecret);\\n  $(\\'copy-key\\').addEventListener(\\'click\\',()=>copyConnection(\\'key\\'));\\n  $(\\'copy-url\\').addEventListener(\\'click\\',()=>copyConnection(\\'url\\'));\\n  $(\\'refresh-logs\\').addEventListener(\\'click\\',()=>readSnapshot(true));\\n  $(\\'log-source\\').addEventListener(\\'change\\',()=>{\\n    lastSource=\\'\\';\\n    $(\\'log-lines\\').disabled=$(\\'log-source\\').value===\\'state\\';\\n    readSnapshot(true);\\n  });\\n  $(\\'log-lines\\').addEventListener(\\'change\\',()=>{if(!offline())renderLogs(lastLogs);});\\n  $(\\'toggle-logs\\').addEventListener(\\'click\\',()=>{paused=!paused;clearTimeout(timer);timer=null;text(\\'toggle-logs\\',paused?\\'继续\\':\\'暂停\\');connectionLabel();if(!paused)readSnapshot(true);});\\n  $(\\'follow-logs\\').addEventListener(\\'change\\',()=>{if($(\\'follow-logs\\').checked)$(\\'log-viewport\\').scrollTop=$(\\'log-viewport\\').scrollHeight;});\\n  document.addEventListener(\\'visibilitychange\\',()=>{clearTimeout(timer);timer=null;if(document.hidden)clearSecret();connectionLabel();setButtons();if(!document.hidden&&!paused)readSnapshot(false);});\\n  function dispose(){disposed=true;clearSecret();clearTimeout(timer);timer=null;for(const url of blobUrls)URL.revokeObjectURL(url);blobUrls.clear();}\\n  window.addEventListener(\\'pagehide\\',dispose,{once:true});window.addEventListener(\\'beforeunload\\',dispose,{once:true});\\n  apply(current);if(offline())text(\\'log-text\\',\\'尚未连接运行时，没有实时日志。\\\\n连接后，提示、确认和下载入口只在此区域出现。\\');else schedule();\\n})();\\n</script>\\n</body>\\n</html>\\n', 'download_progress.py': '\"\"\"Observed Hugging Face transfer progress, separate from model readiness.\\n\\nNo extra downloads, repository scans, or scheduling are introduced. An owned\\nload temporarily supplies a progress-bar observer to HF\\'s existing HTTP/Xet\\ntransfer functions. Unsupported signatures degrade to unknown progress. The\\ndownload algorithm, retries, validation, caching and worker counts stay in HF.\\n\"\"\"\\nfrom __future__ import annotations\\n\\nfrom contextlib import contextmanager\\nfrom copy import deepcopy\\nimport functools\\nimport hashlib\\nimport importlib\\nimport inspect\\nimport json\\nimport math\\nimport os\\nfrom pathlib import Path\\nimport threading\\nimport time\\nimport uuid\\n\\nMAX_STATE_BYTES = 256 * 1024\\nPHASES = {\\'waiting\\', \\'downloading\\', \\'verifying\\', \\'loading\\', \\'loaded\\', \\'disabled\\', \\'failed\\'}\\n_ACTIVE = None\\n_RECORDER = None\\n_HOOK_LOCK = threading.RLock()\\n\\n\\ndef _number(value):\\n    return type(value) in (int, float) and math.isfinite(value) and value >= 0\\n\\n\\ndef read_progress(path, expected_instance_id=None):\\n    unavailable = {\\'schema_version\\': 1, \\'model_instance_id\\': expected_instance_id,\\n                   \\'observed_at\\': None, \\'observation_stale\\': True, \\'items\\': {}}\\n    try:\\n        path = Path(path)\\n        if path.stat().st_size > MAX_STATE_BYTES:\\n            raise ValueError(\\'oversized\\')\\n        with path.open(\\'r\\', encoding=\\'utf-8\\') as stream:\\n            raw = stream.read(MAX_STATE_BYTES + 1)\\n        if len(raw.encode(\\'utf-8\\')) > MAX_STATE_BYTES:\\n            raise ValueError(\\'oversized\\')\\n        data = json.loads(raw)\\n        if data.get(\\'schema_version\\') != 1 or not isinstance(data.get(\\'items\\'), dict):\\n            raise ValueError(\\'invalid_schema\\')\\n        if expected_instance_id is not None and data.get(\\'model_instance_id\\') != expected_instance_id:\\n            raise ValueError(\\'generation_mismatch\\')\\n        if not _number(data.get(\\'observed_at\\')):\\n            raise ValueError(\\'invalid_timestamp\\')\\n        items = {}\\n        for key in (\\'model\\', \\'acceleration\\', \\'style\\'):\\n            item = data[\\'items\\'].get(key)\\n            if item is None:\\n                continue\\n            if not isinstance(item, dict) or item.get(\\'phase\\') not in PHASES:\\n                raise ValueError(\\'invalid_item\\')\\n            clean = {\\'phase\\': item[\\'phase\\']}\\n            for field in (\\'bytes_completed\\', \\'bytes_total\\', \\'percent\\', \\'files_completed\\', \\'files_total\\', \\'active_files\\'):\\n                value = item.get(field)\\n                if value is not None and not _number(value):\\n                    raise ValueError(\\'invalid_counter\\')\\n                if field == \\'percent\\' and value is not None and value > 100:\\n                    raise ValueError(\\'invalid_percent\\')\\n                clean[field] = value\\n            for field in (\\'scope\\', \\'detail\\'):\\n                clean[field] = str(item.get(field, \\'\\'))[:240]\\n            clean[\\'cache_hit\\'] = item.get(\\'cache_hit\\') if type(item.get(\\'cache_hit\\')) is bool else None\\n            items[key] = clean\\n        return {\\'schema_version\\': 1, \\'model_instance_id\\': data.get(\\'model_instance_id\\'),\\n                \\'observed_at\\': data[\\'observed_at\\'], \\'observation_stale\\': False, \\'items\\': items}\\n    except (OSError, ValueError, TypeError, AttributeError) as error:\\n        return dict(unavailable, error=str(error) if isinstance(error, ValueError) and str(error) in {\\n            \\'oversized\\', \\'invalid_schema\\', \\'generation_mismatch\\', \\'invalid_timestamp\\', \\'invalid_item\\',\\n            \\'invalid_counter\\', \\'invalid_percent\\'} else \\'progress_unavailable\\')\\n\\n\\nclass DownloadProgress:\\n    def __init__(self, path=None, *, instance_id=None, settings=None, interval=.5, clock=time.monotonic):\\n        self.path = Path(path) if path else None\\n        self.instance_id = instance_id\\n        self.lock = threading.RLock()\\n        self.interval, self.clock, self.last_write = interval, clock, -math.inf\\n        self.category = \\'model\\'\\n        self.transfers = {}\\n        self.transfer_identities = {}\\n        self.measurement_available = None\\n        self.items = {}\\n        self._phase_details = {}\\n        for name in (\\'model\\', \\'acceleration\\', \\'style\\'):\\n            enabled = name == \\'model\\' or (settings is not None and getattr(settings, name, \\'none\\') != \\'none\\')\\n            self.items[name] = dict(phase=\\'waiting\\' if enabled else \\'disabled\\', bytes_completed=0,\\n                bytes_total=None, percent=None, files_completed=0, files_total=None,\\n                active_files=0, scope=\\'observed_transfers\\' if name == \\'model\\' else \\'asset\\',\\n                detail=\\'尚未开始\\' if enabled else \\'未启用\\', cache_hit=None)\\n        self._write(force=True)\\n\\n    def _document(self):\\n        return {\\'schema_version\\': 1, \\'model_instance_id\\': self.instance_id,\\n                \\'observed_at\\': time.time(), \\'observation_stale\\': False, \\'items\\': deepcopy(self.items)}\\n\\n    def snapshot(self):\\n        with self.lock:\\n            return self._document()\\n\\n    def _write(self, *, force=False, event=None):\\n        if not self.path:\\n            return\\n        now = self.clock()\\n        if not force and now - self.last_write < self.interval:\\n            return\\n        try:\\n            self.path.parent.mkdir(parents=True, exist_ok=True)\\n            temporary = self.path.with_name(self.path.name + \\'.\\' + uuid.uuid4().hex + \\'.tmp\\')\\n            try:\\n                temporary.write_text(json.dumps(self._document(), ensure_ascii=False), encoding=\\'utf-8\\')\\n                os.replace(temporary, self.path)\\n            finally:\\n                temporary.unlink(missing_ok=True)\\n            if event:\\n                with self.path.with_suffix(\\'.events.jsonl\\').open(\\'a\\', encoding=\\'utf-8\\') as stream:\\n                    stream.write(json.dumps({\\'observed_at\\': time.time(), \\'model_instance_id\\': self.instance_id,\\n                                             **event}, ensure_ascii=False) + \\'\\\\n\\')\\n            self.last_write = now\\n        except OSError:\\n            # UI telemetry must never abort or retry an otherwise valid download.\\n            pass\\n\\n    def phase(self, category, phase, detail=\\'\\', *, total=None, cache_hit=None):\\n        if phase not in PHASES or category not in self.items:\\n            raise ValueError(\\'Invalid progress phase/category\\')\\n        with self.lock:\\n            item = self.items[category]\\n            if self.measurement_available is False and phase in {\\'loading\\', \\'loaded\\'}:\\n                detail += \\'；当前下载库未提供兼容进度回调\\'\\n            item.update(phase=phase, detail=detail[:240])\\n            self._phase_details[category] = (phase, detail[:240])\\n            if total is not None and category != \\'model\\':\\n                item.update(bytes_total=int(total), files_total=1)\\n            if cache_hit is not None:\\n                item[\\'cache_hit\\'] = bool(cache_hit)\\n            if phase in {\\'verifying\\', \\'loaded\\'} and total is not None and category != \\'model\\':\\n                item.update(bytes_completed=int(total), percent=100, files_completed=1)\\n            self._write(force=True, event={\\'type\\': \\'phase\\', \\'category\\': category, \\'phase\\': phase})\\n\\n    def begin_transfer(self, category, total=None, initial=0, identity=None):\\n        with self.lock:\\n            identity = (category, identity) if identity is not None else None\\n            transfer = self.transfer_identities.get(identity) if identity is not None else None\\n            if transfer is None:\\n                transfer = uuid.uuid4().hex\\n                self.transfers[transfer] = {\\'category\\': category, \\'n\\': max(0, initial),\\n                                           \\'total\\': total, \\'finished\\': False, \\'active\\': 0}\\n                if identity is not None:\\n                    self.transfer_identities[identity] = transfer\\n            entry = self.transfers[transfer]\\n            entry.update(n=max(entry[\\'n\\'], initial), finished=False, active=entry[\\'active\\'] + 1)\\n            self._update_item(category)\\n            self._write(force=True, event={\\'type\\': \\'transfer.started\\', \\'category\\': category,\\n                                          \\'transfer_id\\': transfer, \\'total\\': total, \\'initial\\': initial})\\n        return transfer\\n\\n    def update_transfer(self, transfer, completed):\\n        with self.lock:\\n            entry = self.transfers[transfer]\\n            # Callback retries cannot decrease or double-count a transfer\\'s absolute progress.\\n            entry[\\'n\\'] = max(entry[\\'n\\'], completed)\\n            self._update_item(entry[\\'category\\'])\\n            self._write()\\n\\n    def finish_transfer(self, transfer, *, success):\\n        with self.lock:\\n            entry = self.transfers[transfer]\\n            entry[\\'active\\'] = max(0, entry[\\'active\\'] - 1)\\n            entry.update(finished=entry[\\'active\\'] == 0, success=success)\\n            self._update_item(entry[\\'category\\'])\\n            self._write(force=True, event={\\'type\\': \\'transfer.finished\\', \\'category\\': entry[\\'category\\'],\\n                                          \\'transfer_id\\': transfer, \\'success\\': success})\\n\\n    def _update_item(self, category):\\n        entries = [e for e in self.transfers.values() if e[\\'category\\'] == category]\\n        item = self.items[category]\\n        item[\\'active_files\\'] = sum(not e[\\'finished\\'] for e in entries)\\n        item[\\'files_completed\\'] = sum(e.get(\\'success\\') is True and e[\\'finished\\'] for e in entries)\\n        value = sum(e[\\'n\\'] for e in entries)\\n        item[\\'bytes_completed\\'] = max(item[\\'bytes_completed\\'], value)\\n        if category != \\'model\\' and item[\\'bytes_total\\']:\\n            item[\\'bytes_completed\\'] = min(item[\\'bytes_total\\'], item[\\'bytes_completed\\'])\\n            item[\\'percent\\'] = round(100 * item[\\'bytes_completed\\'] / item[\\'bytes_total\\'], 1)\\n        if item[\\'active_files\\']:\\n            item.update(phase=\\'downloading\\', detail=\\'已观察文件量（含续传与重建）；整模型总量未知\\' if category == \\'model\\'\\n                        else \\'正在下载/重建已选 LoRA 文件\\')\\n        elif item[\\'phase\\'] == \\'downloading\\':\\n            phase, detail = self._phase_details.get(category, (\\'loading\\', \\'继续加载；下载完成不代表模型就绪\\'))\\n            item.update(phase=phase, detail=detail)\\n\\n\\nclass _ProgressBar:\\n    \"\"\"Protocol proxy used by HF HTTP and Xet reconstruction callbacks.\"\"\"\\n    def __init__(self, recorder, transfer, *, initial=0, total=None, delegate=None):\\n        self.recorder, self.transfer, self.delegate = recorder, transfer, delegate\\n        self.n, self.total = initial, total\\n        self.disable = False\\n        self.lock = threading.RLock()\\n\\n    def update(self, amount=1):\\n        with self.lock:\\n            self.n = max(0, self.n + (amount or 0))\\n            try:\\n                self.recorder.update_transfer(self.transfer, self.n)\\n            except Exception:\\n                pass  # Observation cannot fail an otherwise valid payload transfer.\\n            if self.delegate is not None:\\n                return self.delegate.update(amount)\\n\\n    def __getattr__(self, name):\\n        if self.delegate is not None:\\n            return getattr(self.delegate, name)\\n        if name == \\'format_dict\\':\\n            return {\\'n\\': self.n, \\'total\\': self.total, \\'rate\\': None}\\n        if name in {\\'refresh\\', \\'set_description\\', \\'set_description_str\\', \\'set_postfix_str\\', \\'close\\'}:\\n            return lambda *a, **kw: None\\n        raise AttributeError(name)\\n\\n    def __enter__(self):\\n        return self\\n\\n    def __exit__(self, *args):\\n        return False\\n\\n\\ndef _wrap_transfer(original, recorder):\\n    try:\\n        signature = inspect.signature(original)\\n    except (ValueError, TypeError):\\n        return original\\n    if \\'_tqdm_bar\\' not in signature.parameters:\\n        return original\\n\\n    @functools.wraps(original)\\n    def observed(*args, **kwargs):\\n        bound = signature.bind_partial(*args, **kwargs)\\n        existing = bound.arguments.get(\\'_tqdm_bar\\')\\n        if isinstance(existing, _ProgressBar):\\n            return original(*args, **kwargs)  # HF\\'s nested HTTP retry owns the same byte counter.\\n        total, initial = bound.arguments.get(\\'expected_size\\'), bound.arguments.get(\\'resume_size\\', 0)\\n        total = int(total) if _number(total) else None\\n        initial = int(initial) if _number(initial) else 0\\n        # Hash an owned temporary-file identity, never persist a signed URL or local path.\\n        path = bound.arguments.get(\\'incomplete_path\\') or bound.arguments.get(\\'downloaded_file\\')\\n        if path is None:\\n            path = getattr(bound.arguments.get(\\'temp_file\\'), \\'name\\', None)\\n        identity = hashlib.sha256(os.fsencode(path)).hexdigest() if isinstance(path, (str, bytes, os.PathLike)) else None\\n        transfer = recorder.begin_transfer(recorder.category, total, initial, identity=identity)\\n        bound.arguments[\\'_tqdm_bar\\'] = _ProgressBar(recorder, transfer, initial=initial, total=total, delegate=existing)\\n        try:\\n            result = original(*bound.args, **bound.kwargs)\\n        except BaseException:\\n            recorder.finish_transfer(transfer, success=False)\\n            raise\\n        recorder.finish_transfer(transfer, success=True)\\n        return result\\n    return observed\\n\\n\\n@contextmanager\\ndef observe_hub_downloads(recorder):\\n    \"\"\"A model process owns these hooks; no thread pool or concurrency limit changes.\"\"\"\\n    global _ACTIVE\\n    with _HOOK_LOCK:\\n        if _ACTIVE is recorder:\\n            yield recorder\\n            return\\n        previous, patched = _ACTIVE, []\\n        _ACTIVE = recorder\\n        try:\\n            try:\\n                module = importlib.import_module(\\'huggingface_hub.file_download\\')\\n                for name in (\\'http_get\\', \\'xet_get\\'):\\n                    original = getattr(module, name, None)\\n                    if callable(original):\\n                        wrapper = _wrap_transfer(original, recorder)\\n                        if wrapper is not original:\\n                            setattr(module, name, wrapper)\\n                            patched.append((module, name, original, wrapper))\\n            except (ImportError, AttributeError, TypeError, ValueError):\\n                pass\\n            recorder.measurement_available = bool(patched)\\n            yield recorder\\n        finally:\\n            for module, name, original, wrapper in reversed(patched):\\n                if getattr(module, name) is wrapper:\\n                    setattr(module, name, original)\\n            _ACTIVE = previous\\n\\n\\ndef current_progress():\\n    return _ACTIVE or _RECORDER\\n\\n\\n@contextmanager\\ndef adapter_progress(category, spec):\\n    recorder = current_progress()\\n    if recorder is None:\\n        yield None\\n        return\\n    with observe_hub_downloads(recorder):\\n        previous = recorder.category\\n        recorder.category = category\\n        try:\\n            recorder.phase(category, \\'loading\\', \\'准备所选 LoRA\\', total=spec.size)\\n            yield recorder\\n        except BaseException:\\n            recorder.phase(category, \\'failed\\', \\'LoRA 下载、校验或加载失败；详见模型日志\\')\\n            raise\\n        finally:\\n            recorder.category = previous\\n\\n\\ndef tracked_model_load(function):\\n    @functools.wraps(function)\\n    def tracked(self, *args, **kwargs):\\n        global _RECORDER\\n        path = os.environ.get(\\'H3_DOWNLOAD_PROGRESS_PATH\\')\\n        if not path:\\n            return function(self, *args, **kwargs)\\n        recorder = DownloadProgress(path, instance_id=os.environ.get(\\'H3_MODEL_INSTANCE_ID\\'),\\n                                    settings=getattr(self, \\'adapter_settings\\', None))\\n        _RECORDER = recorder\\n        with observe_hub_downloads(recorder):\\n            recorder.phase(\\'model\\', \\'loading\\', \\'检查缓存并加载所需组件；整模型总量未知\\')\\n            try:\\n                result = function(self, *args, **kwargs)\\n            except BaseException:\\n                recorder.phase(\\'model\\', \\'failed\\', \\'下载或加载失败；详见模型日志\\')\\n                raise\\n            no_transfers = not any(e[\\'category\\'] == \\'model\\' for e in recorder.transfers.values())\\n            recorder.phase(\\'model\\', \\'loaded\\', \\'组件加载完成；等待容器就绪检查\\' +\\n                           (\\'。未观察到传输：缓存命中或当前库未提供回调\\' if no_transfers else \\'\\'))\\n            return result\\n    return tracked\\n\\n\\ndef tracked_adapter_application(function):\\n    @functools.wraps(function)\\n    def tracked(pipe, settings, *args, **kwargs):\\n        try:\\n            return function(pipe, settings, *args, **kwargs)\\n        except BaseException:\\n            recorder = current_progress()\\n            if recorder:\\n                for category in (\\'acceleration\\', \\'style\\'):\\n                    if getattr(settings, category, \\'none\\') != \\'none\\':\\n                        recorder.phase(category, \\'failed\\', \\'LoRA 下载、验证或组合加载失败；详见模型日志\\')\\n            raise\\n    return tracked\\n', 'generation_options.py': '\"\"\"Auditable per-job BF16 choices; no arbitrary kernels or adapter downloads.\\n\\nConfiguration permits queue admission before readiness. Only the model\\'s GPU\\nlease may apply these choices; CPU preparation only validates immutable data.\\n\"\"\"\\nfrom __future__ import annotations\\n\\nfrom adapter_config import AdapterSettings, TURBO, load_adapter_settings, validate_steps\\nfrom runtime_options import RuntimeOptions\\n\\nATTENTION_BACKENDS = (\"auto\", \"native\", \"_native_flash\")\\nACCELERATION_LORAS = (\"none\", TURBO.key)\\n\\n\\ndef requested_options(parameters):\\n    \"\"\"The same defaults apply at public API, queue, and model boundaries.\"\"\"\\n    return {\\n        \"attention_backend\": parameters.get(\"attention_backend\", \"auto\"),\\n        \"acceleration_lora\": parameters.get(\"acceleration_lora\", \"none\"),\\n        \"steps\": parameters[\"steps\"],\\n    }\\n\\n\\ndef validate_generation_options(requested, settings):\\n    if requested[\"attention_backend\"] not in ATTENTION_BACKENDS:\\n        raise ValueError(\"attention_backend must be auto, native or _native_flash; quantized/external attention kernels are unsupported\")\\n    selected = requested[\"acceleration_lora\"]\\n    if selected not in ACCELERATION_LORAS:\\n        raise ValueError(\"acceleration_lora must be none or lightx2v-ref2va-4step; arbitrary adapters are unsupported\")\\n    steps = requested[\"steps\"]\\n    if isinstance(steps, bool) or not isinstance(steps, int) or not 2 <= steps <= 50:\\n        raise ValueError(\"steps must be an integer between 2 and 50\")\\n    if selected != \"none\" and selected != settings.acceleration:\\n        raise ValueError(\"Requested acceleration LoRA is not configured for preloading; restart with H3_ACCELERATION_LORA=lightx2v-ref2va-4step\")\\n    validate_steps(AdapterSettings(acceleration=selected), steps)\\n    return requested\\n\\n\\ndef effective_options(requested, settings, runtime_options):\\n    attention = requested[\"attention_backend\"]\\n    if attention == \"auto\":\\n        attention = runtime_options.attention_backend\\n    # Explicitly restore PyTorch dispatch after a previous forced-Flash job.\\n    if attention == \"auto\":\\n        attention = \"native\"\\n    return {**requested, \"attention_backend\": attention, \"attention_scope\": \"transformer_ref\",\\n            \"precision\": \"bf16\", \"denoiser_evaluations\": requested[\"steps\"] - 1,\\n            \"style_lora\": settings.style, \"style_scale\": settings.style_scale}\\n\\n\\ndef generation_capabilities(*, model_ready=False, settings=None, runtime_options=None):\\n    settings = settings or load_adapter_settings()\\n    runtime_options = runtime_options or RuntimeOptions.from_env()\\n    default_attention = runtime_options.attention_backend\\n    attention = []\\n    for identity, label in ((\"auto\", \"自动 · PyTorch SDPA\"), (\"native\", \"PyTorch SDPA\"),\\n                            (\"_native_flash\", \"PyTorch Flash SDPA\")):\\n        value = {\"id\": identity, \"label\": label, \"supported\": True, \"configured\": True,\\n                 \"ready\": bool(model_ready), \"scope\": \"transformer_ref\", \"precision\": \"bf16\"}\\n        if identity == \"auto\":\\n            value[\"resolves_to\"] = \"native\" if default_attention == \"auto\" else default_attention\\n        if identity == \"_native_flash\":\\n            value[\"reason\"] = \"强制 PyTorch Flash SDPA；内核不兼容时明确失败，不静默回退\"\\n        attention.append(value)\\n    configured = settings.acceleration == TURBO.key\\n    return {\"schema_version\": 1, \"workflow\": \"ref2va\", \"precision\": \"bf16\",\\n            \"model_ready\": bool(model_ready),\\n            \"defaults\": {\"attention_backend\": \"auto\", \"acceleration_lora\": \"none\", \"steps\": 50},\\n            \"options\": {\"attention_backends\": attention, \"acceleration_loras\": [\\n                {\"id\": \"none\", \"label\": \"关闭\", \"supported\": True, \"configured\": True,\\n                 \"ready\": bool(model_ready), \"steps\": {\"min\": 2, \"max\": 50, \"default\": 50}},\\n                {\"id\": TURBO.key, \"label\": \"LightX2V Ref2VA Turbo · 4 次评估\", \"supported\": True,\\n                 \"configured\": configured, \"ready\": bool(configured and model_ready),\\n                 \"steps\": {\"min\": 5, \"max\": 5, \"required\": 5, \"denoiser_evaluations\": 4},\\n                 \"reason\": \"已配置预加载；模型就绪前可排队\" if configured else \"未在启动配置中预加载\",\\n                 \"repository\": TURBO.repository, \"revision\": TURBO.revision, \"sha256\": TURBO.sha256,\\n                 \"precision\": \"bf16\", \"validation\": \"GPU acceptance is reported separately; configuration is not a speed claim\"},\\n            ]},\\n            \"queue_semantics\": \"supported && configured permits admission before model_ready; readiness never means completion\",\\n            \"step_semantics\": \"steps counts sigma grid points; actual denoiser evaluations = steps - 1\",\\n            \"style_lora\": {\"id\": settings.style, \"scale\": settings.style_scale, \"control\": \"deployment\"},\\n            \"quantization\": False}\\n', 'lora_preflight.py': '\"\"\"Fresh-process LoRA dependency check before model downloads or GPU loading.\\n\\nPEFT 0.21.2 visits its optional torchao dispatcher even for ordinary BF16\\nLinear layers. An installed torchao < 0.16 raises before the normal dispatcher.\\nThe dedicated Colab runtime may explicitly remove that unused optional package;\\nthis helper never installs or upgrades packages, or changes the PyTorch stack.\\n\"\"\"\\nfrom __future__ import annotations\\n\\nimport argparse\\nfrom importlib import metadata\\nimport importlib.util\\nimport json\\nimport subprocess\\nimport sys\\n\\nfrom packaging.version import Version\\n\\n\\nSTACK_PACKAGES = (\"torch\", \"torchvision\", \"torchaudio\", \"psutil\")\\n\\n\\ndef distribution_version(name):\\n    try:\\n        return metadata.version(name)\\n    except metadata.PackageNotFoundError:\\n        return None\\n\\n\\ndef prepare_optional_torchao(*, repair=False):\\n    \"\"\"Run before importing torch/PEFT; only the explicit old optional package changes.\"\"\"\\n    before = {name: distribution_version(name) for name in STACK_PACKAGES}\\n    old_version = distribution_version(\"torchao\")\\n    removed = None\\n    if old_version is not None and Version(old_version) < Version(\"0.16.0\"):\\n        if not repair:\\n            raise RuntimeError(\\n                f\"Unused torchao {old_version} blocks PEFT BF16 LoRA dispatch. \"\\n                \"In this dedicated runtime run lora_preflight.py --repair-optional-torchao; \"\\n                \"do not upgrade the existing PyTorch stack.\"\\n            )\\n        subprocess.run([sys.executable, \"-m\", \"pip\", \"uninstall\", \"-y\", \"torchao\"],\\n                       check=True, capture_output=True, text=True)\\n        importlib.invalidate_caches()\\n        removed = old_version\\n    after = {name: distribution_version(name) for name in STACK_PACKAGES}\\n    if before != after:\\n        raise RuntimeError(\"LoRA optional dependency preparation changed the protected PyTorch/psutil stack\")\\n    current = distribution_version(\"torchao\")\\n    if removed is not None and (current is not None or importlib.util.find_spec(\"torchao\") is not None):\\n        raise RuntimeError(\"torchao remains importable after uninstall; use a clean model process before loading LoRA\")\\n    return {\"optional_torchao\": {\"before\": old_version, \"after\": current, \"removed_version\": removed},\\n            \"stack_before\": before, \"stack_after\": after, \"stack_unchanged\": True}\\n\\n\\ndef bf16_lora_smoke():\\n    \"\"\"Exercise PEFT\\'s actual dispatch and injection, which import-only checks miss.\\n\\n    Tiny CPU tensors avoid GPU initialization, large model downloads, and changes\\n    to the model container. Native BF16 GPU support is checked by normal preflight.\\n    \"\"\"\\n    import torch\\n    import peft\\n    from peft import LoraConfig, get_peft_model\\n    from peft.import_utils import is_torchao_available\\n\\n    base = torch.nn.Sequential(torch.nn.Linear(4, 4, bias=False, dtype=torch.bfloat16))\\n    model = get_peft_model(base, LoraConfig(r=2, lora_alpha=2, target_modules=[\"0\"]),\\n                           autocast_adapter_dtype=False)\\n    model.requires_grad_(False)\\n    model.eval()\\n    value = torch.ones((1, 4), dtype=torch.bfloat16)\\n    with torch.no_grad():\\n        enabled = model(value)\\n        with model.disable_adapter():\\n            disabled = model(value)\\n        restored = model(value)\\n    if any(parameter.dtype != torch.bfloat16 for parameter in model.parameters()):\\n        raise RuntimeError(\"Tiny LoRA injection changed BF16 parameter precision\")\\n    if any(output.dtype != torch.bfloat16 or not torch.isfinite(output).all().item()\\n           for output in (enabled, disabled, restored)):\\n        raise RuntimeError(\"Tiny BF16 LoRA enable/disable/restore forward check failed\")\\n    if not any(\"lora_A\" in name for name, _ in model.named_parameters()):\\n        raise RuntimeError(\"Tiny LoRA test did not inject an adapter\")\\n    return {\"peft\": peft.__version__, \"torch\": torch.__version__,\\n            \"torchao_available\": is_torchao_available(), \"device\": \"cpu\", \"precision\": \"bf16\",\\n            \"injected\": True, \"enable_disable_restore_forward\": True,\\n            \"parameter_elements\": sum(parameter.numel() for parameter in model.parameters()),\\n            \"real_model_loaded\": False, \"gpu_generation_verified\": False}\\n\\n\\ndef run(*, repair=False):\\n    report = prepare_optional_torchao(repair=repair)\\n    report[\"smoke\"] = bf16_lora_smoke()\\n    report[\"status\"] = \"passed\"\\n    return report\\n\\n\\nif __name__ == \"__main__\":\\n    parser = argparse.ArgumentParser(description=__doc__)\\n    parser.add_argument(\"--repair-optional-torchao\", action=\"store_true\")\\n    args = parser.parse_args()\\n    print(json.dumps(run(repair=args.repair_optional_torchao), ensure_ascii=False))\\n', 'condition_guard.py': '\"\"\"Bounded, side-effect-free four-valued admission decisions.\\n\\nThe caller owns observation identity, freshness and the lock that makes a decision\\nactionable. This helper performs no I/O and acquires no locks. Its timestamp is\\nthe decision time, not a claim that an external observation was refreshed then.\\n\"\"\"\\nfrom __future__ import annotations\\n\\nimport json\\nimport math\\nimport time\\nimport uuid\\n\\nSCHEMA_VERSION = \"1.0\"\\nGATE_VERSION = \"1.0\"\\nMAX_CONDITIONS = 64\\nMAX_WITNESSES = 64\\nMAX_CONTEXT_BYTES = 8192\\n\\n\\ndef observation_state(value):\\n    \"\"\"Only native booleans assert facts; missing witnesses do not negate facts.\"\"\"\\n    if type(value) is bool:\\n        return \"true\" if value else \"false\"\\n    if type(value) is str and value in {\"unknown\", \"conflict\"}:\\n        return value\\n    if type(value) is list:\\n        if len(value) > MAX_WITNESSES:\\n            return \"unknown\"\\n        # Lists are one level only: nested structures cannot introduce assertions.\\n        states = {observation_state(item) if type(item) is not list else \"unknown\"\\n                  for item in value}\\n        if \"conflict\" in states or {\"true\", \"false\"} <= states:\\n            return \"conflict\"\\n        if \"true\" in states:\\n            return \"true\"\\n        if \"false\" in states:\\n            return \"false\"\\n    return \"unknown\"\\n\\n\\ndef negate_observation(value):\\n    \"\"\"Negate known booleans without turning unknown/conflict into a true fact.\"\"\"\\n    state = observation_state(value)\\n    return {\"true\": False, \"false\": True, \"unknown\": None, \"conflict\": \"conflict\"}[state]\\n\\n\\ndef _context_copy(context):\\n    if type(context) is not dict:\\n        raise ValueError(\"Gate context must be a JSON object\")\\n    def check(value, depth=0):\\n        if depth > 5:\\n            raise ValueError(\"Gate context is too deeply nested\")\\n        if value is None or type(value) in {bool, int, str}:\\n            return\\n        if type(value) is float and math.isfinite(value):\\n            return\\n        if type(value) in {list, dict} and len(value) <= 64:\\n            if type(value) is dict:\\n                if any(type(key) is not str for key in value):\\n                    raise ValueError(\"Gate context keys must be strings\")\\n                value = value.values()\\n            for item in value:\\n                check(item, depth + 1)\\n            return\\n        raise ValueError(\"Gate context must contain bounded finite JSON values\")\\n    check(context)\\n    encoded = json.dumps(context, allow_nan=False, separators=(\",\", \":\"), ensure_ascii=True)\\n    if len(encoded.encode(\"utf-8\")) > MAX_CONTEXT_BYTES:\\n        raise ValueError(\"Gate context exceeds the receipt budget\")\\n    return json.loads(encoded)\\n\\n\\ndef evaluate_gate(gate_id, required, observations, context):\\n    \"\"\"Return a decision receipt; malformed declarations fail before admission.\\n\\nExplicit false facts differ from unknown and contradictory facts. In a witness\\nlist, a native boolean supplies evidence even if another witness is missing;\\nopposite boolean witnesses produce conflict. No string \\'true\\' or numeric 1 is a\\ntrue assertion. Inputs outside the declared required set cannot enable a gate.\\n\"\"\"\\n    if type(gate_id) is not str or not 1 <= len(gate_id) <= 128:\\n        raise ValueError(\"Gate identity must be a bounded nonempty string\")\\n    if (type(required) not in {list, tuple} or not 1 <= len(required) <= MAX_CONDITIONS\\n            or any(type(name) is not str or not 1 <= len(name) <= 128 for name in required)\\n            or len(required) != len(set(required))):\\n        raise ValueError(\"Gate requires a bounded, nonempty set of unique condition names\")\\n    if type(observations) is not dict:\\n        raise ValueError(\"Gate observations must be a mapping\")\\n    context = _context_copy(context)\\n    conditions = {name: observation_state(observations.get(name)) for name in required}\\n    blocked = [name for name, state in conditions.items() if state != \"true\"]\\n    return {\"schema_version\": SCHEMA_VERSION, \"gate_version\": GATE_VERSION,\\n            \"gate_id\": gate_id, \"decision_id\": uuid.uuid4().hex,\\n            \"observed_at\": time.time(), \"monotonic_ns\": time.monotonic_ns(),\\n            \"context\": context, \"conditions\": conditions,\\n            \"allowed\": not blocked, \"blocked\": blocked}\\n'}\n",
    "CONSOLE_PROGRAMS = {'preflight': '\\x23@title 资源与驻留方案\\n\\x23@markdown 只读取硬件与空间；不下载权重，不开启公网。默认A100 80GB常驻；40GB需显式选择分阶段。\\nif not globals().get(\"dashboard\"):\\n    raise RuntimeError(\"先运行顶部的刷新看板，再执行资源检查。\")\\nimport os, sys\\nimport contextlib, io\\nfrom pathlib import Path\\nPROJECT_DIR = Path(\"/content/minimax-h3-ref-api\")\\nPROJECT_DIR.mkdir(parents=True, exist_ok=True)\\n使用40GB分阶段方案 = False \\x23@param {type:\"boolean\"}\\nSTAGED_BF16 = 使用40GB分阶段方案\\n权重已完整缓存 = False \\x23@param {type:\"boolean\"}\\nMODEL_ALREADY_CACHED = 权重已完整缓存\\nRESIDENCY = \"staged\" if STAGED_BF16 else \"resident\"\\nos.environ[\"H3_MODE\"] = \"bf16\"\\nos.environ[\"H3_SKIP_DISK_CHECK\"] = \"1\" if MODEL_ALREADY_CACHED else \"0\"\\nPREFLIGHT_OK = False\\n(PROJECT_DIR / \"preflight.py\").write_text(\\'\"\"\"Conservative project resource checks; no downloads and no model imports.\"\"\"\\\\nfrom __future__ import annotations\\\\n\\\\nimport argparse\\\\nimport json\\\\nimport os\\\\nfrom pathlib import Path\\\\nimport re\\\\nimport shutil\\\\nimport stat\\\\nimport subprocess\\\\n\\\\nGIB = 1024 ** 3\\\\nFIRST_DOWNLOAD_BYTES = 140 * GIB\\\\nMODEL_REVISION = \"0919fb684102ef115126612f3fbb84d1027e7317\"\\\\n_WEIGHT_COMPONENTS = {\"text_encoder\": \"model\", \"transformer_ref\": \"diffusion_pytorch_model\",\\\\n                      \"vae\": \"diffusion_pytorch_model\", \"audio_vae\": \"diffusion_pytorch_model\"}\\\\n_METADATA_LIMIT = 16 * 1024 ** 2\\\\n\\\\n\\\\ndef _hub_cache_path() -> Path:\\\\n    default_home = Path(os.environ.get(\"XDG_CACHE_HOME\", \"~/.cache\")) / \"huggingface\"\\\\n    home = Path(os.environ.get(\"HF_HOME\", str(default_home))).expanduser()\\\\n    return Path(os.environ.get(\"HF_HUB_CACHE\", os.environ.get(\"HUGGINGFACE_HUB_CACHE\", str(home / \"hub\")))).expanduser()\\\\n\\\\n\\\\ndef _cache_file(path, snapshot, blobs):\\\\n    \"\"\"Accept snapshot files and completed repo/shared content-addressed blobs.\"\"\"\\\\n    if path.parent.resolve(strict=True) != path.parent:\\\\n        raise ValueError(\"untrusted cache component directory redirection\")\\\\n    resolved = path.resolve(strict=True)\\\\n    # Newer Hub caches share immutable SHA-256 blobs across repositories. Only\\\\n    # an exact snapshot reference may reach this pool; never scan/credit it.\\\\n    shared_pool = blobs.parent.parent / \"blobs\"\\\\n    shared_bucket = shared_pool / resolved.name[:2]\\\\n    shared_blob = (re.fullmatch(r\"[0-9a-f]{64}\", resolved.name) is not None\\\\n                   and resolved.parent == shared_bucket\\\\n                   and shared_pool.resolve(strict=True) == shared_pool\\\\n                   and shared_bucket.resolve(strict=True) == shared_bucket)\\\\n    if not (resolved.is_relative_to(snapshot) or\\\\n            (resolved.parent == blobs and re.fullmatch(r\"[0-9a-f]{40}|[0-9a-f]{64}\", resolved.name))\\\\n            or shared_blob):\\\\n        raise ValueError(\"cache file escapes its snapshot/repository blobs\")\\\\n    info = resolved.stat()\\\\n    if not stat.S_ISREG(info.st_mode) or info.st_size <= 0 or \".incomplete\" in resolved.name:\\\\n        raise ValueError(\"cache file is not a completed regular file\")\\\\n    return resolved, info\\\\n\\\\n\\\\ndef _small_json(path, snapshot, blobs):\\\\n    resolved, info = _cache_file(path, snapshot, blobs)\\\\n    if info.st_size > _METADATA_LIMIT:\\\\n        raise ValueError(\"cache metadata exceeds inspection limit\")\\\\n    return json.loads(resolved.read_bytes())\\\\n\\\\n\\\\ndef _weight_metadata(path, snapshot, blobs):\\\\n    \"\"\"Check only the bounded safetensors header and file size, not weight data.\"\"\"\\\\n    resolved, before = _cache_file(path, snapshot, blobs)\\\\n    with resolved.open(\"rb\") as source:\\\\n        prefix = source.read(8)\\\\n        if len(prefix) != 8:\\\\n            raise ValueError(\"incomplete safetensors header\")\\\\n        length = int.from_bytes(prefix, \"little\")\\\\n        if not 2 <= length <= _METADATA_LIMIT or length + 8 > before.st_size:\\\\n            raise ValueError(\"invalid safetensors header size\")\\\\n        header = json.loads(source.read(length))\\\\n    if not isinstance(header, dict):\\\\n        raise ValueError(\"invalid safetensors header\")\\\\n    ranges, names = [], set()\\\\n    sizes = {\"BOOL\": 1, \"U8\": 1, \"I8\": 1, \"U16\": 2, \"I16\": 2, \"F16\": 2, \"BF16\": 2,\\\\n             \"U32\": 4, \"I32\": 4, \"F32\": 4, \"U64\": 8, \"I64\": 8, \"F64\": 8,\\\\n             \"F8_E4M3\": 1, \"F8_E5M2\": 1}\\\\n    for name, entry in header.items():\\\\n        if name == \"__metadata__\":\\\\n            continue\\\\n        start, end = entry[\"data_offsets\"]\\\\n        shape, element_bytes = entry[\"shape\"], sizes[entry[\"dtype\"]]\\\\n        if not isinstance(shape, list) or len(shape) > 16 or any(type(n) is not int or n < 0 for n in shape):\\\\n            raise ValueError(\"invalid tensor shape\")\\\\n        count = 1\\\\n        for dimension in shape:\\\\n            count *= dimension\\\\n        if type(start) is not int or type(end) is not int or start < 0 or end - start != count * element_bytes:\\\\n            raise ValueError(\"invalid tensor data range\")\\\\n        ranges.append((start, end))\\\\n        names.add(name)\\\\n    cursor = 0\\\\n    for start, end in sorted(ranges):\\\\n        if start != cursor:\\\\n            raise ValueError(\"tensor data ranges are incomplete or overlap\")\\\\n        cursor = end\\\\n    after = resolved.stat()\\\\n    if not names or cursor <= 0 or 8 + length + cursor != before.st_size or (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns):\\\\n        raise ValueError(\"weight file is truncated, changing, or has trailing data\")\\\\n    identity = (after.st_dev, after.st_ino) if after.st_ino else str(resolved)\\\\n    return names, cursor, after.st_size, identity\\\\n\\\\n\\\\ndef cached_weight_budget(cache: Path) -> dict:\\\\n    \"\"\"Credit complete weight components, not readiness or model integrity.\"\"\"\\\\n    revision = os.environ.get(\"H3_MODEL_REVISION\", MODEL_REVISION)\\\\n    result = {\"model_revision\": revision, \"reusable_bytes\": 0, \"verified_components\": [],\\\\n              \"observation\": \"no_verified_weights\", \"scope\": \"disk_budget_only_not_model_readiness\"}\\\\n    if not re.fullmatch(r\"[0-9a-f]{40}\", revision):\\\\n        result[\"observation\"] = \"revision_not_an_exact_commit\"\\\\n        return result\\\\n    try:\\\\n        root = cache.resolve(strict=True)\\\\n        repo = root / \"models--MiniMaxAI--MiniMax-H3\"\\\\n        snapshot = repo / \"snapshots\" / revision\\\\n        blobs = repo / \"blobs\"\\\\n        if not snapshot.is_dir():\\\\n            return result\\\\n        # Parent directory symlinks may otherwise redirect an exact snapshot\\\\n        # name into a different revision/repository or an unrelated filesystem.\\\\n        for path in (repo, snapshot.parent, snapshot):\\\\n            if path.resolve(strict=True) != path:\\\\n                raise ValueError(\"untrusted cache directory redirection\")\\\\n        credited = {}\\\\n        for component, stem in _WEIGHT_COMPONENTS.items():\\\\n            directory = snapshot / component\\\\n            single = directory / (stem + \".safetensors\")\\\\n            index = directory / (stem + \".safetensors.index.json\")\\\\n            if single.exists():\\\\n                files, weight_map, total_size = [single.name], None, None\\\\n            elif index.exists():\\\\n                data = _small_json(index, snapshot, blobs)\\\\n                weight_map = data[\"weight_map\"]\\\\n                if not isinstance(weight_map, dict) or not weight_map:\\\\n                    raise ValueError(\"invalid weight index\")\\\\n                files = sorted(set(weight_map.values()))\\\\n                total_size = data.get(\"metadata\", {}).get(\"total_size\")\\\\n                if total_size is not None and (type(total_size) is not int or total_size <= 0):\\\\n                    raise ValueError(\"invalid indexed weight size\")\\\\n            else:\\\\n                continue\\\\n            if any(not isinstance(name, str) or not re.fullmatch(r\"[A-Za-z0-9_-]+\\\\\\\\.safetensors\", name) for name in files):\\\\n                raise ValueError(\"untrusted shard filename\")\\\\n            if any(not (directory / name).exists() for name in files):\\\\n                continue  # partially downloaded components receive no credit\\\\n            component_files, data_bytes = {}, 0\\\\n            for filename in files:\\\\n                names, size, disk_bytes, identity = _weight_metadata(directory / filename, snapshot, blobs)\\\\n                if weight_map is not None and names != {key for key, value in weight_map.items() if value == filename}:\\\\n                    raise ValueError(\"weight index does not match shard tensors\")\\\\n                component_files[identity] = disk_bytes\\\\n                data_bytes += size\\\\n            if total_size is not None and data_bytes != total_size:\\\\n                raise ValueError(\"indexed weight bytes are incomplete\")\\\\n            credited.update(component_files)\\\\n            result[\"verified_components\"].append(component)\\\\n        result[\"reusable_bytes\"] = min(sum(credited.values()), FIRST_DOWNLOAD_BYTES)\\\\n        if credited:\\\\n            result[\"observation\"] = \"completed_weight_metadata_verified\"\\\\n    except FileNotFoundError:\\\\n        # Cache creation/deletion races and missing roots never relax the gate.\\\\n        result.update(reusable_bytes=0, verified_components=[], observation=\"cache_missing_or_changed\")\\\\n    except (OSError, ValueError, TypeError, KeyError, AttributeError, OverflowError, RuntimeError) as error:\\\\n        result.update(reusable_bytes=0, verified_components=[], observation=\"cache_unverified\",\\\\n                      error_type=type(error).__name__)\\\\n    return result\\\\n\\\\n\\\\ndef check_resources(mode: str = \"bf16\", residency: str = \"resident\") -> dict:\\\\n    if mode != \"bf16\":\\\\n        raise ValueError(\"This project requires native BF16 on an NVIDIA A100; reduced-precision modes are disabled.\")\\\\n    if residency not in {\"resident\", \"staged\"}:\\\\n        raise ValueError(\"residency must be resident or staged\")\\\\n    if not Path(\"/proc/meminfo\").is_file():\\\\n        raise RuntimeError(\"Deploy this project on a Linux NVIDIA GPU machine.\")\\\\n    memory = {}\\\\n    for line in Path(\"/proc/meminfo\").read_text().splitlines():\\\\n        name, value = line.split(\":\", 1)\\\\n        memory[name] = int(value.strip().split()[0]) * 1024\\\\n    try:\\\\n        result = subprocess.run(\\\\n            [\"nvidia-smi\", \"--query-gpu=name,memory.total\", \"--format=csv,noheader,nounits\"],\\\\n            text=True, capture_output=True, check=True, timeout=20,\\\\n        )\\\\n        first = result.stdout.strip().splitlines()[0]\\\\n        gpu, memory_mib = first.rsplit(\",\", 1)\\\\n        vram_gib = float(memory_mib.strip()) / 1024\\\\n    except (OSError, ValueError, IndexError, subprocess.SubprocessError) as exc:\\\\n        raise RuntimeError(\"No working NVIDIA GPU detected. Select a GPU runtime first.\") from exc\\\\n    # The first visible CUDA GPU is used. Report conservatively when device masks are present.\\\\n    visible = os.environ.get(\"CUDA_VISIBLE_DEVICES\")\\\\n    if visible and visible not in {\"0\", \"0,\"}:\\\\n        raise RuntimeError(\"Preflight expects the first NVIDIA GPU. Unset CUDA_VISIBLE_DEVICES or set it to 0.\")\\\\n    cache = _hub_cache_path()\\\\n    disk_path = cache\\\\n    while not disk_path.exists():\\\\n        disk_path = disk_path.parent\\\\n    free_disk_bytes = shutil.disk_usage(disk_path).free\\\\n    free_disk = free_disk_bytes / GIB\\\\n    cache_budget = cached_weight_budget(cache)\\\\n    remaining_disk_bytes = max(0, FIRST_DOWNLOAD_BYTES - cache_budget[\"reusable_bytes\"])\\\\n    available_ram = memory[\"MemAvailable\"] / GIB\\\\n    strategy = (\"staged_component_residency\" if residency == \"staged\" else\\\\n                \"component_cpu_offload\" if vram_gib >= 75 else \"group_cpu_offload\")\\\\n    required_ram_gib = 70 if residency == \"staged\" else 140\\\\n    report = {\\\\n        \"mode\": mode, \"gpu\": gpu.strip(), \"vram_gib\": round(vram_gib, 1),\\\\n        \"available_ram_gib\": round(available_ram, 1),\\\\n        \"total_ram_gib\": round(memory[\"MemTotal\"] / GIB, 1),\\\\n        \"cache_free_disk_gib\": round(free_disk, 1), \"cache_path\": str(cache),\\\\n        \"cache_reusable_weight_gib\": round(cache_budget[\"reusable_bytes\"] / GIB, 2),\\\\n        \"cache_remaining_required_gib\": round(remaining_disk_bytes / GIB, 2),\\\\n        \"cache_weight_observation\": cache_budget,\\\\n        \"disk_check_skipped\": os.environ.get(\"H3_SKIP_DISK_CHECK\") == \"1\",\\\\n        \"a100_variant\": \"80GB\" if vram_gib >= 75 else \"40GB\",\\\\n        \"strategy\": strategy,\\\\n        \"residency\": residency, \"required_available_ram_gib\": required_ram_gib,\\\\n    }\\\\n    errors = []\\\\n    if \"A100\" not in gpu.upper():\\\\n        errors.append(f\"GPU must be an NVIDIA A100, detected {gpu.strip()}\")\\\\n    if available_ram < required_ram_gib:\\\\n        errors.append(f\"available host RAM {available_ram:.1f} GiB < {required_ram_gib} GiB ({residency})\")\\\\n    if vram_gib < 38:\\\\n        errors.append(f\"GPU memory {vram_gib:.1f} GiB < 38 GiB (A100 40GB class required)\")\\\\n    if free_disk_bytes < remaining_disk_bytes and not report[\"disk_check_skipped\"]:\\\\n        errors.append(\\\\n            f\"cache disk free {free_disk:.1f} GiB < remaining required {remaining_disk_bytes / GIB:.1f} GiB \"\\\\n            f\"(140 GiB first-download budget minus {cache_budget[\\\\\\'reusable_bytes\\\\\\'] / GIB:.1f} GiB \"\\\\n            \"of completed reusable weights; unverified/partial files receive no credit)\"\\\\n        )\\\\n    print(json.dumps(report, indent=2, ensure_ascii=False), flush=True)\\\\n    if errors:\\\\n        raise RuntimeError(\\\\n            \"Resource preflight failed before model download: \" + \"; \".join(errors)\\\\n            + \". These are conservative project gates, not a guarantee against peak-memory OOM.\"\\\\n        )\\\\n    if residency == \"staged\":\\\\n        print(\\\\n            \"Staged A100 BF16: the text encoder and transformer_ref are loaded one at a time, \"\\\\n            \"with the previous large component unloaded first. Disk reloads and CPU/GPU transfers add latency. \"\\\\n            \"The 70 GiB host-RAM gate is a project threshold. The original staged A100 40GB single-image baseline passed; this optimized build still needs GPU acceptance.\",\\\\n            flush=True,\\\\n        )\\\\n    elif strategy == \"group_cpu_offload\":\\\\n        print(\\\\n            \"A100 40GB: native BF16 weights are preserved. The 61.7 GB transformer cannot fit in GPU memory, \"\\\\n            \"so blocks move between CPU RAM and GPU. Throughput depends on PCIe and host memory bandwidth and may be slow.\",\\\\n            flush=True,\\\\n        )\\\\n    else:\\\\n        print(\"A100 80GB: native BF16 with components alternated between CPU RAM and GPU.\", flush=True)\\\\n    return report\\\\n\\\\n\\\\nif __name__ == \"__main__\":\\\\n    parser = argparse.ArgumentParser(description=__doc__)\\\\n    parser.add_argument(\"--staged\", action=\"store_true\", help=\"Explicit sequential BF16 residency profile: 70 GiB available host RAM\")\\\\n    args = parser.parse_args()\\\\n    check_resources(os.environ.get(\"H3_MODE\", \"bf16\"), residency=\"staged\" if args.staged else \"resident\")\\\\n\\', encoding=\"utf-8\")\\n(PROJECT_DIR / \"notebook_ui.py\").write_text(\\'\"\"\"Read-only dashboard and separate diagnostics for the notebook control panel.\"\"\"\\\\nfrom __future__ import annotations\\\\n\\\\nimport html\\\\nimport json\\\\nfrom collections import deque\\\\nfrom datetime import datetime, timedelta, timezone\\\\nfrom pathlib import Path\\\\nimport re\\\\nimport subprocess\\\\nimport time\\\\n\\\\nSTYLE = \"\"\"\\\\n<style>\\\\n.h3-card{--bg:#f8fafc;--ink:#172033;--muted:#627086;--line:#dbe3ec;--accent:#187c72;box-sizing:border-box;background:var(--bg);color:var(--ink);border:1px solid var(--line);border-left:4px solid var(--accent);border-radius:12px;padding:17px 20px;margin:8px 0;font:14px/1.55 system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;max-width:980px}\\\\n.h3-card *{box-sizing:border-box}.h3-card[data-tone=\"error\"]{--accent:#ba4242}.h3-card[data-tone=\"idle\"]{--accent:#7b8797}.h3-card[data-tone=\"running\"]{--accent:#bd7c16}\\\\n.h3-head{display:flex;gap:12px;justify-content:space-between;align-items:center;flex-wrap:wrap}.h3-title{font-size:17px;font-weight:650;letter-spacing:-.2px}.h3-badge{font-size:11px;font-weight:650;letter-spacing:.3px;color:var(--accent);border:1px solid var(--line);padding:3px 9px;border-radius:99px;white-space:nowrap}.h3-note{color:var(--muted);margin:5px 0 0}\\\\n.h3-fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px 18px;margin-top:13px}.h3-label{display:block;color:var(--muted);font-size:11px;letter-spacing:.25px;margin-bottom:2px}.h3-value{font-size:14px;font-weight:550;overflow-wrap:anywhere}.h3-card details{margin-top:12px;border-top:1px solid var(--line);padding-top:10px}.h3-card summary{cursor:pointer;color:var(--muted);font-size:12px}.h3-card pre{white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.55 ui-monospace,SFMono-Regular,Consolas,monospace;margin:9px 0 0;max-height:280px;overflow:auto}.h3-card a{color:var(--accent);text-decoration:none}.h3-card a:hover{text-decoration:underline}\\\\n.h3-board{border-left-width:1px;padding:22px 24px}.h3-board h2{font-size:23px;line-height:1.3;margin:4px 0 8px}.h3-kicker{font-size:12px;color:var(--muted)}.h3-next{margin:12px 0 21px;padding:11px 14px;border-radius:8px;background:color-mix(in srgb,var(--accent) 8%,var(--bg));font-size:15px}.h3-modules{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:12px 0 19px}.h3-module{padding:12px 14px;border:1px solid var(--line);border-radius:8px}.h3-module strong{font-weight:650;display:block;font-size:16px;margin-top:4px}.h3-subtle{color:var(--muted);font-size:12px;margin-top:4px}.h3-summary{display:flex;flex-wrap:wrap;gap:8px 22px;margin:12px 0}.h3-activity{border-top:1px solid var(--line);margin-top:18px;padding-top:13px}.h3-activity .h3-title{font-size:14px}.h3-activity .h3-fields{margin-top:8px;gap:8px 18px}.h3-stamp{font-size:11px;color:var(--muted);margin-top:17px}.h3-logs{border-left-width:1px}.h3-logs pre{max-height:360px;margin:14px 0 0}.h3-logs pre:focus{outline:2px solid var(--accent);outline-offset:3px}\\\\n@media(max-width:620px){.h3-board{padding:17px 15px}.h3-modules{grid-template-columns:1fr;gap:8px}.h3-module{padding:9px 12px;display:grid;grid-template-columns:95px 1fr;align-items:center}.h3-module strong{margin:0}.h3-module .h3-subtle{grid-column:2}.h3-board h2{font-size:21px}.h3-fields{grid-template-columns:1fr}}\\\\n@media(prefers-color-scheme:dark){.h3-card{--bg:#17202d;--ink:#e4ebf4;--muted:#a5b3c6;--line:#344358;--accent:#67cdbb}.h3-card[data-tone=\"error\"]{--accent:#ff9696}.h3-card[data-tone=\"running\"]{--accent:#e4ba6d}.h3-card[data-tone=\"idle\"]{--accent:#b5bfcb}}\\\\n</style>\\\\n\"\"\"\\\\n\\\\n_dashboard = None\\\\n_diagnostics = deque(maxlen=20)\\\\n_known_secrets = ()\\\\n_process_observer = None\\\\n_DIAGNOSTIC_LIMIT = 12000\\\\n\\\\n\\\\ndef redact_text(text, secrets=()):\\\\n    \"\"\"Redact known credentials and common authorization/key assignments before display.\"\"\"\\\\n    text = str(text)\\\\n    for secret in sorted({str(s) for s in (*_known_secrets, *secrets) if s}, key=len, reverse=True):\\\\n        text = text.replace(secret, \\\\\\'[已隐藏]\\\\\\')\\\\n    text = re.sub(r\\\\\\'(?i)(\\\\\\\\bBearer\\\\\\\\s+)[^\\\\\\\\s\\\\\\\\\"\\\\\\\\\\\\\\'<>;,]+\\\\\\', r\\\\\\'\\\\\\\\1[已隐藏]\\\\\\', text)\\\\n    text = re.sub(r\\\\\\'\\\\\\'\\\\\\'(?ix)([\"\\\\\\']?(?:H3_API_KEY|API_KEY|api[-_]?key|access_token|authorization)[\"\\\\\\']?\\\\\\\\s*[:=]\\\\\\\\s*)([\"\\\\\\'])(.*?)(\\\\\\\\2)\\\\\\'\\\\\\'\\\\\\',\\\\n                  lambda match: match.group(1) + match.group(2) + \\\\\\'[已隐藏]\\\\\\' + match.group(2), text)\\\\n    text = re.sub(r\\\\\\'(?i)(\\\\\\\\b(?:H3_API_KEY|API_KEY|api[-_]?key|access_token)\\\\\\\\s*[:=]\\\\\\\\s*)[^\\\\\\\\s\\\\\\\\\"\\\\\\\\\\\\\\'<>;,]+\\\\\\', r\\\\\\'\\\\\\\\1[已隐藏]\\\\\\', text)\\\\n    return text\\\\n\\\\n\\\\ndef _remember(title, text):\\\\n    if text:\\\\n        _diagnostics.append(redact_text(str(title) + \\\\\\'\\\\\\\\n\\\\\\' + str(text))[-_DIAGNOSTIC_LIMIT:])\\\\n\\\\n\\\\ndef last_diagnostics():\\\\n    return \\\\\\'\\\\\\\\n\\\\\\\\n\\\\\\'.join(_diagnostics)[-_DIAGNOSTIC_LIMIT:]\\\\n\\\\n\\\\ndef diagnostics_html(title, text, *, secrets=()):\\\\n    \"\"\"A bounded, keyboard-scrollable log view; never embedded in dashboard cards.\"\"\"\\\\n    value = redact_text(text, secrets=secrets)\\\\n    truncated = len(value) > _DIAGNOSTIC_LIMIT\\\\n    value = value[-_DIAGNOSTIC_LIMIT:]\\\\n    note = \\\\\\'仅显示最后 12,000 个字符；完整记录保留在日志文件。\\\\\\' if truncated else \\\\\\'只读日志 · 敏感凭据已隐藏\\\\\\'\\\\n    return (STYLE + \\\\\\'<section class=\"h3-card h3-logs\" aria-label=\"日志\"><div class=\"h3-title\">\\\\\\'\\\\n            + html.escape(redact_text(title), quote=True) + \\\\\\'</div><p class=\"h3-note\">\\\\\\' + note\\\\n            + \\\\\\'</p><pre tabindex=\"0\" aria-label=\"日志内容\">\\\\\\' + html.escape(value or \\\\\\'暂无记录。\\\\\\', quote=True)\\\\n            + \\\\\\'</pre></section>\\\\\\')\\\\n\\\\n\\\\ndef _short(value, maximum=160):\\\\n    text = redact_text(value).replace(\\\\\\'\\\\\\\\n\\\\\\', \\\\\\' \\\\\\').replace(\\\\\\'\\\\\\\\r\\\\\\', \\\\\\' \\\\\\')\\\\n    return text if len(text) <= maximum else text[:maximum - 1] + \\\\\\'…\\\\\\'\\\\n\\\\n\\\\ndef _activity(title, kwargs):\\\\n    _remember(title, kwargs.get(\\\\\\'details\\\\\\'))\\\\n    fields = [(label, value) for label, value in kwargs.get(\\\\\\'fields\\\\\\', ())\\\\n              if not any(word in str(label) for word in (\\\\\\'日志\\\\\\', \\\\\\'路径\\\\\\', \\\\\\'密钥\\\\\\', \\\\\\'当前记录\\\\\\'))]\\\\n    return {\\\\\\'title\\\\\\': _short(title, 70), \\\\\\'badge\\\\\\': _short(kwargs.get(\\\\\\'badge\\\\\\', \\\\\\'\\\\\\'), 35),\\\\n            \\\\\\'note\\\\\\': _short(kwargs.get(\\\\\\'note\\\\\\', \\\\\\'\\\\\\')), \\\\\\'tone\\\\\\': kwargs.get(\\\\\\'tone\\\\\\', \\\\\\'idle\\\\\\'),\\\\n            \\\\\\'fields\\\\\\': [(str(k), _short(v, 95)) for k, v in fields[:4]]}\\\\n\\\\n\\\\ndef card_html(title, *, badge=\"\", note=\"\", fields=(), tone=\"idle\", details=None, details_label=\"查看详情\"):\\\\n    escape = lambda value: html.escape(_short(value), quote=True)\\\\n    if tone not in {\"idle\", \"running\", \"success\", \"error\"}:\\\\n        tone = \"idle\"\\\\n    values = \"\".join(\\\\n        \\\\\\'<div><span class=\"h3-label\">\\\\\\' + escape(label) + \\\\\\'</span><span class=\"h3-value\">\\\\\\'\\\\n        + escape(value) + \\\\\\'</span></div>\\\\\\' for label, value in fields\\\\n    )\\\\n    return (STYLE + \\\\\\'<section class=\"h3-card\" data-tone=\"\\\\\\' + tone + \\\\\\'\"><div class=\"h3-head\">\\\\\\'\\\\n            + \\\\\\'<div class=\"h3-title\">\\\\\\' + escape(title) + \\\\\\'</div><span class=\"h3-badge\">\\\\\\'\\\\n            + escape(badge) + \\\\\\'</span></div>\\\\\\' + (\\\\\\'<p class=\"h3-note\">\\\\\\' + escape(note) + \\\\\\'</p>\\\\\\' if note else \"\")\\\\n            + (\\\\\\'<div class=\"h3-fields\">\\\\\\' + values + \\\\\\'</div>\\\\\\' if fields else \"\") + \"</section>\")\\\\n\\\\n\\\\ndef render_dashboard(context, activity=None):\\\\n    \"\"\"Render supplied observations only. This pure function performs no host I/O.\"\"\"\\\\n    escape = lambda value: html.escape(_short(value), quote=True)\\\\n    state = context.get(\\\\\\'state\\\\\\') or {}\\\\n    stale = bool(state.get(\\\\\\'observation_stale\\\\\\'))\\\\n    failed_read = bool(context.get(\\\\\\'observation_error\\\\\\'))\\\\n    phase = state.get(\\\\\\'phase\\\\\\')\\\\n    if context.get(\\\\\\'placeholder\\\\\\'):\\\\n        headline, next_step, tone = \\\\\\'等待首次读取\\\\\\', \\\\\\'运行「刷新看板」查看本次状态；此处是界面占位，没有实时观察。\\\\\\', \\\\\\'idle\\\\\\'\\\\n    elif failed_read:\\\\n        headline, next_step, tone = \\\\\\'状态读取失败\\\\\\', \\\\\\'重新刷新看板；如仍失败，在日志区查看原因。\\\\\\', \\\\\\'error\\\\\\'\\\\n    elif stale:\\\\n        headline, next_step, tone = \\\\\\'状态需要刷新\\\\\\', \\\\\\'当前观察已过期；刷新后再判断可用能力。\\\\\\', \\\\\\'running\\\\\\'\\\\n    elif phase == \\\\\\'stopped\\\\\\' and state.get(\\\\\\'cleanup_complete\\\\\\'):\\\\n        headline, next_step, tone = \\\\\\'本次服务已停止\\\\\\', \\\\\\'确认结果已保存后，可在控制面板释放 Colab 实例。\\\\\\', \\\\\\'idle\\\\\\'\\\\n    elif phase == \\\\\\'stopping\\\\\\':\\\\n        headline, next_step, tone = \\\\\\'正在停止与回收\\\\\\', \\\\\\'等待受管进程退出并确认清理完成；此时不要重复启动。\\\\\\', \\\\\\'running\\\\\\'\\\\n    elif state.get(\\\\\\'error\\\\\\') or phase in {\\\\\\'failed\\\\\\', \\\\\\'degraded\\\\\\'}:\\\\n        headline, next_step, tone = \\\\\\'有模块需要处理\\\\\\', \\\\\\'先看下方可用能力；具体原因在日志区，控制面板仍可查询或停止。\\\\\\', \\\\\\'error\\\\\\'\\\\n    elif state.get(\\\\\\'draining\\\\\\'):\\\\n        headline, next_step, tone = \\\\\\'已暂停接收新任务\\\\\\', \\\\\\'已接收的队列继续执行；可恢复接收，也可停止服务。\\\\\\', \\\\\\'idle\\\\\\'\\\\n    elif state.get(\\\\\\'ready\\\\\\'):\\\\n        headline, next_step, tone = \\\\\\'可以生成\\\\\\', \\\\\\'在控制面板提交新内容，或按任务 ID 查询已有任务。\\\\\\', \\\\\\'success\\\\\\'\\\\n    elif state.get(\\\\\\'api_ready\\\\\\'):\\\\n        accepting = (state.get(\\\\\\'queue\\\\\\') or {}).get(\\\\\\'admission_open\\\\\\') is True\\\\n        headline, next_step, tone = (\\\\\\'API 可用 · 生成尚未就绪\\\\\\',\\\\n            (\\\\\\'可先查询或排队；\\\\\\' if accepting else \\\\\\'可先查询；\\\\\\') + \\\\\\'模型、公网的当前能力分别见下方。\\\\\\', \\\\\\'running\\\\\\')\\\\n    elif state:\\\\n        headline, next_step, tone = \\\\\\'服务正在准备\\\\\\', \\\\\\'刷新看板观察进展；不要重复启动。\\\\\\', \\\\\\'running\\\\\\'\\\\n    elif not context.get(\\\\\\'preflight_ok\\\\\\'):\\\\n        headline, next_step, tone = \\\\\\'尚未检查资源\\\\\\', \\\\\\'在控制面板先运行「资源与驻留方案」。\\\\\\', \\\\\\'idle\\\\\\'\\\\n    elif not context.get(\\\\\\'install_ok\\\\\\'):\\\\n        headline, next_step, tone = \\\\\\'资源检查通过\\\\\\', \\\\\\'在控制面板运行「安装与检查」。\\\\\\', \\\\\\'idle\\\\\\'\\\\n    else:\\\\n        headline, next_step, tone = \\\\\\'准备工作已完成\\\\\\', \\\\\\'在控制面板选择是否开放公网，再启动服务。\\\\\\', \\\\\\'idle\\\\\\'\\\\n\\\\n    def module(name, alive_key, ready_key=None):\\\\n        alive, ready = state.get(alive_key), state.get(ready_key) if ready_key else None\\\\n        if not state:\\\\n            status, detail = (\\\\\\'尚未读取\\\\\\' if context.get(\\\\\\'placeholder\\\\\\') else \\\\\\'未启动\\\\\\'), \\\\\\'尚无运行观察\\\\\\'\\\\n        elif ready is True:\\\\n            status, detail = \\\\\\'可用\\\\\\', \\\\\\'进程运行中\\\\\\' if alive is True else \\\\\\'存活状态未确认\\\\\\'\\\\n        elif alive is True:\\\\n            status, detail = (\\\\\\'运行中\\\\\\', \\\\\\'调度与控制\\\\\\') if ready_key is None else (\\\\\\'准备中\\\\\\', \\\\\\'进程运行，能力未就绪\\\\\\')\\\\n        elif alive is False:\\\\n            status, detail = \\\\\\'已停止\\\\\\', \\\\\\'进程未运行\\\\\\'\\\\n        else:\\\\n            status, detail = \\\\\\'未确认\\\\\\', \\\\\\'缺少当前观察\\\\\\'\\\\n        if stale or failed_read:\\\\n            status, detail = \\\\\\'待刷新\\\\\\', \\\\\\'不据旧状态判断就绪\\\\\\'\\\\n        return (\\\\\\'<div class=\"h3-module\"><span class=\"h3-label\">\\\\\\' + escape(name) + \\\\\\'</span><strong>\\\\\\'\\\\n                + escape(status) + \\\\\\'</strong><div class=\"h3-subtle\">\\\\\\' + escape(detail) + \\\\\\'</div></div>\\\\\\')\\\\n\\\\n    if stale or failed_read:\\\\n        public = \\\\\\'待刷新\\\\\\'\\\\n    elif not state:\\\\n        public = \\\\\\'尚未观察\\\\\\'\\\\n    elif not state.get(\\\\\\'public_requested\\\\\\'):\\\\n        public = \\\\\\'未启用\\\\\\'\\\\n    elif state.get(\\\\\\'public_api_ready\\\\\\'):\\\\n        public = \\\\\\'API 探测通过\\\\\\'\\\\n    elif state.get(\\\\\\'tunnel_connected\\\\\\'):\\\\n        public = \\\\\\'隧道已连接 · API 待验证\\\\\\'\\\\n    else:\\\\n        public = \\\\\\'准备中\\\\\\'\\\\n    queue = state.get(\\\\\\'queue\\\\\\') or {}\\\\n    summary = [(\\\\\\'公网\\\\\\', public)]\\\\n    if queue and not stale and not failed_read:\\\\n        summary += [(\\\\\\'任务\\\\\\', f\"排队 {queue.get(\\\\\\'queued\\\\\\', \\\\\\'—\\\\\\')} · 执行 {queue.get(\\\\\\'running\\\\\\', \\\\\\'—\\\\\\')}\")]\\\\n        if queue.get(\\\\\\'admission_open\\\\\\') is False:\\\\n            summary.append((\\\\\\'接收任务\\\\\\', \\\\\\'已暂停\\\\\\'))\\\\n    resources = context.get(\\\\\\'resource_report\\\\\\') or {}\\\\n    if resources:\\\\n        summary += [(\\\\\\'GPU\\\\\\', resources.get(\\\\\\'gpu\\\\\\', \\\\\\'未记录\\\\\\')),\\\\n                    (\\\\\\'可用内存\\\\\\', str(resources.get(\\\\\\'available_ram_gib\\\\\\', \\\\\\'—\\\\\\')) + \\\\\\' GiB（预检）\\\\\\')]\\\\n    resource_text = \\\\\\'\\\\\\'.join(\\\\\\'<span><span class=\"h3-label\">\\\\\\' + escape(k) + \\\\\\'</span>\\\\\\' + escape(v) + \\\\\\'</span>\\\\\\' for k, v in summary)\\\\n    stamp = state.get(\\\\\\'observed_at\\\\\\')\\\\n    if isinstance(stamp, (int, float)):\\\\n        try:\\\\n            stamp = datetime.fromtimestamp(stamp, timezone(timedelta(hours=8))).strftime(\\\\\\'%m-%d %H:%M:%S 北京时间\\\\\\')\\\\n        except (OverflowError, OSError, ValueError):\\\\n            stamp = \\\\\\'未记录\\\\\\'\\\\n    else:\\\\n        stamp = \\\\\\'尚无服务快照\\\\\\'\\\\n    body = (STYLE + \\\\\\'<section class=\"h3-card h3-board\" data-tone=\"\\\\\\' + tone + \\\\\\'\" aria-label=\"运行看板\">\\\\\\'\\\\n            \\\\\\'<div class=\"h3-kicker\">当前状态</div><h2>\\\\\\' + escape(headline) + \\\\\\'</h2>\\\\\\'\\\\n            \\\\\\'<div class=\"h3-next\"><b>下一步</b>\\\\u3000\\\\\\' + escape(next_step) + \\\\\\'</div><div class=\"h3-modules\">\\\\\\'\\\\n            + module(\\\\\\'总管理\\\\\\', \\\\\\'manager_alive\\\\\\') + module(\\\\\\'API 后台\\\\\\', \\\\\\'server_alive\\\\\\', \\\\\\'api_ready\\\\\\')\\\\n            + module(\\\\\\'大模型容器\\\\\\', \\\\\\'model_alive\\\\\\', \\\\\\'model_ready\\\\\\') + \\\\\\'</div>\\\\\\'\\\\n            \\\\\\'<div class=\"h3-summary\">\\\\\\' + resource_text + \\\\\\'</div>\\\\\\')\\\\n    if activity:\\\\n        activity_tone = activity.get(\\\\\\'tone\\\\\\', \\\\\\'idle\\\\\\')\\\\n        if activity_tone not in {\\\\\\'idle\\\\\\', \\\\\\'running\\\\\\', \\\\\\'success\\\\\\', \\\\\\'error\\\\\\'}:\\\\n            activity_tone = \\\\\\'idle\\\\\\'\\\\n        body += (\\\\\\'<div class=\"h3-activity\" data-tone=\"\\\\\\' + activity_tone + \\\\\\'\"><div class=\"h3-label\">最近操作</div>\\\\\\'\\\\n                 \\\\\\'<div class=\"h3-head\"><span class=\"h3-title\">\\\\\\' + escape(activity.get(\\\\\\'title\\\\\\', \\\\\\'\\\\\\'))\\\\n                 + \\\\\\'</span><span class=\"h3-badge\">\\\\\\' + escape(activity.get(\\\\\\'badge\\\\\\', \\\\\\'\\\\\\')) + \\\\\\'</span></div>\\\\\\')\\\\n        if activity.get(\\\\\\'note\\\\\\'):\\\\n            body += \\\\\\'<div class=\"h3-note\">\\\\\\' + escape(activity[\\\\\\'note\\\\\\']) + \\\\\\'</div>\\\\\\'\\\\n        fields = activity.get(\\\\\\'fields\\\\\\') or ()\\\\n        if fields:\\\\n            body += \\\\\\'<div class=\"h3-fields\">\\\\\\' + \\\\\\'\\\\\\'.join(\\\\\\'<div><span class=\"h3-label\">\\\\\\' + escape(k)\\\\n                + \\\\\\'</span><span class=\"h3-value\">\\\\\\' + escape(v) + \\\\\\'</span></div>\\\\\\' for k, v in fields[:4]) + \\\\\\'</div>\\\\\\'\\\\n        body += \\\\\\'</div>\\\\\\'\\\\n    return body + \\\\\\'<div class=\"h3-stamp\">服务观察：\\\\\\' + escape(stamp) + \\\\\\' · 按需刷新，不执行控制命令</div></section>\\\\\\'\\\\n\\\\n\\\\nclass Dashboard:\\\\n    def __init__(self, context_reader):\\\\n        self.context_reader = context_reader\\\\n        self.activity = None\\\\n        self._handle = None\\\\n\\\\n    def refresh(self):\\\\n        from IPython.display import HTML, display\\\\n        global _known_secrets\\\\n        context = dict(self.context_reader())\\\\n        host = context.pop(\\\\\\'host\\\\\\', None)\\\\n        if host is not None:\\\\n            key = getattr(host, \\\\\\'api_key\\\\\\', None)\\\\n            if key:\\\\n                _known_secrets = tuple(set((*_known_secrets[-3:], str(key))))\\\\n            try:\\\\n                context[\\\\\\'state\\\\\\'] = host.snapshot()\\\\n            except Exception as error:\\\\n                context[\\\\\\'state\\\\\\'] = {}\\\\n                context[\\\\\\'observation_error\\\\\\'] = True\\\\n                _remember(\\\\\\'看板状态读取失败\\\\\\', str(error))\\\\n        rendered = HTML(render_dashboard(context, self.activity))\\\\n        if self._handle is None:\\\\n            self._handle = display(rendered, display_id=\\\\\\'h3-dashboard\\\\\\')\\\\n        else:\\\\n            self._handle.update(rendered)\\\\n        return context\\\\n\\\\n\\\\ndef mount_dashboard(context_reader):\\\\n    global _dashboard\\\\n    _dashboard = Dashboard(context_reader)\\\\n    _dashboard.refresh()\\\\n    return _dashboard\\\\n\\\\n\\\\nclass StatusCard:\\\\n    def __init__(self, title, **kwargs):\\\\n        self._handle = None\\\\n        self.update(title, **kwargs)\\\\n\\\\n    def update(self, title, **kwargs):\\\\n        from IPython.display import HTML, display\\\\n        activity = _activity(title, kwargs)\\\\n        if _dashboard is not None:\\\\n            _dashboard.activity = activity\\\\n            _dashboard.refresh()\\\\n        elif self._handle is None:\\\\n            self._handle = display(HTML(card_html(**activity)), display_id=True)\\\\n        else:\\\\n            self._handle.update(HTML(card_html(**activity)))\\\\n\\\\n\\\\ndef elapsed_text(seconds):\\\\n    seconds = max(0, int(seconds))\\\\n    return f\"{seconds // 60}分{seconds % 60:02d}秒\" if seconds >= 60 else f\"{seconds}秒\"\\\\n\\\\n\\\\ndef log_tail(path, limit=6000):\\\\n    path = Path(path)\\\\n    if not path.is_file():\\\\n        return \"\"\\\\n    with path.open(\"rb\") as source:\\\\n        source.seek(max(0, path.stat().st_size - limit))\\\\n        text = source.read().decode(\"utf-8\", errors=\"replace\")\\\\n    return re.sub(r\"\\\\\\\\x1b\\\\\\\\[[0-?]*[ -/]*[@-~]\", \"\", text).replace(\"\\\\\\\\r\", \"\\\\\\\\n\")\\\\n\\\\n\\\\ndef latest_stage(path):\\\\n    lines = [line.strip() for line in log_tail(path).splitlines() if line.strip()]\\\\n    for line in reversed(lines):\\\\n        if \"BF16 staged:\" in line:\\\\n            return line.split(\"BF16 staged:\", 1)[1].strip()[:145]\\\\n        if \"status=\" in line or \"API_SMOKE_TEST_PASSED\" in line:\\\\n            return line[:145]\\\\n    return lines[-1][:145] if lines else \"进程已启动，等待首条日志\"\\\\n\\\\n\\\\ndef run_logged(command, log_path, *, title, cwd=None, env=None, card=None, status_reader=None):\\\\n    \"\"\"Run a real child process; persist logs and update a bounded status card.\"\"\"\\\\n    path = Path(log_path)\\\\n    path.parent.mkdir(parents=True, exist_ok=True)\\\\n    status = card or StatusCard(title, badge=\"执行中\", tone=\"running\", note=\"完整输出写入日志。\")\\\\n    started = time.monotonic()\\\\n    with path.open(\"a\", encoding=\"utf-8\") as output:\\\\n        output.write(\"\\\\\\\\n--- \" + title + \" ---\\\\\\\\n\")\\\\n        output.flush()\\\\n        process = subprocess.Popen(command, cwd=cwd, env=env, stdout=output, stderr=subprocess.STDOUT)\\\\n        observer = _process_observer\\\\n        if observer is not None:\\\\n            observer.process_started(process)\\\\n        try:\\\\n            while process.poll() is None:\\\\n                if observer is not None:\\\\n                    observer.process_progress(process)\\\\n                current = []\\\\n                if status_reader is not None:\\\\n                    try:\\\\n                        current = status_reader()\\\\n                    except (OSError, ValueError):\\\\n                        pass\\\\n                status.update(title, badge=\"执行中\", tone=\"running\", fields=\\\\n                    [(\"已用时间\", elapsed_text(time.monotonic() - started))]\\\\n                    + current)\\\\n                time.sleep(2)\\\\n        except BaseException:\\\\n            process.terminate()\\\\n            try:\\\\n                process.wait(timeout=15)\\\\n            except subprocess.TimeoutExpired:\\\\n                process.kill()\\\\n                process.wait()\\\\n            status.update(title, badge=\"已中断\", tone=\"error\", note=\"操作进程已停止；已提交的远程任务可能仍在执行。\", fields=[(\"日志\", str(path))])\\\\n            raise\\\\n        finally:\\\\n            if observer is not None:\\\\n                observer.process_finished(process)\\\\n    if process.returncode:\\\\n        status.update(title, badge=\"未完成\", tone=\"error\", note=\"查看日志中的实际错误后再重试。\",\\\\n                      fields=[(\"日志\", str(path))], details=log_tail(path), details_label=\"展开最后的错误日志\")\\\\n        raise RuntimeError(f\"{title}退出码 {process.returncode}；完整日志：{path}\")\\\\n    status.update(title, badge=\"完成\", tone=\"success\", fields=[\\\\n        (\"已用时间\", elapsed_text(time.monotonic() - started)), (\"完整日志\", str(path)),\\\\n    ])\\\\n    return process.returncode\\\\n\\\\n\\\\ndef json_probe(command, log_path, *, cwd=None, env=None, card=None):\\\\n    \"\"\"Capture a short JSON-producing check without dumping full notebook output.\"\"\"\\\\n    process = subprocess.Popen(command, cwd=cwd, env=env, text=True,\\\\n                               stdout=subprocess.PIPE, stderr=subprocess.PIPE)\\\\n    observer = _process_observer\\\\n    try:\\\\n        if observer is not None:\\\\n            observer.process_started(process)\\\\n        stdout, stderr = process.communicate(timeout=180)\\\\n    except BaseException:\\\\n        if process.poll() is None:\\\\n            process.kill()\\\\n            process.communicate(timeout=10)\\\\n        raise\\\\n    finally:\\\\n        if observer is not None:\\\\n            observer.process_finished(process)\\\\n    with Path(log_path).open(\"a\", encoding=\"utf-8\") as log:\\\\n        log.write(stdout + \"\\\\\\\\n\" + stderr + \"\\\\\\\\n\")\\\\n    if process.returncode:\\\\n        if card is not None:\\\\n            card.update(\"依赖检查未通过\", badge=\"需要处理\", tone=\"error\", note=\"检查日志中的版本或导入错误后再继续。\",\\\\n                        fields=[(\"日志\", str(log_path))], details=stderr[-4000:], details_label=\"展开检查错误\")\\\\n        raise RuntimeError(f\"依赖检查失败；请在日志区查看：{log_path}\")\\\\n    return json.loads(stdout.strip().splitlines()[-1])\\\\n\\', encoding=\"utf-8\")\\nif str(PROJECT_DIR) not in sys.path:\\n    sys.path.insert(0, str(PROJECT_DIR))\\nfrom preflight import check_resources\\nfrom notebook_ui import StatusCard, elapsed_text, latest_stage, log_tail, run_logged, json_probe\\nresource_card = StatusCard(\"检查资源\", badge=\"检查中\", tone=\"running\")\\ncaptured = io.StringIO()\\ntry:\\n    with contextlib.redirect_stdout(captured):\\n        RESOURCE_REPORT = check_resources(residency=RESIDENCY)\\nexcept Exception as error:\\n    resource_card.update(\"资源检查未通过\", badge=\"需要处理\", tone=\"error\", note=str(error),\\n                         details=captured.getvalue(), details_label=\"展开资源详情\")\\n    raise\\nfinally:\\n    (PROJECT_DIR / \"preflight.log\").write_text(captured.getvalue(), encoding=\"utf-8\")\\nPREFLIGHT_OK = True\\nresource_card.update(\"资源检查通过\", badge=\"可继续\", tone=\"success\", note=\"本格未下载模型；已有缓存会在加载时检查。\",\\n    fields=[(\"GPU\", RESOURCE_REPORT[\"gpu\"]), (\"可用 RAM\", str(RESOURCE_REPORT[\"available_ram_gib\"]) + \" GiB\"),\\n            (\"空余磁盘\", str(RESOURCE_REPORT[\"cache_free_disk_gib\"]) + \" GiB\"), (\"驻留方案\", RESIDENCY)],\\n    details=captured.getvalue(), details_label=\"展开完整检查\")\\n', 'install': '\\x23@title 安装与检查\\n\\x23@markdown 保留 Colab 预装 PyTorch 栈。完整安装记录写入 install.log，界面只显示当前状态。\\nimport subprocess, shutil, json\\nINSTALL_OK = False\\nif not globals().get(\"PREFLIGHT_OK\"):\\n    raise RuntimeError(\"先运行资源检查；资源检查不通过时不安装或下载。\")\\nexisting_host = globals().get(\"startup_host\")\\nif existing_host:\\n    existing_state = existing_host.snapshot()\\n    if (existing_state[\"server_alive\"] or existing_state[\"tunnel_alive\"] or\\n            existing_state.get(\"model_alive\") or existing_state.get(\"manager_alive\") or\\n            (existing_state[\"phase\"] != \"new\" and\\n             (existing_state[\"phase\"] not in {\"failed\", \"stopped\"} or\\n              not existing_state.get(\"cleanup_complete\", False)))):\\n        raise RuntimeError(\"旧生命周期仍在运行或尚未完成清理，不能安装依赖；先在停止与释放 停止并确认子进程已退出。\")\\nPYTORCH_STACK_CHECK = \\'import importlib.metadata as metadata, json, platform, torch, psutil\\\\nversions = {}\\\\nfor name in (\"torch\", \"torchvision\", \"torchaudio\"):\\\\n    try:\\\\n        versions[name] = metadata.version(name)\\\\n    except metadata.PackageNotFoundError:\\\\n        pass\\\\nreport = {\"python\": platform.python_version(), \"pytorch_stack\": versions,\\\\n          \"host_runtime\": {\"psutil\": metadata.version(\"psutil\")},\\\\n          \"torch_cuda\": torch.version.cuda, \"cuda_available\": torch.cuda.is_available(),\\\\n          \"native_bf16\": torch.cuda.is_available() and torch.cuda.is_bf16_supported(),\\\\n          \"gpu\": torch.cuda.get_device_name(0) if torch.cuda.is_available() else None}\\\\nprint(json.dumps(report, ensure_ascii=False))\\\\nif psutil.__version__ != report[\"host_runtime\"][\"psutil\"]:\\\\n    raise RuntimeError(\"psutil imported module and installed distribution versions do not match\")\\\\nif not report[\"native_bf16\"]:\\\\n    raise RuntimeError(\"The preinstalled PyTorch stack has no native-BF16 CUDA support\")\\\\n\\'\\nDEPENDENCY_CHECK = \\'import json, os, platform, torch, diffusers, transformers, fastapi, uvicorn, av, PIL, psutil\\\\nfrom diffusers import ModularPipeline, MiniMaxH3Transformer3DModel\\\\nfrom diffusers.modular_pipelines.minimax_h3 import MiniMaxH3ImageReference, MiniMaxH3VideoReference, MiniMaxH3AudioReference\\\\nfrom transformers import Qwen3VLForConditionalGeneration\\\\nfrom diffusers.utils.export_utils import encode_video\\\\nfrom adapter_config import load_adapter_settings\\\\nsettings = load_adapter_settings()\\\\nif settings.acceleration != \"none\" or settings.style != \"none\":\\\\n    try:\\\\n        import peft\\\\n    except ImportError as exc:\\\\n        raise RuntimeError(\"LoRA enabled: rerun notebook step 2 to install requirements-lora.txt\") from exc\\\\nif not torch.cuda.is_available() or not torch.cuda.is_bf16_supported():\\\\n    raise RuntimeError(\"Native-BF16 CUDA support is required\")\\\\nprint(json.dumps({\"fresh_process_imports\": \"passed\", \"python\": platform.python_version(),\\\\n                  \"torch\": torch.__version__, \"cuda\": torch.version.cuda,\\\\n                  \"diffusers\": diffusers.__version__, \"transformers\": transformers.__version__,\\\\n                  \"host_runtime\": {\"psutil\": psutil.__version__},\\\\n                  \"native_bf16\": True}, ensure_ascii=False))\\\\n\\'\\nPACKAGE_FILES = {\\'preflight.py\\': \\'\"\"\"Conservative project resource checks; no downloads and no model imports.\"\"\"\\\\nfrom __future__ import annotations\\\\n\\\\nimport argparse\\\\nimport json\\\\nimport os\\\\nfrom pathlib import Path\\\\nimport re\\\\nimport shutil\\\\nimport stat\\\\nimport subprocess\\\\n\\\\nGIB = 1024 ** 3\\\\nFIRST_DOWNLOAD_BYTES = 140 * GIB\\\\nMODEL_REVISION = \"0919fb684102ef115126612f3fbb84d1027e7317\"\\\\n_WEIGHT_COMPONENTS = {\"text_encoder\": \"model\", \"transformer_ref\": \"diffusion_pytorch_model\",\\\\n                      \"vae\": \"diffusion_pytorch_model\", \"audio_vae\": \"diffusion_pytorch_model\"}\\\\n_METADATA_LIMIT = 16 * 1024 ** 2\\\\n\\\\n\\\\ndef _hub_cache_path() -> Path:\\\\n    default_home = Path(os.environ.get(\"XDG_CACHE_HOME\", \"~/.cache\")) / \"huggingface\"\\\\n    home = Path(os.environ.get(\"HF_HOME\", str(default_home))).expanduser()\\\\n    return Path(os.environ.get(\"HF_HUB_CACHE\", os.environ.get(\"HUGGINGFACE_HUB_CACHE\", str(home / \"hub\")))).expanduser()\\\\n\\\\n\\\\ndef _cache_file(path, snapshot, blobs):\\\\n    \"\"\"Accept snapshot files and completed repo/shared content-addressed blobs.\"\"\"\\\\n    if path.parent.resolve(strict=True) != path.parent:\\\\n        raise ValueError(\"untrusted cache component directory redirection\")\\\\n    resolved = path.resolve(strict=True)\\\\n    # Newer Hub caches share immutable SHA-256 blobs across repositories. Only\\\\n    # an exact snapshot reference may reach this pool; never scan/credit it.\\\\n    shared_pool = blobs.parent.parent / \"blobs\"\\\\n    shared_bucket = shared_pool / resolved.name[:2]\\\\n    shared_blob = (re.fullmatch(r\"[0-9a-f]{64}\", resolved.name) is not None\\\\n                   and resolved.parent == shared_bucket\\\\n                   and shared_pool.resolve(strict=True) == shared_pool\\\\n                   and shared_bucket.resolve(strict=True) == shared_bucket)\\\\n    if not (resolved.is_relative_to(snapshot) or\\\\n            (resolved.parent == blobs and re.fullmatch(r\"[0-9a-f]{40}|[0-9a-f]{64}\", resolved.name))\\\\n            or shared_blob):\\\\n        raise ValueError(\"cache file escapes its snapshot/repository blobs\")\\\\n    info = resolved.stat()\\\\n    if not stat.S_ISREG(info.st_mode) or info.st_size <= 0 or \".incomplete\" in resolved.name:\\\\n        raise ValueError(\"cache file is not a completed regular file\")\\\\n    return resolved, info\\\\n\\\\n\\\\ndef _small_json(path, snapshot, blobs):\\\\n    resolved, info = _cache_file(path, snapshot, blobs)\\\\n    if info.st_size > _METADATA_LIMIT:\\\\n        raise ValueError(\"cache metadata exceeds inspection limit\")\\\\n    return json.loads(resolved.read_bytes())\\\\n\\\\n\\\\ndef _weight_metadata(path, snapshot, blobs):\\\\n    \"\"\"Check only the bounded safetensors header and file size, not weight data.\"\"\"\\\\n    resolved, before = _cache_file(path, snapshot, blobs)\\\\n    with resolved.open(\"rb\") as source:\\\\n        prefix = source.read(8)\\\\n        if len(prefix) != 8:\\\\n            raise ValueError(\"incomplete safetensors header\")\\\\n        length = int.from_bytes(prefix, \"little\")\\\\n        if not 2 <= length <= _METADATA_LIMIT or length + 8 > before.st_size:\\\\n            raise ValueError(\"invalid safetensors header size\")\\\\n        header = json.loads(source.read(length))\\\\n    if not isinstance(header, dict):\\\\n        raise ValueError(\"invalid safetensors header\")\\\\n    ranges, names = [], set()\\\\n    sizes = {\"BOOL\": 1, \"U8\": 1, \"I8\": 1, \"U16\": 2, \"I16\": 2, \"F16\": 2, \"BF16\": 2,\\\\n             \"U32\": 4, \"I32\": 4, \"F32\": 4, \"U64\": 8, \"I64\": 8, \"F64\": 8,\\\\n             \"F8_E4M3\": 1, \"F8_E5M2\": 1}\\\\n    for name, entry in header.items():\\\\n        if name == \"__metadata__\":\\\\n            continue\\\\n        start, end = entry[\"data_offsets\"]\\\\n        shape, element_bytes = entry[\"shape\"], sizes[entry[\"dtype\"]]\\\\n        if not isinstance(shape, list) or len(shape) > 16 or any(type(n) is not int or n < 0 for n in shape):\\\\n            raise ValueError(\"invalid tensor shape\")\\\\n        count = 1\\\\n        for dimension in shape:\\\\n            count *= dimension\\\\n        if type(start) is not int or type(end) is not int or start < 0 or end - start != count * element_bytes:\\\\n            raise ValueError(\"invalid tensor data range\")\\\\n        ranges.append((start, end))\\\\n        names.add(name)\\\\n    cursor = 0\\\\n    for start, end in sorted(ranges):\\\\n        if start != cursor:\\\\n            raise ValueError(\"tensor data ranges are incomplete or overlap\")\\\\n        cursor = end\\\\n    after = resolved.stat()\\\\n    if not names or cursor <= 0 or 8 + length + cursor != before.st_size or (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns):\\\\n        raise ValueError(\"weight file is truncated, changing, or has trailing data\")\\\\n    identity = (after.st_dev, after.st_ino) if after.st_ino else str(resolved)\\\\n    return names, cursor, after.st_size, identity\\\\n\\\\n\\\\ndef cached_weight_budget(cache: Path) -> dict:\\\\n    \"\"\"Credit complete weight components, not readiness or model integrity.\"\"\"\\\\n    revision = os.environ.get(\"H3_MODEL_REVISION\", MODEL_REVISION)\\\\n    result = {\"model_revision\": revision, \"reusable_bytes\": 0, \"verified_components\": [],\\\\n              \"observation\": \"no_verified_weights\", \"scope\": \"disk_budget_only_not_model_readiness\"}\\\\n    if not re.fullmatch(r\"[0-9a-f]{40}\", revision):\\\\n        result[\"observation\"] = \"revision_not_an_exact_commit\"\\\\n        return result\\\\n    try:\\\\n        root = cache.resolve(strict=True)\\\\n        repo = root / \"models--MiniMaxAI--MiniMax-H3\"\\\\n        snapshot = repo / \"snapshots\" / revision\\\\n        blobs = repo / \"blobs\"\\\\n        if not snapshot.is_dir():\\\\n            return result\\\\n        # Parent directory symlinks may otherwise redirect an exact snapshot\\\\n        # name into a different revision/repository or an unrelated filesystem.\\\\n        for path in (repo, snapshot.parent, snapshot):\\\\n            if path.resolve(strict=True) != path:\\\\n                raise ValueError(\"untrusted cache directory redirection\")\\\\n        credited = {}\\\\n        for component, stem in _WEIGHT_COMPONENTS.items():\\\\n            directory = snapshot / component\\\\n            single = directory / (stem + \".safetensors\")\\\\n            index = directory / (stem + \".safetensors.index.json\")\\\\n            if single.exists():\\\\n                files, weight_map, total_size = [single.name], None, None\\\\n            elif index.exists():\\\\n                data = _small_json(index, snapshot, blobs)\\\\n                weight_map = data[\"weight_map\"]\\\\n                if not isinstance(weight_map, dict) or not weight_map:\\\\n                    raise ValueError(\"invalid weight index\")\\\\n                files = sorted(set(weight_map.values()))\\\\n                total_size = data.get(\"metadata\", {}).get(\"total_size\")\\\\n                if total_size is not None and (type(total_size) is not int or total_size <= 0):\\\\n                    raise ValueError(\"invalid indexed weight size\")\\\\n            else:\\\\n                continue\\\\n            if any(not isinstance(name, str) or not re.fullmatch(r\"[A-Za-z0-9_-]+\\\\\\\\.safetensors\", name) for name in files):\\\\n                raise ValueError(\"untrusted shard filename\")\\\\n            if any(not (directory / name).exists() for name in files):\\\\n                continue  # partially downloaded components receive no credit\\\\n            component_files, data_bytes = {}, 0\\\\n            for filename in files:\\\\n                names, size, disk_bytes, identity = _weight_metadata(directory / filename, snapshot, blobs)\\\\n                if weight_map is not None and names != {key for key, value in weight_map.items() if value == filename}:\\\\n                    raise ValueError(\"weight index does not match shard tensors\")\\\\n                component_files[identity] = disk_bytes\\\\n                data_bytes += size\\\\n            if total_size is not None and data_bytes != total_size:\\\\n                raise ValueError(\"indexed weight bytes are incomplete\")\\\\n            credited.update(component_files)\\\\n            result[\"verified_components\"].append(component)\\\\n        result[\"reusable_bytes\"] = min(sum(credited.values()), FIRST_DOWNLOAD_BYTES)\\\\n        if credited:\\\\n            result[\"observation\"] = \"completed_weight_metadata_verified\"\\\\n    except FileNotFoundError:\\\\n        # Cache creation/deletion races and missing roots never relax the gate.\\\\n        result.update(reusable_bytes=0, verified_components=[], observation=\"cache_missing_or_changed\")\\\\n    except (OSError, ValueError, TypeError, KeyError, AttributeError, OverflowError, RuntimeError) as error:\\\\n        result.update(reusable_bytes=0, verified_components=[], observation=\"cache_unverified\",\\\\n                      error_type=type(error).__name__)\\\\n    return result\\\\n\\\\n\\\\ndef check_resources(mode: str = \"bf16\", residency: str = \"resident\") -> dict:\\\\n    if mode != \"bf16\":\\\\n        raise ValueError(\"This project requires native BF16 on an NVIDIA A100; reduced-precision modes are disabled.\")\\\\n    if residency not in {\"resident\", \"staged\"}:\\\\n        raise ValueError(\"residency must be resident or staged\")\\\\n    if not Path(\"/proc/meminfo\").is_file():\\\\n        raise RuntimeError(\"Deploy this project on a Linux NVIDIA GPU machine.\")\\\\n    memory = {}\\\\n    for line in Path(\"/proc/meminfo\").read_text().splitlines():\\\\n        name, value = line.split(\":\", 1)\\\\n        memory[name] = int(value.strip().split()[0]) * 1024\\\\n    try:\\\\n        result = subprocess.run(\\\\n            [\"nvidia-smi\", \"--query-gpu=name,memory.total\", \"--format=csv,noheader,nounits\"],\\\\n            text=True, capture_output=True, check=True, timeout=20,\\\\n        )\\\\n        first = result.stdout.strip().splitlines()[0]\\\\n        gpu, memory_mib = first.rsplit(\",\", 1)\\\\n        vram_gib = float(memory_mib.strip()) / 1024\\\\n    except (OSError, ValueError, IndexError, subprocess.SubprocessError) as exc:\\\\n        raise RuntimeError(\"No working NVIDIA GPU detected. Select a GPU runtime first.\") from exc\\\\n    # The first visible CUDA GPU is used. Report conservatively when device masks are present.\\\\n    visible = os.environ.get(\"CUDA_VISIBLE_DEVICES\")\\\\n    if visible and visible not in {\"0\", \"0,\"}:\\\\n        raise RuntimeError(\"Preflight expects the first NVIDIA GPU. Unset CUDA_VISIBLE_DEVICES or set it to 0.\")\\\\n    cache = _hub_cache_path()\\\\n    disk_path = cache\\\\n    while not disk_path.exists():\\\\n        disk_path = disk_path.parent\\\\n    free_disk_bytes = shutil.disk_usage(disk_path).free\\\\n    free_disk = free_disk_bytes / GIB\\\\n    cache_budget = cached_weight_budget(cache)\\\\n    remaining_disk_bytes = max(0, FIRST_DOWNLOAD_BYTES - cache_budget[\"reusable_bytes\"])\\\\n    available_ram = memory[\"MemAvailable\"] / GIB\\\\n    strategy = (\"staged_component_residency\" if residency == \"staged\" else\\\\n                \"component_cpu_offload\" if vram_gib >= 75 else \"group_cpu_offload\")\\\\n    required_ram_gib = 70 if residency == \"staged\" else 140\\\\n    report = {\\\\n        \"mode\": mode, \"gpu\": gpu.strip(), \"vram_gib\": round(vram_gib, 1),\\\\n        \"available_ram_gib\": round(available_ram, 1),\\\\n        \"total_ram_gib\": round(memory[\"MemTotal\"] / GIB, 1),\\\\n        \"cache_free_disk_gib\": round(free_disk, 1), \"cache_path\": str(cache),\\\\n        \"cache_reusable_weight_gib\": round(cache_budget[\"reusable_bytes\"] / GIB, 2),\\\\n        \"cache_remaining_required_gib\": round(remaining_disk_bytes / GIB, 2),\\\\n        \"cache_weight_observation\": cache_budget,\\\\n        \"disk_check_skipped\": os.environ.get(\"H3_SKIP_DISK_CHECK\") == \"1\",\\\\n        \"a100_variant\": \"80GB\" if vram_gib >= 75 else \"40GB\",\\\\n        \"strategy\": strategy,\\\\n        \"residency\": residency, \"required_available_ram_gib\": required_ram_gib,\\\\n    }\\\\n    errors = []\\\\n    if \"A100\" not in gpu.upper():\\\\n        errors.append(f\"GPU must be an NVIDIA A100, detected {gpu.strip()}\")\\\\n    if available_ram < required_ram_gib:\\\\n        errors.append(f\"available host RAM {available_ram:.1f} GiB < {required_ram_gib} GiB ({residency})\")\\\\n    if vram_gib < 38:\\\\n        errors.append(f\"GPU memory {vram_gib:.1f} GiB < 38 GiB (A100 40GB class required)\")\\\\n    if free_disk_bytes < remaining_disk_bytes and not report[\"disk_check_skipped\"]:\\\\n        errors.append(\\\\n            f\"cache disk free {free_disk:.1f} GiB < remaining required {remaining_disk_bytes / GIB:.1f} GiB \"\\\\n            f\"(140 GiB first-download budget minus {cache_budget[\\\\\\'reusable_bytes\\\\\\'] / GIB:.1f} GiB \"\\\\n            \"of completed reusable weights; unverified/partial files receive no credit)\"\\\\n        )\\\\n    print(json.dumps(report, indent=2, ensure_ascii=False), flush=True)\\\\n    if errors:\\\\n        raise RuntimeError(\\\\n            \"Resource preflight failed before model download: \" + \"; \".join(errors)\\\\n            + \". These are conservative project gates, not a guarantee against peak-memory OOM.\"\\\\n        )\\\\n    if residency == \"staged\":\\\\n        print(\\\\n            \"Staged A100 BF16: the text encoder and transformer_ref are loaded one at a time, \"\\\\n            \"with the previous large component unloaded first. Disk reloads and CPU/GPU transfers add latency. \"\\\\n            \"The 70 GiB host-RAM gate is a project threshold. The original staged A100 40GB single-image baseline passed; this optimized build still needs GPU acceptance.\",\\\\n            flush=True,\\\\n        )\\\\n    elif strategy == \"group_cpu_offload\":\\\\n        print(\\\\n            \"A100 40GB: native BF16 weights are preserved. The 61.7 GB transformer cannot fit in GPU memory, \"\\\\n            \"so blocks move between CPU RAM and GPU. Throughput depends on PCIe and host memory bandwidth and may be slow.\",\\\\n            flush=True,\\\\n        )\\\\n    else:\\\\n        print(\"A100 80GB: native BF16 with components alternated between CPU RAM and GPU.\", flush=True)\\\\n    return report\\\\n\\\\n\\\\nif __name__ == \"__main__\":\\\\n    parser = argparse.ArgumentParser(description=__doc__)\\\\n    parser.add_argument(\"--staged\", action=\"store_true\", help=\"Explicit sequential BF16 residency profile: 70 GiB available host RAM\")\\\\n    args = parser.parse_args()\\\\n    check_resources(os.environ.get(\"H3_MODE\", \"bf16\"), residency=\"staged\" if args.staged else \"resident\")\\\\n\\', \\'server.py\\': \\'\"\"\"Authenticated API adapter. Model execution and durable jobs belong to the manager.\"\"\"\\\\nfrom __future__ import annotations\\\\n\\\\nimport asyncio\\\\nimport errno\\\\nimport hashlib\\\\nimport hmac\\\\nimport ipaddress\\\\nimport json\\\\nimport logging\\\\nimport math\\\\nimport os\\\\nfrom pathlib import Path\\\\nimport re\\\\nimport shutil\\\\nimport threading\\\\nfrom contextlib import asynccontextmanager\\\\nfrom typing import Annotated, Literal\\\\nimport uuid\\\\nfrom urllib.parse import urlsplit\\\\n\\\\nfrom fastapi import Depends, FastAPI, File, Form, Header, HTTPException, Query, UploadFile\\\\nfrom fastapi.middleware.cors import CORSMiddleware\\\\nfrom fastapi.responses import FileResponse, JSONResponse\\\\nfrom fastapi.security import HTTPAuthorizationCredentials, HTTPBearer\\\\nfrom pydantic import BaseModel, ConfigDict, Field, ValidationError\\\\n\\\\nfrom control_protocol import ControlError, rpc_call\\\\nfrom adapter_config import load_adapter_settings\\\\nfrom generation_options import generation_capabilities, validate_generation_options\\\\nfrom runtime_options import RuntimeOptions\\\\n\\\\nLOG = logging.getLogger(\"minimax_api\")\\\\nMIB = 1024 * 1024\\\\nMAX_FILE_BYTES = 32 * MIB\\\\nMAX_TOTAL_BYTES = 64 * MIB\\\\nMAX_REQUEST_BYTES = MAX_TOTAL_BYTES + MIB\\\\nMAX_CONTROL_BYTES = 64 * 1024\\\\nEXTENSIONS = {\\\\n    \"image\": {\".jpg\", \".jpeg\", \".png\", \".webp\"},\\\\n    \"video\": {\".mp4\", \".mov\", \".webm\"},\\\\n    \"audio\": {\".wav\", \".mp3\", \".m4a\", \".flac\", \".ogg\"},\\\\n}\\\\nJOB_ID = re.compile(r\"^[a-f0-9]{32}$\")\\\\nsecurity = HTTPBearer()\\\\n\\\\n# Public receipts are an explicit projection, not arbitrary owner-provided JSON.\\\\n# Keep this contract independent of the model module: the API must not load it.\\\\nPUBLIC_STAGE_CONDITIONS = (\"instance_matches\", \"attempt_owned\", \"attempt_live\", \"model_loaded\", \"worker_alive\",\\\\n    \"capability_available\", \"admission_confirmed\", \"predecessor_completed\", \"stage_not_started\",\\\\n    \"cancel_flag_clear\", \"cancel_event_clear\", \"reservation_owned\", \"budget_grant_held\")\\\\nPUBLIC_GATE_CONDITIONS = {\\\\n    \"manager.dispatch\": (\"manager_open\", \"job_queued\", \"attempt_unassigned\", \"model_identity_current\",\\\\n        \"model_observation_fresh\", \"model_process_alive\", \"model_ready\", \"worker_alive\", \"worker_accepting\", \"supervisor_alive\"),\\\\n    \"model.execute\": (\"instance_matches\", \"request_validated\", \"model_loaded\", \"worker_alive\", \"capability_available\",\\\\n        \"not_draining\", \"not_stopping\", \"attempt_available\", \"job_unowned\", \"artifact_absent\",\\\\n        \"generation_options_valid\", \"resources_reserved\"),\\\\n    **{\"model.stage.\" + stage: PUBLIC_STAGE_CONDITIONS for stage in (\"prepare\", \"gpu\", \"encode_validate\")},\\\\n}\\\\n\\\\n\\\\ndef public_gate_receipt(value, expected_gate):\\\\n    \"\"\"Expose known decision facts; no free-form context, parameters or paths.\"\"\"\\\\n    if not isinstance(value, dict) or value.get(\"gate_id\") != expected_gate or expected_gate not in PUBLIC_GATE_CONDITIONS:\\\\n        return None\\\\n    required = PUBLIC_GATE_CONDITIONS[expected_gate]\\\\n    raw_conditions = value.get(\"conditions\")\\\\n    raw_conditions = raw_conditions if isinstance(raw_conditions, dict) else {}\\\\n    states = {\"true\", \"false\", \"unknown\", \"conflict\"}\\\\n    conditions = {name: raw_conditions.get(name) if type(raw_conditions.get(name)) is str\\\\n                  and raw_conditions[name] in states else \"unknown\" for name in required}\\\\n    result = {\"gate_id\": expected_gate, \"conditions\": conditions,\\\\n              \"allowed\": value.get(\"allowed\") if type(value.get(\"allowed\")) is bool else None}\\\\n    if result[\"allowed\"] is True and any(state != \"true\" for state in conditions.values()):\\\\n        # Do not publish a positive authorization whose required evidence is\\\\n        # missing, malformed or contradictory; keep uncertainty visible.\\\\n        result[\"allowed\"] = None\\\\n    for name in (\"schema_version\", \"gate_version\"):\\\\n        if isinstance(value.get(name), str) and re.fullmatch(r\"[0-9]{1,3}\\\\\\\\.[0-9]{1,3}\", value[name]):\\\\n            result[name] = value[name]\\\\n    if isinstance(value.get(\"decision_id\"), str) and JOB_ID.fullmatch(value[\"decision_id\"]):\\\\n        result[\"decision_id\"] = value[\"decision_id\"]\\\\n    observed = value.get(\"observed_at\")\\\\n    if type(observed) in {int, float} and math.isfinite(observed) and observed >= 0:\\\\n        result[\"observed_at\"] = observed\\\\n    monotonic = value.get(\"monotonic_ns\")\\\\n    if type(monotonic) is int and 0 <= monotonic < 2 ** 63:\\\\n        result[\"monotonic_ns\"] = monotonic\\\\n    blocked = value.get(\"blocked\")\\\\n    if isinstance(blocked, list):\\\\n        result[\"blocked\"] = [name for name in required if name in blocked]\\\\n    raw = value.get(\"context\")\\\\n    context = {}\\\\n    if isinstance(raw, dict):\\\\n        for name in (\"manager_instance_id\", \"model_instance_id\", \"instance_id\", \"job_id\", \"attempt_id\",\\\\n                     \"budget_instance_id\", \"reservation_id\", \"lease_id\", \"budget_decision_id\"):\\\\n            if isinstance(raw.get(name), str) and JOB_ID.fullmatch(raw[name]):\\\\n                context[name] = raw[name]\\\\n        expected_source = \"global_manager.py\" if expected_gate == \"manager.dispatch\" else \"model_container.py\"\\\\n        if raw.get(\"source_file\") == expected_source:\\\\n            context[\"source_file\"] = expected_source\\\\n        if isinstance(raw.get(\"source_sha256\"), str) and re.fullmatch(r\"[a-f0-9]{64}\", raw[\"source_sha256\"]):\\\\n            context[\"source_sha256\"] = raw[\"source_sha256\"]\\\\n        if type(raw.get(\"pipeline\")) is bool:\\\\n            context[\"pipeline\"] = raw[\"pipeline\"]\\\\n        if raw.get(\"budget_scope\") in (\"stage_budget\", \"legacy_single_active\"):\\\\n            context[\"budget_scope\"] = raw[\"budget_scope\"]\\\\n        if raw.get(\"stage\") in (\"prepare\", \"gpu\", \"encode_validate\"):\\\\n            context[\"stage\"] = raw[\"stage\"]\\\\n    result[\"context\"] = context\\\\n    return result\\\\n\\\\n\\\\ndef public_condition_fields(record):\\\\n    fields = {}\\\\n    if \"condition_gate\" in record:\\\\n        fields[\"condition_gate\"] = public_gate_receipt(record[\"condition_gate\"], \"manager.dispatch\")\\\\n    if \"execution_condition_gates\" in record:\\\\n        raw = record[\"execution_condition_gates\"]\\\\n        fields[\"execution_condition_gates\"] = ({\\\\n            name: public_gate_receipt(raw[name], name) for name in PUBLIC_GATE_CONDITIONS\\\\n            if name.startswith(\"model.\") and name in raw\\\\n        } if isinstance(raw, dict) else None)\\\\n    if \"stage_completions\" in record:\\\\n        raw = record[\"stage_completions\"]\\\\n        fields[\"stage_completions\"] = ({\\\\n            name: raw.get(name) if type(raw.get(name)) is bool else None\\\\n            for name in (\"prepare\", \"gpu\", \"encode_validate\")\\\\n        } if isinstance(raw, dict) else None)\\\\n    if \"cancellation_requested\" in record:\\\\n        fields[\"cancellation_requested\"] = (record[\"cancellation_requested\"]\\\\n            if type(record[\"cancellation_requested\"]) is bool else None)\\\\n    return fields\\\\nDEFAULT_CORS_ORIGINS = (\\\\n    \"https://zjj1280637679-ship-it.github.io\",\\\\n    \"http://localhost:8000\",\\\\n    \"http://127.0.0.1:8000\",\\\\n)\\\\n\\\\n\\\\ndef _cors_allowed_origins() -> list[str]:\\\\n    \"\"\"Explicit browser origins, independent of Bearer authorization.\\\\n\\\\n    H3_CORS_ORIGINS replaces the defaults; an empty value disables cross-origin\\\\n    reads. Public origins require HTTPS, while HTTP is restricted to loopback.\\\\n    \"\"\"\\\\n    configured = os.environ.get(\"H3_CORS_ORIGINS\")\\\\n    values = DEFAULT_CORS_ORIGINS if configured is None else configured.split(\",\")\\\\n    origins = []\\\\n    for value in values:\\\\n        value = value.strip()\\\\n        if not value:\\\\n            continue\\\\n        try:\\\\n            if \"*\" in value or any(char.isspace() or ord(char) < 32 for char in value):\\\\n                raise ValueError()\\\\n            parsed = urlsplit(value)\\\\n            hostname, port = parsed.hostname, parsed.port\\\\n            if (parsed.scheme not in {\"https\", \"http\"} or not hostname\\\\n                    or parsed.username is not None or parsed.password is not None\\\\n                    or parsed.path not in {\"\", \"/\"} or parsed.query or parsed.fragment\\\\n                    or (port is not None and not 1 <= port <= 65535)):\\\\n                raise ValueError()\\\\n            try:\\\\n                address = ipaddress.ip_address(hostname)\\\\n            except ValueError:\\\\n                address = None\\\\n                hostname = hostname.encode(\"idna\").decode(\"ascii\").lower()\\\\n                if len(hostname) > 253 or not re.fullmatch(\\\\n                    r\"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\\\\\\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*\",\\\\n                    hostname,\\\\n                ):\\\\n                    raise ValueError()\\\\n            if parsed.scheme == \"http\" and not (hostname == \"localhost\" or (address and address.is_loopback)):\\\\n                raise ValueError()\\\\n            host = f\"[{address.compressed}]\" if address and address.version == 6 else hostname\\\\n            suffix = f\":{port}\" if port is not None and port != (443 if parsed.scheme == \"https\" else 80) else \"\"\\\\n            origin = f\"{parsed.scheme}://{host}{suffix}\"\\\\n        except (ValueError, UnicodeError):\\\\n            raise RuntimeError(\"H3_CORS_ORIGINS must contain explicit HTTPS origins or loopback HTTP origins; wildcards, credentials and URL paths are not allowed.\") from None\\\\n        if origin not in origins:\\\\n            origins.append(origin)\\\\n    return origins\\\\n\\\\n\\\\nclass RequestGuard:\\\\n    \"\"\"Authenticate before multipart parsing and bound actual incoming bytes.\"\"\"\\\\n\\\\n    def __init__(self, app, api_key: str):\\\\n        self.app, self.api_key = app, api_key\\\\n\\\\n    async def __call__(self, scope, receive, send):\\\\n        if scope[\"type\"] != \"http\" or not scope[\"path\"].startswith(\"/v1/\"):\\\\n            return await self.app(scope, receive, send)\\\\n        headers = dict(scope.get(\"headers\", []))\\\\n        authorization = headers.get(b\"authorization\", b\"\").decode(\"latin1\")\\\\n        scheme, _, token = authorization.partition(\" \")\\\\n        if scheme.lower() != \"bearer\" or not hmac.compare_digest(token.encode(\"latin1\"), self.api_key.encode(\"ascii\")):\\\\n            return await JSONResponse({\"detail\": \"Bearer API key required\"}, 401,\\\\n                                      headers={\"WWW-Authenticate\": \"Bearer\"})(scope, receive, send)\\\\n        limit = MAX_REQUEST_BYTES if scope[\"path\"] == \"/v1/jobs\" and scope[\"method\"] == \"POST\" else MAX_CONTROL_BYTES\\\\n        try:\\\\n            content_length = int(headers.get(b\"content-length\", b\"0\"))\\\\n            if content_length < 0:\\\\n                raise ValueError\\\\n        except ValueError:\\\\n            return await JSONResponse({\"detail\": \"Invalid Content-Length\"}, 400)(scope, receive, send)\\\\n        if content_length > limit:\\\\n            return await JSONResponse({\"detail\": \"Request exceeds body limit\"}, 413)(scope, receive, send)\\\\n        received = 0\\\\n\\\\n        async def limited_receive():\\\\n            nonlocal received\\\\n            message = await receive()\\\\n            received += len(message.get(\"body\", b\"\"))\\\\n            if received > limit:\\\\n                raise HTTPException(413, \"Request exceeds body limit\")\\\\n            return message\\\\n\\\\n        await self.app(scope, limited_receive, send)\\\\n\\\\n\\\\nclass ControlRequest(BaseModel):\\\\n    model_config = ConfigDict(extra=\"forbid\")\\\\n    action: Literal[\"drain\", \"resume\", \"start_model\", \"stop_model\", \"start_api\", \"stop_api\", \"shutdown\"]\\\\n    force: bool = Field(False, strict=True)\\\\n    command_id: str | None = Field(None, min_length=1, max_length=128, pattern=r\"^[A-Za-z0-9._:-]+$\")\\\\n\\\\n\\\\nclass DriveArchiveReceipt(BaseModel):\\\\n    model_config = ConfigDict(extra=\"forbid\")\\\\n    file_id: str = Field(min_length=1, max_length=128, pattern=r\"^[A-Za-z0-9_-]+$\")\\\\n    sha256: str = Field(pattern=r\"^[a-f0-9]{64}$\")\\\\n    bytes: int = Field(gt=0, strict=True)\\\\n\\\\n\\\\ndef _watch_parent(parent_pid, stop, exit_process=os._exit, process_factory=None, expected_creation=None):\\\\n    # Windows venv redirectors are legitimate intermediate OS parents. Ownership\\\\n    # is the supplied manager process generation, not direct getppid equality.\\\\n    import psutil\\\\n    factory = process_factory or psutil.Process\\\\n    try:\\\\n        if expected_creation is None:\\\\n            expected_creation = factory(parent_pid).create_time()\\\\n    except psutil.Error:\\\\n        exit_process(70)\\\\n        return\\\\n    while not stop.wait(1):\\\\n        try:\\\\n            process = factory(parent_pid)\\\\n            alive = (process.is_running() and process.status() != psutil.STATUS_ZOMBIE\\\\n                     and process.create_time() == expected_creation)\\\\n        except psutil.Error:\\\\n            alive = False\\\\n        if not alive:\\\\n            exit_process(70)\\\\n            return\\\\n\\\\n\\\\ndef create_app(controller=None, api_key: str | None = None, output_dir: Path | None = None):\\\\n    \"\"\"API creation never initializes CUDA, a model, or a second job-state owner.\"\"\"\\\\n    token = api_key if api_key is not None else os.environ.get(\"H3_API_KEY\", \"\")\\\\n    if len(token) < 32 or not token.isascii() or any(c.isspace() for c in token):\\\\n        raise RuntimeError(\"Set H3_API_KEY to a random ASCII token of at least 32 characters.\")\\\\n    instance_id = os.environ.get(\"H3_INSTANCE_ID\") or uuid.uuid4().hex\\\\n    root = Path(output_dir or os.environ.get(\"H3_OUTPUT_DIR\", \"./h3_outputs\")).resolve()\\\\n    private_key = os.environ.get(\"H3_CONTROL_KEY\", \"\")\\\\n    if controller is None:\\\\n        manager_url = os.environ.get(\"H3_MANAGER_URL\", \"\")\\\\n        if not manager_url or len(private_key) < 32:\\\\n            raise RuntimeError(\"The API requires its manager connection and private control token.\")\\\\n        controller = lambda operation, payload: rpc_call(manager_url, private_key, operation, payload)\\\\n    # Only concurrent transport writes are bounded by count; durable jobs/outbox\\\\n    # records have no count limit. Disk bytes govern their storage admission.\\\\n    upload_lock = threading.Lock()\\\\n    upload_state = {\"active\": 0}\\\\n    disk_reserve_bytes = max(0, int(os.environ.get(\"H3_DISK_RESERVE_BYTES\", 64 * MIB)))\\\\n    stopped = threading.Event()\\\\n\\\\n    def unknown_count():\\\\n        if not root.exists():\\\\n            return 0\\\\n        return sum(1 for directory in root.iterdir()\\\\n                   if JOB_ID.fullmatch(directory.name) and not directory.is_symlink()\\\\n                   and (directory / \"submission-uncertain.json\").is_file())\\\\n\\\\n    def acquire_upload():\\\\n        with upload_lock:\\\\n            if upload_state[\"active\"] >= 3:\\\\n                return False\\\\n            if shutil.disk_usage(root).free < disk_reserve_bytes + (upload_state[\"active\"] + 1) * MAX_TOTAL_BYTES:\\\\n                raise HTTPException(507, \"Insufficient disk space for reference upload\")\\\\n            upload_state[\"active\"] += 1\\\\n            return True\\\\n\\\\n    def release_upload():\\\\n        with upload_lock:\\\\n            upload_state[\"active\"] -= 1\\\\n\\\\n    def transport_status():\\\\n        with upload_lock:\\\\n            return {\"active_uploads\": upload_state[\"active\"], \"unknown_submissions\": unknown_count(),\\\\n                    \"concurrent_upload_limit\": 3, \"durable_submission_count_limit\": None,\\\\n                    \"disk_reserve_bytes\": disk_reserve_bytes, \"max_reference_bytes_per_request\": MAX_TOTAL_BYTES}\\\\n\\\\n    def redact(value):\\\\n        if isinstance(value, dict):\\\\n            forbidden = {\"api_key\", \"control_key\", \"private_key\", \"internal_key\", \"token\", \"authorization\", \"manager_url\"}\\\\n            return {key: redact(item) for key, item in value.items() if key.lower() not in forbidden}\\\\n        if isinstance(value, list):\\\\n            return [redact(item) for item in value]\\\\n        if isinstance(value, str):\\\\n            for secret in (token, private_key):\\\\n                if secret:\\\\n                    value = value.replace(secret, \"[redacted]\")\\\\n        return value\\\\n\\\\n    def call(operation, payload=None):\\\\n        try:\\\\n            request = dict(payload or {})\\\\n            if operation in {\"submit\", \"cancel\", \"control\", \"archive\"}:\\\\n                request[\"expected_instance_id\"] = instance_id\\\\n            result = controller(operation, request)\\\\n            if not isinstance(result, dict):\\\\n                raise TypeError(\"Invalid manager response\")\\\\n            return result\\\\n        except ControlError as error:\\\\n            status = getattr(error, \"status\", 503)\\\\n            status = status if isinstance(status, int) and 400 <= status <= 599 else 503\\\\n            # Transport/internal failures are not evidence of rejection; callers\\\\n            # reconcile uncertain submissions before removing their inputs.\\\\n            if status >= 500 and status != 507:\\\\n                raise HTTPException(503, \"Manager unavailable; query the command or job before retrying\") from None\\\\n            detail = str(redact(str(error)))[:500]\\\\n            raise HTTPException(status, detail or \"Manager rejected the request\") from None\\\\n        except Exception as error:\\\\n            LOG.warning(\"Manager operation failed: %s (%s)\", operation, type(error).__name__)\\\\n            raise HTTPException(503, \"Manager unavailable; query the command or job before retrying\") from None\\\\n\\\\n    def valid_id(job_id):\\\\n        if not JOB_ID.fullmatch(job_id):\\\\n            raise HTTPException(404, \"Task does not exist\")\\\\n\\\\n    def public_job(record):\\\\n        identity = record.get(\"id\", record.get(\"job_id\"))\\\\n        if not isinstance(identity, str) or not JOB_ID.fullmatch(identity):\\\\n            raise HTTPException(503, \"Manager returned an invalid task identity\")\\\\n        record_instance = record.get(\"instance_id\")\\\\n        if \"instance_id\" in record:\\\\n            if record_instance != instance_id:\\\\n                raise HTTPException(503, \"Manager returned a task from a different instance\")\\\\n        else:\\\\n            # Compatibility with an already running older manager: bind only\\\\n            # after an authenticated current-manager identity readback. Do not\\\\n            # replace an explicit mismatch or infer identity from a job ID.\\\\n            state = call(\"status\")\\\\n            if state.get(\"instance_id\") != instance_id:\\\\n                raise HTTPException(503, \"Manager identity is not confirmed for this task\")\\\\n        allowed = {\"status\", \"created_at\", \"started_at\", \"finished_at\", \"error\", \"actual_seconds\",\\\\n                   \"generation_parameters\", \"generation_options\", \"lifecycle\", \"metrics\", \"active_phase\", \"attempt_id\", \"instance_id\",\\\\n                   \"cancel_requested\", \"cleanup_complete\", \"replayed\", \"queue_position\", \"dispatch_state\", \"dispatch_reason\", \"waiting_for\"}\\\\n        result = {\"id\": identity, **{key: record[key] for key in allowed if key in record}}\\\\n        result.update(public_condition_fields(record))\\\\n        result[\"instance_id\"] = instance_id\\\\n        if result.get(\"status\") not in {\"queued\", \"running\", \"cancel_requested\", \"succeeded\", \"failed\", \"cancelled\"}:\\\\n            raise HTTPException(503, \"Manager returned an invalid task state\")\\\\n        if isinstance(record.get(\"artifact\"), dict):\\\\n            result[\"artifact\"] = {key: value for key, value in record[\"artifact\"].items() if key != \"path\"}\\\\n        result[\"status_url\"] = f\"/v1/jobs/{identity}\"\\\\n        if result[\"status\"] in {\"queued\", \"running\", \"cancel_requested\"}:\\\\n            result[\"cancel_url\"] = f\"/v1/jobs/{identity}/cancel\"\\\\n            result[\"poll_after_seconds\"] = 2\\\\n        if result[\"status\"] == \"succeeded\":\\\\n            result[\"file_url\"] = f\"/v1/jobs/{identity}/file\"\\\\n            archive = record.get(\"archive\")\\\\n            if isinstance(archive, dict) and archive.get(\"provider\") == \"google_drive\":\\\\n                try:\\\\n                    receipt = DriveArchiveReceipt.model_validate({k: archive.get(k) for k in DriveArchiveReceipt.model_fields})\\\\n                except ValidationError:\\\\n                    raise HTTPException(503, \"Manager returned an invalid archive receipt\") from None\\\\n                download_url = f\"https://drive.google.com/uc?export=download&id={receipt.file_id}\"\\\\n                result[\"archive\"] = {\\\\n                    \"provider\": \"google_drive\", **receipt.model_dump(), \"download_url\": download_url,\\\\n                    \"view_url\": f\"https://drive.google.com/file/d/{receipt.file_id}/view\",\\\\n                }\\\\n                result[\"download_url\"] = download_url\\\\n        return redact(result)\\\\n\\\\n    @asynccontextmanager\\\\n    async def lifespan(app):\\\\n        root.mkdir(parents=True, exist_ok=True)\\\\n        watcher = None\\\\n        parent_pid = os.environ.get(\"H3_PARENT_PID\")\\\\n        if parent_pid:\\\\n            parent_pid = int(parent_pid)\\\\n            if parent_pid <= 1:\\\\n                raise RuntimeError(\"Invalid manager parent process identity\")\\\\n            created = os.environ.get(\"H3_PARENT_CREATED_AT\")\\\\n            expected_creation = float(created) if created is not None else None\\\\n            watcher = threading.Thread(target=_watch_parent, args=(parent_pid, stopped),\\\\n                                       kwargs={\"expected_creation\": expected_creation},\\\\n                                       name=\"h3-api-owner-watch\", daemon=True)\\\\n            watcher.start()\\\\n        try:\\\\n            yield\\\\n        finally:\\\\n            stopped.set()\\\\n            if watcher:\\\\n                watcher.join(timeout=2)\\\\n\\\\n    adapter_settings = load_adapter_settings()\\\\n    runtime_options = RuntimeOptions.from_env()\\\\n    app = FastAPI(title=\"MiniMax-H3 Ref2VA API\", version=\"0.4.0\", lifespan=lifespan,\\\\n                  description=\"Independent authenticated API adapter; durable scheduling is owned by the global manager.\")\\\\n    app.add_middleware(RequestGuard, api_key=token)\\\\n    # Starlette wraps the last-added middleware outermost. Handle valid browser\\\\n    # preflights before RequestGuard, and attach CORS headers even to its 401s.\\\\n    # Every actual /v1 request still traverses the unchanged Bearer guard.\\\\n    app.add_middleware(\\\\n        CORSMiddleware,\\\\n        allow_origins=_cors_allowed_origins(),\\\\n        allow_credentials=False,\\\\n        allow_methods=[\"GET\", \"POST\"],\\\\n        allow_headers=[\"Authorization\", \"Content-Type\", \"Idempotency-Key\", \"Range\"],\\\\n        expose_headers=[\"Content-Disposition\", \"Content-Length\", \"Content-Range\", \"Accept-Ranges\", \"ETag\", \"Retry-After\"],\\\\n        max_age=600,\\\\n    )\\\\n\\\\n    def require_auth(credentials: Annotated[HTTPAuthorizationCredentials, Depends(security)]):\\\\n        if not hmac.compare_digest(credentials.credentials.encode(\"utf-8\"), token.encode(\"ascii\")):\\\\n            raise HTTPException(401, \"Invalid API key\", headers={\"WWW-Authenticate\": \"Bearer\"})\\\\n\\\\n    @app.get(\"/health/live\")\\\\n    def live():\\\\n        return {\"api_ready\": True, \"alive\": True, \"instance_id\": instance_id}\\\\n\\\\n    @app.get(\"/health\")\\\\n    def health():\\\\n        try:\\\\n            state = call(\"status\")\\\\n        except HTTPException:\\\\n            return JSONResponse({\"api_ready\": True, \"manager_ready\": False, \"model_ready\": False,\\\\n                                 \"ready\": False, \"instance_id\": instance_id}, 503)\\\\n        same_instance = state.get(\"instance_id\") == instance_id\\\\n        return JSONResponse({\"api_ready\": True, \"manager_ready\": same_instance,\\\\n                             \"model_ready\": same_instance and state.get(\"model_ready\") is True,\\\\n                             \"ready\": same_instance and state.get(\"ready\") is True,\\\\n                             \"instance_id\": instance_id}, 200 if same_instance else 503)\\\\n\\\\n    @app.get(\"/v1/system\", dependencies=[Depends(require_auth)])\\\\n    def system():\\\\n        local = transport_status()\\\\n        try:\\\\n            state = redact(call(\"status\"))\\\\n        except HTTPException:\\\\n            return JSONResponse({\"instance_id\": instance_id, \"api_ready\": True, \"manager_ready\": False,\\\\n                                 \"ready\": False, \"model_ready\": False, \"api_local\": local}, 503)\\\\n        return {**state, \"api_local\": local}\\\\n\\\\n    @app.get(\"/v1/capabilities\", dependencies=[Depends(require_auth)])\\\\n    def capabilities():\\\\n        # Configuration admits queued work while model_ready is still false.\\\\n        # Never infer successful loading from a download percentage.\\\\n        state = call(\"status\")\\\\n        same_instance = state.get(\"instance_id\") == instance_id\\\\n        return {**generation_capabilities(model_ready=same_instance and state.get(\"model_ready\") is True,\\\\n                    settings=adapter_settings, runtime_options=runtime_options), \"instance_id\": instance_id}\\\\n\\\\n    @app.get(\"/v1/events\", dependencies=[Depends(require_auth)])\\\\n    def events(after: Annotated[int, Query(ge=0)] = 0, limit: Annotated[int, Query(ge=1, le=1000)] = 100):\\\\n        return redact(call(\"events\", {\"after\": after, \"limit\": limit}))\\\\n\\\\n    @app.get(\"/v1/commands/{command_id}\", dependencies=[Depends(require_auth)])\\\\n    def command(command_id: str):\\\\n        if not re.fullmatch(r\"[A-Za-z0-9._:-]{1,128}\", command_id):\\\\n            raise HTTPException(404, \"Command does not exist\")\\\\n        return redact(call(\"command\", {\"command_id\": command_id}))\\\\n\\\\n    @app.post(\"/v1/control\", status_code=202, dependencies=[Depends(require_auth)])\\\\n    def control(request: ControlRequest):\\\\n        if request.action in {\"stop_api\", \"shutdown\"} and request.command_id is None:\\\\n            raise HTTPException(422, \"A client command_id is required when stopping this API; query it through the manager\")\\\\n        return redact(call(\"control\", request.model_dump(exclude_none=True)))\\\\n\\\\n    @app.post(\"/v1/jobs\", status_code=202, dependencies=[Depends(require_auth)])\\\\n    async def submit(\\\\n        files: Annotated[list[UploadFile], File(description=\"Reference files in semantic order\")],\\\\n        kinds: Annotated[str, Form(description=\\\\\\'JSON array matching files, e.g. [\"image\",\"audio\"]\\\\\\')],\\\\n        prompt: Annotated[str, Form(min_length=1, max_length=4000)],\\\\n        seconds: Annotated[float, Form(ge=5, le=15)] = 5,\\\\n        width: Annotated[int, Form(ge=256, le=1344)] = 960,\\\\n        height: Annotated[int, Form(ge=256, le=1344)] = 544,\\\\n        steps: Annotated[int, Form(ge=2, le=50)] = 50,\\\\n        attention_backend: Annotated[str, Form()] = \"auto\",\\\\n        acceleration_lora: Annotated[str, Form()] = \"none\",\\\\n        seed: Annotated[int, Form(ge=0, le=2147483647)] = 42,\\\\n        idempotency_key: Annotated[str | None, Header(alias=\"Idempotency-Key\", max_length=128)] = None,\\\\n    ):\\\\n        directory = None\\\\n        reserved = retain_inputs = False\\\\n        try:\\\\n            if not prompt.strip() or not math.isfinite(seconds):\\\\n                raise HTTPException(422, \"Prompt and duration must be valid\")\\\\n            try:\\\\n                validate_generation_options({\"attention_backend\": attention_backend,\\\\n                    \"acceleration_lora\": acceleration_lora, \"steps\": steps}, adapter_settings)\\\\n            except ValueError as error:\\\\n                raise HTTPException(422, str(error)) from None\\\\n            if idempotency_key is not None and not re.fullmatch(r\"[A-Za-z0-9._:-]{1,128}\", idempotency_key):\\\\n                raise HTTPException(422, \"Invalid Idempotency-Key\")\\\\n            if width % 32 or height % 32 or width * height > 1344 * 768:\\\\n                raise HTTPException(422, \"Dimensions must be multiples of 32, at most 1,032,192 pixels\")\\\\n            frames = 5 + 17 * math.ceil((round(seconds * 24) - 5) / 17)\\\\n            if frames > 360:\\\\n                raise HTTPException(422, \"Requested duration rounds beyond 15 seconds; use at most 14.375 seconds\")\\\\n            try:\\\\n                modalities = json.loads(kinds)\\\\n            except (ValueError, TypeError):\\\\n                raise HTTPException(422, \"kinds must be a JSON array\") from None\\\\n            if not isinstance(modalities, list) or not 1 <= len(files) <= 12 or len(modalities) != len(files):\\\\n                raise HTTPException(422, \"Supply 1-12 files and one kind per file\")\\\\n            if any(not isinstance(kind, str) or kind not in EXTENSIONS for kind in modalities):\\\\n                raise HTTPException(422, \"Kinds must be image, video or audio\")\\\\n            if modalities.count(\"image\") > 9 or modalities.count(\"video\") > 3 or modalities.count(\"audio\") > 3:\\\\n                raise HTTPException(422, \"At most 9 images, 3 videos and 3 audio references\")\\\\n            if all(kind == \"audio\" for kind in modalities):\\\\n                raise HTTPException(422, \"At least one image or video reference is required\")\\\\n            for upload, kind in zip(files, modalities):\\\\n                if Path(upload.filename or \"\").suffix.lower() not in EXTENSIONS[kind]:\\\\n                    raise HTTPException(422, f\"Unsupported {kind} file extension\")\\\\n            reserved = await asyncio.to_thread(acquire_upload)\\\\n            if not reserved:\\\\n                raise HTTPException(429, \"Concurrent upload limit reached; retry after uploads finish\", headers={\"Retry-After\": \"5\"})\\\\n            job_id = uuid.uuid4().hex\\\\n            directory = root / job_id\\\\n            input_dir = directory / \"inputs\"\\\\n            input_dir.mkdir(parents=True, exist_ok=False)\\\\n            references, content_identity, total = [], [], 0\\\\n            for index, (upload, kind) in enumerate(zip(files, modalities)):\\\\n                suffix = Path(upload.filename or \"\").suffix.lower()\\\\n                path = input_dir / f\"{index:02d}{suffix}\"\\\\n                size, digest = 0, hashlib.sha256()\\\\n                with path.open(\"xb\") as destination:\\\\n                    while chunk := await upload.read(MIB):\\\\n                        size += len(chunk)\\\\n                        total += len(chunk)\\\\n                        if size > MAX_FILE_BYTES or total > MAX_TOTAL_BYTES:\\\\n                            raise HTTPException(413, \"Each reference <=32 MiB; total references <=64 MiB\")\\\\n                        digest.update(chunk)\\\\n                        await asyncio.to_thread(destination.write, chunk)\\\\n                if not size:\\\\n                    raise HTTPException(422, \"Reference file is empty\")\\\\n                references.append({\"kind\": kind, \"path\": str(path)})\\\\n                content_identity.append({\"kind\": kind, \"sha256\": digest.hexdigest(), \"bytes\": size})\\\\n            parameters = dict(prompt=prompt, references=references, seconds=seconds,\\\\n                              width=width, height=height, steps=steps, seed=seed,\\\\n                              attention_backend=attention_backend, acceleration_lora=acceleration_lora)\\\\n            semantic_request = {**parameters, \"references\": content_identity}\\\\n            fingerprint = hashlib.sha256(json.dumps(semantic_request, sort_keys=True,\\\\n                                                    separators=(\",\", \":\"), allow_nan=False).encode()).hexdigest()\\\\n            payload = {\"job_id\": job_id, \"parameters\": parameters, \"fingerprint\": fingerprint,\\\\n                       \"idempotency_key\": idempotency_key or job_id}\\\\n            def uncertain_submission():\\\\n                marker = {\"job_id\": job_id, \"idempotency_key\": payload[\"idempotency_key\"],\\\\n                          \"fingerprint\": fingerprint, \"state\": \"submission_outcome_unknown\"}\\\\n                (directory / \"submission-uncertain.json\").write_text(json.dumps(marker), encoding=\"utf-8\")\\\\n                return HTTPException(503, {\"message\": \"Submission outcome unknown; query this job before retrying\",\\\\n                                          \"job_id\": job_id, \"status_url\": f\"/v1/jobs/{job_id}\",\\\\n                                          \"idempotency_key\": payload[\"idempotency_key\"]})\\\\n\\\\n            retain_inputs = True  # A dispatched command may commit before its response arrives.\\\\n            try:\\\\n                record = await asyncio.to_thread(call, \"submit\", payload)\\\\n            except HTTPException as error:\\\\n                if error.status_code < 500 or error.status_code == 507:\\\\n                    retain_inputs = False\\\\n                    raise\\\\n                # A dropped response does not prove the durable command failed.\\\\n                # Query the identity just sent. Preserve inputs if still unknown.\\\\n                retain_inputs = True\\\\n                try:\\\\n                    record = await asyncio.to_thread(call, \"job\", {\"job_id\": job_id})\\\\n                except HTTPException:\\\\n                    raise uncertain_submission() from None\\\\n            try:\\\\n                result = public_job(record)\\\\n            except HTTPException:\\\\n                raise uncertain_submission() from None\\\\n            retain_inputs = result[\"id\"] == job_id\\\\n            result.setdefault(\"actual_seconds\", frames / 24)\\\\n            return result\\\\n        except OSError as error:\\\\n            if error.errno in {errno.ENOSPC, errno.EDQUOT} and not retain_inputs:\\\\n                raise HTTPException(507, \"Insufficient disk space for reference upload\") from None\\\\n            raise\\\\n        finally:\\\\n            for upload in files:\\\\n                await upload.close()\\\\n            if directory is not None and not retain_inputs:\\\\n                await asyncio.to_thread(shutil.rmtree, directory, ignore_errors=True)\\\\n            if reserved:\\\\n                release_upload()\\\\n\\\\n    def get_record(job_id):\\\\n        valid_id(job_id)\\\\n        record = call(\"job\", {\"job_id\": job_id})\\\\n        if record.get(\"id\", record.get(\"job_id\")) != job_id:\\\\n            raise HTTPException(503, \"Manager returned a different task identity\")\\\\n        # A durable manager record resolves this upload\\\\\\'s uncertain delivery;\\\\n        # only the transport marker is removed, never manager-owned inputs.\\\\n        directory = root / job_id\\\\n        if not directory.is_symlink():\\\\n            try:\\\\n                (directory / \"submission-uncertain.json\").unlink(missing_ok=True)\\\\n            except OSError:\\\\n                LOG.warning(\"Could not remove resolved upload marker\")\\\\n        return record\\\\n\\\\n    @app.get(\"/v1/jobs/{job_id}\", dependencies=[Depends(require_auth)])\\\\n    def status(job_id: str):\\\\n        return public_job(get_record(job_id))\\\\n\\\\n    @app.post(\"/v1/jobs/{job_id}/cancel\", status_code=202, dependencies=[Depends(require_auth)])\\\\n    def cancel(job_id: str):\\\\n        valid_id(job_id)\\\\n        record = call(\"cancel\", {\"job_id\": job_id})\\\\n        if record.get(\"id\", record.get(\"job_id\")) != job_id:\\\\n            raise HTTPException(503, \"Manager returned a different task identity\")\\\\n        return public_job(record)\\\\n\\\\n    @app.post(\"/v1/jobs/{job_id}/drive-archive\", dependencies=[Depends(require_auth)])\\\\n    def register_drive_archive(job_id: str, receipt: DriveArchiveReceipt):\\\\n        \"\"\"Record the authenticated owner\\\\\\'s receipt after external upload and readback.\"\"\"\\\\n        valid_id(job_id)\\\\n        record = call(\"archive\", {\"job_id\": job_id, **receipt.model_dump()})\\\\n        if record.get(\"id\", record.get(\"job_id\")) != job_id:\\\\n            raise HTTPException(503, \"Manager returned a different task identity\")\\\\n        return public_job(record)\\\\n\\\\n    @app.get(\"/v1/jobs/{job_id}/file\", dependencies=[Depends(require_auth)])\\\\n    def download(job_id: str):\\\\n        record = get_record(job_id)\\\\n        if record.get(\"status\") != \"succeeded\":\\\\n            raise HTTPException(409, \"Video is not ready\")\\\\n        artifact = record.get(\"artifact\")\\\\n        if not isinstance(artifact, dict) or not isinstance(artifact.get(\"path\"), str):\\\\n            raise HTTPException(409, \"No verified artifact is published\")\\\\n        expected = root / job_id / \"result.mp4\"\\\\n        candidate = Path(artifact[\"path\"])\\\\n        # The manager chooses output identity; even a malformed/stale response\\\\n        # must not let this public adapter serve arbitrary local files.\\\\n        if candidate != expected or candidate.is_symlink() or expected.parent.is_symlink():\\\\n            raise HTTPException(409, \"Artifact ownership does not match the task\")\\\\n        try:\\\\n            if candidate.resolve() != expected or not candidate.is_file():\\\\n                raise HTTPException(404, \"Result was removed\")\\\\n            size = candidate.stat().st_size\\\\n            if not size or artifact.get(\"bytes\") != size:\\\\n                raise HTTPException(409, \"Artifact size no longer matches its committed manifest\")\\\\n            digest = hashlib.sha256()\\\\n            with candidate.open(\"rb\") as source:\\\\n                for chunk in iter(lambda: source.read(MIB), b\"\"):\\\\n                    digest.update(chunk)\\\\n            committed_hash = artifact.get(\"sha256\")\\\\n            if (not isinstance(committed_hash, str) or not re.fullmatch(r\"[a-f0-9]{64}\", committed_hash)\\\\n                    or not hmac.compare_digest(digest.hexdigest(), committed_hash)):\\\\n                raise HTTPException(409, \"Artifact content no longer matches its committed manifest\")\\\\n        except OSError:\\\\n            raise HTTPException(404, \"Result was removed or cannot be read\") from None\\\\n        return FileResponse(candidate, media_type=\"video/mp4\", filename=f\"{job_id}.mp4\",\\\\n                            headers={\"ETag\": \\\\\\'\"\\\\\\' + digest.hexdigest() + \\\\\\'\"\\\\\\',\\\\n                                     \"Cache-Control\": \"private, no-store\"})\\\\n\\\\n    return app\\\\n\\', \\'model_backend.py\\': \\'\"\"\"Real MiniMax-H3 ref2va inference. No synthetic output or mock fallback.\"\"\"\\\\nfrom __future__ import annotations\\\\n\\\\nimport gc\\\\nimport json\\\\nimport math\\\\nimport os\\\\nfrom pathlib import Path\\\\nimport subprocess\\\\nfrom runtime_options import configure_qwen_offload, measured_load\\\\nfrom pipeline_backend import PipelineBackendSupport\\\\nfrom adapter_config import load_adapter_settings, configure_pipeline, apply_adapters, validate_steps\\\\nfrom download_progress import tracked_model_load\\\\n\\\\nMODEL_ID = \"MiniMaxAI/MiniMax-H3\"\\\\nMODEL_REVISION = \"0919fb684102ef115126612f3fbb84d1027e7317\"\\\\n\\\\n\\\\ndef _require_loaded_components(pipe) -> None:\\\\n    \"\"\"Diffusers may log component-load failures without propagating them.\"\"\"\\\\n    required = [spec.name for spec in pipe.blocks.expected_components]\\\\n    if not required:\\\\n        raise RuntimeError(\"Ref2VA workflow declared no required components.\")\\\\n    missing = [name for name in required if getattr(pipe, name, None) is None]\\\\n    if missing:\\\\n        raise RuntimeError(\\\\n            \"MiniMax-H3 component loading was incomplete: \" + \", \".join(missing)\\\\n            + \". Inspect the component loading errors above; API readiness is blocked.\"\\\\n        )\\\\n\\\\n\\\\ndef _parameter_kept_in_fp32(parameter_name, keep_fp32) -> bool:\\\\n    \"\"\"Mirror Diffusers 0.43 load_model_dict_into_meta\\\\\\'s exact path segments.\\\\n\\\\n    Its dtype/device-map helpers use looser substring checks, but they do not\\\\n    define the dtype assigned by the actual weight loader. In particular,\\\\n    ``quant_conv`` must not match ``post_quant_conv``.\\\\n    \"\"\"\\\\n    if isinstance(keep_fp32, str):\\\\n        keep_fp32 = [keep_fp32]\\\\n    return any(part in parameter_name.split(\".\") for part in (keep_fp32 or []))\\\\n\\\\n\\\\ndef _audit_parameter_precision(pipe) -> dict:\\\\n    \"\"\"Inspect loaded parameter metadata, without copying weights or buffers.\\\\n\\\\n    Each official component owns its FP32 exceptions. In particular, MiniMax\\\\\\'s\\\\n    audio VAE keeps its weights in FP32 even when the pipeline requests BF16.\\\\n    Match the actual loader\\\\\\'s complete dotted-path segments, not substrings.\\\\n    \"\"\"\\\\n    from collections import Counter\\\\n    import torch\\\\n\\\\n    components = {}\\\\n    for spec in pipe.blocks.expected_components:\\\\n        name = spec.name\\\\n        module = getattr(pipe, name, None)\\\\n        if not callable(getattr(module, \"named_parameters\", None)):\\\\n            continue  # tokenizers, schedulers and processors have no weights\\\\n        if (any(getattr(module, flag, False) for flag in\\\\n                (\"is_quantized\", \"is_loaded_in_4bit\", \"is_loaded_in_8bit\"))\\\\n                or getattr(module, \"hf_quantizer\", None) is not None):\\\\n            raise RuntimeError(f\"Quantized component is forbidden: {name}\")\\\\n        keep_fp32 = getattr(module, \"_keep_in_fp32_modules\", None) or []\\\\n        if isinstance(keep_fp32, str):\\\\n            keep_fp32 = [keep_fp32]\\\\n        counts, tensors = Counter(), Counter()\\\\n        for parameter_name, parameter in module.named_parameters():\\\\n            full_name = f\"{name}.{parameter_name}\"\\\\n            # Quantized tensor subclasses may report their compute dtype as\\\\n            # BF16. The native loader uses ordinary nn.Parameter objects.\\\\n            if type(parameter) is not torch.nn.Parameter or getattr(parameter, \"is_quantized\", False):\\\\n                raise RuntimeError(f\"Non-native or quantized parameter is forbidden: {full_name}\")\\\\n            if getattr(parameter, \"is_meta\", False):\\\\n                raise RuntimeError(f\"Parameter was not materialized: {full_name}\")\\\\n            expected = torch.float32 if _parameter_kept_in_fp32(parameter_name, keep_fp32) else torch.bfloat16\\\\n            if parameter.dtype != expected:\\\\n                raise RuntimeError(\\\\n                    f\"Unexpected precision in {full_name}: {parameter.dtype}, expected {expected}\"\\\\n                )\\\\n            dtype = str(parameter.dtype)\\\\n            counts[dtype] += parameter.numel()\\\\n            tensors[dtype] += 1\\\\n        if not tensors:\\\\n            raise RuntimeError(f\"No loaded parameters available for precision audit: {name}\")\\\\n        record = {\"component\": name, \"status\": \"passed\", \"parameter_counts\": dict(counts),\\\\n                  \"tensor_counts\": dict(tensors), \"keep_in_fp32_modules\": list(keep_fp32)}\\\\n        components[name] = record\\\\n        print(\"H3_PRECISION_AUDIT \" + json.dumps(record, sort_keys=True), flush=True)\\\\n    if not components:\\\\n        raise RuntimeError(\"No model components available for precision audit\")\\\\n    report = {\"status\": \"passed\", \"scope\": \"loaded_parameters_only\", \"components\": components}\\\\n    print(\"H3_PRECISION_AUDIT \" + json.dumps(\\\\n        {\"status\": \"passed\", \"scope\": report[\"scope\"], \"components\": list(components)}, sort_keys=True\\\\n    ), flush=True)\\\\n    return report\\\\n\\\\n\\\\ndef aligned_frames(seconds: float) -> int:\\\\n    frames = 5 + 17 * math.ceil((round(seconds * 24) - 5) / 17)\\\\n    if not 5 <= seconds <= 15 or not 120 <= frames <= 360:\\\\n        raise ValueError(\"Duration must align to 17*n+5 frames within 5–15s; maximum request is 14.375s.\")\\\\n    return frames\\\\n\\\\n\\\\ndef _probe(path: Path, kind: str) -> float:\\\\n    \"\"\"Reject oversized media before loading all decoded frames into host RAM.\"\"\"\\\\n    if kind == \"image\":\\\\n        from PIL import Image\\\\n        with Image.open(path) as im:\\\\n            if im.width * im.height > 16_000_000 or getattr(im, \"n_frames\", 1) != 1:\\\\n                raise ValueError(\"Reference images must be static and at most 16 megapixels.\")\\\\n            if not .25 <= im.width / im.height <= 4:\\\\n                raise ValueError(\"Reference image aspect ratio must be between 1:4 and 4:1.\")\\\\n            im.verify()\\\\n        return 0\\\\n    process = subprocess.run(\\\\n        [\"ffprobe\", \"-v\", \"error\", \"-threads\", \"1\", \"-show_format\", \"-show_streams\", \"-of\", \"json\", str(path)],\\\\n        capture_output=True, text=True, timeout=30, check=True,\\\\n    )\\\\n    info = json.loads(process.stdout)\\\\n    streams = info.get(\"streams\", [])\\\\n    wanted = [s for s in streams if s.get(\"codec_type\") == kind]\\\\n    if not wanted:\\\\n        raise ValueError(f\"No {kind} stream in reference file.\")\\\\n    stream = wanted[0]\\\\n    duration = float(stream.get(\"duration\") or info.get(\"format\", {}).get(\"duration\") or 0)\\\\n    if not math.isfinite(duration) or not 2 <= duration <= 15:\\\\n        raise ValueError(f\"Reference {kind} duration must be known and between 2 and 15s.\")\\\\n    if kind == \"video\":\\\\n        from fractions import Fraction\\\\n        rate = float(Fraction(stream.get(\"avg_frame_rate\", \"0\")))\\\\n        if not 0 < rate <= 60 or stream.get(\"width\", 0) * stream.get(\"height\", 0) > 1920 * 1080:\\\\n            raise ValueError(\"Reference video must be at most 1080p / 60 fps.\")\\\\n    for audio in (s for s in streams if s.get(\"codec_type\") == \"audio\"):\\\\n        if int(audio.get(\"sample_rate\", 0)) > 96000 or int(audio.get(\"channels\", 0)) > 2:\\\\n            raise ValueError(\"Reference audio must be mono/stereo and at most 96 kHz.\")\\\\n    return duration\\\\n\\\\n\\\\ndef _normalize_video(path: Path, target: Path | None = None) -> Path:\\\\n    # Bound decoded memory before MiniMaxH3VideoReference.from_file stacks all frames.\\\\n    target = target or path.with_name(path.stem + \"_24fps.mp4\")\\\\n    subprocess.run([\\\\n        \"ffmpeg\", \"-nostdin\", \"-y\", \"-v\", \"error\", \"-threads\", \"1\", \"-filter_threads\", \"1\", \"-i\", str(path),\\\\n        \"-map\", \"0:v:0\", \"-map\", \"0:a:0?\", \"-t\", \"15\",\\\\n        \"-vf\", \"scale=960:544:force_original_aspect_ratio=decrease:force_divisible_by=2,fps=24\",\\\\n        \"-c:v\", \"libx264\", \"-crf\", \"18\", \"-preset\", \"fast\", \"-pix_fmt\", \"yuv420p\",\\\\n        \"-c:a\", \"aac\", \"-ac\", \"2\", \"-ar\", \"32000\", \"-threads\", \"1\", str(target),\\\\n    ], check=True, capture_output=True, timeout=180)\\\\n    return target\\\\n\\\\n\\\\nclass MiniMaxBackend(PipelineBackendSupport):\\\\n    _reference_probe = staticmethod(_probe)\\\\n    _normalize_reference = staticmethod(_normalize_video)\\\\n    _aligned_frames = staticmethod(aligned_frames)\\\\n\\\\n    def __init__(self, runtime_options=None):\\\\n        self._init_runtime(runtime_options)\\\\n        self.adapter_settings = load_adapter_settings()\\\\n        self.pipe = None\\\\n        self.precision_audit = None\\\\n\\\\n    @measured_load\\\\n    @tracked_model_load\\\\n    def load(self) -> None:\\\\n        self.precision_audit = None\\\\n        from preflight import check_resources\\\\n        resources = check_resources()\\\\n        import torch\\\\n        from diffusers import ComponentsManager, ModularPipeline\\\\n\\\\n        if not torch.cuda.is_available() or not torch.cuda.is_bf16_supported():\\\\n            raise RuntimeError(\"A CUDA GPU with native BF16 support is required.\")\\\\n        revision = os.environ.get(\"H3_MODEL_REVISION\", MODEL_REVISION)\\\\n        torch.backends.cuda.matmul.allow_tf32 = True\\\\n        strategy = resources[\"strategy\"]\\\\n        print(f\"A100 inference: native BF16; memory strategy={strategy}\", flush=True)\\\\n        if strategy == \"component_cpu_offload\":\\\\n            if self.runtime_options.denoiser_offload != \"stream\":\\\\n                raise ValueError(\"H3_DENOISER_OFFLOAD=sync applies only to group offload; this profile uses component offload.\")\\\\n            manager = ComponentsManager()\\\\n            pipe = ModularPipeline.from_pretrained(\\\\n                MODEL_ID, revision=revision, workflow=\"ref2va\", components_manager=manager,\\\\n            )\\\\n            configure_pipeline(pipe, self.adapter_settings)\\\\n            with self._stage(\"load.components\"):\\\\n                pipe.load_components(dtype=torch.bfloat16, revision=revision)\\\\n            _require_loaded_components(pipe)\\\\n            with self._stage(\"configure.adapters\"):\\\\n                apply_adapters(pipe, self.adapter_settings)\\\\n            with self._stage(\"audit.parameter_precision\"):\\\\n                self.precision_audit = _audit_parameter_precision(pipe)\\\\n            self.runtime_options.configure_attention(pipe.transformer_ref)\\\\n            manager.enable_auto_cpu_offload(device=\"cuda\", memory_reserve_margin=\"12GB\")\\\\n        elif strategy == \"group_cpu_offload\":\\\\n            pipe = ModularPipeline.from_pretrained(MODEL_ID, revision=revision, workflow=\"ref2va\")\\\\n            configure_pipeline(pipe, self.adapter_settings)\\\\n            with self._stage(\"load.components\"):\\\\n                pipe.load_components(dtype=torch.bfloat16, revision=revision)\\\\n            _require_loaded_components(pipe)\\\\n            pipe.transformer_ref.requires_grad_(False)\\\\n            with self._stage(\"configure.adapters\"):\\\\n                apply_adapters(pipe, self.adapter_settings)\\\\n            with self._stage(\"audit.parameter_precision\"):\\\\n                self.precision_audit = _audit_parameter_precision(pipe)\\\\n            self.runtime_options.configure_attention(pipe.transformer_ref)\\\\n            pipe.transformer_ref.enable_group_offload(**self.runtime_options.group_offload_kwargs(torch))\\\\n            configure_qwen_offload(pipe.text_encoder)\\\\n            # A100 40GB cannot hold the 61.7GB BF16 denoiser as one component.\\\\n            # Stream BF16 blocks without quantization; PCIe bandwidth affects speed.\\\\n            pipe.vae.to(\"cuda\")\\\\n            pipe.audio_vae.to(\"cuda\")\\\\n        else:\\\\n            raise ValueError(f\"Unsupported A100 memory strategy: {strategy}\")\\\\n        self.pipe = pipe\\\\n\\\\n    def validate_request(self, *, steps, attention_backend=None, acceleration_lora=None):\\\\n        return self.validate_generation_request(steps=steps, attention_backend=attention_backend,\\\\n                                                acceleration_lora=acceleration_lora)\\\\n\\\\n    def _infer_raw(self, prepared):\\\\n        \"\"\"The original BF16 workflow stays wholly inside the exclusive GPU stage.\"\"\"\\\\n        if self.pipe is None:\\\\n            raise RuntimeError(\"The model has not loaded.\")\\\\n        import torch\\\\n        p = prepared.parameters\\\\n        return self.pipe(\\\\n            prompt=p[\"prompt\"], references=prepared.references, num_frames=aligned_frames(p[\"seconds\"]),\\\\n            height=p[\"height\"], width=p[\"width\"], num_inference_steps=p[\"steps\"],\\\\n            generator=torch.Generator(device=\"cpu\").manual_seed(p[\"seed\"]),\\\\n            output_type=\"pil\", output=[\"videos\", \"audio\", \"sampling_rate\"],\\\\n        )\\\\n\\', \\'staged_backend.py\\': \\'\"\"\"Sequential component residency: single-image A100 40GB acceptance passed.\\\\n\\\\nVerified on Colab A100 40GB with about 83.47 GiB host RAM: public submission,\\\\npolling, generation, download, and full audiovisual decode. The 512x288 test\\\\nused one image, a 5s request/124 output frames, and 8 steps (7 denoising rounds).\\\\nThe backbone stays BF16 while official _keep_in_fp32_modules layers remain FP32.\\\\nNo quantization or fake output exists. This is an integration test, not a\\\\nquality benchmark or acceptance of video/audio reference combinations.\\\\nOptional runtime modes, adapters, and media scheduling added afterward have not\\\\nbeen GPU-retested; their defaults preserve the accepted inference choices.\\\\n\\\\nTested with Python 3.13.16, PyTorch 2.14.1+cu130, Diffusers 0.43.0, and\\\\nTransformers 5.7.0. The separately pinned PyTorch 2.10 install has not been\\\\nGPU-tested. A100 80GB resident acceptance is recorded separately in README.md;\\\\nit does not establish acceptance of this refactored staged pipeline.\\\\n\"\"\"\\\\nfrom __future__ import annotations\\\\n\\\\nimport gc\\\\nimport os\\\\nfrom pathlib import Path\\\\nimport time\\\\n\\\\nfrom model_backend import MODEL_ID, MODEL_REVISION, _normalize_video, _probe, aligned_frames, _parameter_kept_in_fp32, _audit_parameter_precision\\\\nfrom runtime_options import configure_qwen_offload, measured_load\\\\nfrom pipeline_backend import PipelineBackendSupport, GIB\\\\nfrom adapter_config import load_adapter_settings, configure_pipeline, apply_adapters, validate_steps\\\\nfrom download_progress import tracked_model_load\\\\n\\\\n\\\\nclass StagedMiniMaxBackend(PipelineBackendSupport):\\\\n    \"\"\"Exclusive GPU inference; Qwen and transformer_ref never co-reside.\"\"\"\\\\n    pipeline_model_peak_ram_bytes = 76 * GIB\\\\n    resource_residency = \"staged\"\\\\n    _reference_probe = staticmethod(_probe)\\\\n    _normalize_reference = staticmethod(_normalize_video)\\\\n    _aligned_frames = staticmethod(aligned_frames)\\\\n\\\\n    def __init__(self, runtime_options=None):\\\\n        self._init_runtime(runtime_options)\\\\n        self.adapter_settings = load_adapter_settings()\\\\n        self.pipe = None\\\\n        self.revision = os.environ.get(\"H3_MODEL_REVISION\", MODEL_REVISION)\\\\n        self._phase = None\\\\n        self.precision_audit = None\\\\n\\\\n    @staticmethod\\\\n    def _log(message):\\\\n        print(f\"[{time.strftime(\\\\\\'%H:%M:%S\\\\\\')}] BF16 staged: {message}\", flush=True)\\\\n\\\\n    def _load_required(self, names):\\\\n        import torch\\\\n        # Diffusers 0.43 load_components logs some failures instead of raising.\\\\n        # Load individually to avoid its temporary dict retaining multiple newly\\\\n        # loaded components before registering them.\\\\n        for name in names:\\\\n            if getattr(self.pipe, name, None) is None:\\\\n                self._log(f\"loading {name}\")\\\\n                with self._stage(f\"load.{name}\"):\\\\n                    self.pipe.load_components(names=name, dtype=torch.bfloat16, revision=self.revision)\\\\n            if getattr(self.pipe, name, None) is None:\\\\n                raise RuntimeError(f\"Required MiniMax-H3 component failed to load: {name}\")\\\\n            if name in {\"text_encoder\", \"transformer_ref\"}:\\\\n                from collections import Counter\\\\n                module = getattr(self.pipe, name)\\\\n                keep_fp32 = getattr(module, \"_keep_in_fp32_modules\", []) or []\\\\n                counts = Counter()\\\\n                for parameter_name, parameter in module.named_parameters():\\\\n                    counts[str(parameter.dtype)] += parameter.numel()\\\\n                    expected = torch.float32 if _parameter_kept_in_fp32(parameter_name, keep_fp32) else torch.bfloat16\\\\n                    if parameter.dtype != expected:\\\\n                        raise RuntimeError(f\"Unexpected precision in {name}.{parameter_name}: {parameter.dtype}, expected {expected}\")\\\\n                self._log(f\"{name} original precision verified, parameter counts={dict(counts)}\")\\\\n\\\\n    def _switch(self, target):\\\\n        if self._phase != target:\\\\n            with self._stage(f\"switch.{target}\"):\\\\n                self._switch_impl(target)\\\\n\\\\n    def _switch_impl(self, target):\\\\n        import torch\\\\n        other = \"text_encoder\" if target == \"denoise\" else \"transformer_ref\"\\\\n        self._phase = None  # a failed load must never leave a stale ready phase\\\\n        self._log(f\"unloading {other} before {target}\")\\\\n        self.pipe.unload_components(other)\\\\n        gc.collect()\\\\n        torch.cuda.empty_cache()\\\\n        if target == \"encode\":\\\\n            self._load_required([\"text_encoder\"])\\\\n            configure_qwen_offload(self.pipe.text_encoder)\\\\n            self._log(\"Qwen vision/embeddings/rotary on CUDA; decoder layers offloaded as whole BF16 blocks\")\\\\n        else:\\\\n            self._load_required([\"transformer_ref\"])\\\\n            self.pipe.transformer_ref.requires_grad_(False)\\\\n            with self._stage(\"configure.adapters\"):\\\\n                apply_adapters(self.pipe, self.adapter_settings)\\\\n            self.precision_audit = _audit_parameter_precision(self.pipe)\\\\n            self.runtime_options.configure_attention(self.pipe.transformer_ref)\\\\n            selected = getattr(self, \"_active_generation_options\", None)\\\\n            if selected is not None:\\\\n                self._apply_generation_transformer(selected)\\\\n            self.pipe.transformer_ref.enable_group_offload(**self.runtime_options.group_offload_kwargs(torch))\\\\n            self._log(f\"denoiser offload={self.runtime_options.denoiser_offload}; attention={self.runtime_options.attention_backend}\")\\\\n        self._phase = target\\\\n        self._log(f\"{target} stage loaded; other large component released\")\\\\n\\\\n    @measured_load\\\\n    @tracked_model_load\\\\n    def load(self):\\\\n        import torch\\\\n        from diffusers import ModularPipeline\\\\n        if not torch.cuda.is_available() or not torch.cuda.is_bf16_supported():\\\\n            raise RuntimeError(\"Native-BF16 CUDA device is required\")\\\\n        if \"A100\" not in torch.cuda.get_device_name(0).upper():\\\\n            raise RuntimeError(\"This acceptance build targets an NVIDIA A100\")\\\\n        import psutil, shutil\\\\n        if psutil.virtual_memory().available < 70 * 1024**3:\\\\n            raise RuntimeError(\"Staged BF16 requires at least 70 GiB available host RAM before loading\")\\\\n        if torch.cuda.get_device_properties(0).total_memory < 38 * 1024**3:\\\\n            raise RuntimeError(\"Staged BF16 requires an A100 40 GB or larger\")\\\\n        cache = Path(os.environ.get(\"HF_HOME\", \"~/.cache/huggingface\")).expanduser()\\\\n        cache.mkdir(parents=True, exist_ok=True)\\\\n        if shutil.disk_usage(cache).free < 140 * 1024**3 and os.environ.get(\"H3_SKIP_DISK_CHECK\") != \"1\":\\\\n            raise RuntimeError(\"Staged BF16 needs 140 GiB free cache disk on the first download\")\\\\n        self.pipe = ModularPipeline.from_pretrained(\\\\n            MODEL_ID, revision=self.revision, workflow=\"ref2va\",\\\\n        )\\\\n        configure_pipeline(self.pipe, self.adapter_settings)\\\\n        names = list(self.pipe.blocks.sub_blocks)\\\\n        if names[:3] != [\"before_encode\", \"text_encoder\", \"vae_encoder\"]:\\\\n            raise RuntimeError(f\"Unexpected Ref2VA block topology: {names}\")\\\\n        if not any(name.startswith(\"denoise.\") for name in names) or not any(name.startswith(\"decode.\") for name in names):\\\\n            raise RuntimeError(f\"Unexpected Ref2VA block topology: {names}\")\\\\n        self._load_required([\"tokenizer\", \"processor\", \"scheduler\", \"audio_scheduler\", \"vae\", \"audio_vae\"])\\\\n        self.pipe.vae.requires_grad_(False).to(\"cuda\")\\\\n        self.pipe.audio_vae.requires_grad_(False).to(\"cuda\")\\\\n        # Actually load both large components during startup, one at a time. This\\\\n        # also downloads all required weights before the API advertises readiness.\\\\n        self._switch(\"denoise\")\\\\n        self._switch(\"encode\")\\\\n        self._log(\"both large components loaded successfully in turn; encoder stage ready\")\\\\n\\\\n    @staticmethod\\\\n    def _cpu(value):\\\\n        import torch\\\\n        if isinstance(value, torch.Tensor):\\\\n            return value.detach().cpu()\\\\n        if isinstance(value, list):\\\\n            return [StagedMiniMaxBackend._cpu(item) for item in value]\\\\n        if isinstance(value, tuple):\\\\n            return tuple(StagedMiniMaxBackend._cpu(item) for item in value)\\\\n        if isinstance(value, dict):\\\\n            return {key: StagedMiniMaxBackend._cpu(item) for key, item in value.items()}\\\\n        return value\\\\n\\\\n    def _run(self, state, stage):\\\\n        import torch\\\\n        # The resolved workflow has flat leaf keys: before_encode, text_encoder,\\\\n        # vae_encoder, denoise.prepare_layout ... denoise.after_denoise,\\\\n        # decode.video, decode.audio. Calling the documented block contract\\\\n        # (components, PipelineState) avoids a deepcopy of large reference media.\\\\n        with torch.inference_mode():\\\\n            for name, block in self.pipe.blocks.sub_blocks.items():\\\\n                selected = name in {\"before_encode\", \"text_encoder\", \"vae_encoder\"} if stage == \"encode\" else name.startswith(stage + \".\")\\\\n                if selected:\\\\n                    self._log(f\"running {name}\")\\\\n                    with self._stage(f\"block.{name}\"):\\\\n                        _, state = block(self.pipe, state)\\\\n        return state\\\\n\\\\n    def validate_request(self, *, steps, attention_backend=None, acceleration_lora=None):\\\\n        return self.validate_generation_request(steps=steps, attention_backend=attention_backend,\\\\n                                                acceleration_lora=acceleration_lora)\\\\n\\\\n    def _infer_raw(self, prepared):\\\\n        \"\"\"All staged model swapping, text/VAE encode, denoise and decode use GPU lease.\"\"\"\\\\n        import torch\\\\n        from diffusers.modular_pipelines.modular_pipeline import PipelineState\\\\n        if self.pipe is None:\\\\n            raise RuntimeError(\"Backend has not loaded\")\\\\n        p = prepared.parameters\\\\n        state = None\\\\n        try:\\\\n            self._switch(\"encode\")\\\\n            state = PipelineState(values={\\\\n                \"prompt\": p[\"prompt\"], \"references\": prepared.references, \"num_frames\": aligned_frames(p[\"seconds\"]),\\\\n                \"height\": p[\"height\"], \"width\": p[\"width\"], \"num_inference_steps\": p[\"steps\"],\\\\n                \"generator\": torch.Generator(device=\"cpu\").manual_seed(p[\"seed\"]),\\\\n                \"output_type\": \"pil\",\\\\n            })\\\\n            state = self._run(state, \"encode\")\\\\n            # prompt_embeds is the one GPU tensor emitted by the encoder; VAE\\\\n            # conditioning latents already live on CPU. Do not retain CUDA state\\\\n            # while swapping 62GB components; preserve generator state unchanged.\\\\n            state.values = self._cpu(state.values)\\\\n            self._switch(\"denoise\")\\\\n            # The denoiser passes prompt_embeds straight through, unlike layout/\\\\n            # condition latents, which their preparation blocks move to device.\\\\n            state.set(\"prompt_embeds\", state.get(\"prompt_embeds\").to(\"cuda\"))\\\\n            state = self._run(state, \"denoise\")\\\\n            # Free the large denoiser before VAE decode; no longer needed for this\\\\n            # job. Keep the final latents on CUDA for the official decoder blocks.\\\\n            with self._stage(\"unload.transformer_ref\"):\\\\n                self.pipe.unload_components(\"transformer_ref\")\\\\n                self._phase = None\\\\n            state = self._run(state, \"decode\")\\\\n            return {\"videos\": state.get(\"videos\"), \"audio\": state.get(\"audio\"), \"sampling_rate\": state.get(\"sampling_rate\")}\\\\n        finally:\\\\n            state = None\\\\n\\', \\'staged_server.py\\': \\'\"\"\"Compatibility API entry point; staging is chosen by the model container owner.\"\"\"\\\\nfrom server import create_app\\\\n\\\\n\\\\ndef build_app():\\\\n    return create_app()\\\\n\\', \\'smoke_test.py\\': \\'\"\"\"Exercise a REAL running API and verify its downloaded audiovisual MP4.\\\\n\\\\nThis is a low-step integration smoke test, not a generation-quality benchmark.\\\\nIt has no fake backend, synthetic-video fallback, or GPU/model loader.\\\\n\"\"\"\\\\nfrom __future__ import annotations\\\\n\\\\nimport argparse\\\\nfrom contextlib import contextmanager\\\\nfrom datetime import datetime, timezone\\\\nfrom fractions import Fraction\\\\nimport hashlib\\\\nimport json\\\\nimport mimetypes\\\\nimport os\\\\nfrom pathlib import Path\\\\nimport re\\\\nimport shutil\\\\nimport subprocess\\\\nimport time\\\\nimport uuid\\\\nfrom urllib.parse import urlsplit\\\\n\\\\nPARAMETERS = {\\\\n    \"seconds\": 5, \"width\": 512, \"height\": 288, \"steps\": 8, \"seed\": 42,\\\\n}\\\\n\\\\n\\\\ndef utc_now() -> str:\\\\n    return datetime.now(timezone.utc).isoformat()\\\\n\\\\n\\\\ndef require(condition: bool, message: str) -> None:\\\\n    if not condition:\\\\n        raise RuntimeError(message)\\\\n\\\\n\\\\ndef sha256(path: Path) -> str:\\\\n    digest = hashlib.sha256()\\\\n    with path.open(\"rb\") as source:\\\\n        for block in iter(lambda: source.read(1024 * 1024), b\"\"):\\\\n            digest.update(block)\\\\n    return digest.hexdigest()\\\\n\\\\n\\\\ndef save_report(outputdir: Path, report: dict) -> None:\\\\n    \"\"\"Checkpoint the accepted job ID before polling; resuming never resubmits.\"\"\"\\\\n    target = outputdir / \"test_report.json\"\\\\n    temporary = target.with_suffix(\".json.tmp\")\\\\n    temporary.write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding=\"utf-8\")\\\\n    temporary.replace(target)\\\\n\\\\n\\\\n@contextmanager\\\\ndef content_history_lock(path):\\\\n    \"\"\"OS-held writer lock; process exit releases it without stale lock ownership.\"\"\"\\\\n    path.parent.mkdir(parents=True, exist_ok=True)\\\\n    with path.with_suffix(path.suffix + \".lock\").open(\"a+b\") as lock:\\\\n        if os.fstat(lock.fileno()).st_size == 0:\\\\n            lock.write(b\"0\")\\\\n            lock.flush()\\\\n        deadline = time.monotonic() + 5\\\\n        while True:\\\\n            lock.seek(0)\\\\n            try:\\\\n                if os.name == \"nt\":\\\\n                    import msvcrt\\\\n                    msvcrt.locking(lock.fileno(), msvcrt.LK_NBLCK, 1)\\\\n                else:\\\\n                    import fcntl\\\\n                    fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)\\\\n                break\\\\n            except OSError:\\\\n                require(time.monotonic() < deadline, \"Content history is busy; no generation was submitted\")\\\\n                time.sleep(.05)\\\\n        try:\\\\n            yield\\\\n        finally:\\\\n            lock.seek(0)\\\\n            if os.name == \"nt\":\\\\n                msvcrt.locking(lock.fileno(), msvcrt.LK_UNLCK, 1)\\\\n            else:\\\\n                fcntl.flock(lock.fileno(), fcntl.LOCK_UN)\\\\n\\\\n\\\\ndef register_content(path: Path, reference_hash: str, prompt: str, *, outputdir: Path, api_base_url: str) -> dict:\\\\n    \"\"\"Reserve fresh content durably before the one paid submission attempt.\"\"\"\\\\n    canonical = json.dumps({\"reference_sha256\": reference_hash, \"prompt\": prompt.strip()},\\\\n                           sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"))\\\\n    fingerprint = hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()\\\\n    with content_history_lock(path):\\\\n        history = json.loads(path.read_text(encoding=\"utf-8\")) if path.exists() else {\"schema_version\": 1, \"entries\": {}}\\\\n        require(history.get(\"schema_version\") == 1 and isinstance(history.get(\"entries\"), dict),\\\\n                \"Invalid content history; refusing to submit without reliable duplicate detection\")\\\\n        require(fingerprint not in history[\"entries\"],\\\\n                \"Reference and prompt combination was already registered; provide new content or use --resume-job for query/download only\")\\\\n        record = {\"fingerprint\": fingerprint, \"reference_sha256\": reference_hash, \"prompt\": prompt.strip(),\\\\n                  \"registered_at\": utc_now(), \"request_id\": uuid.uuid4().hex,\\\\n                  \"outputdir\": str(outputdir), \"api_base_url\": api_base_url}\\\\n        history[\"entries\"][fingerprint] = record\\\\n        temporary = path.with_name(path.name + \".\" + uuid.uuid4().hex + \".tmp\")\\\\n        try:\\\\n            with temporary.open(\"x\", encoding=\"utf-8\") as output:\\\\n                json.dump(history, output, ensure_ascii=False, indent=2)\\\\n                output.flush()\\\\n                os.fsync(output.fileno())\\\\n            temporary.replace(path)\\\\n            if os.name != \"nt\":\\\\n                descriptor = os.open(path.parent, os.O_RDONLY)\\\\n                try:\\\\n                    os.fsync(descriptor)\\\\n                finally:\\\\n                    os.close(descriptor)\\\\n        finally:\\\\n            temporary.unlink(missing_ok=True)\\\\n    return {**record, \"history_path\": str(path)}\\\\n\\\\n\\\\ndef verify_video(path: Path) -> dict:\\\\n    probe = subprocess.run(\\\\n        [\"ffprobe\", \"-v\", \"error\", \"-count_frames\", \"-show_streams\", \"-show_format\", \"-of\", \"json\", str(path)],\\\\n        capture_output=True, text=True, timeout=120, check=True,\\\\n    )\\\\n    media = json.loads(probe.stdout)\\\\n    video = next((s for s in media[\"streams\"] if s[\"codec_type\"] == \"video\"), None)\\\\n    audio = next((s for s in media[\"streams\"] if s[\"codec_type\"] == \"audio\"), None)\\\\n    require(video is not None and audio is not None, \"MP4 must contain both video and audio streams\")\\\\n    frames = int(video.get(\"nb_read_frames\") or video.get(\"nb_frames\") or 0)\\\\n    fps = float(Fraction(video.get(\"avg_frame_rate\", \"0\")))\\\\n    duration = float(video.get(\"duration\") or media[\"format\"][\"duration\"])\\\\n    require(video.get(\"codec_name\") == \"h264\", \"Expected an H.264 video stream\")\\\\n    require(frames >= 120 and 5 <= duration <= 6, \"Expected at least 120 frames and a 5–6 second video\")\\\\n    require(abs(fps - 24) < 0.01, \"Expected 24 fps\")\\\\n    require((video[\"width\"], video[\"height\"]) == (512, 288), \"Unexpected video dimensions\")\\\\n    require(int(audio.get(\"channels\", 0)) == 2, \"Expected stereo generated audio\")\\\\n    subprocess.run(\\\\n        [\"ffmpeg\", \"-nostdin\", \"-v\", \"error\", \"-xerror\", \"-i\", str(path),\\\\n         \"-map\", \"0:v:0\", \"-map\", \"0:a:0\", \"-f\", \"null\", \"-\"],\\\\n        capture_output=True, text=True, timeout=180, check=True,\\\\n    )\\\\n    return {\\\\n        \"video_codec\": video[\"codec_name\"], \"width\": video[\"width\"], \"height\": video[\"height\"],\\\\n        \"decoded_frames\": frames, \"fps\": fps, \"duration_seconds\": duration,\\\\n        \"audio_codec\": audio.get(\"codec_name\"), \"audio_channels\": audio[\"channels\"],\\\\n        \"audio_sample_rate\": audio.get(\"sample_rate\"), \"full_decode_passed\": True,\\\\n        \"bytes\": path.stat().st_size, \"sha256\": sha256(path),\\\\n    }\\\\n\\\\n\\\\ndef run(args, report: dict) -> None:\\\\n    import requests\\\\n\\\\n    reference = None\\\\n    if not args.resume_job:\\\\n        require(bool(getattr(args, \"reference\", None)), \"New generation requires an explicit --reference image\")\\\\n        require(isinstance(getattr(args, \"prompt\", None), str) and bool(args.prompt.strip()),\\\\n                \"New generation requires an explicit nonempty --prompt\")\\\\n        reference = Path(args.reference).resolve()\\\\n        require(reference.is_file(), \"Reference image does not exist\")\\\\n        require(reference.stat().st_size <= 8 * 1024 * 1024, \"Reference image exceeds smoke-test size limit\")\\\\n        from PIL import Image\\\\n        with Image.open(reference) as image:\\\\n            image.verify()\\\\n    parsed = urlsplit(args.url)\\\\n    require(parsed.scheme in {\"https\", \"http\"} and bool(parsed.hostname), \"Provide an HTTP(S) API base URL\")\\\\n    require(not parsed.username and not parsed.password and not parsed.query and not parsed.fragment,\\\\n            \"Do not embed credentials, query parameters or fragments in the API URL\")\\\\n    key = os.environ.get(\"H3_API_KEY\", \"\")\\\\n    require(len(key) >= 32, \"Set H3_API_KEY to the running server\\\\\\'s token\")\\\\n    for command in (\"ffprobe\", \"ffmpeg\"):\\\\n        require(shutil.which(command) is not None, f\"{command} is required before submitting a paid GPU job\")\\\\n    base = args.url.rstrip(\"/\")\\\\n    report[\"api_base_url\"] = base\\\\n    parameters = {**PARAMETERS, \"steps\": args.steps,\\\\n                  \"attention_backend\": getattr(args, \"attention_backend\", \"auto\"),\\\\n                  \"acceleration_lora\": getattr(args, \"acceleration_lora\", \"none\")}\\\\n    require(parameters[\"acceleration_lora\"] == \"none\" or parameters[\"steps\"] == 5,\\\\n            \"Turbo Ref2VA requires explicit --steps 5 (four denoiser evaluations)\")\\\\n    if not args.resume_job:\\\\n        parameters[\"prompt\"] = args.prompt.strip()\\\\n        report[\"parameters\"] = parameters\\\\n    report[\"test_scope\"] = \"real API integration; low-step smoke test, not visual quality acceptance\"\\\\n    headers = {\"Authorization\": f\"Bearer {key}\"}\\\\n    session = requests.Session()\\\\n    started = time.monotonic()\\\\n    deadline = started + args.startup_timeout\\\\n    print(\"Waiting for API and manager availability; model loading may continue while jobs queue...\", flush=True)\\\\n    while True:\\\\n        try:\\\\n            response = session.get(base + \"/health\", timeout=10)\\\\n            health = response.json()\\\\n            if not isinstance(health, dict):\\\\n                raise ValueError(\"Invalid health response\")\\\\n            # New APIs expose admission separately from model execution. A legacy\\\\n            # aggregate ready flag is only a fallback when capability keys are\\\\n            # absent, never an override for an explicitly unavailable API/manager.\\\\n            explicit_capabilities = \"api_ready\" in health or \"manager_ready\" in health\\\\n            admission_ready = response.status_code == 200 and (\\\\n                health.get(\"api_ready\") is True and health.get(\"manager_ready\") is True\\\\n                if explicit_capabilities else health.get(\"ready\") is True)\\\\n            if admission_ready or (args.resume_job and response.status_code in {200, 503}):\\\\n                report[\"health\"] = {\"http_status\": response.status_code,\\\\n                    \"ready\": health.get(\"ready\") is True, \"admission_ready\": admission_ready,\\\\n                    **{name: health.get(name) if type(health.get(name)) is bool else None\\\\n                       for name in (\"api_ready\", \"manager_ready\", \"model_ready\")},\\\\n                    \"observed_at\": utc_now()}\\\\n                break\\\\n        except (requests.RequestException, ValueError):\\\\n            pass\\\\n        require(time.monotonic() < deadline, \"API and manager did not become available before startup timeout\")\\\\n        time.sleep(args.poll_seconds)\\\\n    print(f\"/health: HTTP {report[\\\\\\'health\\\\\\'][\\\\\\'http_status\\\\\\']}, admission_ready={report[\\\\\\'health\\\\\\'][\\\\\\'admission_ready\\\\\\']}, \"\\\\n          f\"ready={report[\\\\\\'health\\\\\\'][\\\\\\'ready\\\\\\']}, model_ready={report[\\\\\\'health\\\\\\'][\\\\\\'model_ready\\\\\\']}\", flush=True)\\\\n\\\\n    if args.resume_job:\\\\n        job_id = args.resume_job\\\\n        report[\"resumed\"] = True\\\\n        report[\"test_scope\"] = \"resume existing job: status/download only; no new content registration or generation request\"\\\\n        print(f\"Resuming status/download for {job_id}; no generation submission\", flush=True)\\\\n    else:\\\\n        response = session.post(base + \"/v1/jobs\", timeout=30)\\\\n        report[\"unauthorized_submit_http_status\"] = response.status_code\\\\n        require(response.status_code in {401, 403}, \"Unauthenticated submission was not rejected\")\\\\n        print(f\"Unauthenticated POST rejected: HTTP {response.status_code}\", flush=True)\\\\n        report[\"reference_sha256\"] = sha256(reference)\\\\n        report[\"reference_source\"] = str(reference)\\\\n        history_path = Path(getattr(args, \"content_history\", None) or args.outputdir.parent / \"content-history.json\").resolve()\\\\n        registration = register_content(history_path, report[\"reference_sha256\"], parameters[\"prompt\"],\\\\n                                        outputdir=args.outputdir, api_base_url=base)\\\\n        report[\"content_registration\"] = registration\\\\n        save_report(args.outputdir, report)\\\\n        with reference.open(\"rb\") as image:\\\\n            require(sha256(reference) == report[\"reference_sha256\"], \"Reference changed after content registration; generation not submitted\")\\\\n            response = session.post(\\\\n                base + \"/v1/jobs\", headers={**headers, \"Idempotency-Key\": registration[\"request_id\"]}, timeout=120,\\\\n                data={**parameters, \"kinds\": json.dumps([\"image\"])},\\\\n                files=[(\"files\", (reference.name, image, mimetypes.guess_type(reference.name)[0] or \"image/jpeg\"))],\\\\n            )\\\\n        report[\"submit_http_status\"] = response.status_code\\\\n        require(response.status_code == 202, f\"Generation submit failed: HTTP {response.status_code}\")\\\\n        task = response.json()\\\\n        job_id = task[\"id\"]\\\\n        report[\"actual_seconds\"] = task.get(\"actual_seconds\")\\\\n        print(f\"Submitted real job {job_id}: HTTP 202\", flush=True)\\\\n    require(re.fullmatch(r\"[a-f0-9]{32}\", job_id) is not None, \"Unexpected job ID format\")\\\\n    report[\"job_id\"] = job_id\\\\n    report.setdefault(\"status_history\", [])\\\\n    save_report(args.outputdir, report)\\\\n\\\\n    deadline = time.monotonic() + args.generation_timeout\\\\n    while True:\\\\n        response = session.get(base + f\"/v1/jobs/{job_id}\", headers=headers, timeout=30)\\\\n        require(response.status_code == 200, f\"Status query failed: HTTP {response.status_code}\")\\\\n        task = response.json()\\\\n        status = task.get(\"status\")\\\\n        if args.resume_job and task.get(\"generation_parameters\"):\\\\n            report[\"parameters\"] = task[\"generation_parameters\"]\\\\n        report[\"status_history\"].append({\"http_status\": response.status_code, \"status\": status,\\\\n                                        \"queue_position\": task.get(\"queue_position\"),\\\\n                                        \"waiting_for\": task.get(\"waiting_for\"),\\\\n                                        \"active_phase\": task.get(\"active_phase\"), \"observed_at\": utc_now()})\\\\n        save_report(args.outputdir, report)\\\\n        print(f\"{utc_now()} GET job: HTTP 200, status={status}, \"\\\\n              f\"queue_position={task.get(\\\\\\'queue_position\\\\\\')}, waiting_for={task.get(\\\\\\'waiting_for\\\\\\')}, \"\\\\n              f\"active_phase={task.get(\\\\\\'active_phase\\\\\\')}\", flush=True)\\\\n        if status in {\"succeeded\", \"failed\", \"cancelled\"}:\\\\n            report[\"terminal_status\"] = status\\\\n            report[\"metrics\"] = task.get(\"metrics\")\\\\n            report[\"lifecycle\"] = task.get(\"lifecycle\")\\\\n            report[\"terminal_error\"] = task.get(\"error\")\\\\n            report[\"cleanup_complete\"] = task.get(\"cleanup_complete\")\\\\n            break\\\\n        require(status in {\"queued\", \"running\", \"cancel_requested\"}, \"Unknown job status\")\\\\n        require(time.monotonic() < deadline, \"Generation timeout; task may still be running on server\")\\\\n        time.sleep(args.poll_seconds)\\\\n    require(status == \"succeeded\", \"Real model generation failed; inspect the server log\")\\\\n\\\\n    output = args.outputdir / f\"{job_id}.mp4\"\\\\n    with session.get(base + f\"/v1/jobs/{job_id}/file\", headers=headers, timeout=120, stream=True) as response:\\\\n        report[\"download_http_status\"] = response.status_code\\\\n        require(response.status_code == 200, f\"Video download failed: HTTP {response.status_code}\")\\\\n        size = 0\\\\n        with output.open(\"wb\") as destination:\\\\n            for chunk in response.iter_content(1024 * 1024):\\\\n                size += len(chunk)\\\\n                require(size <= 128 * 1024 * 1024, \"Smoke-test output unexpectedly exceeds 128 MiB\")\\\\n                destination.write(chunk)\\\\n    report[\"video\"] = verify_video(output)\\\\n    report[\"video_path\"] = str(output.resolve())\\\\n    report[\"elapsed_seconds\"] = round(time.monotonic() - started, 2)\\\\n    report[\"passed\"] = True\\\\n    print(\"API_SMOKE_TEST_PASSED\", flush=True)\\\\n    print(json.dumps(report[\"video\"], indent=2), flush=True)\\\\n    print(f\"VIDEO_PATH={output.resolve()}\", flush=True)\\\\n\\\\n\\\\ndef main() -> None:\\\\n    parser = argparse.ArgumentParser(description=__doc__)\\\\n    parser.add_argument(\"--url\", required=True, help=\"Base URL of an already running real server\")\\\\n    parser.add_argument(\"--reference\", help=\"Required for new generation: explicitly chosen local reference image\")\\\\n    parser.add_argument(\"--prompt\", help=\"Required for new generation: fresh explicit prompt; no automatic default\")\\\\n    parser.add_argument(\"--content-history\", type=Path,\\\\n                        help=\"Shared durable content registry; default OUTPUTDIR.parent/content-history.json\")\\\\n    parser.add_argument(\"--steps\", type=int, choices=range(2, 51), default=8,\\\\n                        help=\"Scheduler grid points; Turbo Ref2VA requires 5 for four evaluations\")\\\\n    parser.add_argument(\"--attention-backend\", choices=(\"auto\", \"native\", \"_native_flash\"), default=\"auto\")\\\\n    parser.add_argument(\"--acceleration-lora\", choices=(\"none\", \"lightx2v-ref2va-4step\"), default=\"none\")\\\\n    parser.add_argument(\"--resume-job\", help=\"Existing job ID: query and download only, never submit another generation\")\\\\n    parser.add_argument(\"--outputdir\", type=Path, default=Path(\"smoke_result\"))\\\\n    parser.add_argument(\"--startup-timeout\", type=int, default=3600)\\\\n    parser.add_argument(\"--generation-timeout\", type=int, default=2700)\\\\n    parser.add_argument(\"--poll-seconds\", type=int, choices=range(1, 61), default=15, metavar=\"1..60\")\\\\n    args = parser.parse_args()\\\\n    args.outputdir = args.outputdir.resolve()\\\\n    args.outputdir.mkdir(parents=True, exist_ok=True)\\\\n    report = {\"started_at\": utc_now(), \"passed\": False}\\\\n    if args.resume_job:\\\\n        require(re.fullmatch(r\"[a-f0-9]{32}\", args.resume_job) is not None, \"Unexpected resume job ID\")\\\\n        saved = args.outputdir / \"test_report.json\"\\\\n        if saved.exists():\\\\n            previous = json.loads(saved.read_text(encoding=\"utf-8\"))\\\\n            require(previous.get(\"job_id\") == args.resume_job, \"Output directory belongs to a different job\")\\\\n            require(previous.get(\"api_base_url\") == args.url.rstrip(\"/\"), \"Output directory belongs to a different API\")\\\\n            report.update(previous)\\\\n            report.update(passed=False, resumed_at=utc_now())\\\\n            report.pop(\"error\", None)\\\\n            report.pop(\"error_type\", None)\\\\n    try:\\\\n        run(args, report)\\\\n    except BaseException as error:\\\\n        # No response bodies, headers, credentials, or environment are copied into the report.\\\\n        report[\"error_type\"] = type(error).__name__\\\\n        message = str(error)\\\\n        if os.environ.get(\"H3_API_KEY\"):\\\\n            message = message.replace(os.environ[\"H3_API_KEY\"], \"[REDACTED]\")\\\\n        report[\"error\"] = message\\\\n        raise\\\\n    finally:\\\\n        report[\"finished_at\"] = utc_now()\\\\n        path = args.outputdir / \"test_report.json\"\\\\n        save_report(args.outputdir, report)\\\\n        print(f\"REPORT_PATH={path}\", flush=True)\\\\n\\\\n\\\\nif __name__ == \"__main__\":\\\\n    main()\\\\n\\', \\'runtime_options.py\\': \\'\"\"\"BF16 runtime controls and lightweight host-wall-time diagnostics.\\\\n\\\\nThe accepted stream/on-demand-pinning path remains the default. ``sync`` and\\\\nexplicit attention choices are diagnostic alternatives, not GPU-validated\\\\nspeedups. No option changes weight precision or downloads attention kernels.\\\\n\"\"\"\\\\nfrom __future__ import annotations\\\\n\\\\nfrom contextlib import contextmanager\\\\nfrom contextvars import ContextVar\\\\nfrom dataclasses import asdict, dataclass\\\\nfrom datetime import datetime, timezone\\\\nfrom functools import wraps\\\\nimport inspect\\\\nimport json\\\\nimport os\\\\nfrom pathlib import Path\\\\nimport sys\\\\nimport threading\\\\nimport time\\\\n\\\\n\\\\n@dataclass(frozen=True)\\\\nclass RuntimeOptions:\\\\n    denoiser_offload: str = \"stream\"\\\\n    attention_backend: str = \"auto\"\\\\n\\\\n    def __post_init__(self):\\\\n        if self.denoiser_offload not in {\"stream\", \"sync\"}:\\\\n            raise ValueError(\"H3_DENOISER_OFFLOAD must be stream or sync (experimental).\")\\\\n        if self.attention_backend not in {\"auto\", \"native\", \"_native_flash\"}:\\\\n            raise ValueError(\"H3_ATTENTION_BACKEND must be auto, native, or _native_flash.\")\\\\n\\\\n    @classmethod\\\\n    def from_env(cls):\\\\n        return cls(\\\\n            denoiser_offload=os.environ.get(\"H3_DENOISER_OFFLOAD\", \"stream\"),\\\\n            attention_backend=os.environ.get(\"H3_ATTENTION_BACKEND\", \"auto\"),\\\\n        )\\\\n\\\\n    def group_offload_kwargs(self, torch):\\\\n        return {\\\\n            \"onload_device\": torch.device(\"cuda\"),\\\\n            \"offload_device\": torch.device(\"cpu\"),\\\\n            \"offload_type\": \"block_level\",\\\\n            \"num_blocks_per_group\": 1,\\\\n            \"use_stream\": self.denoiser_offload == \"stream\",\\\\n            \"low_cpu_mem_usage\": self.denoiser_offload == \"stream\",\\\\n        }\\\\n\\\\n    def configure_attention(self, transformer):\\\\n        if self.attention_backend != \"auto\":\\\\n            # Official Diffusers v0.43 API. _native_flash forces PyTorch SDPA\\\\n            # FLASH_ATTENTION; errors must propagate, with no silent fallback.\\\\n            transformer.set_attention_backend(self.attention_backend)\\\\n\\\\n\\\\ndef configure_qwen_offload(text_encoder):\\\\n    \"\"\"Preserve the A100-tested placement of Qwen\\\\\\'s directly accessed weights.\"\"\"\\\\n    import torch\\\\n    from diffusers.hooks import apply_group_offloading\\\\n\\\\n    text_encoder.requires_grad_(False)\\\\n    encoder = text_encoder.model\\\\n    language = encoder.language_model\\\\n    # Qwen reads visual.pos_embed.weight.device outside forward and calls\\\\n    # embed_tokens before language.forward. Rotary uses its buffer directly.\\\\n    encoder.visual.to(\"cuda\")\\\\n    language.embed_tokens.to(\"cuda\")\\\\n    language.norm.to(\"cuda\")\\\\n    language.rotary_emb.to(\"cuda\")\\\\n    for layer in language.layers:\\\\n        apply_group_offloading(\\\\n            layer, onload_device=torch.device(\"cuda\"), offload_device=torch.device(\"cpu\"),\\\\n            offload_type=\"block_level\", num_blocks_per_group=1, use_stream=False,\\\\n        )\\\\n\\\\n\\\\ndef resource_snapshot():\\\\n    \"\"\"Read counters only: never initialize CUDA, synchronize, or scan weights.\"\"\"\\\\n    result = {}\\\\n    try:\\\\n        import psutil\\\\n        process = psutil.Process()\\\\n        memory = process.memory_info()\\\\n        cpu = process.cpu_times()\\\\n        host = psutil.virtual_memory()\\\\n        result.update(\\\\n            rss_bytes=memory.rss, cpu_seconds=cpu.user + cpu.system,\\\\n            host_available_bytes=host.available, host_free_bytes=host.free,\\\\n        )\\\\n        for source, key in ((memory, \"shared\"), (host, \"cached\")):\\\\n            if hasattr(source, key):\\\\n                result[(\"process_\" if source is memory else \"host_\") + key + \"_bytes\"] = getattr(source, key)\\\\n        try:\\\\n            result[\"read_bytes\"] = process.io_counters().read_bytes\\\\n        except (AttributeError, OSError, psutil.Error):\\\\n            pass\\\\n    except Exception:\\\\n        # Counter access can be denied by a container or disappear during exit.\\\\n        # Diagnostics must not abort inference.\\\\n        pass\\\\n    torch = sys.modules.get(\"torch\")\\\\n    if torch is not None:\\\\n        try:\\\\n            if torch.cuda.is_initialized():\\\\n                result[\"cuda_allocated_bytes\"] = torch.cuda.memory_allocated()\\\\n                result[\"cuda_reserved_bytes\"] = torch.cuda.memory_reserved()\\\\n        except (AttributeError, RuntimeError):\\\\n            pass\\\\n    return result\\\\n\\\\n\\\\ndef emit_metric(event):\\\\n    # A leading newline separates our JSON from tqdm\\\\\\'s carriage-return line.\\\\n    try:\\\\n        print(\"\\\\\\\\nH3_METRIC \" + json.dumps(event, ensure_ascii=False, sort_keys=True), flush=True)\\\\n    except (OSError, ValueError):\\\\n        pass\\\\n\\\\n\\\\nclass RuntimeMetrics:\\\\n    def __init__(self, kind, backend, options):\\\\n        self.started = time.perf_counter()\\\\n        self._owner_thread = threading.get_ident()\\\\n        self._phase_stack = []\\\\n        self._lock = threading.RLock()\\\\n        self.data = {\\\\n            \"schema_version\": 1, \"kind\": kind, \"backend\": backend,\\\\n            \"started_at\": datetime.now(timezone.utc).isoformat(),\\\\n            \"runtime_options\": asdict(options),\\\\n            \"timing\": \"host_wall_seconds_without_cuda_synchronize\",\\\\n            \"resource_counter_scope\": \"process; overlapping stage deltas are not additive\",\\\\n            \"resources_before\": resource_snapshot(), \"stages\": [],\\\\n            \"status\": \"running\",\\\\n        }\\\\n\\\\n    @contextmanager\\\\n    def stage(self, phase):\\\\n        started = time.perf_counter()\\\\n        # A job may move from its prepare executor to the GPU and encode workers.\\\\n        # Child stages identify themselves explicitly; thread identity is not job identity.\\\\n        is_owner = not phase.startswith(\"child.\")\\\\n        if is_owner:\\\\n            with self._lock:\\\\n                self._phase_stack.append((phase, started))\\\\n        before = resource_snapshot()\\\\n        emit_metric({\"event\": \"stage_start\", \"phase\": phase, \"kind\": self.data[\"kind\"]})\\\\n        status, error_type = \"succeeded\", None\\\\n        try:\\\\n            yield\\\\n        except BaseException as error:\\\\n            status, error_type = \"failed\", type(error).__name__\\\\n            raise\\\\n        finally:\\\\n            after = resource_snapshot()\\\\n            record = {\\\\n                \"phase\": phase, \"status\": status,\\\\n                \"wall_seconds\": round(time.perf_counter() - started, 6),\\\\n                \"scope\": \"main\" if is_owner else \"child\",\\\\n                \"resources_before\": before, \"resources_after\": after,\\\\n            }\\\\n            for key in (\"read_bytes\", \"cpu_seconds\"):\\\\n                if key in before and key in after:\\\\n                    record[key + \"_delta\"] = max(0, after[key] - before[key])\\\\n            if error_type:\\\\n                record[\"error_type\"] = error_type\\\\n            with self._lock:\\\\n                self.data[\"stages\"].append(record)\\\\n                if is_owner:\\\\n                    self._phase_stack.pop()\\\\n            emit_metric({\"event\": \"stage_end\", \"kind\": self.data[\"kind\"], **record})\\\\n\\\\n    def phase_snapshot(self):\\\\n        with self._lock:\\\\n            if not self._phase_stack:\\\\n                return None\\\\n            phase, started = self._phase_stack[-1]\\\\n        return {\"phase\": phase, \"elapsed_seconds\": round(time.perf_counter() - started, 3), \"kind\": self.data[\"kind\"]}\\\\n\\\\n    def record_schedule(self, record):\\\\n        \"\"\"Append path-free scheduling attribution under the metrics lock.\"\"\"\\\\n        with self._lock:\\\\n            self.data.setdefault(\"scheduling\", []).append(dict(record))\\\\n\\\\n    def finish(self, error=None):\\\\n        self.data.update(\\\\n            status=\"succeeded\" if error is None else \"failed\",\\\\n            finished_at=datetime.now(timezone.utc).isoformat(),\\\\n            wall_seconds=round(time.perf_counter() - self.started, 6),\\\\n            resources_after=resource_snapshot(),\\\\n        )\\\\n        if error is not None:\\\\n            self.data[\"error_type\"] = type(error).__name__\\\\n        return self.data\\\\n\\\\n\\\\nclass RuntimeSupport:\\\\n    def _init_runtime(self, options=None):\\\\n        self.runtime_options = options or RuntimeOptions.from_env()\\\\n        self._loaded = False\\\\n        self._metrics_context = ContextVar(f\"h3_metrics_{id(self)}\", default=None)\\\\n        self._last_metrics_context = ContextVar(f\"h3_last_metrics_{id(self)}\", default=None)\\\\n        self._startup_active_metrics = None\\\\n        self.startup_metrics = None\\\\n        self.last_metrics = None\\\\n\\\\n    @property\\\\n    def _active_metrics(self):\\\\n        return self._metrics_context.get()\\\\n\\\\n    @_active_metrics.setter\\\\n    def _active_metrics(self, value):\\\\n        self._metrics_context.set(value)\\\\n\\\\n    @property\\\\n    def last_metrics(self):\\\\n        return self._last_metrics_context.get()\\\\n\\\\n    @last_metrics.setter\\\\n    def last_metrics(self, value):\\\\n        self._last_metrics_context.set(value)\\\\n\\\\n    @contextmanager\\\\n    def metrics_context(self, metrics):\\\\n        token = self._metrics_context.set(metrics)\\\\n        try:\\\\n            yield metrics\\\\n        finally:\\\\n            self._metrics_context.reset(token)\\\\n\\\\n    @property\\\\n    def current_phase(self):\\\\n        snapshot = self.phase_snapshot()\\\\n        return snapshot[\"phase\"] if snapshot else None\\\\n\\\\n    def phase_snapshot(self, context=None):\\\\n        metrics = getattr(context, \"metrics\", None) if context is not None else self._active_metrics or self._startup_active_metrics\\\\n        return metrics.phase_snapshot() if metrics is not None else None\\\\n\\\\n    def _new_metrics(self, kind):\\\\n        metrics = RuntimeMetrics(kind, type(self).__name__, self.runtime_options)\\\\n        settings = getattr(self, \"adapter_settings\", None)\\\\n        if settings is not None:\\\\n            metrics.data[\"adapters\"] = settings.as_dict()\\\\n            metrics.data[\"adapters_scope\"] = \"preloaded_deployment; per-job applied choices are in generation_options\"\\\\n        return metrics\\\\n\\\\n    @contextmanager\\\\n    def _stage(self, phase):\\\\n        if self._active_metrics is None:\\\\n            yield\\\\n        else:\\\\n            with self._active_metrics.stage(phase):\\\\n                yield\\\\n\\\\n\\\\ndef measured_load(function):\\\\n    @wraps(function)\\\\n    def wrapper(self, *args, **kwargs):\\\\n        if self._loaded:\\\\n            return None\\\\n        metrics = self._new_metrics(\"startup\")\\\\n        self._active_metrics = metrics\\\\n        self._startup_active_metrics = metrics\\\\n        error = None\\\\n        try:\\\\n            with metrics.stage(\"load.total\"):\\\\n                result = function(self, *args, **kwargs)\\\\n            self._loaded = True\\\\n            return result\\\\n        except BaseException as caught:\\\\n            error = caught\\\\n            raise\\\\n        finally:\\\\n            self.startup_metrics = metrics.finish(error)\\\\n            self._active_metrics = None\\\\n            self._startup_active_metrics = None\\\\n    return wrapper\\\\n\\\\n\\\\ndef measured_generation(function):\\\\n    signature = inspect.signature(function)\\\\n\\\\n    @wraps(function)\\\\n    def wrapper(self, *args, **kwargs):\\\\n        self.last_metrics = None  # A failed job must never expose the previous job\\\\\\'s metrics.\\\\n        arguments = signature.bind(self, *args, **kwargs).arguments\\\\n        output_path = Path(arguments[\"output_path\"])\\\\n        metrics = self._new_metrics(\"generation\")\\\\n        self._active_metrics = metrics\\\\n        error = None\\\\n        try:\\\\n            with metrics.stage(\"generate.total\"):\\\\n                return function(self, *args, **kwargs)\\\\n        except BaseException as caught:\\\\n            error = caught\\\\n            raise\\\\n        finally:\\\\n            self.last_metrics = metrics.finish(error)\\\\n            self._active_metrics = None\\\\n            sidecar = output_path.with_suffix(\".metrics.json\")\\\\n            temporary = sidecar.with_suffix(sidecar.suffix + \".tmp\")\\\\n            try:\\\\n                sidecar.parent.mkdir(parents=True, exist_ok=True)\\\\n                temporary.write_text(json.dumps(self.last_metrics, ensure_ascii=False, indent=2) + \"\\\\\\\\n\", encoding=\"utf-8\")\\\\n                temporary.replace(sidecar)\\\\n            except OSError as write_error:\\\\n                # Observability must not turn a generated video into a failed job\\\\n                # or replace the original inference exception.\\\\n                self.last_metrics[\"metrics_write_error\"] = type(write_error).__name__\\\\n                emit_metric({\"event\": \"metrics_write_failed\", \"phase\": \"metrics\", \"error_type\": type(write_error).__name__})\\\\n    return wrapper\\\\n\\', \\'adapter_config.py\\': \\'\"\"\"Opt-in, pinned MiniMax-H3 Ref2VA adapters. No GPU acceptance is claimed.\\\\n\\\\nThe baseline is unchanged with both settings ``none``. LoRAs are loaded into\\\\neach freshly loaded transformer_ref BEFORE group-offload hooks are installed.\\\\nOnly reviewed safetensors assets are accepted; no arbitrary remote code, URLs,\\\\npickle files, quantized weights, or silent cross-workflow routing.\\\\n\"\"\"\\\\nfrom __future__ import annotations\\\\n\\\\nfrom dataclasses import dataclass\\\\nimport hashlib\\\\nimport math\\\\nimport os\\\\nfrom pathlib import Path\\\\nimport re\\\\nfrom download_progress import adapter_progress, current_progress, tracked_adapter_application\\\\n\\\\n\\\\n@dataclass(frozen=True)\\\\nclass AdapterSpec:\\\\n    key: str\\\\n    repository: str\\\\n    filename: str\\\\n    revision: str\\\\n    sha256: str\\\\n    size: int\\\\n    source_tensors: int\\\\n\\\\n\\\\nTURBO = AdapterSpec(\\\\n    \"lightx2v-ref2va-4step\", \"lightx2v/Minimax-h3-Turbo\",\\\\n    \"minimax_h3_ref2v_turbo_4step_v0.1_bf16.safetensors\",\\\\n    \"1a4a150fc6707329409eb52e5d75a0e987ac1928\",\\\\n    \"9e642fc8749c74f8da5e2382877ab5c7aa37b9a73b7fd0d6d457bd1b3cb1ae99\",\\\\n    1383677768, 624,\\\\n)\\\\nREALISM = AdapterSpec(\\\\n    \"fal-realism-people\", \"fal/MiniMax-H3-Realism-People-LoRA\",\\\\n    \"h3-realism-people-t2v-i2v-r2v.safetensors\",\\\\n    \"039cc8579d7aa357a882d7f4111b25da4f72dccc\",\\\\n    \"acc529601d2da117fb81179e76c56e488a3beab1171659d305f04fa3655b787e\",\\\\n    131229656, 208,\\\\n)\\\\n\\\\n\\\\n@dataclass(frozen=True)\\\\nclass AdapterSettings:\\\\n    acceleration: str = \"none\"\\\\n    style: str = \"none\"\\\\n    style_scale: float = 1.0\\\\n\\\\n    def __post_init__(self):\\\\n        if self.acceleration not in {\"none\", TURBO.key}:\\\\n            raise ValueError(\"H3_ACCELERATION_LORA must be none or lightx2v-ref2va-4step\")\\\\n        if self.style not in {\"none\", REALISM.key}:\\\\n            raise ValueError(\"H3_STYLE_LORA must be none or fal-realism-people; arbitrary/FL2VA adapters are not accepted\")\\\\n        if not math.isfinite(self.style_scale) or not 0.0 < self.style_scale <= 1.0:\\\\n            raise ValueError(\"H3_STYLE_LORA_SCALE must be finite and in (0, 1]\")\\\\n\\\\n    @property\\\\n    def turbo(self):\\\\n        return self.acceleration != \"none\"\\\\n\\\\n    def as_dict(self):\\\\n        return {\\\\n            \"acceleration\": self.acceleration, \"style\": self.style,\\\\n            \"style_scale\": self.style_scale,\\\\n            \"reference_image_resize\": \"match\" if self.turbo else \"official-2048-short-edge\",\\\\n            \"required_steps\": 5 if self.turbo else None,\\\\n            \"denoiser_evaluations\": 4 if self.turbo else None,\\\\n            \"fused\": False,\\\\n            \"validation\": \"not GPU-tested\" if self.turbo or self.style != \"none\" else \"baseline\",\\\\n        }\\\\n\\\\n\\\\ndef load_adapter_settings(environ=None):\\\\n    env = os.environ if environ is None else environ\\\\n    return AdapterSettings(\\\\n        acceleration=env.get(\"H3_ACCELERATION_LORA\", \"none\").strip(),\\\\n        style=env.get(\"H3_STYLE_LORA\", \"none\").strip(),\\\\n        style_scale=float(env.get(\"H3_STYLE_LORA_SCALE\", \"1.0\")),\\\\n    )\\\\n\\\\n\\\\ndef validate_steps(settings, steps):\\\\n    if settings.turbo and steps != 5:\\\\n        raise ValueError(\"Ref2VA Turbo requires steps=5 sigma grid points, which gives exactly 4 denoiser evaluations\")\\\\n\\\\n\\\\ndef reference_match_size(width, height, target_width, target_height, multiple=32):\\\\n    \"\"\"ModelTC training policy: cap reference area at canvas area, preserve ratio.\\\\n\\\\n    Rounding follows the author\\\\\\'s implementation. Small inputs are not scaled\\\\n    up before rounding; a final nearest-32 rounding can increase an axis.\\\\n    \"\"\"\\\\n    if min(width, height, target_width, target_height, multiple) <= 0:\\\\n        raise ValueError(\"Image and target dimensions must be positive\")\\\\n    if width > 4 * height or height > 4 * width:\\\\n        raise ValueError(\"Reference image aspect ratio must be between 1:4 and 4:1\")\\\\n    scale = min(1.0, math.sqrt(target_width * target_height / (width * height)))\\\\n    return (max(multiple, round(width * scale / multiple) * multiple),\\\\n            max(multiple, round(height * scale / multiple) * multiple))\\\\n\\\\n\\\\ndef configure_pipeline(pipe, settings):\\\\n    \"\"\"Replace only this pipeline\\\\\\'s resolved Ref2VA setup when Turbo is enabled.\\\\n\\\\n    The original setup still owns validation and video/audio normalization. Its\\\\n    CPU image resize is replaced from the original pixels before any encoder\\\\n    runs. This intentionally retains a small CPU resize overhead instead of\\\\n    copying upstream\\\\\\'s full setup implementation or patching process globals.\\\\n    \"\"\"\\\\n    if not settings.turbo:\\\\n        return\\\\n    from diffusers.modular_pipelines.minimax_h3.before_encoder import MiniMaxH3Ref2VASetupStep\\\\n    from diffusers.modular_pipelines.minimax_h3 import MiniMaxH3ImageReference\\\\n    from PIL import Image\\\\n\\\\n    original = pipe.blocks.sub_blocks.get(\"before_encode\")\\\\n    if getattr(original, \"_h3_turbo_match\", False):\\\\n        return\\\\n    if not isinstance(original, MiniMaxH3Ref2VASetupStep):\\\\n        raise RuntimeError(\"Unexpected Ref2VA setup block; refusing to change reference resizing\")\\\\n\\\\n    class MatchReferenceSetup(MiniMaxH3Ref2VASetupStep):\\\\n        _h3_turbo_match = True\\\\n\\\\n        def __call__(self, components, state):\\\\n            _, state = original(components, state)\\\\n            normalized = list(state.get(\"normalized_references\"))\\\\n            references = state.get(\"references\")\\\\n            if len(normalized) != len(references):\\\\n                raise RuntimeError(\"Reference normalization changed the reference count\")\\\\n            for index, reference in enumerate(references):\\\\n                if reference.kind != \"image\":\\\\n                    continue\\\\n                # This API decodes uploaded images with from_file(), which\\\\n                # returns PIL. Reject a future unsupported path explicitly.\\\\n                if not isinstance(reference.image, Image.Image):\\\\n                    raise TypeError(\"Turbo API requires decoded PIL image references\")\\\\n                image = reference.image.convert(\"RGB\")\\\\n                width, height = reference_match_size(\\\\n                    *image.size, state.get(\"width\"), state.get(\"height\"), components.canvas_multiple,\\\\n                )\\\\n                if image.size != (width, height):\\\\n                    image = components.image_processor.resize(image, height=height, width=width)\\\\n                normalized[index] = MiniMaxH3ImageReference(image=image)\\\\n            state.set(\"normalized_references\", normalized)\\\\n            return components, state\\\\n\\\\n    pipe._h3_original_before_encode = original\\\\n    pipe._h3_turbo_before_encode = MatchReferenceSetup()\\\\n    pipe.blocks.sub_blocks[\"before_encode\"] = pipe._h3_turbo_before_encode\\\\n\\\\n\\\\ndef select_reference_setup(pipe, acceleration):\\\\n    \"\"\"Select an already constructed setup block inside the exclusive GPU lease.\"\"\"\\\\n    turbo = acceleration == TURBO.key\\\\n    selected = getattr(pipe, \"_h3_turbo_before_encode\" if turbo else \"_h3_original_before_encode\", None)\\\\n    if turbo and selected is None:\\\\n        raise RuntimeError(\"Turbo reference setup was not prepared during model loading\")\\\\n    if selected is not None:\\\\n        pipe.blocks.sub_blocks[\"before_encode\"] = selected\\\\n\\\\n\\\\ndef select_loaded_adapters(pipe, settings, acceleration):\\\\n    \"\"\"Toggle only preloaded, unfused adapters; preserve independent style LoRA.\\\\n\\\\n    This never downloads, loads, fuses, deletes, casts, or changes base weights.\\\\n    Call only while the model execution owns the GPU lease, including restore.\\\\n    \"\"\"\\\\n    transformer = getattr(pipe, \"transformer_ref\", None)\\\\n    if transformer is None:\\\\n        raise RuntimeError(\"Cannot select adapters without transformer_ref\")\\\\n    if not settings.turbo and settings.style == \"none\":\\\\n        if acceleration != \"none\":\\\\n            raise RuntimeError(\"Requested acceleration adapter is not loaded\")\\\\n        return\\\\n    if getattr(transformer, \"_h3_adapter_settings\", None) != settings:\\\\n        raise RuntimeError(\"Loaded adapter identity does not match deployment configuration\")\\\\n    names, scales = [], []\\\\n    if acceleration != \"none\":\\\\n        if acceleration != settings.acceleration:\\\\n            raise RuntimeError(\"Requested acceleration adapter is not loaded\")\\\\n        for name, expected in ((\"scheduler\", 12.0), (\"audio_scheduler\", 3.0)):\\\\n            if float(getattr(pipe, name).config.shift) != expected:\\\\n                raise RuntimeError(f\"Ref2VA Turbo requires {name} shift={expected}\")\\\\n        names.append(\"h3_acceleration\")\\\\n        scales.append(1.0)\\\\n    if settings.style != \"none\":\\\\n        names.append(\"h3_style\")\\\\n        scales.append(settings.style_scale)\\\\n    if names:\\\\n        transformer.set_adapters(names, weights=scales)\\\\n        transformer.enable_lora()\\\\n    else:\\\\n        transformer.disable_lora()\\\\n    # PEFT activation can turn LoRA factors trainable again. Preserve the\\\\n    # inference-only lifetime after enabling, disabling, and restoring.\\\\n    transformer.requires_grad_(False)\\\\n    transformer.eval()\\\\n    if hasattr(transformer, \"_reset_stateful_cache\"):\\\\n        transformer._reset_stateful_cache()\\\\n\\\\n\\\\n_VERIFIED_FILES = set()\\\\n\\\\n\\\\ndef _download_verified(spec):\\\\n    from huggingface_hub import hf_hub_download\\\\n    progress = current_progress()\\\\n    category = \\\\\\'acceleration\\\\\\' if spec == TURBO else \\\\\\'style\\\\\\'\\\\n    cached = None\\\\n    try:\\\\n        from huggingface_hub import try_to_load_from_cache\\\\n        cached = try_to_load_from_cache(spec.repository, spec.filename, revision=spec.revision)\\\\n        cached = isinstance(cached, str) and Path(cached).is_file()\\\\n    except (ImportError, OSError, ValueError):\\\\n        cached = None\\\\n    if progress:\\\\n        progress.phase(category, \\\\\\'verifying\\\\\\' if cached else \\\\\\'downloading\\\\\\',\\\\n                       \\\\\\'命中缓存，检查文件完整性\\\\\\' if cached else \\\\\\'下载所选 LoRA 文件\\\\\\', total=spec.size, cache_hit=cached)\\\\n    path = Path(hf_hub_download(spec.repository, spec.filename, revision=spec.revision))\\\\n    stat = path.stat()\\\\n    if progress:\\\\n        progress.phase(category, \\\\\\'verifying\\\\\\', \\\\\\'校验文件大小与 SHA-256\\\\\\', total=spec.size, cache_hit=cached)\\\\n    signature = (str(path.resolve()), stat.st_size, stat.st_mtime_ns, spec.sha256)\\\\n    if signature not in _VERIFIED_FILES:\\\\n        if stat.st_size != spec.size:\\\\n            raise RuntimeError(f\"Unexpected adapter file size for {spec.key}\")\\\\n        digest = hashlib.sha256()\\\\n        with path.open(\"rb\") as stream:\\\\n            for chunk in iter(lambda: stream.read(8 * 1024 * 1024), b\"\"):\\\\n                digest.update(chunk)\\\\n        if digest.hexdigest() != spec.sha256:\\\\n            raise RuntimeError(f\"SHA-256 mismatch for {spec.key}\")\\\\n        _VERIFIED_FILES.add(signature)\\\\n    return path\\\\n\\\\n\\\\ndef _validate_converted(state_dict, transformer, spec):\\\\n    \"\"\"Verify every converted tensor has a paired, dimension-compatible target.\"\"\"\\\\n    pairs = {}\\\\n    pattern = re.compile(r\"^transformer\\\\\\\\.(.+)\\\\\\\\.lora_([AB])\\\\\\\\.weight$\")\\\\n    for key, tensor in state_dict.items():\\\\n        match = pattern.fullmatch(key)\\\\n        if not match or len(tensor.shape) != 2:\\\\n            raise ValueError(f\"Unsupported converted LoRA tensor: {key}\")\\\\n        name, side = match.groups()\\\\n        if spec == REALISM and not re.fullmatch(r\"(?:transformer_blocks|token_refiner\\\\\\\\.refiner_blocks)\\\\\\\\.\\\\\\\\d+\\\\\\\\.attn\\\\\\\\.(to_[qkv]|to_out\\\\\\\\.0)\", name):\\\\n            raise ValueError(f\"Realism adapter must target only shared attention projections: {name}\")\\\\n        pairs.setdefault(name, {})[side] = tensor\\\\n    if not pairs:\\\\n        raise ValueError(\"Converted adapter has no target tensors\")\\\\n    for name, pair in pairs.items():\\\\n        if set(pair) != {\"A\", \"B\"}:\\\\n            raise ValueError(f\"Unpaired LoRA target: {name}\")\\\\n        module = transformer.get_submodule(name)\\\\n        base = module.get_base_layer() if hasattr(module, \"get_base_layer\") else module\\\\n        a, b = pair[\"A\"], pair[\"B\"]\\\\n        if a.shape[0] != b.shape[1] or tuple(base.weight.shape) != (b.shape[0], a.shape[1]):\\\\n            raise ValueError(f\"LoRA shape mismatch for {name}; pruned/other-model adapters are unsupported\")\\\\n    return pairs\\\\n\\\\n\\\\n@tracked_adapter_application\\\\ndef apply_adapters(pipe, settings):\\\\n    \"\"\"Load reviewed adapters into transformer_ref without fusing base weights.\\\\n\\\\n    Both named adapters can be composed, but that combination still needs GPU\\\\n    quality/latency acceptance. Only LoRA factors are cast; keep-FP32 base layers\\\\n    are never changed. Cache state is cleared when supported.\\\\n    \"\"\"\\\\n    specs = []\\\\n    if settings.turbo:\\\\n        specs.append((TURBO, \"h3_acceleration\", 1.0))\\\\n    if settings.style != \"none\":\\\\n        specs.append((REALISM, \"h3_style\", settings.style_scale))\\\\n    if not specs:\\\\n        return\\\\n    import importlib.util\\\\n    if importlib.util.find_spec(\"peft\") is None:\\\\n        raise RuntimeError(\"LoRA is enabled but PEFT is missing; install requirements-lora.txt using the existing torch constraints\")\\\\n    import torch\\\\n    from safetensors import safe_open\\\\n    transformer = getattr(pipe, \"transformer_ref\", None)\\\\n    if transformer is None or getattr(pipe, \"transformer\", None) is not None:\\\\n        raise RuntimeError(\"Adapters require the ref2va-only pipeline with transformer_ref loaded\")\\\\n    if getattr(transformer, \"_h3_adapter_settings\", None) is not None:\\\\n        if transformer._h3_adapter_settings != settings:\\\\n            raise RuntimeError(\"Changing adapters requires a freshly loaded transformer_ref\")\\\\n        return\\\\n    if settings.turbo:\\\\n        for name, expected in ((\"scheduler\", 12.0), (\"audio_scheduler\", 3.0)):\\\\n            if float(getattr(pipe, name).config.shift) != expected:\\\\n                raise RuntimeError(f\"Ref2VA Turbo requires {name} shift={expected}\")\\\\n    base_dtypes = {id(p): p.dtype for p in transformer.parameters()}\\\\n    names, scales = [], []\\\\n    for spec, adapter_name, scale in specs:\\\\n        category = \"acceleration\" if spec == TURBO else \"style\"\\\\n        with adapter_progress(category, spec) as progress:\\\\n            path = _download_verified(spec)\\\\n            if progress:\\\\n                progress.phase(category, \"loading\", \"加载并校验 LoRA 张量；不改变主干精度\")\\\\n            with safe_open(path, framework=\"pt\", device=\"cpu\") as handle:\\\\n                keys = list(handle.keys())\\\\n                if len(keys) != spec.source_tensors:\\\\n                    raise ValueError(f\"Unexpected tensor count for {spec.key}\")\\\\n                if any(handle.get_slice(key).get_dtype() != \"BF16\" for key in keys):\\\\n                    raise ValueError(f\"The reviewed {spec.key} asset must contain only BF16 factors\")\\\\n                if spec == TURBO and (handle.metadata() or {}).get(\"alpha\") != \"8\":\\\\n                    raise ValueError(\"Ref2VA Turbo training alpha must be 8\")\\\\n            state_dict, metadata = pipe.lora_state_dict(\\\\n                str(path.parent), weight_name=path.name, use_safetensors=True,\\\\n                local_files_only=True, return_lora_metadata=True,\\\\n            )\\\\n            pairs = _validate_converted(state_dict, transformer, spec)\\\\n            # Use the official ref-specific loader so the file metadata\\\\\\'s alpha/rank\\\\n            # scaling survives conversion. Generic load_lora_weights(dict) would\\\\n            # lose the original file\\\\\\'s alpha=8 metadata.\\\\n            pipe.load_lora_into_transformer_ref(\\\\n                state_dict, transformer_ref=transformer, prefix=\"transformer\",\\\\n                adapter_name=adapter_name, metadata=metadata, _pipeline=pipe,\\\\n                low_cpu_mem_usage=True,\\\\n            )\\\\n            del state_dict\\\\n            for name in pairs:\\\\n                layer = transformer.get_submodule(name)\\\\n                if adapter_name not in layer.lora_A or adapter_name not in layer.lora_B:\\\\n                    raise RuntimeError(f\"Adapter failed to load into {name}\")\\\\n                expected_scale = 8.0 / 128 if spec == TURBO else 1.0\\\\n                if not math.isclose(float(layer.scaling[adapter_name]), expected_scale, rel_tol=1e-6):\\\\n                    raise RuntimeError(f\"Unexpected training alpha/rank scale for {spec.key} at {name}\")\\\\n                dtype = layer.get_base_layer().weight.dtype\\\\n                if dtype not in {torch.bfloat16, torch.float32}:\\\\n                    raise RuntimeError(f\"Unexpected base precision at {name}: {dtype}\")\\\\n                layer.lora_A[adapter_name].to(dtype=dtype)\\\\n                layer.lora_B[adapter_name].to(dtype=dtype)\\\\n            del pairs\\\\n            names.append(adapter_name)\\\\n            scales.append(scale)\\\\n            if progress:\\\\n                progress.phase(category, \"loaded\", \"LoRA 已加载并校验\", total=spec.size)\\\\n    transformer.set_adapters(names, weights=scales)\\\\n    for parameter in transformer.parameters():\\\\n        if id(parameter) in base_dtypes and parameter.dtype != base_dtypes[id(parameter)]:\\\\n            raise RuntimeError(\"LoRA loading changed the base-model precision\")\\\\n    transformer.requires_grad_(False)\\\\n    transformer.eval()\\\\n    if hasattr(transformer, \"_reset_stateful_cache\"):\\\\n        transformer._reset_stateful_cache()\\\\n    transformer._h3_adapter_settings = settings\\\\n\\', \\'resource_scheduler.py\\': \\'\"\"\"Bounded CPU child events; the GPU owner and model stages remain serial.\\\\n\\\\nThe optimizer is exact within floating-point tolerance for its declared cost\\\\nmodel, not a claim of global hardware optimality. Admission uses calibrated\\\\nmemory/thread estimates, not OS-enforced peak limits. Missing calibration selects\\\\none lane. Native codec/library pools are not constrained by the Python executor.\\\\n\"\"\"\\\\nfrom __future__ import annotations\\\\n\\\\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\\\\nfrom dataclasses import dataclass\\\\nimport hashlib\\\\nimport json\\\\nimport math\\\\nimport os\\\\nfrom pathlib import Path\\\\nimport threading\\\\nimport time\\\\n\\\\nMIB = 1024 ** 2\\\\nRESERVE_MIB = 2048\\\\n\\\\n\\\\n@dataclass(frozen=True)\\\\nclass Allocation:\\\\n    lanes: tuple[tuple[int, ...], ...]\\\\n    predicted_seconds: float\\\\n    reason: str\\\\n    task_memory_mib: float | None = None\\\\n    threads_per_worker: int | None = None\\\\n    profile_metadata: dict | None = None\\\\n\\\\n\\\\ndef optimal_allocation(costs, io_mib, *, cpu_slots, memory_slots, bandwidth_mib_s,\\\\n                       max_workers=4, overhead_seconds=0.002):\\\\n    \"\"\"Minimize max(compute makespan, shared IO floor)+lane overhead.\\\\n\\\\n    At most 12 children / 4 lanes: branch-and-bound enumerates legal assignments,\\\\n    removing symmetric empty lanes. Inputs are service estimates from calibration.\\\\n    Equal predicted costs favor fewer workers. No nested GPU concurrency is allowed.\\\\n    \"\"\"\\\\n    if not costs:\\\\n        return Allocation((), 0.0, \"no children\")\\\\n    if len(costs) > 12 or any(not math.isfinite(x) or x <= 0 for x in costs):\\\\n        raise ValueError(\"Require 1..12 finite positive child costs\")\\\\n    if len(io_mib) != len(costs) or any(not math.isfinite(x) or x < 0 for x in io_mib):\\\\n        raise ValueError(\"IO demand must match the child costs\")\\\\n    if not math.isfinite(bandwidth_mib_s) or bandwidth_mib_s <= 0:\\\\n        raise ValueError(\"A positive measured bandwidth is required\")\\\\n    if overhead_seconds < 0 or not math.isfinite(overhead_seconds):\\\\n        raise ValueError(\"Invalid dispatch overhead\")\\\\n    if any(isinstance(value, bool) or not isinstance(value, int) for value in (cpu_slots, memory_slots, max_workers)):\\\\n        raise ValueError(\"CPU, memory, and worker lane caps must be integers\")\\\\n    cap = min(4, max_workers, cpu_slots, memory_slots, len(costs))\\\\n    if cap < 1:\\\\n        raise MemoryError(\"No CPU/memory lane is available\")\\\\n    order = sorted(range(len(costs)), key=lambda i: costs[i], reverse=True)\\\\n    io_floor = sum(io_mib) / bandwidth_mib_s\\\\n    winner = None\\\\n    for workers in range(1, cap + 1):\\\\n        loads, bins = [0.0] * workers, [[] for _ in range(workers)]\\\\n        # A valid upper bound from longest-processing-time list scheduling.\\\\n        for index in order:\\\\n            lane = min(range(workers), key=lambda k: loads[k])\\\\n            loads[lane] += costs[index]\\\\n            bins[lane].append(index)\\\\n        best_load, best_bins = max(loads), [row[:] for row in bins]\\\\n        lower_bound = max(sum(costs) / workers, max(costs))\\\\n        loads, bins = [0.0] * workers, [[] for _ in range(workers)]\\\\n\\\\n        def visit(position):\\\\n            nonlocal best_load, best_bins\\\\n            if best_load <= lower_bound + 1e-10:\\\\n                return\\\\n            if position == len(order):\\\\n                best_load, best_bins = max(loads), [row[:] for row in bins]\\\\n                return\\\\n            index = order[position]\\\\n            seen = set()\\\\n            for lane in range(workers):\\\\n                previous = loads[lane]\\\\n                if previous in seen or previous + costs[index] >= best_load - 1e-10:\\\\n                    continue\\\\n                seen.add(previous)\\\\n                loads[lane] += costs[index]\\\\n                bins[lane].append(index)\\\\n                visit(position + 1)\\\\n                bins[lane].pop()\\\\n                loads[lane] = previous\\\\n\\\\n        visit(0)\\\\n        predicted = max(best_load, io_floor) + overhead_seconds * workers\\\\n        candidate = Allocation(tuple(tuple(row) for row in best_bins), predicted,\\\\n                               \"minimum predicted makespan under calibrated CPU/IO/memory limits\")\\\\n        if winner is None or predicted < winner.predicted_seconds - 1e-10:\\\\n            winner = candidate\\\\n    return winner\\\\n\\\\n\\\\ndef _cpu_slots():\\\\n    \"\"\"Affinity-visible logical cores; not a cgroup CPU quota or thread limit.\"\"\"\\\\n    import psutil\\\\n    try:\\\\n        return max(1, len(psutil.Process().cpu_affinity()))\\\\n    except (AttributeError, OSError, psutil.Error):\\\\n        return max(1, os.cpu_count() or 1)\\\\n\\\\n\\\\ndef _phase_table(profile, key, phase):\\\\n    table = profile.get(key, {})\\\\n    if not isinstance(table, dict) or not isinstance(table.get(phase, {}), dict):\\\\n        raise ValueError(f\"Calibration {key} must map phase names to modality estimates\")\\\\n    return table.get(phase, {})\\\\n\\\\n\\\\nclass MediaController:\\\\n    \"\"\"Negative feedback applies between batches, never inside a GPU stage.\\\\n\\\\n    A slow/low-memory observation reduces the next concurrency ceiling. Recovery\\\\n    increases it by one only after three healthy observations. A profile is an\\\\n    explicit local calibration artifact, never silently invented from model IO.\\\\n    \"\"\"\\\\n    def __init__(self):\\\\n        self.ceiling = 4\\\\n        self.healthy = 0\\\\n        self.lock = threading.Lock()\\\\n\\\\n    def plan(self, items, phase):\\\\n        import psutil\\\\n        requested = os.environ.get(\"H3_MEDIA_WORKERS\", \"auto\")\\\\n        if requested not in {\"auto\", \"1\", \"2\", \"3\", \"4\"}:\\\\n            raise ValueError(\"H3_MEDIA_WORKERS must be auto or 1..4\")\\\\n        cpu = _cpu_slots()\\\\n        free = psutil.virtual_memory().available\\\\n        # This coarse guard protects the uncalibrated serial path. It is not a\\\\n        # promise that a codec\\\\\\'s true peak is bounded by one GiB.\\\\n        if free < (RESERVE_MIB + 1024) * MIB:\\\\n            raise MemoryError(\"Less than 3 GiB available RAM for reference preparation\")\\\\n        with self.lock:\\\\n            ceiling = self.ceiling\\\\n        maximum = min(cpu, ceiling)\\\\n        if requested != \"auto\":\\\\n            maximum = min(maximum, int(requested))\\\\n        profile_path = os.environ.get(\"H3_MEDIA_PROFILE\", \"\")\\\\n        if not profile_path:\\\\n            # A manual ceiling does not substitute for measured child costs.\\\\n            return Allocation((tuple(range(len(items))),), 0.0, \"uncalibrated: serial; native threads/peak memory not bounded\"), 1\\\\n        profile_bytes = Path(profile_path).read_bytes()\\\\n        profile = json.loads(profile_bytes)\\\\n        if not isinstance(profile, dict) or profile.get(\"schema_version\") != 1:\\\\n            raise ValueError(\"Unsupported media calibration schema\")\\\\n        if profile.get(\"cpu_slots\") != cpu:\\\\n            raise ValueError(\"Media calibration CPU affinity differs from this machine\")\\\\n        metadata = {\"sha256\": hashlib.sha256(profile_bytes).hexdigest(), \"schema_version\": 1,\\\\n                    \"affinity_cpu_slots\": cpu, \"phase\": phase}\\\\n        rates = _phase_table(profile, \"seconds_per_mib\", phase)\\\\n        if any(item[\"kind\"] not in rates for item in items):\\\\n            return Allocation((tuple(range(len(items))),), 0.0, \"missing modality calibration: serial\",\\\\n                              profile_metadata=metadata), 1\\\\n        threads = profile.get(\"threads_per_worker\")\\\\n        memory_rates = _phase_table(profile, \"task_memory_mib\", phase)\\\\n        if threads is None or any(item[\"kind\"] not in memory_rates for item in items):\\\\n            return Allocation((tuple(range(len(items))),), 0.0, \"missing thread/memory calibration: serial\",\\\\n                              profile_metadata=metadata), 1\\\\n        if isinstance(threads, bool) or not isinstance(threads, int) or threads < 1:\\\\n            raise ValueError(\"threads_per_worker must be a positive measured integer\")\\\\n        demands = [float(memory_rates[item[\"kind\"]]) for item in items]\\\\n        if any(not math.isfinite(value) or value <= 0 for value in demands):\\\\n            raise ValueError(\"task_memory_mib estimates must be finite and positive\")\\\\n        if not items:\\\\n            return Allocation((), 0.0, \"no children\"), 0\\\\n        task_memory = max(demands)\\\\n        # Prepared objects survive until encoding. Conservatively reserve each\\\\n        # child\\\\\\'s estimated peak again as its retained-result budget; then admit\\\\n        # temporary concurrent working sets. Estimates need matching input bounds.\\\\n        retained = sum(demands) if phase == \"prepare\" else 0\\\\n        memory_slots = max(0, math.floor((free / MIB - RESERVE_MIB - retained) / task_memory))\\\\n        cpu_budget = cpu // threads\\\\n        maximum = min(maximum, memory_slots, cpu_budget)\\\\n        if maximum < 1:\\\\n            raise MemoryError(\"Calibrated reference working sets exceed the available CPU/memory budget\")\\\\n        sizes = [max(Path(item[\"path\"]).stat().st_size / MIB, 0.01) for item in items]\\\\n        costs = [float(rates[item[\"kind\"]]) * size for item, size in zip(items, sizes)]\\\\n        allocation = optimal_allocation(costs, sizes, cpu_slots=cpu_budget, memory_slots=memory_slots,\\\\n                                        bandwidth_mib_s=float(profile.get(\"bandwidth_mib_s\", 0)),\\\\n                                        max_workers=maximum,\\\\n                                        overhead_seconds=float(profile.get(\"overhead_seconds\", 0.002)))\\\\n        metadata.update(cpu_budget_slots=cpu_budget, memory_budget_slots=memory_slots,\\\\n                        estimated_child_seconds=costs, estimated_child_memory_mib=demands,\\\\n                        bandwidth_mib_s=float(profile[\"bandwidth_mib_s\"]),\\\\n                        overhead_seconds=float(profile.get(\"overhead_seconds\", 0.002)),\\\\n                        retained_result_reserve_mib=retained)\\\\n        return Allocation(allocation.lanes, allocation.predicted_seconds, allocation.reason,\\\\n                          task_memory, threads, metadata), memory_slots\\\\n\\\\n    def observe(self, allocation, elapsed, available_slots, succeeded):\\\\n        with self.lock:\\\\n            slow = allocation.predicted_seconds > 0 and elapsed > allocation.predicted_seconds * 1.25\\\\n            if not succeeded or slow or available_slots < len(allocation.lanes):\\\\n                self.ceiling = max(1, min(self.ceiling - 1, len(allocation.lanes)))\\\\n                self.healthy = 0\\\\n            else:\\\\n                self.healthy += 1\\\\n                if self.healthy >= 3:\\\\n                    self.ceiling = min(4, self.ceiling + 1)\\\\n                    self.healthy = 0\\\\n\\\\n\\\\nCONTROLLER = MediaController()\\\\n\\\\n\\\\ndef _children(items, function, phase, metrics):\\\\n    if not items:\\\\n        return []\\\\n    allocation, slots = CONTROLLER.plan(items, phase)\\\\n    attribution = _input_attribution(items)\\\\n    attribution[\"profile\"] = allocation.profile_metadata\\\\n    results = [None] * len(items)\\\\n    stop = threading.Event()\\\\n    started, succeeded = time.perf_counter(), False\\\\n    _schedule_log(\"H3_SCHEDULE\", {\"phase\": phase, \"workers\": len(allocation.lanes),\\\\n                  \"predicted_seconds\": allocation.predicted_seconds, \"reason\": allocation.reason,\\\\n                  \"estimated_task_memory_mib\": allocation.task_memory_mib,\\\\n                  \"estimated_threads_per_worker\": allocation.threads_per_worker,\\\\n                  **attribution}, metrics)\\\\n\\\\n    def lane(indices):\\\\n        for index in indices:\\\\n            if stop.is_set():\\\\n                return\\\\n            try:\\\\n                if metrics is None:\\\\n                    results[index] = function(items[index])\\\\n                else:\\\\n                    with metrics.stage(f\"child.{phase}.{index}\"):\\\\n                        results[index] = function(items[index])\\\\n            except BaseException:\\\\n                stop.set()\\\\n                raise\\\\n\\\\n    try:\\\\n        if len(allocation.lanes) == 1:\\\\n            lane(allocation.lanes[0])\\\\n        else:\\\\n            # Structured lifetime: cancel unstarted work, join started work before\\\\n            # returning or raising. No orphan children overlap the next GPU phase.\\\\n            with ThreadPoolExecutor(max_workers=len(allocation.lanes), thread_name_prefix=\"h3-media\") as pool:\\\\n                futures = [pool.submit(lane, indices) for indices in allocation.lanes]\\\\n                try:\\\\n                    for future in as_completed(futures):\\\\n                        future.result()\\\\n                except BaseException:\\\\n                    stop.set()\\\\n                    for future in futures:\\\\n                        future.cancel()\\\\n                    raise\\\\n        succeeded = True\\\\n        return results\\\\n    finally:\\\\n        elapsed = time.perf_counter() - started\\\\n        if not succeeded:\\\\n            results.clear()  # Release completed child objects before re-raising.\\\\n        try:\\\\n            import psutil\\\\n            free_mib = psutil.virtual_memory().available / MIB\\\\n            estimate = allocation.task_memory_mib or 1024\\\\n            remaining = max(0, math.floor((free_mib - RESERVE_MIB) / estimate))\\\\n            CONTROLLER.observe(allocation, elapsed, remaining, succeeded)\\\\n            _schedule_log(\"H3_SCHEDULE_FEEDBACK\", {\"phase\": phase, \"wall_seconds\": elapsed,\\\\n                          \"succeeded\": succeeded, \"next_ceiling\": CONTROLLER.ceiling,\\\\n                          \"workers\": len(allocation.lanes), **attribution}, metrics)\\\\n        except Exception as feedback_error:\\\\n            # A missing/denied counter or telemetry failure must never mask the\\\\n            # original child exception or discard successfully prepared media.\\\\n            _schedule_log(\"H3_SCHEDULE_FEEDBACK\", {\"phase\": phase, \"feedback\": \"unavailable\",\\\\n                          \"error_type\": type(feedback_error).__name__, \"wall_seconds\": elapsed,\\\\n                          \"succeeded\": succeeded, **attribution}, metrics)\\\\n\\\\n\\\\ndef _input_attribution(items):\\\\n    children = []\\\\n    for index, item in enumerate(items):\\\\n        kind = item.get(\"kind\") if isinstance(item, dict) else None\\\\n        size = None\\\\n        if isinstance(item, dict) and \"path\" in item:\\\\n            try:\\\\n                size = Path(item[\"path\"]).stat().st_size\\\\n            except (OSError, TypeError, ValueError):\\\\n                pass\\\\n        children.append({\"index\": index, \"kind\": kind, \"input_bytes\": size})\\\\n    complete = all(child[\"input_bytes\"] is not None for child in children)\\\\n    return {\"child_count\": len(children), \"children\": children,\\\\n            \"input_bytes\": sum(child[\"input_bytes\"] for child in children) if complete else None}\\\\n\\\\n\\\\ndef _schedule_log(prefix, record, metrics=None):\\\\n    try:\\\\n        print(\"\\\\\\\\n\" + prefix + \" \" + json.dumps(record), flush=True)\\\\n    except (OSError, ValueError):\\\\n        pass\\\\n    try:\\\\n        recorder = getattr(metrics, \"record_schedule\", None)\\\\n        if recorder is not None:\\\\n            recorder({\"event\": prefix, **record})\\\\n    except Exception:\\\\n        pass  # Attribution must not alter the child outcome.\\\\n\\\\n\\\\ndef prepare_references(references, classes, probe, normalize, metrics=None):\\\\n    \"\"\"Probe barrier -> aggregate validation -> bounded decode barrier, in order.\"\"\"\\\\n    normalized, refs = [], []\\\\n    lock = threading.Lock()\\\\n    try:\\\\n        durations = _children(references, lambda item: probe(Path(item[\"path\"]), item[\"kind\"]),\\\\n                              \"probe\", metrics)\\\\n        for kind in (\"video\", \"audio\"):\\\\n            if sum(duration for item, duration in zip(references, durations) if item[\"kind\"] == kind) > 15:\\\\n                raise ValueError(\"Total reference duration per modality must be <=15 seconds\")\\\\n\\\\n        def prepare(item):\\\\n            path = Path(item[\"path\"])\\\\n            if item[\"kind\"] == \"video\":\\\\n                # Known target is registered before conversion, so failed ffmpeg\\\\n                # outputs are cleaned too. normalize uses this same target.\\\\n                target = path.with_name(path.stem + \"_24fps.mp4\")\\\\n                with lock:\\\\n                    normalized.append(target)\\\\n                path = normalize(path)\\\\n                with lock:\\\\n                    if path not in normalized:\\\\n                        normalized.append(path)\\\\n            return classes[item[\"kind\"]].from_file(str(path))\\\\n\\\\n        refs = _children(references, prepare, \"prepare\", metrics)\\\\n        return refs, normalized\\\\n    except BaseException:\\\\n        refs.clear()\\\\n        for path in normalized:\\\\n            path.unlink(missing_ok=True)\\\\n        raise\\\\n\\', \\'performance_model.py\\': \\'\"\"\"CPU-only optimistic physical lower bounds, not a GPU benchmark or simulator.\\\\n\\\\nResource floor = max_r(sum_i(work[i,r]) / peak[r]).\\\\nNode floor = max_r(work[i,r] / peak[r]).\\\\nCritical-path floor = longest dependency path using node floors.\\\\nOverall floor = max(resource floor, critical-path floor).\\\\n\\\\nMissing workload/capacity is reported, never invented. No PyTorch, CUDA,\\\\ndownloads, or live runtime access is used. Numeric inputs use explicit work\\\\nunits; capacities use the same unit per second. Decimal GB means 1e9 bytes.\\\\n\"\"\"\\\\nfrom __future__ import annotations\\\\n\\\\nimport argparse\\\\nfrom collections import deque\\\\nimport json\\\\nimport math\\\\nfrom pathlib import Path\\\\n\\\\n\\\\nDATASHEET = \"https://images.nvidia.com/data-center/a100/a100-datasheet.pdf\"\\\\nA100_40_SOURCE = \"https://developer.nvidia.com/blog/nvidia-ampere-architecture-in-depth/\"\\\\nBACKGROUND = \"https://docs.nvidia.com/deeplearning/performance/dl-performance-gpu-background/\"\\\\n\\\\n\\\\ndef _number(value, path, *, positive=False):\\\\n    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):\\\\n        raise ValueError(f\"{path} must be a finite number\")\\\\n    if value < 0 or (positive and value <= 0):\\\\n        raise ValueError(f\"{path} must be {\\\\\\'positive\\\\\\' if positive else \\\\\\'non-negative\\\\\\'}\")\\\\n    return float(value)\\\\n\\\\n\\\\ndef hardware_template(profile=\"a100-sxm-40gb\"):\\\\n    \"\"\"Return capacities only. The caller must supply a profiled workload DAG.\"\"\"\\\\n    if profile not in {\"a100-sxm-40gb\", \"a100-sxm-80gb\"}:\\\\n        raise ValueError(\"Supported profiles: a100-sxm-40gb, a100-sxm-80gb\")\\\\n    hbm = 1555e9 if profile == \"a100-sxm-40gb\" else 2039e9\\\\n    def resource(unit, capacity, note, source=None):\\\\n        return {\"work_unit\": unit, \"capacity_per_second\": capacity, \"note\": note, \"source\": source}\\\\n    return {\\\\n        \"schema_version\": 1,\\\\n        \"hardware\": profile,\\\\n        \"coverage\": \"partial\",\\\\n        \"observed_seconds\": None,\\\\n        \"resources\": {\\\\n            \"gpu_bf16_dense_flop\": resource(\"FLOP\", 312e12,\\\\n                \"BF16 dense Tensor Core work only; 624 TFLOP/s sparsity peak does not apply. One multiply-add counts as 2 FLOPs.\", DATASHEET),\\\\n            \"gpu_fp32_flop\": resource(\"FLOP\", None,\\\\n                \"Keep FP32-layer work separate. Determine actual instruction path first; do not divide it by the BF16 peak. FP32 CUDA-core peak is 19.5e12 FLOP/s, TF32 is a different path.\", DATASHEET),\\\\n            \"gpu_hbm_bytes\": resource(\"byte\", hbm,\\\\n                \"Total HBM traffic, not model-file size or PCIe traffic. Decimal GB/s; theoretical peak, not measured bandwidth.\", A100_40_SOURCE if profile.endswith(\"40gb\") else DATASHEET),\\\\n            \"host_memory_bytes\": resource(\"byte\", None, \"Host RAM topology and bandwidth are unknown.\"),\\\\n            \"pcie_host_to_gpu_bytes\": resource(\"byte\", None, \"Actual host-to-GPU topology/link width unknown. 64 GB/s bidirectional must not be used as one-way capacity.\"),\\\\n            \"pcie_gpu_to_host_bytes\": resource(\"byte\", None, \"Actual GPU-to-host topology/link width unknown. Keep transfer directions explicit.\"),\\\\n            \"storage_read_bytes\": resource(\"byte\", None, \"Backing-storage read bandwidth is unknown; distinguish page-cache hits from physical reads.\"),\\\\n            \"network_bytes\": resource(\"byte\", None, \"External network path and bandwidth are unknown.\"),\\\\n            \"cpu_work\": resource(\"operation\", None, \"Choose a measured CPU operation definition and matching peak before supplying work.\"),\\\\n        },\\\\n        \"stages\": [],\\\\n        \"notes\": [\\\\n            \"This template contains no MiniMax-H3 FLOP or byte estimates and predicts no generation time.\",\\\\n            \"Add stage objects with id, depends_on, and work entries of {amount, unit}; null amount means unknown.\",\\\\n            \"Use distinct stages for non-overlappable work and preserve true dependencies. A fused stage assumes ideal overlap among its resources.\",\\\\n            \"Resource capacities describe shared resource pools. Do not duplicate one physical pool under different names to invent extra capacity.\",\\\\n            \"Omitted resource work is assumed zero for the declared model. coverage=complete is an explicit assertion by the profiler, not automatic discovery.\",\\\\n            \"Only use this full-GPU profile when the assigned GPU is the matching full A100, not a MIG slice.\",\\\\n            \"GPU matrix, memory, launch, decode, I/O and transfer work still need profiling. Available RAM and VRAM capacity are feasibility constraints, not bandwidth.\",\\\\n        ],\\\\n        \"method_source\": BACKGROUND,\\\\n    }\\\\n\\\\n\\\\ndef compute_performance_bounds(document):\\\\n    if not isinstance(document, dict):\\\\n        raise ValueError(\"Input must be a JSON object\")\\\\n    coverage = document.get(\"coverage\", \"partial\")\\\\n    if coverage not in {\"partial\", \"complete\"}:\\\\n        raise ValueError(\"coverage must be partial or complete\")\\\\n    resources = document.get(\"resources\")\\\\n    stages = document.get(\"stages\")\\\\n    if not isinstance(resources, dict) or not resources:\\\\n        raise ValueError(\"resources must be a nonempty object\")\\\\n    if not isinstance(stages, list):\\\\n        raise ValueError(\"stages must be a list\")\\\\n    capacities, units = {}, {}\\\\n    for name, definition in resources.items():\\\\n        if not isinstance(name, str) or not name or not isinstance(definition, dict):\\\\n            raise ValueError(\"Every resource needs a nonempty name and an object definition\")\\\\n        unit = definition.get(\"work_unit\")\\\\n        if not isinstance(unit, str) or not unit.strip():\\\\n            raise ValueError(f\"resources.{name}.work_unit must be explicit\")\\\\n        units[name] = unit\\\\n        capacity = definition.get(\"capacity_per_second\")\\\\n        capacities[name] = None if capacity is None else _number(capacity, f\"resources.{name}.capacity_per_second\", positive=True)\\\\n\\\\n    nodes, dependencies, weights, totals, missing = {}, {}, {}, {}, []\\\\n    known_usable_items = 0\\\\n    for index, stage in enumerate(stages):\\\\n        if not isinstance(stage, dict) or not isinstance(stage.get(\"id\"), str) or not stage[\"id\"]:\\\\n            raise ValueError(f\"stages[{index}] requires a nonempty string id\")\\\\n        name = stage[\"id\"]\\\\n        if name in nodes:\\\\n            raise ValueError(f\"Duplicate stage id: {name}\")\\\\n        nodes[name] = stage\\\\n        deps = stage.get(\"depends_on\", [])\\\\n        if not isinstance(deps, list) or any(not isinstance(dep, str) for dep in deps) or len(set(deps)) != len(deps):\\\\n            raise ValueError(f\"stages.{name}.depends_on must be a list of unique stage ids\")\\\\n        dependencies[name] = deps\\\\n        work = stage.get(\"work\")\\\\n        if not isinstance(work, dict):\\\\n            raise ValueError(f\"stages.{name}.work must be an object\")\\\\n        node_times = []\\\\n        if not work:\\\\n            missing.append({\"path\": f\"stages.{name}.work\", \"reason\": \"no workload supplied\"})\\\\n        for resource, item in work.items():\\\\n            path = f\"stages.{name}.work.{resource}\"\\\\n            if resource not in resources:\\\\n                raise ValueError(f\"{path} names an undefined resource\")\\\\n            if not isinstance(item, dict) or item.get(\"unit\") != units[resource]:\\\\n                raise ValueError(f\"{path}.unit must equal {units[resource]!r}; implicit conversion is not performed\")\\\\n            if \"amount\" not in item:\\\\n                raise ValueError(f\"{path}.amount must be a number or explicit null\")\\\\n            total = totals.setdefault(resource, {\"known_amount\": 0.0, \"unit\": units[resource], \"has_unknown_work\": False})\\\\n            if item[\"amount\"] is None:\\\\n                total[\"has_unknown_work\"] = True\\\\n                missing.append({\"path\": path + \".amount\", \"reason\": \"unknown workload\"})\\\\n                continue\\\\n            amount = _number(item[\"amount\"], path + \".amount\")\\\\n            total[\"known_amount\"] += amount\\\\n            if capacities[resource] is None:\\\\n                if amount > 0:\\\\n                    missing.append({\"path\": \"resources.\" + resource + \".capacity_per_second\", \"reason\": \"unknown capacity for nonzero work\"})\\\\n                else:\\\\n                    node_times.append(0.0)\\\\n                    known_usable_items += 1\\\\n            else:\\\\n                node_times.append(amount / capacities[resource])\\\\n                known_usable_items += 1\\\\n        weights[name] = max(node_times) if node_times else None\\\\n\\\\n    if not stages:\\\\n        missing.append({\"path\": \"stages\", \"reason\": \"no workload DAG supplied\"})\\\\n    followers = {name: [] for name in nodes}\\\\n    indegree = {name: len(deps) for name, deps in dependencies.items()}\\\\n    for name, deps in dependencies.items():\\\\n        for dep in deps:\\\\n            if dep not in nodes:\\\\n                raise ValueError(f\"Stage {name!r} depends on unknown stage {dep!r}\")\\\\n            followers[dep].append(name)\\\\n    ready = deque(name for name in nodes if indegree[name] == 0)\\\\n    ends, paths, order = {}, {}, []\\\\n    while ready:\\\\n        name = ready.popleft()\\\\n        order.append(name)\\\\n        predecessor = max(dependencies[name], key=lambda dep: ends[dep], default=None)\\\\n        ends[name] = (ends[predecessor] if predecessor is not None else 0.0) + (weights[name] or 0.0)\\\\n        paths[name] = (paths[predecessor] if predecessor is not None else []) + [name]\\\\n        for successor in followers[name]:\\\\n            indegree[successor] -= 1\\\\n            if indegree[successor] == 0:\\\\n                ready.append(successor)\\\\n    if len(order) != len(nodes):\\\\n        raise ValueError(\"The stage graph contains a dependency cycle\")\\\\n\\\\n    resource_bounds = {\\\\n        name: total[\"known_amount\"] / capacities[name]\\\\n        for name, total in totals.items() if capacities[name] is not None\\\\n    }\\\\n    usable = known_usable_items > 0\\\\n    ideal = max(resource_bounds.values(), default=0.0) if usable else None\\\\n    terminal = max(ends, key=ends.get, default=None)\\\\n    critical = ends[terminal] if terminal is not None and usable else None\\\\n    lower_bound = max(ideal, critical) if ideal is not None and critical is not None else None\\\\n    # Deduplicate shared missing capacity entries while keeping deterministic order.\\\\n    missing = [dict(path=path, reason=reason) for path, reason in dict.fromkeys((entry[\"path\"], entry[\"reason\"]) for entry in missing)]\\\\n    complete = coverage == \"complete\" and not missing and bool(stages)\\\\n    comparison = None\\\\n    observed = document.get(\"observed_seconds\")\\\\n    if observed is not None:\\\\n        observed = _number(observed, \"observed_seconds\", positive=True)\\\\n        comparison = {\\\\n            \"observed_seconds\": observed,\\\\n            \"scope\": \"declared_complete_workload\" if complete else \"partial_workload_only\",\\\\n            \"time_over_lower_bound\": observed / lower_bound if lower_bound is not None and lower_bound > 0 else None,\\\\n            \"lower_bound_fraction_of_observed\": lower_bound / observed if lower_bound is not None else None,\\\\n            \"inconsistent_observation\": lower_bound is not None and observed + 1e-12 < lower_bound,\\\\n            \"overall_efficiency\": None,\\\\n            \"note\": \"Ratios compare time with an optimistic bound, not measured device utilization or proven achievable efficiency. Partial workloads cannot establish whole-task efficiency.\",\\\\n        }\\\\n    return {\\\\n        \"schema_version\": 1,\\\\n        \"coverage\": \"declared_complete\" if complete else \"partial\",\\\\n        \"ideal_full_parallel_lower_bound_seconds\": ideal,\\\\n        \"critical_path_lower_bound_seconds\": critical,\\\\n        \"overall_lower_bound_seconds\": lower_bound,\\\\n        \"resource_lower_bounds_seconds\": resource_bounds,\\\\n        \"stage_lower_bounds_seconds\": weights,\\\\n        \"critical_path\": paths[terminal] if terminal is not None and usable else [],\\\\n        \"total_work_by_resource\": totals,\\\\n        \"missing\": missing,\\\\n        \"unavailable_capacities\": [name for name, value in capacities.items() if value is None],\\\\n        \"comparison\": comparison,\\\\n        \"interpretation\": \"Optimistic necessary lower bound under supplied resource pools and DAG, not an achievable runtime prediction. Independent resources and work inside each stage are assumed to overlap perfectly; dependencies cannot overlap.\",\\\\n    }\\\\n\\\\n\\\\ndef main(argv=None):\\\\n    parser = argparse.ArgumentParser(description=__doc__)\\\\n    parser.add_argument(\"input\", nargs=\"?\", type=Path, help=\"UTF-8 JSON workload and resource document\")\\\\n    parser.add_argument(\"--template\", choices=(\"a100-sxm-40gb\", \"a100-sxm-80gb\"), help=\"Emit capacities only; no fake workload\")\\\\n    parser.add_argument(\"--output\", type=Path, help=\"Write UTF-8 JSON instead of stdout\")\\\\n    args = parser.parse_args(argv)\\\\n    if bool(args.input) == bool(args.template):\\\\n        parser.error(\"Choose exactly one input JSON or --template\")\\\\n    try:\\\\n        result = hardware_template(args.template) if args.template else compute_performance_bounds(json.loads(args.input.read_text(encoding=\"utf-8-sig\")))\\\\n    except (ValueError, OSError) as exc:\\\\n        parser.error(str(exc))\\\\n    rendered = json.dumps(result, ensure_ascii=False, indent=2, allow_nan=False) + \"\\\\\\\\n\"\\\\n    if args.output:\\\\n        args.output.write_text(rendered, encoding=\"utf-8\")\\\\n    else:\\\\n        print(rendered, end=\"\")\\\\n\\\\n\\\\nif __name__ == \"__main__\":\\\\n    main()\\\\n\\', \\'性能参照模板.json\\': \\'{\\\\n  \"schema_version\": 1,\\\\n  \"hardware\": \"a100-sxm-40gb\",\\\\n  \"coverage\": \"partial\",\\\\n  \"observed_seconds\": null,\\\\n  \"resources\": {\\\\n    \"gpu_bf16_dense_flop\": {\\\\n      \"work_unit\": \"FLOP\",\\\\n      \"capacity_per_second\": 312000000000000.0,\\\\n      \"note\": \"BF16 dense Tensor Core work only; 624 TFLOP/s sparsity peak does not apply. One multiply-add counts as 2 FLOPs.\",\\\\n      \"source\": \"https://images.nvidia.com/data-center/a100/a100-datasheet.pdf\"\\\\n    },\\\\n    \"gpu_fp32_flop\": {\\\\n      \"work_unit\": \"FLOP\",\\\\n      \"capacity_per_second\": null,\\\\n      \"note\": \"Keep FP32-layer work separate. Determine actual instruction path first; do not divide it by the BF16 peak. FP32 CUDA-core peak is 19.5e12 FLOP/s, TF32 is a different path.\",\\\\n      \"source\": \"https://images.nvidia.com/data-center/a100/a100-datasheet.pdf\"\\\\n    },\\\\n    \"gpu_hbm_bytes\": {\\\\n      \"work_unit\": \"byte\",\\\\n      \"capacity_per_second\": 1555000000000.0,\\\\n      \"note\": \"Total HBM traffic, not model-file size or PCIe traffic. Decimal GB/s; theoretical peak, not measured bandwidth.\",\\\\n      \"source\": \"https://developer.nvidia.com/blog/nvidia-ampere-architecture-in-depth/\"\\\\n    },\\\\n    \"host_memory_bytes\": {\\\\n      \"work_unit\": \"byte\",\\\\n      \"capacity_per_second\": null,\\\\n      \"note\": \"Host RAM topology and bandwidth are unknown.\",\\\\n      \"source\": null\\\\n    },\\\\n    \"pcie_host_to_gpu_bytes\": {\\\\n      \"work_unit\": \"byte\",\\\\n      \"capacity_per_second\": null,\\\\n      \"note\": \"Actual host-to-GPU topology/link width unknown. 64 GB/s bidirectional must not be used as one-way capacity.\",\\\\n      \"source\": null\\\\n    },\\\\n    \"pcie_gpu_to_host_bytes\": {\\\\n      \"work_unit\": \"byte\",\\\\n      \"capacity_per_second\": null,\\\\n      \"note\": \"Actual GPU-to-host topology/link width unknown. Keep transfer directions explicit.\",\\\\n      \"source\": null\\\\n    },\\\\n    \"storage_read_bytes\": {\\\\n      \"work_unit\": \"byte\",\\\\n      \"capacity_per_second\": null,\\\\n      \"note\": \"Backing-storage read bandwidth is unknown; distinguish page-cache hits from physical reads.\",\\\\n      \"source\": null\\\\n    },\\\\n    \"network_bytes\": {\\\\n      \"work_unit\": \"byte\",\\\\n      \"capacity_per_second\": null,\\\\n      \"note\": \"External network path and bandwidth are unknown.\",\\\\n      \"source\": null\\\\n    },\\\\n    \"cpu_work\": {\\\\n      \"work_unit\": \"operation\",\\\\n      \"capacity_per_second\": null,\\\\n      \"note\": \"Choose a measured CPU operation definition and matching peak before supplying work.\",\\\\n      \"source\": null\\\\n    }\\\\n  },\\\\n  \"stages\": [],\\\\n  \"notes\": [\\\\n    \"This template contains no MiniMax-H3 FLOP or byte estimates and predicts no generation time.\",\\\\n    \"Add stage objects with id, depends_on, and work entries of {amount, unit}; null amount means unknown.\",\\\\n    \"Use distinct stages for non-overlappable work and preserve true dependencies. A fused stage assumes ideal overlap among its resources.\",\\\\n    \"Resource capacities describe shared resource pools. Do not duplicate one physical pool under different names to invent extra capacity.\",\\\\n    \"Omitted resource work is assumed zero for the declared model. coverage=complete is an explicit assertion by the profiler, not automatic discovery.\",\\\\n    \"Only use this full-GPU profile when the assigned GPU is the matching full A100, not a MIG slice.\",\\\\n    \"GPU matrix, memory, launch, decode, I/O and transfer work still need profiling. Available RAM and VRAM capacity are feasibility constraints, not bandwidth.\"\\\\n  ],\\\\n  \"method_source\": \"https://docs.nvidia.com/deeplearning/performance/dl-performance-gpu-background/\"\\\\n}\\\\n\\', \\'requirements.txt\\': \\'# Linux NVIDIA A100. Native BF16; no quantization dependencies.\\\\ntorch==2.10.0\\\\ntorchvision==0.25.0\\\\ntorchaudio==2.10.0\\\\ndiffusers==0.43.0\\\\ntransformers==5.7.0\\\\naccelerate>=1.10,<2\\\\nsafetensors>=0.6,<1\\\\nhuggingface-hub>=1.0,<2\\\\nnumpy>=1.26,<3\\\\nPillow>=11,<13\\\\neinops>=0.8,<1\\\\nav>=14,<18\\\\nsoundfile>=0.13,<1\\\\nimageio>=2.37,<3\\\\nimageio-ffmpeg>=0.6,<1\\\\nfastapi>=0.115,<1\\\\nuvicorn>=0.34,<1\\\\npython-multipart>=0.0.20,<1\\\\npsutil>=6,<8\\\\nthreadpoolctl>=3,<4\\\\nrequests>=2.32,<3\\\\n\\', \\'requirements-colab.txt\\': \\'# Colab: preserve its preinstalled torch / torchvision / torchaudio stack.\\\\n# Notebook adds exact-version constraints for installed members of that stack.\\\\ndiffusers==0.43.0\\\\ntransformers==5.7.0\\\\naccelerate>=1.10,<2\\\\nsafetensors>=0.6,<1\\\\nhuggingface-hub>=1.0,<2\\\\nnumpy>=1.26,<3\\\\nPillow>=11,<13\\\\neinops>=0.8,<1\\\\nav>=14,<18\\\\nsoundfile>=0.13,<1\\\\nimageio>=2.37,<3\\\\nimageio-ffmpeg>=0.6,<1\\\\nfastapi>=0.115,<1\\\\nuvicorn>=0.34,<1\\\\npython-multipart>=0.0.20,<1\\\\n# The notebook host uses psutil while pip runs: retain its preinstalled version.\\\\n# All process ownership/resource APIs used here are available in 5.9.5.\\\\npsutil>=5.9.5,<8\\\\nthreadpoolctl>=3,<4\\\\nrequests>=2.32,<3\\\\n\\', \\'requirements-lora.txt\\': \\'# Optional: install only when an explicit acceleration/style adapter is selected.\\\\n# Colab must apply the same exact torch-stack constraints as the base install.\\\\npeft==0.21.2\\\\n\\', \\'run.py\\': \\'\"\"\"Start/query/control the API, model container and global event manager.\"\"\"\\\\nfrom __future__ import annotations\\\\n\\\\nimport argparse\\\\nimport json\\\\nimport os\\\\nfrom pathlib import Path\\\\nimport signal\\\\nimport time\\\\n\\\\nfrom startup import StartupSession\\\\nfrom control_protocol import rpc_call\\\\n\\\\n\\\\ndef main() -> None:\\\\n    parser = argparse.ArgumentParser(description=__doc__)\\\\n    parser.add_argument(\"--port\", type=int, default=8000)\\\\n    parser.add_argument(\"--staged\", action=\"store_true\", help=\"Explicit sequential BF16 loading for an A100 with >=70 GiB available host RAM; not the default resident profile\")\\\\n    parser.add_argument(\"--public\", action=\"store_true\", help=\"Prepare a temporary tunnel alongside the model; readiness requires their live join\")\\\\n    parser.add_argument(\"--install-cloudflared\", action=\"store_true\", help=\"With --public, fetch an official SHA-256 checked cloudflared release if needed\")\\\\n    parser.add_argument(\"--attention-backend\", choices=[\"auto\", \"native\", \"_native_flash\"])\\\\n    parser.add_argument(\"--denoiser-offload\", choices=[\"stream\", \"sync\"])\\\\n    parser.add_argument(\"--acceleration-lora\", choices=[\"none\", \"lightx2v-ref2va-4step\"])\\\\n    parser.add_argument(\"--style-lora\", choices=[\"none\", \"fal-realism-people\"])\\\\n    parser.add_argument(\"--style-lora-scale\", type=float)\\\\n    parser.add_argument(\"--media-workers\", choices=[\"auto\", \"1\", \"2\", \"3\", \"4\"], help=\"A ceiling; parallel preparation also requires a local measured profile\")\\\\n    parser.add_argument(\"--media-profile\", type=Path, help=\"Local calibration JSON for bounded CPU child scheduling\")\\\\n    parser.add_argument(\"--validate-config\", action=\"store_true\", help=\"Validate configuration without initializing CUDA, downloading, or starting a server\")\\\\n    parser.add_argument(\"--manager-url\", help=\"Existing private loopback controller; use H3_CONTROL_KEY\")\\\\n    parser.add_argument(\"--action\", choices=[\"status\", \"events\", \"drain\", \"resume\", \"start_model\", \"stop_model\", \"start_api\", \"stop_api\", \"shutdown\"], default=\"status\")\\\\n    parser.add_argument(\"--force\", action=\"store_true\", help=\"Explicitly permit stopping an occupied model container\")\\\\n    args = parser.parse_args()\\\\n    if args.manager_url:\\\\n        token = os.environ.get(\"H3_CONTROL_KEY\", \"\")\\\\n        if len(token) < 32:\\\\n            raise ValueError(\"Set the existing private H3_CONTROL_KEY for controller access\")\\\\n        operation = args.action if args.action in {\"status\", \"events\"} else \"control\"\\\\n        payload = {} if operation != \"control\" else {\"action\": args.action, \"force\": args.force}\\\\n        print(json.dumps(rpc_call(args.manager_url, token, operation, payload), ensure_ascii=False, indent=2))\\\\n        return\\\\n    for argument, name in {\\\\n        \"attention_backend\": \"H3_ATTENTION_BACKEND\", \"denoiser_offload\": \"H3_DENOISER_OFFLOAD\",\\\\n        \"acceleration_lora\": \"H3_ACCELERATION_LORA\", \"style_lora\": \"H3_STYLE_LORA\",\\\\n        \"style_lora_scale\": \"H3_STYLE_LORA_SCALE\", \"media_workers\": \"H3_MEDIA_WORKERS\",\\\\n        \"media_profile\": \"H3_MEDIA_PROFILE\",\\\\n    }.items():\\\\n        value = getattr(args, argument)\\\\n        if value is not None:\\\\n            os.environ[name] = str(value)\\\\n    from adapter_config import load_adapter_settings\\\\n    from runtime_options import RuntimeOptions\\\\n    runtime_options, adapters = RuntimeOptions.from_env(), load_adapter_settings()\\\\n    if os.environ.get(\"H3_MEDIA_WORKERS\", \"auto\") not in {\"auto\", \"1\", \"2\", \"3\", \"4\"}:\\\\n        raise ValueError(\"H3_MEDIA_WORKERS must be auto or 1..4\")\\\\n    if args.media_profile and not args.media_profile.is_file():\\\\n        raise FileNotFoundError(\"The media calibration profile does not exist\")\\\\n    if args.validate_config:\\\\n        print(json.dumps({\"configuration\": \"valid\", \"residency\": \"staged\" if args.staged else \"resident\",\\\\n                          \"runtime\": runtime_options.__dict__, \"adapters\": adapters.as_dict(),\\\\n                          \"media_workers\": os.environ.get(\"H3_MEDIA_WORKERS\", \"auto\"),\\\\n                          \"gpu_started\": False}, ensure_ascii=False, indent=2))\\\\n        return\\\\n    residency = \"staged\" if args.staged else \"resident\"\\\\n    new_key = not os.environ.get(\"H3_API_KEY\")\\\\n    session = StartupSession(Path(__file__).resolve().parent, port=args.port, staged=args.staged,\\\\n                             public=args.public, install_cloudflared=args.install_cloudflared)\\\\n    if new_key:\\\\n        print(\"Temporary API key (shown once; keep private): \" + session.api_key, flush=True)\\\\n    print(f\"BF16 residency profile: {residency}; lifecycle status: {session.state_path}\", flush=True)\\\\n    last_state = None\\\\n\\\\n    def show_state(state):\\\\n        nonlocal last_state\\\\n        summary = {name: state[name] for name in (\\\\n            \"instance_id\", \"phase\", \"ready\", \"api_ready\", \"model_ready\", \"tunnel_connected\", \"public_ready\", \"public_url\", \"error\")}\\\\n        if summary != last_state:\\\\n            print(json.dumps(summary, ensure_ascii=False), flush=True)\\\\n            last_state = summary\\\\n\\\\n    try:\\\\n        session.start()\\\\n        print(f\"Manager control: {session.manager_url}; API log: {session.api_log}; model log: {session.server_log}\", flush=True)\\\\n        try:\\\\n            state = session.wait_ready(on_update=show_state)\\\\n            print(f\"Generation ready: http://127.0.0.1:{args.port}/docs\", flush=True)\\\\n            if args.public:\\\\n                print(f\"Public generation verified for this instance: {state[\\\\\\'public_url\\\\\\']}\", flush=True)\\\\n        except (RuntimeError, TimeoutError) as error:\\\\n            print(f\"Generation unavailable: {error}. Query/control remain available while the manager is alive.\", flush=True)\\\\n        while True:\\\\n            state = session.snapshot()\\\\n            show_state(state)\\\\n            if state.get(\"manager_alive\") is False and state[\"phase\"] != \"stopped\":\\\\n                raise RuntimeError(state[\"error\"])\\\\n            if state[\"phase\"] == \"stopped\":\\\\n                break\\\\n            time.sleep(1)\\\\n    finally:\\\\n        session.stop()\\\\n\\\\n\\\\nif __name__ == \"__main__\":\\\\n    signal.signal(signal.SIGTERM, lambda *_: (_ for _ in ()).throw(KeyboardInterrupt()))\\\\n    try:\\\\n        main()\\\\n    except KeyboardInterrupt:\\\\n        print(\"Server stopped. Release the cloud GPU instance separately to stop provider billing.\")\\\\n\\', \\'startup.py\\': \\'\"\"\"Managed launcher/client: global_manager owns API, model and tunnel lifecycles.\"\"\"\\\\nfrom __future__ import annotations\\\\nfrom copy import deepcopy\\\\nimport json\\\\nimport os\\\\nfrom pathlib import Path\\\\nimport secrets\\\\nimport signal\\\\nimport socket\\\\nimport subprocess\\\\nimport sys\\\\nimport threading\\\\nimport time\\\\nimport uuid\\\\nfrom urllib.request import urlopen\\\\nfrom control_protocol import ControlError, rpc_call\\\\nfrom process_owner import ProcessOwner\\\\n\\\\n\\\\ndef assert_port_available(port):\\\\n    with socket.socket() as probe:\\\\n        probe.bind((\"127.0.0.1\", int(port)))\\\\n\\\\n\\\\ndef _free_port(excluded):\\\\n    while True:\\\\n        with socket.socket() as probe:\\\\n            probe.bind((\"127.0.0.1\", 0))\\\\n            port = probe.getsockname()[1]\\\\n        if port not in excluded:\\\\n            return port\\\\n\\\\n\\\\ndef probe_ready(url, instance_id, timeout=3):\\\\n    try:\\\\n        with urlopen(url.rstrip(\"/\") + \"/health\", timeout=timeout) as response:\\\\n            data = json.loads(response.read(16384))\\\\n        return isinstance(data, dict) and data.get(\"ready\") is True and data.get(\"instance_id\") == instance_id\\\\n    except Exception:\\\\n        return False\\\\n\\\\n\\\\nclass StartupSession:\\\\n    def __init__(self, directory, *, port=8000, staged=False, public=False,\\\\n                 install_cloudflared=False, env=None, startup_timeout=3600,\\\\n                 tunnel_timeout=180, poll_interval=1, probe_timeout=3, clock=None,\\\\n                 start_model=True):\\\\n        self.directory = Path(directory).resolve()\\\\n        self.port, self.staged, self.public = int(port), bool(staged), bool(public)\\\\n        if not 1 <= self.port <= 65535 or min(startup_timeout, tunnel_timeout, poll_interval, probe_timeout) <= 0:\\\\n            raise ValueError(\"Valid ports and positive timeouts are required\")\\\\n        self.install_cloudflared = bool(install_cloudflared)\\\\n        self.model_autostart = bool(start_model)\\\\n        self.startup_timeout, self.tunnel_timeout = startup_timeout, tunnel_timeout\\\\n        self.poll_interval, self.probe_timeout = poll_interval, probe_timeout\\\\n        self._clock = clock or time.monotonic\\\\n        self._environment = dict(os.environ if env is None else env)\\\\n        self.api_key = self._environment.get(\"H3_API_KEY\") or secrets.token_urlsafe(32)\\\\n        self._control_key = self._environment.get(\"H3_CONTROL_KEY\") or secrets.token_urlsafe(32)\\\\n        for token in (self.api_key, self._control_key):\\\\n            if len(token) < 32 or not token.isascii() or any(c.isspace() for c in token):\\\\n                raise ValueError(\"Tokens require at least 32 non-whitespace ASCII characters\")\\\\n        if self.api_key == self._control_key:\\\\n            raise ValueError(\"Public and private control tokens must be distinct\")\\\\n        self.instance_id = uuid.uuid4().hex\\\\n        self.root = Path(self._environment.get(\"H3_OUTPUT_DIR\", self.directory / \"h3_outputs\")).resolve()\\\\n        self.run_directory = self.directory / \"runtime\" / self.instance_id\\\\n        self.state_path = self.run_directory / \"status.json\"\\\\n        self.events_path = self.run_directory / \"events.jsonl\"\\\\n        self.server_log = self.run_directory / \"model.log\"\\\\n        self.api_log = self.run_directory / \"api.log\"\\\\n        self.tunnel_log = self.run_directory / \"tunnel.log\"\\\\n        self.manager_log = self.run_directory / \"manager.log\"\\\\n        self.manager = self._output = self._started_at = self._manager_owner = None\\\\n        self._state_lock = threading.Lock()\\\\n        self._last = dict(instance_id=self.instance_id, phase=\"new\", ready=False,\\\\n                          api_ready=False, model_ready=False, public_ready=False,\\\\n                          public_requested=self.public, public_url=None,\\\\n                          public_api_ready=False, tunnel_connected=False,\\\\n                          server_alive=False, model_alive=False, tunnel_alive=False,\\\\n                          manager_alive=False, cleanup_complete=True, shutdown_complete=True, error=None)\\\\n        self.manager_url = None\\\\n\\\\n    @staticmethod\\\\n    def _cleanup_confirmed(state):\\\\n        return (state.get(\"phase\") in {\"stopped\", \"failed\"} and state.get(\"cleanup_complete\") is True\\\\n                and state.get(\"shutdown_complete\") is True\\\\n                and all(state.get(name) is False for name in (\"server_alive\", \"model_alive\", \"tunnel_alive\"))\\\\n                and not state.get(\"process_observation_errors\"))\\\\n\\\\n    def _remember(self, state):\\\\n        # RPCs can finish out of order while the notebook polls during stop().\\\\n        # A verified terminal receipt is monotonic for this manager instance.\\\\n        with self._state_lock:\\\\n            if not self._cleanup_confirmed(self._last) or self._cleanup_confirmed(state):\\\\n                self._last = deepcopy(state)\\\\n            return deepcopy(self._last)\\\\n\\\\n    def _read_final_receipt(self):\\\\n        try:\\\\n            state = json.loads(self.state_path.read_text(encoding=\"utf-8\"))\\\\n            if isinstance(state, dict) and state.get(\"instance_id\") == self.instance_id and self._cleanup_confirmed(state):\\\\n                self._remember(state)\\\\n        except (OSError, ValueError):\\\\n            pass\\\\n\\\\n    def _manager_tree_alive(self):\\\\n        if self._manager_owner:\\\\n            return self._manager_owner.observe()[\"alive\"]\\\\n        return self.manager is not None and self.manager.poll() is None\\\\n\\\\n    def _owner_observation(self):\\\\n        if self._manager_owner:\\\\n            return self._manager_owner.observe()\\\\n        alive = self.manager is not None and self.manager.poll() is None\\\\n        return {\"alive\": alive, \"cleanup_complete\": not alive, \"errors\": [],\\\\n                \"pids\": [self.manager.pid] if alive else [], \"identities\": [],\\\\n                \"scope\": \"manager_launcher_only\", \"observed_at\": time.time()}\\\\n\\\\n    def _unavailable_snapshot(self, owner_state, *, stopped=False):\\\\n        \"\"\"Keep the last RPC as history; never mix its readiness with current exit evidence.\"\"\"\\\\n        if owner_state.get(\"alive\") is False:\\\\n            self._read_final_receipt()\\\\n        with self._state_lock:\\\\n            history = deepcopy(self._last)\\\\n        result = deepcopy(history)\\\\n        errors = list(owner_state.get(\"errors\", []))\\\\n        tree_complete = (owner_state.get(\"cleanup_complete\") is True and not errors\\\\n                         and owner_state.get(\"scope\") != \"manager_launcher_only\")\\\\n        manager_pid = history.get(\"manager_pid\", getattr(self.manager, \"pid\", None))\\\\n        manager_alive = (None if errors else manager_pid in owner_state.get(\"pids\", []))\\\\n        if owner_state.get(\"scope\") == \"manager_launcher_only\":\\\\n            manager_alive = owner_state[\"alive\"]\\\\n        confirmed = self._cleanup_confirmed(history) and owner_state.get(\"cleanup_complete\") is True and not errors\\\\n        children_exited = tree_complete or (self._cleanup_confirmed(history) and manager_alive is False\\\\n                                            and owner_state.get(\"scope\") == \"manager_launcher_only\")\\\\n        child_alive = False if children_exited else None\\\\n        current_time = time.time()\\\\n        owner_observed_at = owner_state.get(\"observed_at\")\\\\n        manager_observed_at = history.get(\"observed_at\")\\\\n        observation_age = lambda timestamp: (round(max(0, current_time - timestamp), 3)\\\\n                                              if isinstance(timestamp, (int, float)) else None)\\\\n        modules = {name: {\"alive\": child_alive, \"ready\": False,\\\\n                          \"observation_unknown\": child_alive is None}\\\\n                   for name in (\"api\", \"model\", \"tunnel\")}\\\\n        modules[\"manager\"] = {\"alive\": manager_alive, \"ready\": False,\\\\n                              \"supervisor_alive\": False if manager_alive is False else None,\\\\n                              \"observation_unknown\": manager_alive is None}\\\\n        current_owned = {}\\\\n        for name, previous in history.get(\"owned_processes\", {}).items():\\\\n            current_owned[name] = {\"alive\": child_alive, \"cleanup_complete\": children_exited,\\\\n                                   \"pids\": [] if children_exited else None,\\\\n                                   \"identities\": deepcopy(previous.get(\"identities\", [])),\\\\n                                   \"errors\": [] if children_exited else [\"manager_observation_unavailable\"],\\\\n                                   \"observed_at\": current_time}\\\\n        result.update(last_manager_observation=history, manager_process_tree=deepcopy(owner_state),\\\\n                      manager_observed_at=manager_observed_at, observed_at=current_time,\\\\n                      owner_observed_at=owner_observed_at,\\\\n                      observation_age_seconds=observation_age(owner_observed_at),\\\\n                      manager_observation_age_seconds=observation_age(manager_observed_at),\\\\n                      manager_launcher_pid=getattr(self.manager, \"pid\", None), manager_alive=manager_alive,\\\\n                      server_alive=child_alive, model_alive=child_alive, tunnel_alive=child_alive,\\\\n                      ready=False, api_ready=False, model_ready=False, public_ready=False,\\\\n                      public_api_ready=False, tunnel_connected=False, supervisor_alive=modules[\"manager\"][\"supervisor_alive\"],\\\\n                      modules=modules, owned_processes=current_owned,\\\\n                      cleanup_complete=confirmed, observation_stale=True, manager_observation_stale=True,\\\\n                      phase=\"stopped\" if confirmed else \"failed\" if stopped or manager_alive is False else \"degraded\")\\\\n        process_errors = deepcopy(history.get(\"process_observation_errors\", {}))\\\\n        if errors:\\\\n            process_errors[\"session_owner\"] = errors\\\\n        result[\"process_observation_errors\"] = process_errors\\\\n        if isinstance(history.get(\"downloads\"), dict):\\\\n            result[\"downloads\"] = {**deepcopy(history[\"downloads\"]), \"model_ready\": False,\\\\n                                   \"observation_stale\": True,\\\\n                                   \"lifecycle\": \"stopped\" if children_exited else \"unavailable\"}\\\\n        if not confirmed:\\\\n            result[\"error\"] = (\"Owned process cleanup remains unconfirmed\" if errors else\\\\n                               \"Manager exited before cleanup was confirmed\" if manager_alive is False else\\\\n                               \"Manager control observation unavailable\")\\\\n        return result\\\\n\\\\n    def start(self, *, background=True):\\\\n        if self._started_at is not None:\\\\n            raise RuntimeError(\"Session already started; query or stop it\")\\\\n        assert_port_available(self.port)\\\\n        manager_port = _free_port({self.port})\\\\n        model_port = _free_port({self.port, manager_port})\\\\n        self.manager_url = f\"http://127.0.0.1:{manager_port}\"\\\\n        self._environment.update(H3_API_KEY=self.api_key, H3_CONTROL_KEY=self._control_key,\\\\n                                 H3_INSTANCE_ID=self.instance_id, H3_OUTPUT_DIR=str(self.root),\\\\n                                 H3_STARTUP_TIMEOUT=str(self.startup_timeout), H3_TUNNEL_TIMEOUT=str(self.tunnel_timeout))\\\\n        self.run_directory.mkdir(parents=True, exist_ok=False)\\\\n        self._started_at = self._clock()\\\\n        self._last.update(phase=\"preparing\", cleanup_complete=False, shutdown_complete=False)\\\\n        command = [sys.executable, \"-u\", str(self.directory / \"global_manager.py\"),\\\\n                   \"--port\", str(manager_port), \"--api-port\", str(self.port),\\\\n                   \"--model-port\", str(model_port), \"--directory\", str(self.directory),\\\\n                   \"--instance-id\", self.instance_id, \"--root\", str(self.root), \"--parent-pid\", str(os.getpid()),\\\\n                   \"--startup-timeout\", str(self.startup_timeout), \"--probe-timeout\", str(self.probe_timeout),\\\\n                   \"--poll-interval\", str(self.poll_interval), \"--tunnel-timeout\", str(self.tunnel_timeout)]\\\\n        if self.staged:\\\\n            command.append(\"--staged\")\\\\n        if self.public:\\\\n            command.append(\"--public\")\\\\n        if self.install_cloudflared:\\\\n            command.append(\"--install-cloudflared\")\\\\n        if not self.model_autostart:\\\\n            command.append(\"--no-model-autostart\")\\\\n        try:\\\\n            self._output = self.manager_log.open(\"w\", encoding=\"utf-8\")\\\\n            self.manager = subprocess.Popen(command, cwd=self.directory, env=self._environment,\\\\n                                             stdout=self._output, stderr=subprocess.STDOUT,\\\\n                                             start_new_session=os.name != \"nt\")\\\\n            self._manager_owner = ProcessOwner(self.manager)\\\\n            deadline = self._clock() + 20\\\\n            while self._clock() < deadline:\\\\n                if not self._manager_tree_alive():\\\\n                    raise RuntimeError(\"Global manager exited during launch; inspect manager.log\")\\\\n                try:\\\\n                    state = rpc_