 return self._unavailable_snapshot(owner_state)\\\\n\\\\n    def control(self, action, **parameters):\\\\n        if not self.manager or not self._manager_tree_alive():\\\\n            raise ControlError(\"Manager is not running\", 503)\\\\n        return rpc_call(self.manager_url, self._control_key, \"control\",\\\\n                        {\"action\": action, \"expected_instance_id\": self.instance_id, **parameters}, timeout=10)\\\\n\\\\n    def command(self, command_id):\\\\n        return rpc_call(self.manager_url, self._control_key, \"command\", {\"command_id\": command_id})\\\\n\\\\n    def events(self, after=0, limit=100):\\\\n        return rpc_call(self.manager_url, self._control_key, \"events\", {\"after\": after, \"limit\": limit})\\\\n\\\\n    def wait_ready(self, on_update=None):\\\\n        while True:\\\\n            state = self.snapshot()\\\\n            if on_update:\\\\n                on_update(state)\\\\n            if state.get(\"ready\"):\\\\n                return state\\\\n            if state.get(\"phase\") in {\"failed\", \"stopped\", \"stopping\"} or state.get(\"error\") and state.get(\"model_alive\") is False:\\\\n                raise RuntimeError(state.get(\"error\") or \"Preparation failed; control interface remains available\")\\\\n            if self._clock() - self._started_at > self.startup_timeout:\\\\n                raise TimeoutError(\"Generation readiness deadline exceeded; query or stop the manager\")\\\\n            time.sleep(self.poll_interval)\\\\n\\\\n    def stop(self):\\\\n        if self.manager is None:\\\\n            self._last.update(phase=\"stopped\", cleanup_complete=True, manager_alive=False)\\\\n            return dict(self._last)\\\\n        if self._manager_tree_alive():\\\\n            deadline = time.monotonic() + 30\\\\n            requested = False\\\\n            command_id = \"shutdown-\" + uuid.uuid4().hex\\\\n            while time.monotonic() < deadline and self._manager_tree_alive():\\\\n                try:\\\\n                    if not requested:\\\\n                        self.control(\"shutdown\", command_id=command_id)\\\\n                        requested = True\\\\n                    self.snapshot()\\\\n                except (ControlError, OSError):\\\\n                    # A lost acknowledgement is not permission to interrupt audit\\\\n                    # finalization. Retrying this ID cannot enqueue a second stop.\\\\n                    pass\\\\n                if self.manager.poll() is not None:\\\\n                    break\\\\n                time.sleep(.2)\\\\n            # The manager exits itself only after its final command/audit checkpoint.\\\\n            # A clean child snapshot alone must not trigger an early manager signal.\\\\n        if self._manager_owner:\\\\n            owner_state = self._manager_owner.observe()\\\\n            if owner_state[\"alive\"]:\\\\n                owner_state = self._manager_owner.terminate_all(timeout=15)\\\\n        else:\\\\n            if self.manager.poll() is None:\\\\n                self.manager.terminate()\\\\n                self.manager.wait(timeout=15)\\\\n            owner_state = self._owner_observation()\\\\n        if self._output and not self._output.closed:\\\\n            self._output.close()\\\\n        try:\\\\n            recorded = json.loads(self.state_path.read_text(encoding=\"utf-8\"))\\\\n            if recorded.get(\"instance_id\") == self.instance_id:\\\\n                self._remember(recorded)\\\\n        except (OSError, ValueError):\\\\n            pass\\\\n        return self._unavailable_snapshot(owner_state, stopped=True)\\\\n\\', \\'control_protocol.py\\': \\'\"\"\"Small authenticated loopback RPC shared by the three managed processes.\"\"\"\\\\nfrom __future__ import annotations\\\\n\\\\nimport hmac\\\\nimport json\\\\nimport logging\\\\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\\\\nfrom urllib.error import HTTPError, URLError\\\\nfrom urllib.parse import urlsplit\\\\nfrom urllib.request import Request, urlopen\\\\n\\\\nMAX_BODY = 2 * 1024 * 1024\\\\nLOG = logging.getLogger(\"h3.control\")\\\\n\\\\n\\\\nclass ControlError(RuntimeError):\\\\n    def __init__(self, message: str, status: int = 409):\\\\n        super().__init__(message)\\\\n        self.status = int(status)\\\\n\\\\n\\\\ndef rpc_call(url, key, operation, payload=None, timeout=10):\\\\n    origin = urlsplit(url)\\\\n    if origin.scheme != \"http\" or origin.hostname not in {\"127.0.0.1\", \"localhost\", \"::1\"}:\\\\n        raise ControlError(\"Private control transport must use loopback HTTP\", 400)\\\\n    if origin.username or origin.password or origin.query or origin.fragment:\\\\n        raise ControlError(\"Invalid control origin\", 400)\\\\n    body = json.dumps({\"operation\": operation, \"payload\": payload or {}}, allow_nan=False).encode()\\\\n    if len(body) > MAX_BODY:\\\\n        raise ControlError(\"Control payload too large\", 413)\\\\n    request = Request(url.rstrip(\"/\") + \"/rpc\", data=body, method=\"POST\", headers={\\\\n        \"Authorization\": \"Bearer \" + key, \"Content-Type\": \"application/json\", \"Connection\": \"close\"})\\\\n    try:\\\\n        try:\\\\n            response = urlopen(request, timeout=timeout)\\\\n        except HTTPError as error:\\\\n            response = error\\\\n        with response:\\\\n            raw = response.read(MAX_BODY + 1)\\\\n            status = response.status\\\\n        if len(raw) > MAX_BODY:\\\\n            raise ControlError(\"Control response too large\", 502)\\\\n        data = json.loads(raw)\\\\n        if not isinstance(data, dict) or type(data.get(\"ok\")) is not bool:\\\\n            raise ValueError(\"Invalid response envelope\")\\\\n        if data[\"ok\"] is not True or not 200 <= status < 300:\\\\n            raise ControlError(str(data.get(\"error\", \"Control operation failed\")), data.get(\"status\", status))\\\\n        return data.get(\"result\")\\\\n    except ControlError:\\\\n        raise\\\\n    except (URLError, OSError, ValueError, TimeoutError) as error:\\\\n        raise ControlError(\"Control transport unavailable or invalid response\", 503) from error\\\\n\\\\n\\\\ndef make_server(host, port, key, dispatch):\\\\n    if host not in {\"127.0.0.1\", \"localhost\"}:\\\\n        raise ValueError(\"Private controller must bind IPv4 loopback\")\\\\n    if not isinstance(key, str) or len(key) < 32 or not key.isascii() or any(c.isspace() for c in key):\\\\n        raise ValueError(\"A private control token of at least 32 ASCII characters is required\")\\\\n\\\\n    class Handler(BaseHTTPRequestHandler):\\\\n        protocol_version = \"HTTP/1.1\"\\\\n\\\\n        def setup(self):\\\\n            super().setup()\\\\n            self.connection.settimeout(15)\\\\n\\\\n        def log_message(self, *_):\\\\n            pass  # Never log authentication headers, payloads or query secrets.\\\\n\\\\n        def reply(self, status, value):\\\\n            encoded = json.dumps(value, allow_nan=False).encode()\\\\n            self.send_response(status)\\\\n            self.send_header(\"Content-Type\", \"application/json\")\\\\n            self.send_header(\"Content-Length\", str(len(encoded)))\\\\n            self.send_header(\"Cache-Control\", \"no-store\")\\\\n            self.send_header(\"Connection\", \"close\")\\\\n            self.end_headers()\\\\n            self.close_connection = True\\\\n            try:\\\\n                self.wfile.write(encoded)\\\\n            except (BrokenPipeError, ConnectionResetError):\\\\n                pass\\\\n\\\\n        def do_GET(self):\\\\n            if self.path != \"/health\":\\\\n                return self.reply(404, {\"ok\": False, \"error\": \"Not found\", \"status\": 404})\\\\n            self.reply(200, {\"alive\": True})\\\\n\\\\n        def do_POST(self):\\\\n            if self.path != \"/rpc\":\\\\n                return self.reply(404, {\"ok\": False, \"error\": \"Not found\", \"status\": 404})\\\\n            auth = self.headers.get(\"Authorization\", \"\")\\\\n            if not auth.isascii() or not hmac.compare_digest(auth, \"Bearer \" + key):\\\\n                return self.reply(401, {\"ok\": False, \"error\": \"Private authorization required\", \"status\": 401})\\\\n            try:\\\\n                if self.headers.get(\"Transfer-Encoding\"):\\\\n                    raise ControlError(\"Chunked control requests are unsupported\", 400)\\\\n                size = int(self.headers.get(\"Content-Length\", \"0\"))\\\\n                if not 0 < size <= MAX_BODY:\\\\n                    raise ControlError(\"Invalid control payload size\", 413)\\\\n                raw = self.rfile.read(size)\\\\n                if len(raw) != size:\\\\n                    raise ControlError(\"Incomplete control request\", 400)\\\\n                data = json.loads(raw, parse_constant=lambda x: (_ for _ in ()).throw(ValueError(x)))\\\\n                if not isinstance(data, dict) or not isinstance(data.get(\"operation\"), str):\\\\n                    raise ControlError(\"Invalid control operation\", 400)\\\\n                payload = data.get(\"payload\", {})\\\\n                if not isinstance(payload, dict):\\\\n                    raise ControlError(\"Control payload must be an object\", 400)\\\\n                result = dispatch(data[\"operation\"], payload)\\\\n                self.reply(200, {\"ok\": True, \"result\": result})\\\\n            except ControlError as error:\\\\n                self.reply(error.status, {\"ok\": False, \"error\": str(error), \"status\": error.status})\\\\n            except (ValueError, TypeError) as error:\\\\n                self.reply(400, {\"ok\": False, \"error\": \"Invalid control JSON or arguments\", \"status\": 400})\\\\n            except Exception:\\\\n                LOG.exception(\"Control dispatch failed\")\\\\n                self.reply(500, {\"ok\": False, \"error\": \"Internal control operation failed; inspect owner log\", \"status\": 500})\\\\n\\\\n    server = ThreadingHTTPServer((host, int(port)), Handler)\\\\n    server.daemon_threads = True\\\\n    return server\\\\n\\', \\'process_owner.py\\': \\'\"\"\"Track and stop an owned Popen tree by PID and creation identity.\\\\n\\\\nWindows virtual-environment launchers can add a real interpreter descendant.\\\\nAn exited wrapper alone is not the definition of a fully reclaimed process tree.\\\\n\"\"\"\\\\nfrom __future__ import annotations\\\\n\\\\nfrom concurrent.futures import ThreadPoolExecutor\\\\nimport subprocess\\\\nimport threading\\\\nimport time\\\\n\\\\nimport psutil\\\\n\\\\n\\\\nclass ProcessOwner:\\\\n    def __init__(self, popen):\\\\n        self.process = popen\\\\n        self._identities = {}\\\\n        self._lock = threading.RLock()\\\\n        self._root_unknown = False\\\\n        self._unknown_scopes = set()\\\\n        try:\\\\n            process = psutil.Process(popen.pid)\\\\n            self._identities[process.pid] = process.create_time()\\\\n        except psutil.Error:\\\\n            self._root_unknown = True\\\\n            self._unknown_scopes.add(popen.pid)\\\\n\\\\n    def _same(self, pid, created):\\\\n        try:\\\\n            process = psutil.Process(pid)\\\\n            if abs(process.create_time() - created) >= .001:\\\\n                return None\\\\n            if not process.is_running() or process.status() == psutil.STATUS_ZOMBIE:\\\\n                return None\\\\n            return process\\\\n        except psutil.NoSuchProcess:\\\\n            return None\\\\n\\\\n    def _capture(self):\\\\n        errors = []\\\\n        if self._root_unknown:\\\\n            try:\\\\n                if self.process.poll() is None:\\\\n                    root = psutil.Process(self.process.pid)\\\\n                    self._identities[root.pid] = root.create_time()\\\\n                    self._root_unknown = False\\\\n                # An