cle = \"not_started\"\\n        self._public_url = None\\n        self._phase = \"new\"\\n        self._draining = False\\n        self._shutdown_started = False\\n        self._shutdown_complete = False\\n        self._exit_requested = False\\n        self._last_observation = None\\n        self._model_failure = None\\n        self._error = None\\n        self._cleanup_errors = []\\n        self._signature = None\\n        self._condition_gates = {}\\n        self._dispatch_gate_signature = None\\n        self._export_sequence = 0\\n        self._background = False\\n        self._ever_ready = False\\n        self._model_started = None\\n        self._model_unreachable = 0\\n        self._model_ever_ready = False\\n        self._public_ever_ready = False\\n        self._probe_pool = ThreadPoolExecutor(max_workers=2, thread_name_prefix=\"independent-module-probe\")\\n        self._closed = False\\n        self._recover()\\n\\n    def _event(self, kind, *, job=None, data=None):\\n        event = {\"event_id\": uuid.uuid4().hex, \"instance_id\": self.instance_id,\\n                 \"job_id\": job.get(\"job_id\") if job else None,\\n                 \"attempt_id\": job.get(\"attempt_id\") if job else None,\\n                 \"type\": kind, \"observed_at\": time.time(),\\n                 \"monotonic_ns\": time.monotonic_ns(), \"data\": data or {}}\\n        cursor = self._db.execute(\"INSERT INTO events(event_id, record) VALUES (?, ?)\",\\n                                  (event[\"event_id\"], json.dumps(event)))\\n        event[\"sequence\"] = cursor.lastrowid\\n        return event\\n\\n    def _recover(self):\\n        # OS root ownership is held, but previous child fate may be uncertain.\\n        # Never replay an accepted expensive execution after manager replacement.\\n        with self._lock, self._db:\\n            for (encoded,) in self._db.execute(\"SELECT record FROM jobs WHERE status IN (\\'queued\\',\\'running\\',\\'cancel_requested\\')\").fetchall():\\n                job = json.loads(encoded)\\n                self._transition(job, \"failed\", error=\"manager_restarted; execution not replayed\",\\n                                 cleanup_complete=False, finished_at=time.time())\\n            for command_id, encoded in self._db.execute(\"SELECT id,record FROM commands\").fetchall():\\n                command = json.loads(encoded)\\n                if command[\"status\"] in {\"accepted\", \"running\"}:\\n                    command.update(status=\"failed\", error=\"manager_restarted; command not replayed\", finished_at=time.time())\\n                    self._db.execute(\"UPDATE commands SET record=? WHERE id=?\", (json.dumps(command), command_id))\\n            self._event(\"manager.created\", data={\"recovery_policy\": \"no automatic execution replay\"})\\n\\n    def _get_job(self, job_id):\\n        row = self._db.execute(\"SELECT record FROM jobs WHERE id=?\", (job_id,)).fetchone()\\n        if not row:\\n            raise ControlError(\"Job not found\", status=404)\\n        return json.loads(row[0])\\n\\n    def _store_job(self, job):\\n        self._db.execute(\"UPDATE jobs SET status=?,record=? WHERE id=?\",\\n                         (job[\"status\"], json.dumps(job), job[\"job_id\"]))\\n\\n    def _transition(self, job, target, **updates):\\n        allowed = {\"queued\": {\"running\", \"failed\", \"cancelled\"},\\n                   \"running\": {\"queued\", \"succeeded\", \"failed\", \"cancel_requested\", \"cancelled\"},\\n                   \"cancel_requested\": {\"cancelled\", \"failed\"}}\\n        if target not in allowed.get(job[\"status\"], set()):\\n            raise RuntimeError(f\"Illegal main event transition {job[\\'status\\']} -> {target}\")\\n        job.update(status=target, **updates)\\n        job[\"lifecycle\"].append({\"state\": target, \"observed_at\": time.time()})\\n        self._store_job(job)\\n        self._event(\"job.\" + target, job=job, data={\"error\": job.get(\"error\")})\\n\\n    def _active_jobs(self):\\n        rows = self._db.execute(\"SELECT record FROM jobs WHERE status IN (\\'running\\',\\'cancel_requested\\') ORDER BY rowid\").fetchall()\\n        return [json.loads(row[0]) for row in rows]\\n\\n    def _queue_summary(self):\\n        counts = dict(self._db.execute(\"SELECT status,COUNT(*) FROM jobs GROUP BY status\").fetchall())\\n        return {\"queued\": counts.get(\"queued\", 0), \"running\": counts.get(\"running\", 0),\\n                \"cancel_requested\": counts.get(\"cancel_requested\", 0),\\n                \"unfinished\": sum(counts.get(s, 0) for s in NONTERMINAL),\\n                \"job_count_limit\": None, \"order\": \"durable_insertion_fifo\",\\n                \"admission_open\": not (self._draining or self._shutdown_started or self._model_failure\\n                                        or self._phase in {\"new\", \"failed\", \"stopped\"}),\\n                \"disk_reserve_bytes\": self.disk_reserve_bytes}\\n\\n    def _liveness(self):\\n        alive, errors = {}, {}\\n        for name, child in self.children.items():\\n            try:\\n                if name in self.owners:\\n                    observation = self.owners[name].observe()\\n                    alive[name] = observation[\"alive\"]\\n                    if observation[\"errors\"]:\\n                        errors[name] = \"; \".join(observation[\"errors\"])\\n                else:\\n                    alive[name] = child is not None and child.poll() is None\\n            except OSError as error:\\n                alive[name] = True  # Unknown exit retains ownership.\\n                errors[name] = type(error).__name__\\n        return alive, errors\\n\\n    def _historical_ownership(self):\\n        current = {launch_id for child in self.children.values() if child is not None\\n                   for launch_id in getattr(child, \"_h3_tree_records\", {}).values()}\\n        unresolved = []\\n        rows = self._db.execute(\"SELECT launch_id,module,pid,created FROM owned_processes WHERE exited=0\").fetchall()\\n        for launch_id, module, pid, created in rows:\\n            if launch_id in current:\\n                continue\\n            try:\\n                process = psutil.Process(pid)\\n                same = created is None or abs(process.create_time() - created) < .001\\n                if same and process.is_running() and process.status() != psutil.STATUS_ZOMBIE:\\n                    unresolved.append({\"module\": module, \"pid\": pid, \"identity_known\": created is not None})\\n            except psutil.NoSuchProcess:\\n                pass\\n            except psutil.Error:\\n                unresolved.append({\"module\": module, \"pid\": pid, \"identity_known\": False})\\n        return unresolved\\n\\n    def snapshot(self):\\n        with self._lock:\\n            alive, process_errors = self._liveness()\\n            historical = self._historical_ownership()\\n            age = self._clock() - self._last_observation if self._last_observation is not None else None\\n            stale = age is None or age > 3 * self.probe_timeout + self.poll_interval + 2\\n            supervised = not self._background or (self._thread is not None and self._thread.is_alive())\\n            usable = not stale and supervised and not process_errors and not self._shutdown_started\\n            api = bool(usable and alive[\"api\"] and self._api_ready)\\n            model = bool(usable and alive[\"model\"] and self._model.get(\"ready\") is True\\n                         and self._model.get(\"worker_alive\") is True and not self._model_failure)\\n            public_api = bool(api and alive[\"tunnel\"] and self._connected and self._public_api_ready)\\n            ready = api and model and not self._draining and (not self.public or public_api)\\n            phase = self._phase\\n            if phase not in {\"new\", \"stopping\", \"stopped\", \"failed\"}:\\n                phase = \"draining\" if self._draining else \"ready\" if ready else \"degraded\" if self._ever_ready or self._model_failure or self._error else \"preparing\"\\n            downloads = self._model.get(\"downloads\")\\n            if (not isinstance(downloads, dict) or downloads.get(\"model_instance_id\") != self.model_instance_id\\n                    or not isinstance(downloads.get(\"items\"), dict)):\\n                downloads = {\"schema_version\": 1, \"model_instance_id\": self.model_instance_id,\\n                             \"observed_at\": None, \"observation_stale\": True, \"items\": {},\\n                             \"error\": \"progress_not_observed_for_current_model\"}\\n            else:\\n                downloads = deepcopy(downloads)\\n            download_lifecycle = ((\"stopping\" if alive[\"model\"] else \"stopped\") if self._shutdown_started else\\n                                  \"failed\" if self._model_failure and self._model_failure != \"model_stopped\" else\\n                                  \"not_started\" if self.model_instance_id is None else\\n                                  \"stopped\" if alive[\"model\"] is False else self._model.get(\"phase\", \"unknown\"))\\n            downloads.update(model_ready=model, observation_stale=bool(downloads.get(\"observation_stale\")\\n                             or stale or not supervised or alive[\"model\"] is not True or \"model\" in process_errors),\\n                             lifecycle=download_lifecycle)\\n            result = {\"instance_id\": self.instance_id, \"phase\": phase, \"ready\": ready,\\n                      \"api_ready\": api, \"model_ready\": model, \"public_requested\": self.public,\\n                      \"public_api_ready\": public_api, \"public_ready\": public_api and model and not self._draining,\\n                      \"tunnel_connected\": bool(alive[\"tunnel\"] and self._connected), \"public_url\": self._public_url,\\n                      \"server_alive\": alive[\"api\"], \"model_alive\": alive[\"model\"], \"tunnel_alive\": alive[\"tunnel\"],\\n                      \"manager_alive\": True, \"manager_pid\": os.getpid(), \"api_pid\": getattr(self.children[\"api\"], \"pid\", None),\\n                      \"server_pid\": getattr(self.children[\"api\"], \"pid\", None),\\n                      \"model_pid\": getattr(self.children[\"model\"], \"pid\", None), \"tunnel_pid\": getattr(self.children[\"tunnel\"], \"pid\", None),\\n                      \"model_instance_id\": self.model_instance_id,\\n                      \"downloads\": downloads,\\n                      \"cleanup_complete\": not any(alive.values()) and not historical and not process_errors,\\n                      \"shutdown_complete\": self._shutdown_complete,\\n                      \"historical_ownership\": historical, \"cleanup_errors\": list(self._cleanup_errors),\\n                      \"error\": self._error or self._model_failure, \"elapsed_seconds\": round(self._clock() - self._started, 3),\\n                      \"observed_at\": time.time(), \"observation_age_seconds\": round(age, 3) if age is not None else None,\\n                      \"observation_stale\": stale, \"supervisor_alive\": supervised,\\n                      \"process_observation_errors\": process_errors, \"draining\": self._draining,\\n                      \"condition_gates\": deepcopy(self._condition_gates),\\n                      \"queue\": self._queue_summary(),\\n                      \"owned_processes\": {name: owner.observe() for name, owner in self.owners.items()},\\n                      \"state_path\": str(self.state_path), \"events_path\": str(self.events_path),\\n                      \"modules\": {\"api\": {\"alive\": alive[\"api\"], \"ready\": api,\\n                                          \"expected_running\": self._api_expected, \"lifecycle\": self._api_lifecycle,\\n                                          \"intent_epoch\": self._api_intent_epoch},\\n                                  \"model\": {**self._model, \"alive\": alive[\"model\"], \"ready\": model, \"downloads\": downloads},\\n                                  \"manager\": {\"alive\": True, \"supervisor_alive\": supervised}}}\\n            return result\\n\\n    def _checkpoint(self):\\n        with self._lock:\\n            state = self.snapshot()\\n            signature = json.dumps({k: state[k] for k in (\"phase\", \"ready\", \"api_ready\", \"model_ready\", \"public_api_ready\", \"server_alive\", \"model_alive\", \"tunnel_alive\", \"cleanup_complete\", \"error\")}, sort_keys=True)\\n            if signature != self._signature:\\n                with self._db:\\n                    self._event(\"manager.state\", data=json.loads(signature))\\n                self._signature = signature\\n            # SQLite remains authoritative if this readable export is interrupted.\\n            rows = self._db.execute(\"SELECT sequence,record FROM events WHERE sequence>? ORDER BY sequence\", (self._export_sequence,)).fetchall()\\n            if rows:\\n                with self.events_path.open(\"a\", encoding=\"utf-8\") as output:\\n                    for sequence, record in rows:\\n                        event = json.loads(record)\\n                        event[\"sequence\"] = sequence\\n                        output.write(json.dumps(event) + \"\\\\n\")\\n                    if self._shutdown_complete:\\n                        output.flush()\\n                        os.fsync(output.fileno())\\n                self._export_sequence = rows[-1][0]\\n            # Publish the final receipt only after the matching audit export.\\n            temporary = self.state_path.with_suffix(\".tmp\")\\n            with temporary.open(\"w\", encoding=\"utf-8\") as output:\\n                output.write(json.dumps(state, indent=2))\\n                if self._shutdown_complete:\\n                    output.flush()\\n                    os.fsync(output.fileno())\\n            temporary.replace(self.state_path)\\n\\n    def _spawn(self, name, command, env):\\n        output = (self.run_directory / (name + \".log\")).open(\"a\", encoding=\"utf-8\")\\n        self._files.append(output)\\n        child = self._popen(command, cwd=self.directory, env=env, stdout=output, stderr=subprocess.STDOUT)\\n        self.children[name] = child\\n        self.owners[name] = self._owner_factory(child)\\n        with self._lock, self._db:\\n            try:\\n                created = psutil.Process(child.pid).create_time()\\n            except psutil.Error:\\n                created = None\\n            launch_id = uuid.uuid4().hex\\n            child._h3_launch_id = launch_id\\n            child._h3_tree_records = {(child.pid, created): launch_id}\\n            self._db.execute(\"INSERT INTO owned_processes(launch_id,module,pid,created) VALUES (?,?,?,?)\",\\n                             (launch_id, name, child.pid, created))\\n            self._event(\"module.started\", data={\"module\": name, \"pid\": child.pid,\\n                        \"model_instance_id\": self.model_instance_id if name == \"model\" else None})\\n        return child\\n\\n    def _register_process_tree(self):\\n        with self._lock, self._db:\\n            for name, owner in self.owners.items():\\n                child = self.children[name]\\n                for identity in owner.observe()[\"identities\"]:\\n                    identity_key = (identity[\"pid\"], identity[\"created_at\"])\\n                    if identity_key not in child._h3_tree_records:\\n                        launch_id = uuid.uuid4().hex\\n                        child._h3_tree_records[identity_key] = launch_id\\n                        self._db.execute(\"INSERT INTO owned_processes(launch_id,module,pid,created) VALUES (?,?,?,?)\",\\n                                         (launch_id, name, *identity_key))\\n\\n    def _child_env(self):\\n        return {**self.env, \"H3_PARENT_PID\": str(os.getpid()),\\n                \"H3_PARENT_CREATED_AT\": str(psutil.Process(os.getpid()).create_time()), \"H3_INSTANCE_ID\": self.instance_id,\\n                \"H3_MANAGER_URL\": f\"http://127.0.0.1:{self.port}\", \"H3_OUTPUT_DIR\": str(self.root)}\\n\\n    def _set_api_expectation(self, expected):\\n        # Only time in which the API is requested to run consumes its first\\n        # public-delivery budget. An explicit stop pauses, rather than resets,\\n        # that budget, including when process exit remains unconfirmed.\\n        with self._lock:\\n            if expected != self._api_expected:\\n                now = self._clock()\\n                if self._api_expected_since is not None:\\n                    self._api_expected_elapsed += max(0.0, now - self._api_expected_since)\\n                self._api_expected_since = now if expected else None\\n                self._api_expected = expected\\n\\n    def _launch_api(self):\\n        alive, errors = self._liveness()\\n        if alive[\"api\"] or \"api\" in errors:\\n            raise ControlError(\"API ownership has not been released\", status=409)\\n        with self._lock:\\n            self._api_ready = self._public_api_ready = False\\n            self._set_api_expectation(True)\\n            self._api_intent_epoch += 1\\n            self._api_lifecycle = \"starting\"\\n        self._spawn(\"api\", [sys.executable, \"-m\", \"uvicorn\", \"server:create_app\", \"--factory\", \"--host\", \"127.0.0.1\",\\n                            \"--port\", str(self.api_port), \"--workers\", \"1\", \"--limit-concurrency\", \"8\"], self._child_env())\\n\\n    def _launch_model(self):\\n        alive, errors = self._liveness()\\n        if alive[\"model\"] or \"model\" in errors:\\n            raise ControlError(\"Old model ownership has not been released\", status=409)\\n        with self._lock:\\n            old_processes = self._db.execute(\"SELECT launch_id,pid,created FROM owned_processes WHERE module=\\'model\\' AND exited=0\").fetchall()\\n        for launch_id, pid, created in old_processes:\\n            try:\\n                process = psutil.Process(pid)\\n                same = created is None or abs(process.create_time() - created) < .001\\n                if same and process.is_running() and process.status() != psutil.STATUS_ZOMBIE:\\n                    raise ControlError(\"Previous model process exit is unconfirmed\", status=409)\\n            except psutil.NoSuchProcess:\\n                pass\\n            except psutil.Error:\\n                raise ControlError(\"Previous model process identity is inaccessible\", status=409)\\n            with self._lock, self._db:\\n                self._db.execute(\"UPDATE owned_processes SET exited=1 WHERE launch_id=?\", (launch_id,))\\n        self.model_instance_id = uuid.uuid4().hex\\n        self._model = {\"phase\": \"loading\", \"instance_id\": self.model_instance_id, \"ready\": False}\\n        self._model_failure = None\\n        self._model_started = self._clock()\\n        self._model_unreachable = 0\\n        self._model_ever_ready = False\\n        command = [sys.executable, \"-u\", str(self.directory / \"model_container.py\"), \"--port\", str(self.model_port),\\n                   \"--instance-id\", self.model_instance_id, \"--root\", str(self.root), \"--parent-pid\", str(os.getpid())]\\n        if self.staged:\\n            command.append(\"--staged\")\\n        env = self._child_env()\\n        env.update(H3_MODEL_INSTANCE_ID=self.model_instance_id,\\n                   H3_DOWNLOAD_PROGRESS_PATH=str(self.run_directory / (\"model-\" + self.model_instance_id + \".downloads.json\")))\\n        self._spawn(\"model\", command, env)\\n\\n    def start(self, *, background=True):\\n        with self._control_lock:\\n            if self._phase != \"new\":\\n                raise ControlError(\"Manager already started\", status=409)\\n            self._phase, self._background = \"preparing\", bool(background)\\n            try:\\n                env = self._child_env()\\n                self._launch_api()\\n                if self.model_autostart:\\n                    try:\\n                        self._launch_model()\\n                    except ControlError:\\n                        # Recovery may observe a previous owner child still exiting.\\n                        # Keep the API/control plane available; never overlap models.\\n                        self._model_failure = \"previous_model_exit_unconfirmed\"\\n                else:\\n                    self._model = {\"instance_id\": None, \"phase\": \"not_started\", \"ready\": False,\\n                                   \"worker_alive\": False, \"accepting\": False}\\n                    with self._lock, self._db:\\n                        self._event(\"model.autostart_skipped\", data={\"reason\": \"explicit_configuration\"})\\n                if self.public:\\n                    command = [sys.executable, \"-u\", str(self.directory / \"tunnel.py\"), \"--port\", str(self.api_port),\\n                               \"--status-file\", str(self.run_directory / \"tunnel-status.json\"), \"--instance-id\", self.instance_id]\\n                    if self.install_cloudflared:\\n                        command.append(\"--install\")\\n                    self._spawn(\"tunnel\", command, env)\\n                if background:\\n                    self._thread = threading.Thread(target=self._monitor, name=\"main-event-supervisor\", daemon=True)\\n                    self._thread.start()\\n                self._checkpoint()\\n            except BaseException:\\n                self._error = \"module_start_failed\"\\n                self.shutdown()\\n                self._phase = \"failed\"\\n                raise\\n        return self\\n\\n    def _transport(self):\\n        try:\\n            path = self.run_directory / \"tunnel-status.json\"\\n            if path.stat().st_size > 16384:\\n                return None, False\\n            body = json.loads(path.read_text(encoding=\"utf-8\"))\\n            url = body.get(\"url\") if isinstance(body, dict) else None\\n            if (body.get(\"instance_id\") != self.instance_id or not isinstance(url, str)\\n                    or not re.fullmatch(r\"https://[a-z0-9-]+\\\\.trycloudflare\\\\.com\", url)):\\n                return None, False\\n            return url, body.get(\"connected\") is True and body.get(\"phase\") not in {\"failed\", \"stopping\", \"stopped\"}\\n        except (OSError, ValueError, TypeError, AttributeError):\\n            return None, False\\n\\n    def _fail_jobs_after_exit(self, reason):\\n        with self._lock, self._db:\\n            for (encoded,) in self._db.execute(\"SELECT record FROM jobs WHERE status IN (\\'queued\\',\\'running\\',\\'cancel_requested\\')\").fetchall():\\n                job = json.loads(encoded)\\n                target = \"cancelled\" if job[\"status\"] == \"cancel_requested\" else \"failed\"\\n                cleaned, cleanup_errors = self._cleanup_job_files(job[\"job_id\"], discard_result=True)\\n                self._transition(job, target, error=reason, finished_at=time.time(), cleanup_complete=cleaned,\\n                                 cleanup_errors=cleanup_errors, model_lease_released=True)\\n\\n    def _cleanup_job_files(self, job_id, *, discard_result):\\n        errors = []\\n        job_root = self.root / job_id\\n        if not job_root.resolve().is_relative_to(self.root) or job_root.is_symlink():\\n            return False, [\"job_directory_identity_invalid\"]\\n        try:\\n            shutil.rmtree(job_root / \"inputs\")\\n        except FileNotFoundError:\\n            pass\\n        except OSError as error:\\n            errors.append(\"inputs: \" + type(error).__name__)\\n        if discard_result:\\n            for name in (\"result.mp4\", \"result.metrics.json\"):\\n                try:\\n                    (job_root / name).unlink(missing_ok=True)\\n                except OSError as error:\\n                    errors.append(name + \": \" + type(error).__name__)\\n        return not errors, errors\\n\\n    def _model_probe(self, expected_instance_id):\\n        try:\\n            candidate = self._rpc(f\"http://127.0.0.1:{self.model_port}\", self.key, \"status\", {}, timeout=self.probe_timeout)\\n            if isinstance(candidate, dict) and candidate.get(\"instance_id\") == expected_instance_id:\\n                return candidate\\n        except Exception:\\n            pass\\n        return None\\n\\n    def refresh(self):\\n        with self._refresh_lock:\\n            if self._shutdown_started:\\n                return self.snapshot()\\n            with self._control_lock:\\n                self._register_process_tree()\\n                alive, errors = self._liveness()\\n                observed_model_id, observed_child = self.model_instance_id, self.children[\"model\"]\\n                observed_api_child = self.children[\"api\"]\\n                observed_api_epoch = self._api_intent_epoch\\n            api_future = (self._probe_pool.submit(self._probe, f\"http://127.0.0.1:{self.api_port}\", self.instance_id, self.probe_timeout)\\n                          if alive[\"api\"] else None)\\n            model_future = (self._probe_pool.submit(self._model_probe, observed_model_id)\\n                            if alive[\"model\"] and \"model\" not in errors else None)\\n            api_ready = bool(api_future.result()) if api_future else False\\n            model = model_future.result() if model_future else None\\n            url, connected = self._transport() if self.public and alive[\"tunnel\"] else (None, False)\\n            public_api = bool(api_ready and connected and self._probe(url, self.instance_id, self.probe_timeout))\\n            with self._control_lock:\\n                if (self._shutdown_started or observed_model_id != self.model_instance_id\\n                        or observed_child is not self.children[\"model\"] or observed_api_child is not self.children[\"api\"]\\n                        or observed_api_epoch != self._api_intent_epoch):\\n                    return self.snapshot()  # Discard a previous model generation\\'s observations.\\n                if alive[\"model\"] and \"model\" not in errors:\\n                    self._model_unreachable = 0 if model else self._model_unreachable + 1\\n                with self._lock:\\n                    self._api_ready = bool(api_ready and self._api_expected)\\n                    self._public_api_ready = bool(public_api and self._api_expected)\\n                    self._connected = connected\\n                    if url:\\n                        self._public_url = url\\n                    previous_downloads = self._model.get(\"downloads\")\\n                    self._model = model or {\"instance_id\": self.model_instance_id, \"ready\": False,\\n                                            \"phase\": \"unreachable\" if alive[\"model\"] else\\n                                                     \"not_started\" if self.model_instance_id is None else \"stopped\"}\\n                    if not model and isinstance(previous_downloads, dict):\\n                        self._model[\"downloads\"] = {**deepcopy(previous_downloads), \"observation_stale\": True}\\n                    self._last_observation = self._clock()\\n                    if model and model.get(\"ready\") is True:\\n                        self._model_ever_ready = True\\n                    if self._public_api_ready:\\n                        self._public_ever_ready = True\\n                        if self._error and self._error.startswith(\"public_\"):\\n                            self._error = None\\n                    if not alive[\"api\"] and self._api_expected:\\n                        self._error = \"api_process_exited; model and durable jobs retained\"\\n                        self._api_lifecycle = \"failed\"\\n                    elif api_ready and self._error and self._error.startswith(\"api_\"):\\n                        self._error = None\\n                    if self._api_expected and api_ready:\\n                        self._api_lifecycle = \"ready\"\\n                    if not alive[\"model\"] and self.model_instance_id is not None:\\n                        self._model_failure = self._model_failure or \"model_process_exited\"\\n                    elif model and model.get(\"phase\") == \"failed\":\\n                        self._model_failure = \"model_load_or_worker_failed\"\\n                if not alive[\"model\"] and \"model\" not in errors and self.model_instance_id is not None:\\n                    self._fail_jobs_after_exit(\"model_process_exited\")\\n                elif model:\\n                    self._consume_result(model)\\n                    with self._lock:\\n                        expired = any(time.time() - job[\"started_at\"] > self.generation_timeout\\n                                      for job in self._active_jobs())\\n                    # A dead worker can no longer own a useful execution. Confirm\\n                    # process exit before releasing the main execution lease.\\n                    if expired:\\n                        self._stop_model(force=True, reason=\"generation_deadline_exceeded\")\\n                    elif self._model_failure or model.get(\"phase\") == \"failed\" or (model.get(\"worker_alive\") is False and model.get(\"phase\") not in {\"starting\", \"loading\"}):\\n                        with self._control_lock:\\n                            self._stop_model(force=True, reason=\"model_worker_failed\")\\n                    else:\\n                        self._dispatch_next(model)\\n                if alive[\"model\"] and self._model_unreachable >= 3:\\n                    with self._control_lock:\\n                        self._stop_model(force=True, reason=\"model_control_unreachable_for_three_cycles\")\\n                with self._lock:\\n                    active = self._active_jobs()\\n                if any(time.time() - job[\"started_at\"] > self.generation_timeout for job in active):\\n                    with self._control_lock:\\n                        self._stop_model(force=True, reason=\"generation_deadline_exceeded\")\\n                if self.snapshot()[\"ready\"]:\\n                    self._ever_ready = True\\n                if (self._model_started is not None and not self._model_ever_ready and self._clock() - self._model_started > self.startup_timeout\\n                        and not self._model.get(\"ready\") and not active and alive[\"model\"]):\\n                    with self._control_lock:\\n                        self._stop_model(force=True, reason=\"model_startup_deadline_exceeded\")\\n                public_elapsed = self._api_expected_elapsed\\n                if self._api_expected_since is not None:\\n                    public_elapsed += max(0.0, self._clock() - self._api_expected_since)\\n                if (self.public and self._api_expected and not self._public_ever_ready\\n                        and public_elapsed > self.tunnel_timeout):\\n                    self._error = \"public_preparation_deadline_exceeded; local API and model retained\"\\n                self._checkpoint()\\n                return self.snapshot()\\n\\n    def _consume_result(self, model):\\n        results = model.get(\"results\")\\n        if not isinstance(results, list):\\n            results = [model.get(\"last_result\")]  # Read old checkpoints without losing their result.\\n        acknowledgements = []\\n        for result in results:\\n            if not isinstance(result, dict) or result.get(\"status\") not in TERMINAL:\\n                continue\\n            with self._lock, self._db:\\n                try:\\n                    job = self._get_job(result.get(\"job_id\"))\\n                except ControlError:\\n                    continue\\n                if (result.get(\"attempt_id\") != job[\"attempt_id\"]\\n                        or model.get(\"instance_id\") != job[\"model_instance_id\"]\\n                        or result.get(\"instance_id\", model[\"instance_id\"]) != job[\"model_instance_id\"]):\\n                    continue\\n                if job[\"status\"] in TERMINAL:\\n                    acknowledgements.append(job[\"attempt_id\"])\\n                    continue\\n                if job[\"status\"] not in {\"running\", \"cancel_requested\"}:\\n                    continue\\n                if result.get(\"cleanup_complete\") is not True:\\n                    self._model_failure = \"model_attempt_cleanup_unconfirmed\"\\n                    job.update(error=self._model_failure, cleanup_complete=False)\\n                    self._store_job(job)\\n                    self._event(\"job.cleanup_pending\", job=job)\\n                    continue  # Retain ownership until process exit is confirmed.\\n                target, artifact = result[\"status\"], result.get(\"artifact\")\\n                cancellation_requested = job[\"status\"] == \"cancel_requested\"\\n                if cancellation_requested and target != \"failed\":\\n                    target, artifact = \"cancelled\", None\\n                elif target == \"succeeded\":\\n                    artifact = self._verified_artifact(job[\"job_id\"], artifact)\\n                    if artifact is None:\\n                        target = \"failed\"\\n                cleaned, cleanup_errors = self._cleanup_job_files(job[\"job_id\"], discard_result=target != \"succeeded\")\\n                self._transition(job, target, artifact=artifact if target == \"succeeded\" else None,\\n                                 error=None if target == \"succeeded\" else result.get(\"error\") or \"result_not_committed\",\\n                                 metrics=result.get(\"metrics\"), finished_at=time.time(), cleanup_complete=cleaned,\\n                                 cancellation_requested=cancellation_requested,\\n                                 execution_condition_gates=deepcopy(result.get(\"condition_gates\")),\\n                                 stage_completions=deepcopy(result.get(\"stage_completions\")),\\n                                 generation_options=result.get(\"generation_options\") or job.get(\"generation_options\"),\\n                                 cleanup_errors=cleanup_errors, model_lease_released=True, dispatch_state=\"completed\")\\n                acknowledgements.append(job[\"attempt_id\"])\\n        # The durable transaction must commit before the model may discard a result.\\n        if acknowledgements and isinstance(model.get(\"results\"), list):\\n            try:\\n                self._rpc(f\"http://127.0.0.1:{self.model_port}\", self.key, \"ack_results\",\\n                          {\"instance_id\": model[\"instance_id\"], \"attempt_ids\": acknowledgements}, timeout=self.probe_timeout)\\n            except Exception:\\n                pass  # Next status repeats the durable results; acknowledge idempotently.\\n\\n    def _verified_artifact(self, job_id, artifact):\\n        if not isinstance(artifact, dict):\\n            return None\\n        try:\\n            path = Path(artifact[\"path\"]).resolve()\\n            lexical = self.root / job_id / \"result.mp4\"\\n            expected = lexical.resolve()\\n            if (path != expected or not path.is_relative_to(self.root) or not path.is_file()\\n                    or lexical.is_symlink() or not isinstance(artifact.get(\"media\"), dict)\\n                    or artifact[\"media\"].get(\"full_decode_passed\") is not True):\\n                return None\\n            if path.stat().st_size != artifact[\"bytes\"] or artifact[\"bytes\"] <= 0:\\n                return None\\n            if not re.fullmatch(r\"[a-f0-9]{64}\", artifact.get(\"sha256\", \"\")):\\n                return None\\n            with path.open(\"rb\") as source:\\n                actual = hashlib.file_digest(source, \"sha256\").hexdigest()\\n            if actual != artifact[\"sha256\"]:\\n                return None\\n            return artifact\\n        except (KeyError, OSError, TypeError, ValueError):\\n            return None\\n\\n    def _dispatch_gate(self, model, job, attempt_id):\\n        \"\"\"Called only in the dispatch/cancel arbitration and state transaction.\\n\\n        The remote observation permits an offer, not remote execution. Container\\n        admission and resource ownership are revalidated by their own owners.\\n        \"\"\"\\n        model = model if isinstance(model, dict) else {}\\n        alive, errors = self._liveness()\\n        age = self._clock() - self._last_observation if self._last_observation is not None else None\\n        bound = 3 * self.probe_timeout + self.poll_interval + 2\\n        identity = self.model_instance_id\\n        identities = (identity, model.get(\"instance_id\"), self._model.get(\"instance_id\"))\\n        current_identity = (all(value == identity for value in identities)\\n                            if all(isinstance(value, str) and value for value in identities) else None)\\n        def capability(field):\\n            witnesses = [model.get(field), self._model.get(field)]\\n            # Missing or malformed fresh evidence cannot borrow a previous True.\\n            return witnesses if all(type(value) is bool for value in witnesses) else None\\n        observations = {\\n            # Draining closes new admission; the already-owned queue still drains.\\n            \"manager_open\": self._shutdown_started is False and self._model_failure is None,\\n            \"job_queued\": job.get(\"status\") == \"queued\", \"attempt_unassigned\": job.get(\"attempt_id\") is None,\\n            \"model_identity_current\": current_identity,\\n            \"model_observation_fresh\": None if age is None else 0 <= age <= bound,\\n            \"model_process_alive\": None if \"model\" in errors else alive.get(\"model\"),\\n            \"model_ready\": capability(\"ready\"),\\n            \"worker_alive\": capability(\"worker_alive\"),\\n            \"worker_accepting\": capability(\"accepting\"),\\n            \"supervisor_alive\": not self._background or (self._thread is not None and self._thread.is_alive()),\\n        }\\n        receipt = evaluate_gate(\"manager.dispatch\", DISPATCH_CONDITIONS, observations,\\n            {\"manager_instance_id\": self.instance_id, \"model_instance_id\": identity, \"job_id\": job[\"job_id\"],\\n             \"attempt_id\": attempt_id, \"source_file\": \"global_manager.py\", \"source_sha256\": GATE_SOURCE_SHA256})\\n        # Commit every positive authorization; coalesce unchanged blocked polls.\\n        signature = json.dumps({\"job_id\": job[\"job_id\"], \"model_instance_id\": identity,\\n                                \"conditions\": receipt[\"conditions\"]}, sort_keys=True)\\n        if receipt[\"allowed\"] or signature != self._dispatch_gate_signature:\\n            self._dispatch_gate_signature = signature\\n            self._condition_gates[\"manager.dispatch\"] = receipt\\n            job[\"condition_gate\"] = receipt\\n            self._store_job(job)\\n            self._event(\"condition.checked\", job=job, data={\"receipt\": receipt})\\n        return receipt\\n\\n    def _dispatch_next(self, model):\\n        with self._control_lock:\\n            deadline = time.monotonic() + max(.01, min(.25, self.poll_interval))\\n            while not self._shutdown_started and not self._model_failure:\\n                with self._lock, self._db:\\n                    row = self._db.execute(\"SELECT record FROM jobs WHERE status=\\'queued\\' ORDER BY rowid LIMIT 1\").fetchone()\\n                    if not row:\\n                        return\\n                    job = json.loads(row[0])\\n                    prospective_attempt = uuid.uuid4().hex\\n                    receipt = self._dispatch_gate(model, job, prospective_attempt)\\n                    if receipt[\"allowed\"] is not True:\\n                        return\\n                    self._transition(job, \"running\", attempt_id=prospective_attempt,\\n                                     model_instance_id=self.model_instance_id, started_at=time.time(), cleanup_complete=False,\\n                                     model_lease_released=False, dispatch_state=\"offering\", dispatch_reason=None)\\n                    self._event(\"job.dispatch_intent\", job=job, data={\"condition_decision_id\": receipt[\"decision_id\"]})\\n                # running means this attempt\\'s ownership, not ownership of the GPU.\\n                # The model stage scheduler alone grants the one GPU lease.\\n                payload = {\"job_id\": job[\"job_id\"], \"attempt_id\": job[\"attempt_id\"],\\n                           \"instance_id\": self.model_instance_id, \"parameters\": job[\"parameters\"]}\\n                try:\\n                    response = self._rpc(f\"http://127.0.0.1:{self.model_port}\", self.key, \"execute\", payload, timeout=self.probe_timeout)\\n                    if not isinstance(response, dict) or response.get(\"accepted\") is not True:\\n                        raise ValueError(\"Invalid execution acknowledgement\")\\n                    for field in (\"job_id\", \"attempt_id\", \"instance_id\"):\\n                        if response.get(field) != payload[field]:\\n                            raise ValueError(\"Execution acknowledgement identity mismatch\")\\n                except Exception as error:\\n                    rejected = None\\n                    if isinstance(error, ControlError):\\n                        try:\\n                            rejected = json.loads(str(error))\\n                        except (ValueError, TypeError):\\n                            pass\\n                    if isinstance(rejected, dict) and rejected.get(\"guarantees_not_accepted\") is True:\\n                        with self._lock, self._db:\\n                            if error.status in {409, 429}:\\n                                self._transition(job, \"queued\", attempt_id=None, model_instance_id=None,\\n                                                 started_at=None, model_lease_released=True, dispatch_state=\"deferred\",\\n                                                 dispatch_reason=rejected.get(\"reason\"))\\n                                return  # FIFO: do not bypass the head to fill a smaller task.\\n                            cleaned, cleanup_errors = self._cleanup_job_files(job[\"job_id\"], discard_result=True)\\n                            self._transition(job, \"failed\", error=str(error), finished_at=time.time(),\\n                                             model_lease_released=True, cleanup_complete=cleaned,\\n                                             cleanup_errors=cleanup_errors, dispatch_state=\"rejected\")\\n                    else:\\n                        # A missing acknowledgement is not evidence of rejection.\\n                        # Reconcile this exact attempt, never send execute twice.\\n                        observed = self._model_probe(self.model_instance_id)\\n                        records = ((observed or {}).get(\"attempts\", []) + (observed or {}).get(\"results\", []))\\n                        matched = any(isinstance(item, dict) and all(item.get(k) == payload[k]\\n                                      for k in (\"job_id\", \"attempt_id\", \"instance_id\")) for item in records)\\n                        if not matched:\\n                            self._stop_model(force=True, reason=\"execution_acknowledgement_uncertain\")\\n                            return\\n                        with self._lock, self._db:\\n                            job.update(dispatch_state=\"reconciled\")\\n                            self._store_job(job)\\n                            self._event(\"job.dispatch_reconciled\", job=job)\\n                        self._model = observed\\n                        self._consume_result(observed)\\n                        return\\n                else:\\n                    with self._lock, self._db:\\n                        job.update(dispatch_state=\"accepted\")\\n                        self._store_job(job)\\n                        self._event(\"job.dispatch_accepted\", job=job)\\n                if time.monotonic() >= deadline:\\n                    return\\n\\n    def _monitor(self):\\n        try:\\n            while not self._cancel.is_set():\\n                self.refresh()\\n                self._cancel.wait(self.poll_interval)\\n        except BaseException as error:\\n            LOG.exception(\"Main event supervision failed\")\\n            with self._lock:\\n                self._error = \"supervisor_failed: \" + type(error).__name__\\n                self._phase, self._draining = \"failed\", True\\n            # Retain the control plane, but end uncertain model ownership.\\n            with self._control_lock:\\n                self._stop_model(force=True, reason=\"supervisor_failed\")\\n            try:\\n                self._checkpoint()\\n            except Exception:\\n                LOG.exception(\"Could not export final supervisor failure\")\\n\\n    def submit(self, payload):\\n        job_id, parameters = payload.get(\"job_id\"), payload.get(\"parameters\")\\n        if not isinstance(job_id, str) or not IDENTIFIER.fullmatch(job_id) or not isinstance(parameters, dict):\\n            raise ControlError(\"Invalid job request\", status=422)\\n        try:\\n            options = requested_options(parameters)\\n            validate_generation_options(options, load_adapter_settings())\\n        except (KeyError, ValueError, TypeError) as error:\\n            raise ControlError(f\"Invalid generation options: {error}\", status=422) from None\\n        refs = parameters.get(\"references\")\\n        if not isinstance(refs, list) or not 1 <= len(refs) <= 12:\\n            raise ControlError(\"Invalid reference list\", status=422)\\n        input_root = (self.root / job_id / \"inputs\").resolve()\\n        if not input_root.is_relative_to(self.root):\\n            raise ControlError(\"Input directory escapes output root\", status=422)\\n        for ref in refs:\\n            try:\\n                path = Path(ref[\"path\"]).resolve()\\n                if not path.is_relative_to(input_root) or not path.is_file() or Path(ref[\"path\"]).is_symlink():\\n                    raise ValueError()\\n            except (KeyError, TypeError, OSError, ValueError):\\n                raise ControlError(\"References must be owned input files\", status=422)\\n        idem, fingerprint = payload.get(\"idempotency_key\"), payload.get(\"fingerprint\")\\n        if idem is not None and (not isinstance(idem, str) or not 1 <= len(idem) <= 128 or not isinstance(fingerprint, str)):\\n            raise ControlError(\"Invalid idempotency key or fingerprint\", status=422)\\n        with self._lock, self._db:\\n            if idem is not None:\\n                row = self._db.execute(\"SELECT fingerprint,record FROM jobs WHERE idempotency_key=?\", (idem,)).fetchone()\\n                if row:\\n                    if row[0] != fingerprint:\\n                        raise ControlError(\"Idempotency key conflicts with request\", status=409)\\n                    return self._public_job(json.loads(row[1]))\\n            if self._draining or self._shutdown_started or self._phase in {\"new\", \"failed\", \"stopped\"} or self._model_failure:\\n                raise ControlError(\"Generation admission is closed\", status=409)\\n            if shutil.disk_usage(self.root).free < self.disk_reserve_bytes + 65536:\\n                raise ControlError(\"Insufficient disk space for durable queue metadata\", status=507)\\n            if self._db.execute(\"SELECT 1 FROM jobs WHERE id=?\", (job_id,)).fetchone():\\n                raise ControlError(\"Job ID already exists\", status=409)\\n            now = time.time()\\n            job = {\"job_id\": job_id, \"status\": \"queued\", \"created_at\": now, \"started_at\": None,\\n                   \"finished_at\": None, \"attempt_id\": None, \"model_instance_id\": None,\\n                   \"parameters\": parameters, \"error\": None, \"artifact\": None, \"metrics\": None,\\n                   \"generation_options\": {\"requested\": options, \"effective\": None},\\n                    \"cleanup_complete\": False, \"model_lease_released\": True, \"dispatch_state\": \"pending\",\\n                   \"lifecycle\": [{\"state\": \"queued\", \"observed_at\": now}]}\\n            self._db.execute(\"INSERT INTO jobs VALUES (?,?,?,?,?)\", (job_id, \"queued\", idem, fingerprint, json.dumps(job)))\\n            self._event(\"job.queued\", job=job)\\n            return self._public_job(job)\\n\\n    def _public_job(self, job):\\n        result = {k: v for k, v in job.items() if k != \"parameters\"}\\n        # Public task identity belongs to this durable manager/API lifetime;\\n        # model_instance_id separately identifies a replaceable GPU process.\\n        result[\"instance_id\"] = self.instance_id\\n        result[\"queue_position\"] = (self._db.execute(\"SELECT COUNT(*) FROM jobs WHERE status=\\'queued\\' AND rowid <= (SELECT rowid FROM jobs WHERE id=?)\",\\n                                                    (job[\"job_id\"],)).fetchone()[0] if job[\"status\"] == \"queued\" else None)\\n        result[\"waiting_for\"] = None\\n        if job[\"status\"] == \"queued\":\\n            # This is a current observation, separate from the last durable\\n            # dispatch rejection. Do not make clients infer it from a log line.\\n            if self._shutdown_started:\\n                result[\"waiting_for\"] = \"shutdown\"\\n            elif self._model_failure:\\n                result[\"waiting_for\"] = \"model_recovery\"\\n            elif self._model.get(\"ready\") is not True or self._model.get(\"worker_alive\") is not True:\\n                result[\"waiting_for\"] = \"model_ready\"\\n            elif self._model.get(\"accepting\") is not True:\\n                result[\"waiting_for\"] = \"model_capacity\"\\n            elif result[\"queue_position\"] > 1:\\n                result[\"waiting_for\"] = \"earlier_jobs\"\\n            else:\\n                result[\"waiting_for\"] = \"scheduler\"\\n        result[\"active_phase\"] = None\\n        if job[\"status\"] in {\"running\", \"cancel_requested\"}:\\n            for attempt in self._model.get(\"attempts\", []):\\n                if attempt.get(\"attempt_id\") == job[\"attempt_id\"] and attempt.get(\"job_id\") == job[\"job_id\"]:\\n                    result[\"active_phase\"] = attempt.get(\"active_phase\") or {\"phase\": attempt.get(\"phase\", attempt.get(\"status\"))}\\n                    if isinstance(attempt.get(\"generation_options\"), dict):\\n                        result[\"generation_options\"] = deepcopy(attempt[\"generation_options\"])\\n                    break\\n            if result[\"active_phase\"] is None and job[\"attempt_id\"] == self._model.get(\"active_attempt_id\"):\\n                result[\"active_phase\"] = self._model.get(\"active_phase\")\\n        return result\\n\\n    def archive(self, payload):\\n        \"\"\"Record a client-confirmed Drive upload for the committed artifact.\"\"\"\\n        job_id, file_id = payload.get(\"job_id\"), payload.get(\"file_id\")\\n        sha256, size = payload.get(\"sha256\"), payload.get(\"bytes\")\\n        if (not isinstance(job_id, str) or not IDENTIFIER.fullmatch(job_id)\\n                or not isinstance(file_id, str) or not DRIVE_FILE_ID.fullmatch(file_id)\\n                or not isinstance(sha256, str) or not SHA256.fullmatch(sha256)\\n                or type(size) is not int or size <= 0):\\n            raise ControlError(\"Invalid Google Drive archive receipt\", status=422)\\n        receipt = {\"provider\": \"google_drive\", \"file_id\": file_id, \"sha256\": sha256, \"bytes\": size}\\n        with self._lock, self._db:\\n            job = self._get_job(job_id)\\n            if job[\"status\"] != \"succeeded\":\\n                raise ControlError(\"Only a succeeded job can be archived\", status=409)\\n            artifact = job.get(\"artifact\")\\n            media = artifact.get(\"media\") if isinstance(artifact, dict) else None\\n            if (not isinstance(media, dict) or media.get(\"full_decode_passed\") is not True\\n                    or artifact.get(\"sha256\") != sha256 or artifact.get(\"bytes\") != size):\\n                raise ControlError(\"Archive receipt does not match the committed artifact\", status=409)\\n            previous = job.get(\"archive\")\\n            if previous is None:\\n                job[\"archive\"] = receipt\\n                self._store_job(job)\\n                self._event(\"job.archived\", job=job, data={\"provider\": \"google_drive\"})\\n            elif previous != receipt:\\n                raise ControlError(\"Job already has a different archive receipt\", status=409)\\n            return self._public_job(job)\\n\\n    def cancel(self, job_id):\\n        with self._control_lock:\\n            with self._lock, self._db:\\n                job = self._get_job(job_id)\\n                if job[\"status\"] in TERMINAL:\\n                    return self._public_job(job)\\n                if job[\"status\"] == \"queued\":\\n                    cleaned, cleanup_errors = self._cleanup_job_files(job_id, discard_result=True)\\n                    self._transition(job, \"cancelled\", finished_at=time.time(), cleanup_complete=cleaned,\\n                                     cleanup_errors=cleanup_errors, model_lease_released=True)\\n                    return self._public_job(job)\\n                if job[\"status\"] == \"running\":\\n                    self._transition(job, \"cancel_requested\")\\n            try:\\n                self._rpc(f\"http://127.0.0.1:{self.model_port}\", self.key, \"cancel\",\\n                          {\"job_id\": job_id, \"attempt_id\": job[\"attempt_id\"], \"instance_id\": job[\"model_instance_id\"]},\\n                          timeout=self.probe_timeout)\\n            except Exception:\\n                pass  # Request remains pending; execution lease is not released.\\n            return self._public_job(job)\\n\\n    def _terminate(self, name, timeout=15):\\n        child = self.children[name]\\n        if child is None:\\n            return True\\n        owner = self.owners.get(name)\\n        if owner:\\n            self._register_process_tree()\\n            return self._record_tree_exit(name, owner.terminate_all(timeout))\\n        try:\\n            if child.poll() is None:\\n                child.terminate()\\n                try:\\n                    child.wait(timeout=timeout)\\n                except subprocess.TimeoutExpired:\\n                    child.kill()\\n                    child.wait(timeout=3)\\n            exited = child.poll() is not None\\n            if exited and hasattr(child, \"_h3_launch_id\"):\\n                with self._lock, self._db:\\n                    self._db.execute(\"UPDATE owned_processes SET exited=1 WHERE launch_id=?\", (child._h3_launch_id,))\\n            return exited\\n        except (OSError, subprocess.SubprocessError) as error:\\n            self._cleanup_errors.append(name + \": \" + type(error).__name__)\\n            return False\\n\\n    def _record_tree_exit(self, name, observed):\\n        if observed[\"cleanup_complete\"]:\\n            with self._lock, self._db:\\n                for launch_id in self.children[name]._h3_tree_records.values():\\n                    self._db.execute(\"UPDATE owned_processes SET exited=1 WHERE launch_id=?\", (launch_id,))\\n            return True\\n        self._cleanup_errors.append(name + \".tree: \" + \"; \".join(observed[\"errors\"] or [\"exit unconfirmed\"]))\\n        return False\\n\\n    def _stop_model(self, *, force=False, reason=\"model_stopped\"):\\n        with self._lock:\\n            active = self._active_jobs()\\n            queued = self._db.execute(\"SELECT COUNT(*) FROM jobs WHERE status=\\'queued\\'\").fetchone()[0]\\n            if (active or queued) and not force:\\n                raise ControlError(\"Model has unfinished jobs; drain or explicitly force stop\", status=409)\\n            self._model_failure = reason\\n            self._model[\"ready\"] = False\\n        if self._terminate(\"model\"):\\n            self._fail_jobs_after_exit(reason)\\n            downloads = self._model.get(\"downloads\")\\n            self._model = {\"instance_id\": self.model_instance_id, \"phase\": \"stopped\", \"ready\": False,\\n                           \"worker_alive\": False, \"cleanup_complete\": True}\\n            if isinstance(downloads, dict):\\n                self._model[\"downloads\"] = {**deepcopy(downloads), \"observation_stale\": True}\\n            with self._lock, self._db:\\n                self._event(\"model.stopped\", data={\"reason\": reason, \"cleanup_complete\": True})\\n        else:\\n            raise ControlError(\"Model exit is unconfirmed; lease retained\", status=503)\\n\\n    def _control_action(self, action, payload):\\n        with self._control_lock:\\n            if action == \"shutdown\":\\n                state = self.shutdown()\\n                if (state.get(\"cleanup_complete\") is not True or state.get(\"process_observation_errors\")\\n                        or any(state.get(name) is not False for name in (\"server_alive\", \"model_alive\", \"tunnel_alive\"))):\\n                    raise ControlError(\"Shutdown cleanup is unconfirmed; manager remains available for retry\", status=503)\\n            elif action == \"stop_model\":\\n                self._stop_model(force=payload.get(\"force\") is True)\\n            elif action == \"start_model\":\\n                if self._shutdown_started or self._phase in {\"failed\", \"stopped\"}:\\n                    raise ControlError(\"Manager is stopping or failed\", status=409)\\n                self._launch_model()\\n            elif action == \"stop_api\":\\n                with self._lock, self._db:\\n                    self._set_api_expectation(False)\\n                    self._api_intent_epoch += 1\\n                    self._api_lifecycle = \"stopping\"\\n                    self._api_ready = self._public_api_ready = False\\n                    if self._error and self._error.startswith(\"api_\"):\\n                        self._error = None\\n                    self._event(\"api.stop_requested\", data={\"intent_epoch\": self._api_intent_epoch})\\n                if not self._terminate(\"api\"):\\n                    self._api_lifecycle = \"stop_unconfirmed\"\\n                    raise ControlError(\"API process exit is unconfirmed\", status=503)\\n                self._api_lifecycle = \"stopped\"\\n                with self._lock, self._db:\\n                    self._event(\"api.stopped\", data={\"intent_epoch\": self._api_intent_epoch, \"cleanup_complete\": True})\\n            elif action == \"start_api\":\\n                if self._shutdown_started or self._phase in {\"failed\", \"stopped\"}:\\n                    raise ControlError(\"Manager cannot start API\", status=409)\\n                self._launch_api()\\n            elif action == \"drain\":\\n                self._draining = True  # Existing queue continues to drain.\\n            elif action == \"resume\":\\n                if self._shutdown_started or self._phase in {\"failed\", \"stopped\"}:\\n                    raise ControlError(\"Manager cannot resume\", status=409)\\n                self._draining = False\\n            else:\\n                raise ControlError(\"Unknown control action\", status=422)\\n            self._checkpoint()\\n\\n    def control(self, payload):\\n        action = payload.get(\"action\")\\n        if action not in {\"drain\", \"resume\", \"start_model\", \"stop_model\", \"start_api\", \"stop_api\", \"shutdown\"}:\\n            raise ControlError(\"Unknown control action\", status=422)\\n        command_id = payload.get(\"command_id\") or uuid.uuid4().hex\\n        if not isinstance(command_id, str) or not 1 <= len(command_id) <= 128:\\n            raise ControlError(\"Invalid command ID\", status=422)\\n        fingerprint = json.dumps({\"action\": action, \"force\": payload.get(\"force\") is True}, sort_keys=True)\\n        record = {\"command_id\": command_id, \"action\": action, \"status\": \"accepted\", \"created_at\": time.time(), \"error\": None}\\n\\n        def run():\\n            try:\\n                self._control_action(action, payload)\\n                result = {**record, \"status\": \"succeeded\", \"finished_at\": time.time()}\\n            except BaseException as error:\\n                LOG.exception(\"Control operation failed\")\\n                result = {**record, \"status\": \"failed\", \"error\": str(error) if isinstance(error, ControlError) else type(error).__name__,\\n                          \"finished_at\": time.time()}\\n            try:\\n                with self._lock, self._db:\\n                    self._db.execute(\"UPDATE commands SET record=? WHERE id=?\", (json.dumps(result), command_id))\\n                    self._event(\"command.\" + result[\"status\"], data={\"command_id\": command_id, \"action\": action, \"error\": result.get(\"error\")})\\n                self._checkpoint()\\n                if action == \"shutdown\" and result[\"status\"] == \"succeeded\":\\n                    self._exit_requested = True\\n            finally:\\n                self._control_slots.release()\\n\\n        thread = threading.Thread(target=run, name=\"main-control-\" + action, daemon=True)\\n        with self._lock:\\n            existing = self._db.execute(\"SELECT fingerprint,record FROM commands WHERE id=?\", (command_id,)).fetchone()\\n            if existing:\\n                if existing[0] != fingerprint:\\n                    raise ControlError(\"Command ID conflicts\", status=409)\\n                return json.loads(existing[1])\\n            if self._control_admission_closed or (self._shutdown_started and action != \"shutdown\"):\\n                raise ControlError(\"Manager is closing; new control operations are unavailable\", status=409)\\n            if not self._control_slots.acquire(blocking=False):\\n                raise ControlError(\"Control operation queue is full\", status=429)\\n            try:\\n                with self._db:\\n                    self._db.execute(\"INSERT INTO commands VALUES (?,?,?)\", (command_id, fingerprint, json.dumps(record)))\\n                    self._event(\"command.accepted\", data={\"command_id\": command_id, \"action\": action})\\n            except BaseException:\\n                self._control_slots.release()\\n                raise\\n            # Admission, registration and start share close()\\'s barrier. An\\n            # accepted command can never appear after its worker join snapshot.\\n            self._control_threads = [t for t in self._control_threads if t.ident is None or t.is_alive()]\\n            self._control_threads.append(thread)\\n            try:\\n                thread.start()\\n            except BaseException:\\n                self._control_slots.release()\\n                with self._db:\\n                    record.update(status=\"failed\", error=\"command_worker_start_failed\", finished_at=time.time())\\n                    self._db.execute(\"UPDATE commands SET record=? WHERE id=?\", (json.dumps(record), command_id))\\n                    self._event(\"command.failed\", data={\"command_id\": command_id, \"error\": record[\"error\"]})\\n                raise\\n        return record\\n\\n    def dispatch(self, operation, payload=None):\\n        payload = payload or {}\\n        if operation in {\"submit\", \"cancel\", \"control\", \"archive\"} and payload.get(\"expected_instance_id\", self.instance_id) != self.instance_id:\\n            raise ControlError(\"Manager instance changed; command rejected\", status=409)\\n        if operation == \"status\":\\n            return self.snapshot()\\n        if operation == \"submit\":\\n            return self.submit(payload)\\n        if operation == \"job\":\\n            with self._lock:\\n                return self._public_job(self._get_job(payload.get(\"job_id\")))\\n        if operation == \"archive\":\\n            return self.archive(payload)\\n        if operation == \"cancel\":\\n            return self.cancel(payload.get(\"job_id\"))\\n        if operation == \"control\":\\n            return self.control(payload)\\n        if operation == \"command\":\\n            with self._lock:\\n                row = self._db.execute(\"SELECT record FROM commands WHERE id=?\", (payload.get(\"command_id\"),)).fetchone()\\n                if not row:\\n                    raise ControlError(\"Command not found\", status=404)\\n                return json.loads(row[0])\\n        if operation == \"events\":\\n            try:\\n                after, limit = max(0, int(payload.get(\"after\", 0))), min(500, max(1, int(payload.get(\"limit\", 100))))\\n            except (TypeError, ValueError):\\n                raise ControlError(\"Invalid event cursor\", status=422)\\n            with self._lock:\\n                rows = self._db.execute(\"SELECT sequence,record FROM events WHERE sequence>? ORDER BY sequence LIMIT ?\", (after, limit)).fetchall()\\n            events = [{**json.loads(encoded), \"sequence\": seq} for seq, encoded in rows]\\n            return {\"events\": events, \"next_cursor\": events[-1][\"sequence\"] if events else after}\\n        raise ControlError(\"Unknown manager operation\", status=404)\\n\\n    def shutdown(self):\\n        with self._control_lock:\\n            self._shutdown_started, self._draining, self._phase = True, True, \"stopping\"\\n            with self._lock:\\n                self._set_api_expectation(False)\\n                self._api_intent_epoch += 1\\n                self._api_lifecycle = \"stopping\"\\n                self._api_ready = self._public_api_ready = False\\n            self._cancel.set()\\n            self._register_process_tree()\\n            names = [name for name in (\"tunnel\", \"api\", \"model\") if name in self.owners]\\n            results = stop_many([self.owners[name] for name in names], timeout=15)\\n            for name, observed in zip(names, results):\\n                self._record_tree_exit(name, observed)\\n            alive, errors = self._liveness()\\n            self._api_lifecycle = \"stopped\" if not alive[\"api\"] and \"api\" not in errors else \"stop_unconfirmed\"\\n            if not alive[\"model\"] and \"model\" not in errors:\\n                self._fail_jobs_after_exit(\"manager_stopped\")\\n            with self._lock:\\n                historical = self._historical_ownership()\\n            self._phase = \"failed\" if any(alive.values()) or errors or historical else \"stopped\"\\n            if any(alive.values()) or errors or historical:\\n                self._error = \"cleanup_incomplete; owned processes remain\"\\n            elif self._error in {\"cleanup_incomplete; owned processes remain\", \"audit_export_failed_during_shutdown\"}:\\n                self._error = None\\n            try:\\n                self._checkpoint()\\n            except (OSError, sqlite3.Error):\\n                self._error = \"audit_export_failed_during_shutdown\"\\n                LOG.exception(\"Could not export shutdown audit\")\\n            return self.snapshot()\\n\\n    def close(self):\\n        with self._lock:\\n            if self._closed:\\n                return\\n            self._control_admission_closed = True\\n        self.shutdown()\\n        if self._thread and self._thread is not threading.current_thread() and self._thread.ident is not None:\\n            self._thread.join(timeout=3 * self.probe_timeout + self.poll_interval + 2)\\n            if self._thread.is_alive():\\n                raise RuntimeError(\"Cannot finalize shutdown with a live supervisor\")\\n        for thread in self._control_threads:\\n            if thread is not threading.current_thread() and thread.ident is not None:\\n                thread.join(timeout=20)\\n                if thread.is_alive():\\n                    raise RuntimeError(\"Cannot finalize shutdown with a live control operation\")\\n        self._probe_pool.shutdown(wait=True, cancel_futures=True)\\n        alive, errors = self._liveness()\\n        if any(value is not False for value in alive.values()) or errors or self._historical_ownership():\\n            raise RuntimeError(\"Cannot release root ownership with live children\")\\n        with self._lock:\\n            self._shutdown_complete = True\\n            try:\\n                with self._db:\\n                    self._event(\"manager.shutdown_complete\")\\n                self._checkpoint()\\n            except BaseException:\\n                self._shutdown_complete = False\\n                raise\\n            self._db.close()\\n            self._owner.close()\\n            self._closed = True\\n        for output in self._files:\\n            output.close()\\n\\n\\ndef main():\\n    parser = argparse.ArgumentParser(description=__doc__)\\n    for argument in (\"port\", \"api-port\", \"model-port\"):\\n        parser.add_argument(\"--\" + argument, required=True, type=int)\\n    parser.add_argument(\"--directory\", required=True, type=Path)\\n    parser.add_argument(\"--root\", required=True, type=Path)\\n    parser.add_argument(\"--instance-id\", required=True)\\n    parser.add_argument(\"--staged\", action=\"store_true\")\\n    parser.add_argument(\"--public\", action=\"store_true\")\\n    parser.add_argument(\"--install-cloudflared\", action=\"store_true\")\\n    parser.add_argument(\"--no-model-autostart\", action=\"store_true\",\\n                        help=\"Start API/public transport only; start_model control can launch the model later\")\\n    parser.add_argument(\"--parent-pid\", type=int)\\n    parser.add_argument(\"--startup-timeout\", type=float, default=3600)\\n    parser.add_argument(\"--generation-timeout\", type=float, default=5400)\\n    parser.add_argument(\"--poll-interval\", type=float, default=1)\\n    parser.add_argument(\"--probe-timeout\", type=float, default=2)\\n    parser.add_argument(\"--tunnel-timeout\", type=float, default=180)\\n    args = parser.parse_args()\\n    manager = GlobalManager(args.directory, root=args.root, instance_id=args.instance_id,\\n                            port=args.port, api_port=args.api_port, model_port=args.model_port,\\n                            staged=args.staged, public=args.public, install_cloudflared=args.install_cloudflared,\\n                            start_model=not args.no_model_autostart,\\n                            startup_timeout=args.startup_timeout, generation_timeout=args.generation_timeout,\\n                            poll_interval=args.poll_interval, probe_timeout=args.probe_timeout, tunnel_timeout=args.tunnel_timeout)\\n    server = make_server(\"127.0.0.1\", args.port, manager.key, manager.dispatch)\\n    serve_thread = threading.Thread(target=server.serve_forever, name=\"manager-control-http\", daemon=True)\\n    stop_requested = False\\n\\n    def request_stop(*_):\\n        # Python signal handlers can interrupt/re-enter Event.set while its\\n        # non-reentrant Condition lock is held. Only assign a flag here.\\n        nonlocal stop_requested\\n        stop_requested = True\\n    parent_identity = None\\n    if args.parent_pid:\\n        try:\\n            parent_identity = float(os.environ.get(\"H3_PARENT_CREATED_AT\") or psutil.Process(args.parent_pid).create_time())\\n        except (psutil.Error, ValueError):\\n            stop_requested = True\\n    signal.signal(signal.SIGTERM, request_stop)\\n    signal.signal(signal.SIGINT, request_stop)\\n    try:\\n        serve_thread.start()\\n        if stop_requested:\\n            raise RuntimeError(\"Manager owner identity is unavailable\")\\n        manager.start()\\n        while not stop_requested and not manager._exit_requested:\\n            time.sleep(.1)\\n            if args.parent_pid:\\n                try:\\n                    parent = psutil.Process(args.parent_pid)\\n                    if parent_identity is None or abs(parent.create_time() - parent_identity) >= .001 or not parent.is_running():\\n                        break\\n                except psutil.Error:\\n                    break\\n    finally:\\n        manager.close()\\n        server.shutdown()\\n        server.server_close()\\n        serve_thread.join(timeout=3)\\n\\n\\nif __name__ == \"__main__\":\\n    logging.basicConfig(level=logging.INFO)\\n    main()\\n', 'model_container.py': '\"\"\"Private, independently supervised MiniMax-H3 model runtime.\\n\\nThe HTTP controller never imports torch or loads weights. The supervised owner\\nloads after binding its socket. Budgeted CPU stages overlap across requests and\\nshare one exclusive GPU lease. Production backends retain native BF16; injected\\nbackends are only a test seam.\\n\"\"\"\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport copy\\nfrom contextlib import contextmanager\\nfrom fractions import Fraction\\nimport gc\\nimport hashlib\\nimport json\\nimport logging\\nimport math\\nimport os\\nfrom pathlib import Path\\nimport queue\\nimport re\\nimport shutil\\nimport signal\\nimport sqlite3\\nimport subprocess\\nimport sys\\nimport threading\\nimport time\\nimport uuid\\n\\nfrom control_protocol import ControlError, make_server\\nfrom condition_guard import evaluate_gate, negate_observation, observation_state\\nfrom download_progress import read_progress\\nfrom pipeline_scheduler import BudgetUnavailable, PipelineBudget\\n\\nLOG = logging.getLogger(\"h3.model_container\")\\nIDENTIFIER = re.compile(r\"[a-f0-9]{32}\\\\Z\")\\nTERMINAL = {\"succeeded\", \"failed\", \"cancelled\"}\\nSOURCE_SHA256 = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()\\nEXECUTE_CONDITIONS = (\"instance_matches\", \"request_validated\", \"model_loaded\", \"worker_alive\",\\n    \"capability_available\", \"not_draining\", \"not_stopping\", \"attempt_available\", \"job_unowned\",\\n    \"artifact_absent\", \"generation_options_valid\", \"resources_reserved\")\\nSTAGE_CONDITIONS = (\"instance_matches\", \"attempt_owned\", \"attempt_live\", \"model_loaded\", \"worker_alive\",\\n    \"capability_available\", \"admission_confirmed\", \"predecessor_completed\", \"stage_not_started\",\\n    \"cancel_flag_clear\", \"cancel_event_clear\", \"reservation_owned\", \"budget_grant_held\")\\n\\n\\nclass ExecutionCancelled(Exception):\\n    pass\\n\\n\\nclass ConditionGateBlocked(RuntimeError):\\n    \"\"\"Missing or contradictory evidence is a failed execution, not cancellation.\"\"\"\\n    pass\\n\\n\\ndef _all_observed(values):\\n    \"\"\"Conjoin distinct obligations; a missing obligation is not a spare witness.\"\"\"\\n    states = [observation_state(value) for value in values]\\n    if \"conflict\" in states:\\n        return \"conflict\"\\n    if \"unknown\" in states:\\n        return None\\n    return all(state == \"true\" for state in states)\\n\\n\\ndef parent_identity(parent_pid):\\n    \"\"\"Bind ownership to one OS process generation, including on Windows.\"\"\"\\n    import psutil\\n    try:\\n        process = psutil.Process(parent_pid)\\n        # A Windows venv redirector may be the OS parent. The authenticated\\n        # launcher specifies the actual owner; bind to that process generation.\\n        if not process.is_running() or process.status() == psutil.STATUS_ZOMBIE:\\n            raise RuntimeError(\"The requested model owner is not alive\")\\n        return process.create_time()\\n    except psutil.Error as error:\\n        raise RuntimeError(\"Cannot establish the model parent process identity\") from error\\n\\n\\ndef parent_is_alive(parent_pid, created_at):\\n    import psutil\\n    try:\\n        process = psutil.Process(parent_pid)\\n        return (process.is_running() and process.create_time() == created_at\\n                and process.status() != psutil.STATUS_ZOMBIE)\\n    except psutil.Error:\\n        # Unverified ownership must not retain a costly unmanaged model worker.\\n        return False\\n\\n\\ndef verify_artifact(path: Path, parameters: dict, *, cpu_threads=1) -> dict:\\n    \"\"\"Validate the entire audiovisual artifact before publishing success.\"\"\"\\n    if path.is_symlink() or not path.is_file() or not path.stat().st_size:\\n        raise ValueError(\"Missing model artifact\")\\n    probe = subprocess.run(\\n        [\"ffprobe\", \"-v\", \"error\", \"-threads\", str(cpu_threads), \"-count_frames\", \"-show_streams\", \"-show_format\", \"-of\", \"json\", str(path)],\\n        capture_output=True, text=True, timeout=120, check=True,\\n    )\\n    data = json.loads(probe.stdout)\\n    streams = data.get(\"streams\", [])\\n    video = next((x for x in streams if x.get(\"codec_type\") == \"video\"), None)\\n    audio = next((x for x in streams if x.get(\"codec_type\") == \"audio\"), None)\\n    if video is None or audio is None:\\n        raise ValueError(\"Artifact must contain video and audio\")\\n    frames = int(video.get(\"nb_read_frames\") or video.get(\"nb_frames\") or 0)\\n    fps = float(Fraction(video.get(\"avg_frame_rate\", \"0\")))\\n    duration = float(video.get(\"duration\") or data.get(\"format\", {}).get(\"duration\") or 0)\\n    expected_frames = 5 + 17 * math.ceil((round(parameters[\"seconds\"] * 24) - 5) / 17)\\n    if ((video.get(\"width\"), video.get(\"height\")) != (parameters[\"width\"], parameters[\"height\"])\\n            or video.get(\"codec_name\") != \"h264\" or frames != expected_frames\\n            or abs(fps - 24) > .01 or not math.isfinite(duration)\\n            or abs(duration - expected_frames / 24) > .1 or int(audio.get(\"channels\", 0)) != 2):\\n        raise ValueError(\"Artifact media does not match the admitted request\")\\n    subprocess.run(\\n        [\"ffmpeg\", \"-nostdin\", \"-v\", \"error\", \"-xerror\", \"-threads\", str(cpu_threads),\\n         \"-filter_threads\", \"1\", \"-filter_complex_threads\", \"1\", \"-i\", str(path),\\n         \"-map\", \"0:v:0\", \"-map\", \"0:a:0\", \"-f\", \"null\", \"-\"],\\n        capture_output=True, text=True, timeout=300, check=True,\\n    )\\n    digest = hashlib.sha256()\\n    with path.open(\"rb\") as source:\\n        for block in iter(lambda: source.read(1024 * 1024), b\"\"):\\n            digest.update(block)\\n    return {\"path\": str(path), \"bytes\": path.stat().st_size, \"sha256\": digest.hexdigest(),\\n            \"media\": {\"video_codec\": video[\"codec_name\"], \"width\": video[\"width\"], \"height\": video[\"height\"],\\n                      \"decoded_frames\": frames, \"fps\": fps, \"duration_seconds\": duration,\\n                      \"audio_codec\": audio.get(\"codec_name\"), \"audio_channels\": audio[\"channels\"],\\n                      \"audio_sample_rate\": audio.get(\"sample_rate\"), \"full_decode_passed\": True}}\\n\\n\\nclass ModelContainer:\\n    def __init__(self, root, instance_id, *, backend=None, staged=False,\\n                 artifact_validator=verify_artifact, resource_limits=None, progress_path=None):\\n        if not isinstance(instance_id, str) or not IDENTIFIER.fullmatch(instance_id):\\n            raise ValueError(\"Model instance must be a 32-character hexadecimal ID\")\\n        self.root = Path(root).resolve()\\n        self.root.mkdir(parents=True, exist_ok=True)\\n        self.instance_id, self.staged = instance_id, bool(staged)\\n        self.backend = backend\\n        self._injected_backend = backend is not None\\n        self._resource_limits = resource_limits\\n        self._pipeline = False\\n        self._budget = None\\n        self._stage_workers = {}\\n        self._results = {}\\n        self.artifact_validator = artifact_validator\\n        self.event_directory = self.root / \"_model_runtime\" / instance_id\\n        if self.event_directory.resolve() != self.event_directory:\\n            raise ValueError(\"Model audit directory must not traverse a symlink\")\\n        self.event_directory.mkdir(parents=True, exist_ok=True)\\n        self.events_path = self.event_directory / \"events.jsonl\"\\n        self.progress_path = Path(progress_path) if progress_path else self.event_directory / \"downloads.json\"\\n        self._lock = threading.RLock()\\n        self._queue = queue.Queue()\\n        self._worker = None\\n        self._done = threading.Event()\\n        self._stop_requested = False\\n        self._draining = False\\n        self._loaded = False\\n        self._phase = \"loading\"\\n        self._error = None\\n        self._active = None\\n        self._last_result = None\\n        self._attempts = {}\\n        self._sequence = 0\\n        self._consecutive_failures = 0\\n        self._worker_cleanup_complete = False\\n        self._last_condition_gate = None\\n        self._ledger_path = self.event_directory / \"attempts.sqlite3\"\\n        ledger = sqlite3.connect(self._ledger_path)\\n        try:\\n            with ledger:\\n                ledger.execute(\"CREATE TABLE IF NOT EXISTS acknowledged (attempt_id TEXT PRIMARY KEY, record TEXT NOT NULL)\")\\n        finally:\\n            ledger.close()\\n\\n    def _previous_attempt(self, attempt_id):\\n        if attempt_id in self._attempts:\\n            return self._attempts[attempt_id]\\n        # Open briefly so acknowledgement does not retain a lifetime DB handle.\\n        ledger = sqlite3.connect(self._ledger_path)\\n        try:\\n            row = ledger.execute(\"SELECT record FROM acknowledged WHERE attempt_id=?\", (attempt_id,)).fetchone()\\n            return json.loads(row[0]) if row else None\\n        finally:\\n            ledger.close()\\n\\n    def _live_attempts(self):\\n        return [value for value in self._attempts.values() if value[\"status\"] not in TERMINAL]\\n\\n    def _event(self, kind, **data):\\n        with self._lock:\\n            self._sequence += 1\\n            event = {\"sequence\": self._sequence, \"event_id\": uuid.uuid4().hex,\\n                     \"instance_id\": self.instance_id, \"type\": kind, \"observed_at\": time.time(),\\n                     \"monotonic_ns\": time.monotonic_ns(), **data}\\n            try:\\n                with self.events_path.open(\"a\", encoding=\"utf-8\") as output:\\n                    output.write(json.dumps(event, ensure_ascii=False) + \"\\\\n\")\\n                    output.flush()\\n                    os.fsync(output.fileno())\\n            except OSError as error:\\n                self._loaded = False\\n                self._phase = \"failed\"\\n                self._error = \"model_audit_unavailable\"\\n                raise ControlError(\"Model audit storage unavailable\", status=503) from error\\n\\n    def _safe_event(self, kind, **data):\\n        try:\\n            self._event(kind, **data)\\n        except BaseException:\\n            LOG.exception(\"Could not persist model event %s\", kind)\\n\\n    def _gate(self, gate_id, required, observations, *, job_id, attempt_id, attempt=None, **context):\\n        \"\"\"Caller owns _lock; persist the decision before permitting its effect.\"\"\"\\n        receipt = evaluate_gate(gate_id, required, observations, {\\n            \"instance_id\": self.instance_id, \"job_id\": job_id, \"attempt_id\": attempt_id,\\n            \"source_file\": \"model_container.py\", \"source_sha256\": SOURCE_SHA256, **context})\\n        self._event(\"condition.gate\", job_id=job_id, attempt_id=attempt_id,\\n                    gate_id=gate_id, receipt=receipt)\\n        self._last_condition_gate = receipt\\n        if attempt is not None:\\n            attempt.setdefault(\"condition_gates\", {})[gate_id] = receipt\\n        return receipt\\n\\n    def _capability_observation(self, *, admitted=False):\\n        if type(self._phase) is not str:\\n            return None\\n        allowed = {\"ready\", \"running\", \"draining\"} if admitted else {\"ready\", \"running\"}\\n        if self._phase in allowed:\\n            return True\\n        if self._phase in {\"loading\", \"starting\", \"failed\", \"stopped\", \"draining\"}:\\n            return False\\n        return None\\n\\n    def start(self):\\n        with self._lock:\\n            if self._worker is not None:\\n                raise ControlError(\"Model container has already started\", status=409)\\n            self._event(\"model.loading\")\\n            self._worker = threading.Thread(target=self._work, name=\"h3-model-worker\", daemon=False)\\n            try:\\n                self._worker.start()\\n            except BaseException:\\n                self._phase, self._error = \"failed\", \"worker_start_failed\"\\n                self._loaded = False\\n                self._done.set()\\n                self._safe_event(\"model.failed\", error=self._error)\\n                raise\\n        return self\\n\\n    def status(self):\\n        with self._lock:\\n            alive = self._worker is not None and self._worker.is_alive()\\n            if self._worker is not None and not alive and self._phase not in {\"failed\", \"stopped\"}:\\n                self._phase, self._error, self._loaded = \"failed\", \"worker_exited\", False\\n            ready = self._loaded is True and alive and self._capability_observation() is True\\n            downloads = read_progress(self.progress_path, expected_instance_id=self.instance_id)\\n            downloads.update(model_ready=ready, lifecycle=self._phase,\\n                             observation_stale=bool(downloads.get(\"observation_stale\") or not alive))\\n            phase = None\\n            snapshot = getattr(self.backend, \"phase_snapshot\", None)\\n            if snapshot:\\n                try:\\n                    phase = snapshot()\\n                except Exception:\\n                    phase = None\\n            active = self._active\\n            live = self._live_attempts()\\n            # Keep each reply below the private protocol\\'s bounded body. Results\\n            # remain owned until ack; additional pages surface after that ack.\\n            results, result_bytes = [], 0\\n            for result in self._results.values():\\n                size = len(json.dumps(result).encode())\\n                if results and result_bytes + size > 1024 * 1024:\\n                    break\\n                results.append(result)\\n                result_bytes += size\\n            return copy.deepcopy({\\n                \"instance_id\": self.instance_id, \"phase\": self._phase, \"ready\": ready,\\n                \"accepting\": ready and self._draining is False and self._stop_requested is False and (\\n                    self._budget.has_capacity() if self._pipeline else active is None),\\n                \"pipeline\": self._pipeline,\\n                \"downloads\": downloads,\\n                \"budget\": self._budget.snapshot() if self._budget else None,\\n                \"attempts\": [{**self._accepted(item), \"phase\": item.get(\"stage\", item[\"status\"]),\\n                              \"generation_options\": item.get(\"generation_options\"),\\n                              \"condition_gates\": item.get(\"condition_gates\", {}),\\n                              \"stage_completions\": item.get(\"stage_completions\", {}),\\n                              \"cancel_requested\": item[\"cancel_requested\"]} for item in live],\\n                \"results\": results, \"pending_results\": len(self._results),\\n                \"active_job_id\": active[\"job_id\"] if active else None,\\n                \"active_attempt_id\": active[\"attempt_id\"] if active else None,\\n                \"cancel_requested\": bool(active and active[\"cancel_requested\"]),\\n                \"active_phase\": phase, \"last_result\": self._last_result,\\n                \"worker_alive\": alive, \"cleanup_complete\": False,\\n                \"worker_cleanup_complete\": self._worker_cleanup_complete,\\n                \"cleanup_scope\": \"Process exit must be confirmed by the owner before GPU ownership is released\",\\n                \"error\": self._error, \"observed_at\": time.time(), \"event_sequence\": self._sequence,\\n                \"last_condition_gate\": self._last_condition_gate,\\n            })\\n\\n    def _check_instance(self, payload, required=False):\\n        instance = payload.get(\"instance_id\")\\n        if instance != self.instance_id and (required or instance is not None):\\n            raise ControlError(\"Model instance does not match this execution generation\", status=409)\\n\\n    def _request(self, payload):\\n        self._check_instance(payload, required=True)\\n        job_id, attempt_id = payload.get(\"job_id\"), payload.get(\"attempt_id\")\\n        if any(not isinstance(x, str) or not IDENTIFIER.fullmatch(x) for x in (job_id, attempt_id)):\\n            raise ControlError(\"Invalid job or attempt identity\", status=422)\\n        parameters = payload.get(\"parameters\")\\n        names = {\"prompt\", \"references\", \"seconds\", \"width\", \"height\", \"steps\", \"seed\"}\\n        optional = {\"attention_backend\", \"acceleration_lora\"}\\n        if not isinstance(parameters, dict) or not names <= set(parameters) or set(parameters) - names - optional:\\n            raise ControlError(\"Invalid generation parameters\", status=422)\\n        p = copy.deepcopy(parameters)\\n        try:\\n            from adapter_config import load_adapter_settings\\n            from generation_options import requested_options, validate_generation_options\\n            validate_generation_options(requested_options(p), load_adapter_settings())\\n        except (TypeError, ValueError) as error:\\n            raise ControlError(str(error), status=422) from None\\n        if not isinstance(p[\"prompt\"], str) or not p[\"prompt\"].strip() or len(p[\"prompt\"]) > 4000:\\n            raise ControlError(\"Invalid prompt\", status=422)\\n        if any(isinstance(p[k], bool) or not isinstance(p[k], int) for k in (\"width\", \"height\", \"steps\", \"seed\")):\\n            raise ControlError(\"Generation dimensions, steps and seed must be integers\", status=422)\\n        if (not 256 <= p[\"width\"] <= 1344 or not 256 <= p[\"height\"] <= 1344\\n                or p[\"width\"] % 32 or p[\"height\"] % 32 or p[\"width\"] * p[\"height\"] > 1344 * 768\\n                or not 2 <= p[\"steps\"] <= 50 or not 0 <= p[\"seed\"] <= 2147483647):\\n            raise ControlError(\"Generation parameters outside resource limits\", status=422)\\n        seconds = p[\"seconds\"]\\n        if (isinstance(seconds, bool) or not isinstance(seconds, (int, float)) or not math.isfinite(seconds)\\n                or not 5 <= seconds <= 15 or 5 + 17 * math.ceil((round(seconds * 24) - 5) / 17) > 360):\\n            raise ControlError(\"Invalid generation duration\", status=422)\\n        refs = p[\"references\"]\\n        if not isinstance(refs, list) or not 1 <= len(refs) <= 12:\\n            raise ControlError(\"Supply 1-12 references\", status=422)\\n        directory = self.root / job_id\\n        inputs = directory / \"inputs\"\\n        if directory.resolve() != directory or inputs.resolve() != inputs:\\n            raise ControlError(\"Reference directory must stay within its assigned job\", status=422)\\n        kinds = []\\n        total = 0\\n        for ref in refs:\\n            if not isinstance(ref, dict) or set(ref) != {\"kind\", \"path\"} or ref[\"kind\"] not in {\"image\", \"video\", \"audio\"}:\\n                raise ControlError(\"Invalid reference metadata\", status=422)\\n            try:\\n                path = Path(ref[\"path\"])\\n                resolved = path.resolve(strict=True)\\n                size = resolved.stat().st_size\\n                valid = (path.is_absolute() and resolved.is_relative_to(inputs) and path == resolved\\n                         and resolved.is_file() and not path.is_symlink() and 0 < size <= 32 * 1024 * 1024)\\n            except (OSError, TypeError, ValueError):\\n                valid = False\\n            if not valid:\\n                raise ControlError(\"Reference path is missing, oversized or outside its assigned inputs\", status=422)\\n            total += size\\n            ref[\"path\"] = str(resolved)\\n            kinds.append(ref[\"kind\"])\\n        if (total > 64 * 1024 * 1024 or kinds.count(\"image\") > 9 or kinds.count(\"video\") > 3\\n                or kinds.count(\"audio\") > 3 or all(k == \"audio\" for k in kinds)):\\n            raise ControlError(\"Reference combination outside resource limits\", status=422)\\n        fingerprint = hashlib.sha256(json.dumps(p, sort_keys=True).encode()).hexdigest()\\n        return job_id, attempt_id, p, fingerprint\\n\\n    def execute(self, payload):\\n        # Idempotent replies must remain possible after inputs have been cleaned.\\n        self._check_instance(payload, required=True)\\n        attempt_id = payload.get(\"attempt_id\")\\n        with self._lock:\\n            old = self._previous_attempt(attempt_id) if isinstance(attempt_id, str) else None\\n            if old:\\n                candidate = hashlib.sha256(json.dumps(payload.get(\"parameters\"), sort_keys=True).encode()).hexdigest()\\n                if old[\"job_id\"] != payload.get(\"job_id\") or old[\"fingerprint\"] != candidate:\\n                    raise ControlError(\"Attempt identity was reused with different parameters\", status=409)\\n                return self._accepted(old)\\n        try:\\n            job_id, attempt_id, parameters, fingerprint = self._request(payload)\\n        except ControlError as error:\\n            if error.status == 422:\\n                raise ControlError(json.dumps({\"guarantees_not_accepted\": True,\\n                                               \"reason\": \"invalid_request\", \"detail\": str(error)}), 422) from None\\n            raise\\n        # Header probes can perform bounded I/O. Do not hold the controller\\'s\\n        # state lock while estimating an otherwise unadmitted request.\\n        resources = None\\n        with self._lock:\\n            estimator = self.backend if self._pipeline and self._loaded is True and self._draining is False else None\\n        if estimator is not None:\\n            try:\\n                resources = estimator.estimate_resources(parameters)\\n            except ValueError:\\n                raise ControlError(json.dumps({\"guarantees_not_accepted\": True,\\n                                               \"reason\": \"invalid_reference_media\"}), status=422) from None\\n        with self._lock:\\n            old = self._previous_attempt(attempt_id)\\n            if old:\\n                if old[\"job_id\"] != job_id or old[\"fingerprint\"] != fingerprint:\\n                    raise ControlError(\"Attempt identity conflict\", status=409)\\n                return self._accepted(old)\\n            output = self.root / job_id / \"result.mp4\"\\n            validator = getattr(self.backend, \"validate_request\", None)\\n            options_valid = True\\n            if validator:\\n                try:\\n                    validator(steps=parameters[\"steps\"], **{name: parameters[name]\\n                        for name in (\"attention_backend\", \"acceleration_lora\") if name in parameters})\\n                except ValueError:\\n                    options_valid = False\\n            observations = {\\n                \"instance_matches\": payload.get(\"instance_id\") == self.instance_id,\\n                \"request_validated\": True,\\n                \"model_loaded\": self._loaded,\\n                \"worker_alive\": self._worker.is_alive() if self._worker is not None else False,\\n                \"capability_available\": self._capability_observation(),\\n                \"not_draining\": negate_observation(self._draining),\\n                \"not_stopping\": negate_observation(self._stop_requested),\\n                \"attempt_available\": old is None,\\n                \"job_unowned\": not any(item[\"job_id\"] == job_id for item in self._live_attempts()),\\n                \"artifact_absent\": not (output.exists() or output.is_symlink()),\\n                \"generation_options_valid\": options_valid,\\n                \"resources_reserved\": None,\\n            }\\n            context = {\"pipeline\": self._pipeline, \"budget_scope\": \"stage_budget\" if self._pipeline else \"legacy_single_active\"}\\n            if any(observation_state(value) != \"true\" for key, value in observations.items() if key != \"resources_reserved\"):\\n                receipt = self._gate(\"model.execute\", EXECUTE_CONDITIONS, observations,\\n                    job_id=job_id, attempt_id=attempt_id, **context)\\n                raise ControlError(json.dumps({\"guarantees_not_accepted\": True, \"reason\": \"model_conditions_blocked\",\\n                    \"decision_id\": receipt[\"decision_id\"], \"blocked\": receipt[\"blocked\"]}), 409 if options_valid else 422)\\n            attempt = {\"job_id\": job_id, \"attempt_id\": attempt_id, \"instance_id\": self.instance_id,\\n                       \"status\": \"accepted\", \"cancel_requested\": False, \"parameters\": parameters,\\n                       \"fingerprint\": fingerprint, \"accepted_at\": time.time(), \"condition_gates\": {},\\n                       \"stage_started\": {\"prepare\": False, \"gpu\": False, \"encode_validate\": False},\\n                       \"stage_completions\": {\"prepare\": None, \"gpu\": None, \"encode_validate\": None}}\\n            reserved = False\\n            if self._pipeline:\\n                if resources is None:\\n                    receipt = self._gate(\"model.execute\", EXECUTE_CONDITIONS, observations,\\n                        job_id=job_id, attempt_id=attempt_id, **context)\\n                    raise ControlError(json.dumps({\"guarantees_not_accepted\": True,\\n                                                   \"reason\": \"model_not_accepting\", \"decision_id\": receipt[\"decision_id\"]}), status=409)\\n                try:\\n                    self._budget.reserve(attempt_id, resources)\\n                except BudgetUnavailable as error:\\n                    self._event(\"reservation.blocked\", job_id=job_id, attempt_id=attempt_id,\\n                                reservation_witness=self._budget.reservation_witness(attempt_id),\\n                                reservation_receipt=self._budget.gate_receipt(attempt_id, \"reserve\"))\\n                    observations[\"resources_reserved\"] = False\\n                    receipt = self._gate(\"model.execute\", EXECUTE_CONDITIONS, observations,\\n                        job_id=job_id, attempt_id=attempt_id, budget_reason=str(error), **context)\\n                    raise ControlError(json.dumps({\"guarantees_not_accepted\": True, \"reason\": str(error),\\n                                                   \"decision_id\": receipt[\"decision_id\"]}),\\n                                       status=507 if error.permanent else 429) from None\\n                reserved = True\\n                attempt[\"resources\"] = resources\\n                attempt[\"_cancel_event\"] = threading.Event()\\n            try:\\n                witness = self._budget.reservation_witness(attempt_id) if self._pipeline else None\\n                if self._pipeline:\\n                    self._event(\"reservation.acquired\", job_id=job_id, attempt_id=attempt_id,\\n                                reservation_witness=witness,\\n                                reservation_receipt=self._budget.gate_receipt(attempt_id, \"reserve\"))\\n                observations[\"resources_reserved\"] = (_all_observed([\\n                    witness.get(\"owned\"), witness.get(\"attempt_id\") == attempt_id,\\n                    witness.get(\"budget_instance_id\") == self._budget.instance_id,\\n                    type(witness.get(\"reservation_id\")) is str and bool(witness[\"reservation_id\"])\\n                ]) if witness is not None else self._active is None if not self._pipeline else None)\\n                receipt = self._gate(\"model.execute\", EXECUTE_CONDITIONS, observations,\\n                    job_id=job_id, attempt_id=attempt_id, attempt=attempt,\\n                    budget_instance_id=witness.get(\"budget_instance_id\") if witness else None,\\n                    reservation_id=witness.get(\"reservation_id\") if witness else None, **context)\\n                if receipt[\"allowed\"] is not True:\\n                    raise ControlError(json.dumps({\"guarantees_not_accepted\": True, \"reason\": \"model_conditions_blocked\",\\n                        \"decision_id\": receipt[\"decision_id\"], \"blocked\": receipt[\"blocked\"]}), 409)\\n            except BaseException:\\n                if reserved:\\n                    self._budget.finish(attempt_id)\\n                raise\\n            self._attempts[attempt_id] = attempt\\n            if not self._pipeline:\\n                self._active = attempt\\n            self._phase = \"running\"\\n            try:\\n                self._event(\"execution.accepted\", job_id=job_id, attempt_id=attempt_id,\\n                            resources=attempt.get(\"resources\"), condition_decision_id=receipt[\"decision_id\"])\\n                self._queue.put_nowait(attempt)\\n            except BaseException:\\n                attempt.update(status=\"failed\", error=\"dispatch_failed\")\\n                self._active = None\\n                if self._budget:\\n                    self._budget.finish(attempt_id)\\n                self._loaded, self._phase, self._error = False, \"failed\", \"dispatch_failed\"\\n                raise\\n            return self._accepted(attempt)\\n\\n    def _accepted(self, attempt):\\n        return copy.deepcopy({key: attempt[key] for key in (\"job_id\", \"attempt_id\", \"instance_id\", \"status\")}\\n                             | {\"accepted\": True, \"result\": attempt.get(\"result\")})\\n\\n    def cancel(self, payload):\\n        self._check_instance(payload, required=True)\\n        if not isinstance(payload.get(\"attempt_id\"), str):\\n            raise ControlError(\"Invalid execution attempt\", status=422)\\n        with self._lock:\\n            attempt = self._previous_attempt(payload.get(\"attempt_id\"))\\n            if attempt is None or attempt[\"job_id\"] != payload.get(\"job_id\"):\\n                raise ControlError(\"Execution attempt not found\", status=404)\\n            if attempt[\"status\"] in TERMINAL:\\n                return self._accepted(attempt)\\n            if not attempt[\"cancel_requested\"]:\\n                self._event(\"execution.cancel_requested\", job_id=attempt[\"job_id\"], attempt_id=attempt[\"attempt_id\"])\\n                attempt.update(cancel_requested=True, status=\"cancel_requested\")\\n                if \"_cancel_event\" in attempt:\\n                    attempt[\"_cancel_event\"].set()\\n                    self._budget.set_cancelled(attempt[\"attempt_id\"], True)\\n            return self._accepted(attempt)\\n\\n    def drain(self, payload=None):\\n        self._check_instance(payload or {})\\n        with self._lock:\\n            if not self._draining:\\n                self._event(\"model.drain_requested\")\\n                self._draining = True\\n                if self._phase not in {\"failed\", \"stopped\"}:\\n                    self._phase = \"draining\"\\n        return self.status()\\n\\n    def stop(self, payload=None):\\n        self._check_instance(payload or {})\\n        with self._lock:\\n            if not self._stop_requested:\\n                self._event(\"model.stop_requested\")\\n                self._stop_requested, self._draining = True, True\\n                if self._phase not in {\"failed\", \"stopped\"}:\\n                    self._phase = \"draining\"\\n        return self.status()\\n\\n    def dispatch(self, operation, payload=None):\\n        payload = payload or {}\\n        if operation == \"status\":\\n            return self.status()\\n        if operation == \"execute\":\\n            return self.execute(payload)\\n        if operation == \"cancel\":\\n            return self.cancel(payload)\\n        if operation == \"drain\":\\n            return self.drain(payload)\\n        if operation == \"stop\":\\n            return self.stop(payload)\\n        if operation == \"ack_results\":\\n            return self.ack_results(payload)\\n        raise ControlError(\"Unknown model operation\", status=404)\\n\\n    def ack_results(self, payload):\\n        self._check_instance(payload, required=True)\\n        identities = payload.get(\"attempt_ids\")\\n        if not isinstance(identities, list) or any(not isinstance(x, str) or not IDENTIFIER.fullmatch(x) for x in identities):\\n            raise ControlError(\"Invalid result acknowledgement\", status=422)\\n        with self._lock:\\n            acknowledged = []\\n            for identity in identities:\\n                attempt = self._attempts.get(identity)\\n                if attempt and attempt[\"status\"] not in TERMINAL:\\n                    raise ControlError(\"Cannot acknowledge an unfinished execution\", status=409)\\n                if identity not in self._results:\\n                    if self._previous_attempt(identity):\\n                        acknowledged.append(identity)\\n                    continue\\n                record = {key: value for key, value in attempt.items() if not key.startswith(\"_\")}\\n                ledger = sqlite3.connect(self._ledger_path)\\n                try:\\n                    with ledger:\\n                        ledger.execute(\"INSERT OR REPLACE INTO acknowledged VALUES (?,?)\", (identity, json.dumps(record)))\\n                finally:\\n                    ledger.close()\\n                self._results.pop(identity)\\n                self._attempts.pop(identity)\\n                if self._budget:\\n                    self._budget.acknowledge(identity)\\n                acknowledged.append(identity)\\n            return {\"instance_id\": self.instance_id, \"acknowledged\": acknowledged}\\n\\n    def _revoke_pipeline(self, error, *, current=None):\\n        with self._lock:\\n            self._loaded, self._phase, self._error = False, \"failed\", error\\n            for attempt in self._live_attempts():\\n                if attempt is not current:\\n                    attempt[\"cancel_requested\"] = True\\n                    attempt[\"_cancel_event\"].set()\\n                    self._budget.set_cancelled(attempt[\"attempt_id\"], True)\\n\\n    @contextmanager\\n    def _pipeline_stage(self, attempt, name, lease):\\n        if name not in {\"prepare\", \"gpu\", \"encode_validate\"} or lease != (\"gpu\" if name == \"gpu\" else \"cpu\"):\\n            raise ValueError(\"Unknown pipeline stage or resource lease\")\\n        cancellation = attempt[\"_cancel_event\"]\\n        identity, job_id = attempt[\"attempt_id\"], attempt[\"job_id\"]\\n        witness = None\\n        # Never hold the model lock while waiting for a budget grant. Budget\\n        # callbacks read Event only and never acquire this model\\'s lock.\\n        try:\\n            with self._budget.stage(identity, lease, cpu_threads=attempt[\"resources\"][\"cpu_threads\"],\\n                                    cancellation_event=cancellation,\\n                                    context={\"model_instance_id\": self.instance_id, \"job_id\": job_id,\\n                                             \"stage\": name}) as acquired:\\n                with self._lock:\\n                    witness = self._budget.lease_witness(identity, lease)\\n                    reservation = self._budget.reservation_witness(identity)\\n                    if witness is not None:\\n                        self._event(\"lease.acquired\", job_id=job_id, attempt_id=identity, stage=name,\\n                                    lease_id=witness.get(\"lease_id\"), budget_instance_id=witness.get(\"budget_instance_id\"),\\n                                    lease_witness=witness)\\n                    admission = attempt.get(\"condition_gates\", {}).get(\"model.execute\", {})\\n                    admission_context = admission.get(\"context\", {})\\n                    previous = {\"prepare\": None, \"gpu\": \"prepare\", \"encode_validate\": \"gpu\"}[name]\\n                    live_state = attempt.get(\"status\")\\n                    live = (None if type(live_state) is not str else False if live_state in TERMINAL else True if live_state in {\\n                        \"accepted\", \"preparing\", \"gpu_wait\", \"gpu_running\", \"encoding\", \"validating\", \"cancel_requested\"} else None)\\n                    observations = {\\n                        \"instance_matches\": attempt.get(\"instance_id\") == self.instance_id,\\n                        \"attempt_owned\": (self._attempts.get(identity) is attempt\\n                            and admission_context.get(\"instance_id\") == self.instance_id\\n                            and admission_context.get(\"job_id\") == job_id and admission_context.get(\"attempt_id\") == identity),\\n                        \"attempt_live\": live, \"model_loaded\": self._loaded,\\n                        \"worker_alive\": self._worker.is_alive() if self._worker is not None else False,\\n                        \"capability_available\": self._capability_observation(admitted=True),\\n                        \"admission_confirmed\": admission.get(\"allowed\"),\\n                        \"predecessor_completed\": admission.get(\"allowed\") if previous is None else attempt.get(\"stage_completions\", {}).get(previous),\\n                        \"stage_not_started\": negate_observation(attempt.get(\"stage_started\", {}).get(name)),\\n                        \"cancel_flag_clear\": negate_observation(attempt.get(\"cancel_requested\")),\\n                        \"cancel_event_clear\": negate_observation(cancellation.is_set()),\\n                        \"reservation_owned\": _all_observed([\\n                            reservation.get(\"owned\"), reservation.get(\"attempt_id\") == identity,\\n                            reservation.get(\"budget_instance_id\") == self._budget.instance_id,\\n                            type(reservation.get(\"reservation_id\")) is str and bool(reservation[\"reservation_id\"])\\n                        ]) if reservation else None,\\n                        \"budget_grant_held\": False if acquired is False else _all_observed([acquired,\\n                            witness.get(\"owned\") if witness else (False if acquired is False else None),\\n                            witness.get(\"attempt_id\") == identity if witness else None,\\n                            witness.get(\"kind\") == lease if witness else None,\\n                            witness.get(\"budget_instance_id\") == self._budget.instance_id if witness else None,\\n                            witness.get(\"reservation_id\") == reservation.get(\"reservation_id\") if witness and reservation else None]),\\n                    }\\n                    receipt = self._gate(\"model.stage.\" + name, STAGE_CONDITIONS, observations,\\n                        job_id=job_id, attempt_id=identity, attempt=attempt, stage=name,\\n                        lease_id=witness.get(\"lease_id\") if witness else None,\\n                        budget_instance_id=witness.get(\"budget_instance_id\") if witness else None,\\n                        budget_decision_id=witness.get(\"decision_id\") if witness else None)\\n                    if receipt[\"allowed\"] is not True:\\n                        # A confirmed cancellation is distinct from unknown or\\n                        # contradictory ownership/capability/precedence evidence.\\n                        non_cancel_unknown = any(state in {\"unknown\", \"conflict\"} for state in receipt[\"conditions\"].values())\\n                        if (not non_cancel_unknown and attempt.get(\"cancel_requested\") is True\\n                                and cancellation.is_set() is True):\\n                            raise ExecutionCancelled()\\n                        raise ConditionGateBlocked(\"Pipeline stage condition evidence is blocked\")\\n                    attempt[\"stage\"] = name\\n                    attempt[\"stage_started\"][name] = True\\n                    attempt[\"status\"] = {\"prepare\": \"preparing\", \"gpu\": \"gpu_running\", \"encode_validate\": \"encoding\"}[name]\\n                    stage_resources = dict(attempt[\"resources\"], cpu_threads=(\\n                        self._budget.gpu_host_cpu_threads if lease == \"gpu\" else attempt[\"resources\"][\"cpu_threads\"]))\\n                    event_context = {\"condition_decision_id\": receipt[\"decision_id\"], \"lease_id\": witness[\"lease_id\"],\\n                                     \"budget_instance_id\": witness[\"budget_instance_id\"], \"lease_witness\": witness}\\n                    self._event(\"stage.started\", job_id=job_id, attempt_id=identity, stage=name,\\n                                resources=stage_resources, **event_context)\\n                succeeded = False\\n                try:\\n                    yield\\n                    succeeded = True\\n                except BaseException:\\n                    if lease == \"gpu\":\\n                        self._revoke_pipeline(\"gpu_execution_failed\", current=attempt)\\n                    raise\\n                finally:\\n                    with self._lock:\\n                        # A successfully persisted finish precedes the completion\\n                        # witness. An audit failure cannot unlock the next stage.\\n                        self._event(\"stage.finished\", job_id=job_id, attempt_id=identity,\\n                                    stage=name, succeeded=succeeded, resources=stage_resources, **event_context)\\n                        attempt[\"stage_completions\"][name] = succeeded\\n        finally:\\n            if witness is not None:\\n                with self._lock:\\n                    released = self._budget.release_witness(witness[\"lease_id\"])\\n                    self._event(\"lease.released\", job_id=job_id, attempt_id=identity, stage=name,\\n                                lease_id=witness[\"lease_id\"], budget_instance_id=witness[\"budget_instance_id\"],\\n                                lease_witness=released)\\n                    if released is None:\\n                        raise ConditionGateBlocked(\"Lease release evidence is unavailable\")\\n\\n    def _run_pipeline_attempt(self, attempt):\\n        identity = attempt[\"attempt_id\"]\\n        path = self.root / attempt[\"job_id\"] / \"result.mp4\"\\n        result = {\"job_id\": attempt[\"job_id\"], \"attempt_id\": identity, \"instance_id\": self.instance_id,\\n                  \"status\": \"failed\", \"error\": None, \"artifact\": None, \"metrics\": None,\\n                  \"started_at\": time.time(), \"cleanup_complete\": False}\\n        prepared = cpu_result = None\\n        try:\\n            parameters = copy.deepcopy(attempt[\"parameters\"])\\n            for reference in parameters[\"references\"]:\\n                reference[\"path\"] = Path(reference[\"path\"])\\n            with self._pipeline_stage(attempt, \"prepare\", \"cpu\"):\\n                prepared = self.backend.prepare(cpu_threads=attempt[\"resources\"][\"cpu_threads\"], **parameters)\\n                data = getattr(getattr(prepared, \"metrics\", None), \"data\", {})\\n                if isinstance(data.get(\"generation_options\"), dict):\\n                    with self._lock:\\n                        attempt[\"generation_options\"] = data[\"generation_options\"]\\n            with self._lock:\\n                if not attempt[\"cancel_requested\"]:\\n                    attempt[\"status\"], attempt[\"stage\"] = \"gpu_wait\", \"gpu_wait\"\\n            with self._pipeline_stage(attempt, \"gpu\", \"gpu\"):\\n                cpu_result = self.backend.infer(prepared)\\n                if getattr(cpu_result, \"cpu_handoff_complete\", False) is not True:\\n                    raise RuntimeError(\"Backend did not confirm CPU handoff and CUDA synchronization\")\\n                if isinstance(attempt.get(\"generation_options\"), dict):\\n                    self._event(\"generation.configured\", job_id=attempt[\"job_id\"], attempt_id=identity,\\n                                generation_options=copy.deepcopy(attempt[\"generation_options\"]))\\n            # CPU encoding and full-file decoding consume their CPU budget, but\\n            # no GPU lease. Another admitted job may now perform its inference.\\n            with self._pipeline_stage(attempt, \"encode_validate\", \"cpu\"):\\n                metrics = self.backend.encode(cpu_result, output_path=path)\\n                if isinstance(metrics, dict):\\n                    result[\"metrics\"] = metrics\\n                with self._lock:\\n                    if attempt[\"cancel_requested\"]:\\n                        raise ExecutionCancelled()\\n                    attempt[\"status\"] = \"validating\"\\n                if self.artifact_validator is verify_artifact:\\n                    result[\"artifact\"] = self.artifact_validator(path, attempt[\"parameters\"],\\n                        cpu_threads=attempt[\"resources\"][\"cpu_threads\"])\\n                else:\\n                    result[\"artifact\"] = self.artifact_validator(path, attempt[\"parameters\"])\\n            result[\"status\"] = \"succeeded\"\\n            with self._lock:\\n                self._consecutive_failures = 0\\n        except ExecutionCancelled:\\n            result[\"status\"] = \"cancelled\"\\n        except BaseException as error:\\n            LOG.exception(\"Pipeline attempt failed: %s/%s\", attempt[\"job_id\"], identity)\\n            result[\"error\"] = (\"condition_gate_blocked\" if isinstance(error, ConditionGateBlocked)\\n                               else \"generation_failed; inspect model log\")\\n            with self._lock:\\n                if not isinstance(error, ValueError):\\n                    self._consecutive_failures += 1\\n                fatal = not isinstance(error, Exception) or self._consecutive_failures >= 2\\n            if fatal:\\n                self._revoke_pipeline(\"model_execution_unavailable\", current=attempt)\\n        finally:\\n            try:\\n                if isinstance(attempt.get(\"generation_options\"), dict):\\n                    result[\"generation_options\"] = copy.deepcopy(attempt[\"generation_options\"])\\n                result[\"condition_gates\"] = copy.deepcopy(attempt.get(\"condition_gates\", {}))\\n                result[\"stage_completions\"] = copy.deepcopy(attempt.get(\"stage_completions\", {}))\\n                # This operation is strictly CPU cleanup; it must not empty the\\n                # CUDA cache while the next attempt owns the GPU lease.\\n                self.backend.cleanup(prepared=prepared, result=cpu_result)\\n                prepared = cpu_result = None\\n                if result[\"metrics\"] is not None:\\n                    try:\\n                        encoded = json.dumps(result[\"metrics\"], allow_nan=False)\\n                        result[\"metrics\"] = json.loads(encoded) if len(encoded.encode()) <= 128 * 1024 else None\\n                    except (TypeError, ValueError):\\n                        result[\"metrics\"] = None\\n                        LOG.warning(\"Pipeline metrics were not finite JSON; omitting diagnostics\")\\n                inputs = self.root / attempt[\"job_id\"] / \"inputs\"\\n                if inputs.is_symlink() or inputs.resolve() != inputs:\\n                    raise ValueError(\"Input ownership changed during pipeline execution\")\\n                if inputs.exists():\\n                    shutil.rmtree(inputs)\\n                result[\"cleanup_complete\"] = True\\n            except BaseException:\\n                LOG.exception(\"Pipeline attempt cleanup failed\")\\n                result.update(status=\"failed\", artifact=None, cleanup_complete=False,\\n                              error=\"execution_cleanup_failed; inspect model log\")\\n                self._revoke_pipeline(\"execution_cleanup_failed\", current=attempt)\\n            with self._lock:\\n                if attempt[\"cancel_requested\"] and result[\"status\"] == \"succeeded\":\\n                    result[\"status\"] = \"cancelled\"\\n                if result[\"status\"] != \"succeeded\":\\n                    result[\"artifact\"] = None\\n                    try:\\n                        path.unlink(missing_ok=True)\\n                        path.with_suffix(\".metrics.json\").unlink(missing_ok=True)\\n                        path.with_suffix(\".metrics.json.tmp\").unlink(missing_ok=True)\\n                    except OSError:\\n                        result.update(status=\"failed\", cleanup_complete=False, error=\"cancel_cleanup_failed\")\\n                        self._revoke_pipeline(\"cancel_cleanup_failed\", current=attempt)\\n                result[\"finished_at\"] = time.time()\\n                attempt.update(status=result[\"status\"], result=result)\\n                attempt.pop(\"parameters\", None)\\n                self._results[identity] = self._last_result = result\\n                if result[\"cleanup_complete\"]:\\n                    self._budget.finish(identity, len(json.dumps(result).encode()))\\n                if self._phase != \"failed\":\\n                    self._phase = \"draining\" if self._draining else (\"running\" if self._live_attempts() else \"ready\")\\n                self._safe_event(\"execution.\" + result[\"status\"], job_id=attempt[\"job_id\"],\\n                                 attempt_id=identity, result=result)\\n\\n    def _run_attempt(self, attempt):\\n        path = self.root / attempt[\"job_id\"] / \"result.mp4\"\\n        result = {\"job_id\": attempt[\"job_id\"], \"attempt_id\": attempt[\"attempt_id\"],\\n                  \"instance_id\": self.instance_id, \"status\": \"failed\", \"error\": None,\\n                  \"artifact\": None, \"metrics\": None, \"started_at\": time.time(),\\n                  \"cleanup_complete\": False}\\n        fatal = None\\n        generated = False\\n        try:\\n            with self._lock:\\n                if not attempt[\"cancel_requested\"]:\\n                    attempt[\"status\"] = \"running\"\\n                self._event(\"execution.running\", job_id=attempt[\"job_id\"], attempt_id=attempt[\"attempt_id\"])\\n            if not attempt[\"cancel_requested\"]:\\n                params = copy.deepcopy(attempt[\"parameters\"])\\n                for reference in params[\"references\"]:\\n                    reference[\"path\"] = Path(reference[\"path\"])\\n                self.backend.generate(output_path=path, **params)\\n                generated = True\\n                if not attempt[\"cancel_requested\"]:\\n                    result[\"artifact\"] = self.artifact_validator(path, attempt[\"parameters\"])\\n            with self._lock:\\n                result[\"status\"] = \"cancelled\" if attempt[\"cancel_requested\"] else \"succeeded\"\\n            self._consecutive_failures = 0\\n        except BaseException as error:\\n            LOG.exception(\"Model attempt failed: %s/%s\", attempt[\"job_id\"], attempt[\"attempt_id\"])\\n            result[\"error\"] = \"generation_failed; inspect model log\"\\n            # Bad input media may be a request error. Invalid generated output\\n            # is an execution failure even when the validator raises ValueError.\\n            if generated or not isinstance(error, ValueError):\\n                self._consecutive_failures += 1\\n            if not isinstance(error, Exception) or self._consecutive_failures >= 2:\\n                fatal = error\\n                with self._lock:\\n                    self._loaded, self._phase, self._error = False, \"failed\", \"model_execution_unavailable\"\\n        finally:\\n            try:\\n                # Keep the lease until execution and its local cleanup have ended.\\n                metrics = getattr(self.backend, \"last_metrics\", None)\\n                if isinstance(metrics, dict):\\n                    try:\\n                        encoded = json.dumps(metrics, allow_nan=False)\\n                        if len(encoded.encode(\"utf-8\")) <= 128 * 1024:\\n                            result[\"metrics\"] = json.loads(encoded)\\n                    except (TypeError, ValueError):\\n                        LOG.warning(\"Model metrics were not finite JSON; omitting diagnostics\")\\n                if result[\"status\"] != \"succeeded\":\\n                    result[\"artifact\"] = None\\n                    path.unlink(missing_ok=True)\\n                inputs = self.root / attempt[\"job_id\"] / \"inputs\"\\n                if inputs.is_symlink() or inputs.resolve() != inputs:\\n                    raise ValueError(\"Input directory ownership changed during execution\")\\n                if inputs.exists():\\n                    shutil.rmtree(inputs)\\n                # Attempt-local files are reclaimed; this does not release the\\n                # model process\\'s persistent CPU/GPU resource ownership.\\n                result[\"cleanup_complete\"] = True\\n            except BaseException as error:\\n                LOG.exception(\"Attempt cleanup failed\")\\n                result.update(status=\"failed\", artifact=None, cleanup_complete=False,\\n                              error=\"execution_cleanup_failed; inspect model log\")\\n                fatal = error\\n                with self._lock:\\n                    self._loaded, self._phase, self._error = False, \"failed\", \"execution_cleanup_failed\"\\n            with self._lock:\\n                # A cancel racing with validation/cleanup still wins before commit.\\n                if attempt[\"cancel_requested\"] and result[\"status\"] == \"succeeded\":\\n                    result.update(status=\"cancelled\", artifact=None)\\n                    try:\\n                        path.unlink(missing_ok=True)\\n                    except OSError as error:\\n                        result.update(status=\"failed\", error=\"cancel_cleanup_failed\", cleanup_complete=False)\\n                        fatal = error\\n                        self._loaded, self._phase, self._error = False, \"failed\", \"cancel_cleanup_failed\"\\n                result[\"finished_at\"] = time.time()\\n                attempt.update(status=result[\"status\"], result=result)\\n                attempt.pop(\"parameters\", None)\\n                self._last_result = result\\n                self._results[attempt[\"attempt_id\"]] = result\\n                self._active = None\\n                if self._phase != \"failed\":\\n                    self._phase = \"draining\" if self._draining else \"ready\"\\n                self._event(\"execution.\" + result[\"status\"], job_id=attempt[\"job_id\"],\\n                            attempt_id=attempt[\"attempt_id\"], result=result)\\n        if fatal is not None:\\n            raise fatal\\n\\n    def _work(self):\\n        try:\\n            if self.backend is None:\\n                if self.staged:\\n                    from staged_backend import StagedMiniMaxBackend\\n                    self.backend = StagedMiniMaxBackend()\\n                else:\\n                    from model_backend import MiniMaxBackend\\n                    self.backend = MiniMaxBackend()\\n            self._pipeline = all(callable(getattr(self.backend, name, None)) for name in\\n                                 (\"prepare\", \"infer\", \"encode\", \"cleanup\", \"estimate_resources\"))\\n            if not self._pipeline and not self._injected_backend:\\n                raise RuntimeError(\"Production backend must implement the staged pipeline contract\")\\n            if self._pipeline:\\n                self._budget = PipelineBudget(self.root, limits=self._resource_limits,\\n                    model_peak_ram_bytes=getattr(self.backend, \"pipeline_model_peak_ram_bytes\", 144 * 1024 ** 3))\\n                configure = getattr(self.backend, \"configure_cpu_budget\", None)\\n                if callable(configure):\\n                    self._budget.native_cpu_status = configure(self._budget.gpu_host_cpu_threads)\\n                elif not self._injected_backend:\\n                    raise RuntimeError(\"Production backend must configure its native CPU thread budget before loading\")\\n                else:\\n                    self._budget.native_cpu_status = {\"configured\": False, \"scope\": \"injected CPU test backend\"}\\n            self.backend.load()\\n            if self._pipeline:\\n                native_snapshot = getattr(self.backend, \"cpu_budget_snapshot\", None)\\n                if callable(native_snapshot):\\n                    # Model loading can import additional BLAS/OpenMP runtimes.\\n                    # Read back their limits before publishing readiness; never\\n                    # reconfigure process-wide pools while jobs are running.\\n                    self._budget.native_cpu_status = native_snapshot()\\n                elif not self._injected_backend:\\n                    raise RuntimeError(\"Production backend must verify native CPU budgets after loading\")\\n            with self._lock:\\n                self._loaded = True\\n                self._phase = \"draining\" if self._draining else \"ready\"\\n                self._event(\"model.ready\", accepting=not self._draining)\\n            while True:\\n                with self._lock:\\n                    if self._pipeline:\\n                        for identity, worker in list(self._stage_workers.items()):\\n                            if not worker.is_alive():\\n                                worker.join()\\n                                del self._stage_workers[identity]\\n                        if self._phase == \"failed\":\\n                            self._revoke_pipeline(self._error or \"pipeline_unavailable\")\\n                        if (self._stop_requested or self._phase == \"failed\") and not self._live_attempts() and not self._stage_workers:\\n                            break\\n                    else:\\n                        if self._stop_requested and self._active is None:\\n                            break\\n                        if self._phase == \"failed\":\\n                            break\\n                try:\\n                    attempt = self._queue.get(timeout=.1)\\n                except queue.Empty:\\n                    continue\\n                try:\\n                    if self._pipeline:\\n                        worker = threading.Thread(target=self._run_pipeline_attempt, args=(attempt,),\\n                                                  name=\"h3-stage-\" + attempt[\"attempt_id\"][:8], daemon=False)\\n                        with self._lock:\\n                            self._stage_workers[attempt[\"attempt_id\"]] = worker\\n                            try:\\n                                worker.start()\\n                            except BaseException:\\n                                self._stage_workers.pop(attempt[\"attempt_id\"], None)\\n                                self._revoke_pipeline(\"pipeline_worker_start_failed\")\\n                                self._run_pipeline_attempt(attempt)\\n                                raise\\n                    else:\\n                        self._run_attempt(attempt)\\n                finally:\\n                    self._queue.task_done()\\n        except BaseException as error:\\n            LOG.exception(\"Model worker exited\")\\n            with self._lock:\\n                self._loaded, self._phase = False, \"failed\"\\n                self._error = self._error or \"model_load_or_worker_failed\"\\n                if self._active is not None:\\n                    attempt = self._active\\n                    result = {\"job_id\": attempt[\"job_id\"], \"attempt_id\": attempt[\"attempt_id\"],\\n                              \"instance_id\": self.instance_id, \"status\": \"failed\", \"artifact\": None,\\n                              \"metrics\": None, \"error\": \"model_worker_exited\", \"finished_at\": time.time(),\\n                              \"cleanup_complete\": False}\\n                    attempt.update(status=\"failed\", result=result)\\n                    self._results[attempt[\"attempt_id\"]] = result\\n                    self._last_result, self._active = result, None\\n                self._safe_event(\"model.failed\", error=self._error, error_type=type(error).__name__)\\n        finally:\\n            with self._lock:\\n                self._loaded = False\\n            if self._pipeline:\\n                # Never unload model state while prepare, CUDA inference, CPU\\n                # encoding, validation or local cleanup still refers to it.\\n                for worker in list(self._stage_workers.values()):\\n                    if worker.ident is not None:\\n                        worker.join()\\n                for attempt in self._live_attempts():\\n                    attempt[\"cancel_requested\"] = True\\n                    attempt[\"_cancel_event\"].set()\\n                    self._budget.set_cancelled(attempt[\"attempt_id\"], True)\\n                    self._run_pipeline_attempt(attempt)\\n            try:\\n                backend, self.backend = self.backend, None\\n                unload = getattr(backend, \"unload\", None)\\n                if unload:\\n                    unload()\\n                if hasattr(backend, \"pipe\"):\\n                    backend.pipe = None\\n                del backend\\n                gc.collect()\\n                torch = sys.modules.get(\"torch\")\\n                if torch is not None and torch.cuda.is_initialized():\\n                    torch.cuda.empty_cache()\\n                self._worker_cleanup_complete = True\\n            except BaseException:\\n                LOG.exception(\"Model worker cleanup failed\")\\n                self._phase, self._error = \"failed\", \"model_unload_failed\"\\n            with self._lock:\\n                if self._phase != \"failed\":\\n                    self._phase = \"stopped\"\\n                self._safe_event(\"model.worker_exited\", phase=self._phase,\\n                                 worker_cleanup_complete=self._worker_cleanup_complete,\\n                                 budget_snapshot=self._budget.snapshot() if self._budget is not None else None)\\n            self._done.set()\\n\\n    def join(self, timeout=None):\\n        if self._worker is not None and self._worker.ident is not None:\\n            self._worker.join(timeout)\\n        return self._done.is_set()\\n\\n\\ndef main():\\n    parser = argparse.ArgumentParser(description=__doc__)\\n    parser.add_argument(\"--port\", type=int, required=True)\\n    parser.add_argument(\"--instance-id\", required=True)\\n    parser.add_argument(\"--root\", type=Path, required=True)\\n    parser.add_argument(\"--staged\", action=\"store_true\")\\n    parser.add_argument(\"--parent-pid\", type=int)\\n    args = parser.parse_args()\\n    owner_created_at = parent_identity(args.parent_pid) if args.parent_pid else None\\n    key = os.environ.get(\"H3_CONTROL_KEY\", \"\")\\n    if len(key) < 32:\\n        raise RuntimeError(\"A private H3_CONTROL_KEY is required\")\\n    container = ModelContainer(args.root, args.instance_id, staged=args.staged,\\n                               progress_path=os.environ.get(\"H3_DOWNLOAD_PROGRESS_PATH\"))\\n    server = make_server(\"127.0.0.1\", args.port, key, container.dispatch)\\n    http = threading.Thread(target=server.serve_forever, name=\"h3-model-control\", daemon=True)\\n    http.start()\\n    stop_pending = False\\n    stop_applied = False\\n\\n    def request_stop(*_):\\n        # Python signal handlers may interrupt this thread while it holds an\\n        # RLock or is writing an event. Only record intent here; even Event.set\\n        # takes a lock and must not run in a reentrant signal callback.\\n        nonlocal stop_pending\\n        stop_pending = True\\n\\n    def apply_stop():\\n        nonlocal stop_applied\\n        if stop_applied:\\n            return\\n        stop_applied = True\\n        try:\\n            container.stop()\\n        except BaseException:\\n            LOG.exception(\"Could not record model stop\")\\n            with container._lock:\\n                container._stop_requested = container._draining = True\\n                container._loaded = False\\n\\n    signal.signal(signal.SIGTERM, request_stop)\\n    signal.signal(signal.SIGINT, request_stop)\\n    try:\\n        container.start()\\n        while True:\\n            if args.parent_pid and not parent_is_alive(args.parent_pid, owner_created_at):\\n                # An ownerless CUDA worker must not outlive its resource lease.\\n                apply_stop()\\n                container.join(2)\\n                server.shutdown()\\n                server.server_close()\\n                os._exit(70)\\n            if stop_pending:\\n                apply_stop()\\n            if container._stop_requested:\\n                if container.join(.2):\\n                    break\\n            else:\\n                # Failed loading leaves the private controller available for diagnosis.\\n                time.sleep(.2)\\n    finally:\\n        apply_stop()\\n        container.join(2)\\n        server.shutdown()\\n        server.server_close()\\n\\n\\nif __name__ == \"__main__\":\\n    logging.basicConfig(level=logging.INFO)\\n    main()\\n', 'tunnel.py': '\"\"\"Prepare an explicit temporary tunnel independently of model readiness.\"\"\"\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport hashlib\\nimport json\\nimport os\\nfrom pathlib import Path\\nimport platform\\nimport re\\nimport signal\\nimport shutil\\nimport subprocess\\nimport sys\\nimport time\\nimport threading\\n\\n\\ndef watch_owner(parent_pid):\\n    \"\"\"Exit through the signal handler so the connector is also reclaimed.\"\"\"\\n    if not parent_pid:\\n        return\\n    import psutil\\n    try:\\n        owner = psutil.Process(int(parent_pid))\\n        created = owner.create_time()\\n    except psutil.Error:\\n        raise RuntimeError(\"Tunnel owner is already unavailable\")\\n\\n    def observe():\\n        while True:\\n            time.sleep(1)\\n            try:\\n                alive = (owner.is_running() and owner.create_time() == created\\n                         and owner.status() != psutil.STATUS_ZOMBIE)\\n            except psutil.Error:\\n                alive = False\\n            if not alive:\\n                if os.name == \"nt\":\\n                    import _thread\\n                    _thread.interrupt_main()\\n                else:\\n                    os.kill(os.getpid(), signal.SIGTERM)\\n                return\\n    threading.Thread(target=observe, name=\"tunnel-owner-watch\", daemon=True).start()\\nimport urllib.request\\n\\n\\ndef ready(port: int) -> bool:\\n    try:\\n        with urllib.request.urlopen(f\"http://127.0.0.1:{port}/health\", timeout=3) as response:\\n            return json.load(response).get(\"ready\") is True\\n    except Exception:\\n        return False\\n\\n\\ndef cloudflared_binary(install: bool = False) -> str:\\n    found = shutil.which(\"cloudflared\")\\n    if found:\\n        return found\\n    cached = Path(__file__).resolve().parent / \".cache\" / \"cloudflared\"\\n    if cached.is_file():\\n        return str(cached)\\n    if not install:\\n        raise RuntimeError(\"cloudflared is not installed. Use --install to fetch an official release with SHA-256 verification.\")\\n    if platform.system() != \"Linux\" or platform.machine() not in {\"x86_64\", \"amd64\"}:\\n        raise RuntimeError(\"Automatic cloudflared install supports Linux x86_64 only; otherwise install it from Cloudflare first.\")\\n    request = urllib.request.Request(\\n        \"https://api.github.com/repos/cloudflare/cloudflared/releases/latest\",\\n        headers={\"User-Agent\": \"minimax-h3-ref-api\", \"Accept\": \"application/vnd.github+json\"},\\n    )\\n    with urllib.request.urlopen(request, timeout=30) as response:\\n        release = json.load(response)\\n    asset = next(a for a in release[\"assets\"] if a[\"name\"] == \"cloudflared-linux-amd64\")\\n    digest = asset.get(\"digest\", \"\")\\n    if not digest.startswith(\"sha256:\"):\\n        raise RuntimeError(\"Official release metadata lacks a SHA-256 digest; install cloudflared manually from Cloudflare.\")\\n    url = asset[\"browser_download_url\"]\\n    if not url.startswith(\"https://github.com/cloudflare/cloudflared/releases/download/\"):\\n        raise RuntimeError(\"Unexpected cloudflared release origin\")\\n    cached.parent.mkdir(parents=True, exist_ok=True)\\n    temporary = cached.with_suffix(\".download\")\\n    hasher = hashlib.sha256()\\n    try:\\n        with urllib.request.urlopen(url, timeout=60) as response, temporary.open(\"wb\") as output:\\n            while chunk := response.read(1024 * 1024):\\n                hasher.update(chunk)\\n                output.write(chunk)\\n        if hasher.hexdigest() != digest.split(\":\", 1)[1]:\\n            raise RuntimeError(\"cloudflared SHA-256 mismatch; binary was not installed\")\\n        temporary.chmod(0o700)\\n        temporary.replace(cached)\\n    finally:\\n        temporary.unlink(missing_ok=True)\\n    print(f\"Installed official cloudflared {release[\\'tag_name\\']} (SHA-256 verified).\", flush=True)\\n    return str(cached)\\n\\n\\ndef run_tunnel(port: int = 8000, install: bool = False, *, status_file: Path | None = None,\\n               instance_id: str | None = None) -> None:\\n    \"\"\"Register the transport; a candidate URL never implies application readiness.\"\"\"\\n    if status_file and (not instance_id or not re.fullmatch(r\"[a-f0-9]{32}\", instance_id)):\\n        raise ValueError(\"Managed tunnel status requires its owner\\'s 32-character instance ID\")\\n    state = {\"instance_id\": instance_id, \"phase\": \"preparing\", \"url\": None,\\n             \"connected\": False, \"pid\": None, \"error\": None}\\n\\n    def publish(**changes):\\n        state.update(changes, observed_at=time.time())\\n        if status_file:\\n            path = Path(status_file)\\n            path.parent.mkdir(parents=True, exist_ok=True)\\n            temporary = path.with_suffix(\".tmp\")\\n            temporary.write_text(json.dumps(state, indent=2), encoding=\"utf-8\")\\n            temporary.replace(path)\\n\\n    process = None\\n    registered = set()\\n    publish()\\n    try:\\n        # A loading origin may not be listening yet. Transport installation and\\n        # registration do not depend on its /health response.\\n        binary = cloudflared_binary(install)\\n        process = subprocess.Popen(\\n            [binary, \"tunnel\", \"--no-autoupdate\", \"--url\", f\"http://127.0.0.1:{port}\"],\\n            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1,\\n        )\\n        publish(pid=process.pid)\\n        for line in process.stdout:\\n            match = re.search(r\"https://[a-z0-9-]+\\\\.trycloudflare\\\\.com\", line)\\n            if match and not state[\"url\"]:\\n                publish(url=match.group(0))\\n                print(f\"PUBLIC_API_URL={match.group(0)}\", flush=True)\\n                print(\"Candidate URL allocated; application readiness still requires the live join.\", flush=True)\\n            connection = re.search(r\"connIndex=(\\\\d+)\", line)\\n            connection_id = connection.group(1) if connection else \"default\"\\n            if \"Registered tunnel connection\" in line:\\n                registered.add(connection_id)\\n                publish(phase=\"registered\", connected=True)\\n            elif any(marker in line for marker in (\\n                \"Unregistered tunnel connection\", \"Connection terminated\",\\n                \"failed to serve tunnel connection\", \"Serve tunnel error\",\\n            )):\\n                if connection:\\n                    registered.discard(connection_id)\\n                else:\\n                    registered.clear()  # No connection identity: revoke conservatively.\\n                publish(phase=\"registered\" if registered else \"reconnecting\", connected=bool(registered))\\n            print(line, end=\"\", flush=True)\\n        if process.wait() != 0:\\n            raise RuntimeError(\"cloudflared stopped; see the tunnel log above\")\\n    except KeyboardInterrupt:\\n        publish(phase=\"stopping\", connected=False)\\n        raise\\n    except BaseException as error:\\n        publish(phase=\"failed\", connected=False, error=type(error).__name__)\\n        raise\\n    finally:\\n        if process is not None and process.poll() is None:\\n            process.terminate()\\n            try:\\n                process.wait(timeout=10)\\n            except subprocess.TimeoutExpired:\\n                process.kill()\\n                process.wait()\\n        publish(phase=\"failed\" if state[\"phase\"] == \"failed\" else \"stopped\", connected=False)\\n\\n\\nif __name__ == \"__main__\":\\n    signal.signal(signal.SIGTERM, lambda *_: (_ for _ in ()).throw(KeyboardInterrupt()))\\n    watch_owner(os.environ.get(\"H3_PARENT_PID\"))\\n    parser = argparse.ArgumentParser(description=__doc__)\\n    parser.add_argument(\"--port\", type=int, default=8000)\\n    parser.add_argument(\"--install\", action=\"store_true\", help=\"Download official cloudflared if missing, checking GitHub release SHA-256\")\\n    parser.add_argument(\"--status-file\", type=Path, help=\"Atomic transport state checkpoint owned by the startup supervisor\")\\n    parser.add_argument(\"--instance-id\", help=\"Owning startup session ID; never an API credential\")\\n    args = parser.parse_args()\\n    try:\\n        run_tunnel(args.port, args.install, status_file=args.status_file, instance_id=args.instance_id)\\n    except KeyboardInterrupt:\\n        print(\"Tunnel stopped. Local GPU server remains running until you stop it.\")\\n', 'client.py': '\"\"\"Submit ordered references to the ref2va API, poll, and download the MP4.\"\"\"\\nfrom __future__ import annotations\\n\\nimport argparse\\nfrom contextlib import ExitStack\\nimport json\\nimport mimetypes\\nimport os\\nfrom pathlib import Path\\nimport time\\nimport requests\\n\\n\\nclass ReferenceAction(argparse.Action):\\n    def __call__(self, parser, namespace, value, option_string=None):\\n        items = list(getattr(namespace, self.dest, None) or [])\\n        items.append((option_string.removeprefix(\"--\"), Path(value)))\\n        setattr(namespace, self.dest, items)\\n\\n\\ndef main() -> None:\\n    parser = argparse.ArgumentParser(description=__doc__)\\n    parser.add_argument(\"url\", help=\"API base URL, e.g. https://example.trycloudflare.com\")\\n    parser.add_argument(\"--prompt\", required=True)\\n    for kind in (\"image\", \"video\", \"audio\"):\\n        parser.add_argument(\"--\" + kind, dest=\"references\", action=ReferenceAction, metavar=\"FILE\")\\n    parser.add_argument(\"--output\", type=Path, default=Path(\"result.mp4\"))\\n    parser.add_argument(\"--seconds\", type=float, default=5)\\n    parser.add_argument(\"--width\", type=int, default=960)\\n    parser.add_argument(\"--height\", type=int, default=544)\\n    parser.add_argument(\"--steps\", type=int, default=50)\\n    parser.add_argument(\"--seed\", type=int, default=42)\\n    parser.add_argument(\"--timeout\", type=int, default=7200, help=\"Maximum poll time in seconds\")\\n    args = parser.parse_args()\\n    key = os.environ.get(\"H3_API_KEY\")\\n    if not key:\\n        parser.error(\"Set H3_API_KEY in the caller\\'s environment first\")\\n    if not args.references:\\n        parser.error(\"At least one --image or --video reference is required\")\\n    if args.output.exists():\\n        parser.error(\"Output file already exists; choose another --output path\")\\n    base = args.url.rstrip(\"/\")\\n    if not (base.startswith(\"https://\") or base.startswith(\"http://127.0.0.1:\")):\\n        parser.error(\"Use HTTPS for public endpoints, or HTTP on 127.0.0.1 for local testing\")\\n    headers = {\"Authorization\": \"Bearer \" + key}\\n    with ExitStack() as stack:\\n        files = [(\"files\", (path.name, stack.enter_context(path.open(\"rb\")), mimetypes.guess_type(path.name)[0] or \"application/octet-stream\"))\\n                 for _, path in args.references]\\n        response = requests.post(\\n            base + \"/v1/jobs\", headers=headers, files=files,\\n            data={\"kinds\": json.dumps([kind for kind, _ in args.references]), \"prompt\": args.prompt,\\n                  \"seconds\": args.seconds, \"width\": args.width, \"height\": args.height,\\n                  \"steps\": args.steps, \"seed\": args.seed}, timeout=120,\\n        )\\n    response.raise_for_status()\\n    job_id = response.json()[\"id\"]\\n    print(\"Job:\", job_id, flush=True)\\n    deadline = time.monotonic() + args.timeout\\n    while True:\\n        response = requests.get(base + f\"/v1/jobs/{job_id}\", headers=headers, timeout=30)\\n        response.raise_for_status()\\n        job = response.json()\\n        print(job[\"status\"], flush=True)\\n        if job[\"status\"] == \"failed\":\\n            raise RuntimeError(json.dumps(job, ensure_ascii=False))\\n        if job[\"status\"] == \"succeeded\":\\n            break\\n        if time.monotonic() >= deadline:\\n            raise TimeoutError(f\"Polling timed out. Job {job_id} may still be running; query it later.\")\\n        time.sleep(min(30, max(0, deadline - time.monotonic())))\\n    args.output.parent.mkdir(parents=True, exist_ok=True)\\n    partial = args.output.with_suffix(args.output.suffix + \".part\")\\n    created_partial = False\\n    try:\\n        with requests.get(base + f\"/v1/jobs/{job_id}/file\", headers=headers, timeout=120, stream=True) as response:\\n            response.raise_for_status()\\n            with partial.open(\"xb\") as output:\\n                created_partial = True\\n                for chunk in response.iter_content(1024 * 1024):\\n                    output.write(chunk)\\n        partial.replace(args.output)\\n    finally:\\n        if created_partial:\\n            partial.unlink(missing_ok=True)\\n    print(\"Saved:\", args.output.resolve())\\n\\n\\nif __name__ == \"__main__\":\\n    main()\\n', 'README.md': '# MiniMax-H3 ref2va 参考运行时 · API 0.4.0\\n\\n这里保存已验收的专用实现：总管理、API 后台、大模型容器三个受管进程，独立的可选公网隧道与 Colab 控制台。模型容器是模型运行时进程，不把 GPU 硬件本身称为容器。\\n\\n- 当前模型：MiniMax-H3，仅 ref2va；至少图片或视频参考，可附加音频。\\n- A100 原生 BF16 主干与 LoRA，保留官方 FP32 例外，不启用权重量化。\\n- 任务分为 CPU 预处理、独占 GPU 推理、CPU 编码校验；按真实依赖及资源预算调度。\\n- 队列无固定条数上限，可指定 ID 取消；资源不足、未知提交和运行中取消各自有真实状态。\\n- API 可先于模型就绪接收排队。生成、产物完整校验、任务清理、服务进程退出和云平台释放分别确认。\\n- 每任务控制 attention_backend、acceleration_lora、steps；Turbo 要显式 steps=5，对应4次模型评估。预加载不等于当前任务启用。\\n\\n仓库内的[运行说明](../../docs/operations.md)、[架构](../../docs/architecture.md)、[验证边界](../../docs/validation.md)提供当前入口。此 README 进入自包含 notebook 时，仓库相对链接仅用于源码导航；云端实际操作使用面板与日志。\\n\\n```bash\\npython run.py --help\\npython smoke_test.py --help\\n```\\n\\n历史 A100 实测不是当前机器的一次新运行。源码来源与精度/配置/任务/释放证据见仓库 evidence。真实生成验收每次必须是全新内容；未知结果按原 ID 对账，不自动重新生成。\\n', 'notebook_ui.py': '\"\"\"Read-only dashboard and separate diagnostics for the notebook control panel.\"\"\"\\nfrom __future__ import annotations\\n\\nimport html\\nimport json\\nfrom collections import deque\\nfrom datetime import datetime, timedelta, timezone\\nfrom pathlib import Path\\nimport re\\nimport subprocess\\nimport time\\n\\nSTYLE = \"\"\"\\n<style>\\n.h3-card{--bg:#f8fafc;--ink:#172033;--muted:#627086;--line:#dbe3ec;--accent:#187c72;box-sizing:border-box;background:var(--bg);color:var(--ink);border:1px solid var(--line);border-left:4px solid var(--accent);border-radius:12px;padding:17px 20px;margin:8px 0;font:14px/1.55 system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;max-width:980px}\\n.h3-card *{box-sizing:border-box}.h3-card[data-tone=\"error\"]{--accent:#ba4242}.h3-card[data-tone=\"idle\"]{--accent:#7b8797}.h3-card[data-tone=\"running\"]{--accent:#bd7c16}\\n.h3-head{display:flex;gap:12px;justify-content:space-between;align-items:center;flex-wrap:wrap}.h3-title{font-size:17px;font-weight:650;letter-spacing:-.2px}.h3-badge{font-size:11px;font-weight:650;letter-spacing:.3px;color:var(--accent);border:1px solid var(--line);padding:3px 9px;border-radius:99px;white-space:nowrap}.h3-note{color:var(--muted);margin:5px 0 0}\\n.h3-fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px 18px;margin-top:13px}.h3-label{display:block;color:var(--muted);font-size:11px;letter-spacing:.25px;margin-bottom:2px}.h3-value{font-size:14px;font-weight:550;overflow-wrap:anywhere}.h3-card details{margin-top:12px;border-top:1px solid var(--line);padding-top:10px}.h3-card summary{cursor:pointer;color:var(--muted);font-size:12px}.h3-card pre{white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.55 ui-monospace,SFMono-Regular,Consolas,monospace;margin:9px 0 0;max-height:280px;overflow:auto}.h3-card a{color:var(--accent);text-decoration:none}.h3-card a:hover{text-decoration:underline}\\n.h3-board{border-left-width:1px;padding:22px 24px}.h3-board h2{font-size:23px;line-height:1.3;margin:4px 0 8px}.h3-kicker{font-size:12px;color:var(--muted)}.h3-next{margin:12px 0 21px;padding:11px 14px;border-radius:8px;background:color-mix(in srgb,var(--accent) 8%,var(--bg));font-size:15px}.h3-modules{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:12px 0 19px}.h3-module{padding:12px 14px;border:1px solid var(--line);border-radius:8px}.h3-module strong{font-weight:650;display:block;font-size:16px;margin-top:4px}.h3-subtle{color:var(--muted);font-size:12px;margin-top:4px}.h3-summary{display:flex;flex-wrap:wrap;gap:8px 22px;margin:12px 0}.h3-activity{border-top:1px solid var(--line);margin-top:18px;padding-top:13px}.h3-activity .h3-title{font-size:14px}.h3-activity .h3-fields{margin-top:8px;gap:8px 18px}.h3-stamp{font-size:11px;color:var(--muted);margin-top:17px}.h3-logs{border-left-width:1px}.h3-logs pre{max-height:360px;margin:14px 0 0}.h3-logs pre:focus{outline:2px solid var(--accent);outline-offset:3px}\\n@media(max-width:620px){.h3-board{padding:17px 15px}.h3-modules{grid-template-columns:1fr;gap:8px}.h3-module{padding:9px 12px;display:grid;grid-template-columns:95px 1fr;align-items:center}.h3-module strong{margin:0}.h3-module .h3-subtle{grid-column:2}.h3-board h2{font-size:21px}.h3-fields{grid-template-columns:1fr}}\\n@media(prefers-color-scheme:dark){.h3-card{--bg:#17202d;--ink:#e4ebf4;--muted:#a5b3c6;--line:#344358;--accent:#67cdbb}.h3-card[data-tone=\"error\"]{--accent:#ff9696}.h3-card[data-tone=\"running\"]{--accent:#e4ba6d}.h3-card[data-tone=\"idle\"]{--accent:#b5bfcb}}\\n</style>\\n\"\"\"\\n\\n_dashboard = None\\n_diagnostics = deque(maxlen=20)\\n_known_secrets = ()\\n_process_observer = None\\n_DIAGNOSTIC_LIMIT = 12000\\n\\n\\ndef redact_text(text, secrets=()):\\n    \"\"\"Redact known credentials and common authorization/key assignments before display.\"\"\"\\n    text = str(text)\\n    for secret in sorted({str(s) for s in (*_known_secrets, *secrets) if s}, key=len, reverse=True):\\n        text = text.replace(secret, \\'[已隐藏]\\')\\n    text = re.sub(r\\'(?i)(\\\\bBearer\\\\s+)[^\\\\s\\\\\"\\\\\\'<>;,]+\\', r\\'\\\\1[已隐藏]\\', text)\\n    text = re.sub(r\\'\\'\\'(?ix)([\"\\']?(?:H3_API_KEY|API_KEY|api[-_]?key|access_token|authorization)[\"\\']?\\\\s*[:=]\\\\s*)([\"\\'])(.*?)(\\\\2)\\'\\'\\',\\n                  lambda match: match.group(1) + match.group(2) + \\'[已隐藏]\\' + match.group(2), text)\\n    text = re.sub(r\\'(?i)(\\\\b(?:H3_API_KEY|API_KEY|api[-_]?key|access_token)\\\\s*[:=]\\\\s*)[^\\\\s\\\\\"\\\\\\'<>;,]+\\', r\\'\\\\1[已隐藏]\\', text)\\n    return text\\n\\n\\ndef _remember(title, text):\\n    if text:\\n        _diagnostics.append(redact_text(str(title) + \\'\\\\n\\' + str(text))[-_DIAGNOSTIC_LIMIT:])\\n\\n\\ndef last_diagnostics():\\n    return \\'\\\\n\\\\n\\'.join(_diagnostics)[-_DIAGNOSTIC_LIMIT:]\\n\\n\\ndef diagnostics_html(title, text, *, secrets=()):\\n    \"\"\"A bounded, keyboard-scrollable log view; never embedded in dashboard cards.\"\"\"\\n    value = redact_text(text, secrets=secrets)\\n    truncated = len(value) > _DIAGNOSTIC_LIMIT\\n    value = value[-_DIAGNOSTIC_LIMIT:]\\n    note = \\'仅显示最后 12,000 个字符；完整记录保留在日志文件。\\' if truncated else \\'只读日志 · 敏感凭据已隐藏\\'\\n    return (STYLE + \\'<section class=\"h3-card h3-logs\" aria-label=\"日志\"><div class=\"h3-title\">\\'\\n            + html.escape(redact_text(title), quote=True) + \\'</div><p class=\"h3-note\">\\' + note\\n            + \\'</p><pre tabindex=\"0\" aria-label=\"日志内容\">\\' + html.escape(value or \\'暂无记录。\\', quote=True)\\n            + \\'</pre></section>\\')\\n\\n\\ndef _short(value, maximum=160):\\n    text = redact_text(value).replace(\\'\\\\n\\', \\' \\').replace(\\'\\\\r\\', \\' \\')\\n    return text if len(text) <= maximum else text[:maximum - 1] + \\'…\\'\\n\\n\\ndef _activity(title, kwargs):\\n    _remember(title, kwargs.get(\\'details\\'))\\n    fields = [(label, value) for label, value in kwargs.get(\\'fields\\', ())\\n              if not any(word in str(label) for word in (\\'日志\\', \\'路径\\', \\'密钥\\', \\'当前记录\\'))]\\n    return {\\'title\\': _short(title, 70), \\'badge\\': _short(kwargs.get(\\'badge\\', \\'\\'), 35),\\n            \\'note\\': _short(kwargs.get(\\'note\\', \\'\\')), \\'tone\\': kwargs.get(\\'tone\\', \\'idle\\'),\\n            \\'fields\\': [(str(k), _short(v, 95)) for k, v in fields[:4]]}\\n\\n\\ndef card_html(title, *, badge=\"\", note=\"\", fields=(), tone=\"idle\", details=None, details_label=\"查看详情\"):\\n    escape = lambda value: html.escape(_short(value), quote=True)\\n    if tone not in {\"idle\", \"running\", \"success\", \"error\"}:\\n        tone = \"idle\"\\n    values = \"\".join(\\n        \\'<div><span class=\"h3-label\">\\' + escape(label) + \\'</span><span class=\"h3-value\">\\'\\n        + escape(value) + \\'</span></div>\\' for label, value in fields\\n    )\\n    return (STYLE + \\'<section class=\"h3-card\" data-tone=\"\\' + tone + \\'\"><div class=\"h3-head\">\\'\\n            + \\'<div class=\"h3-title\">\\' + escape(title) + \\'</div><span class=\"h3-badge\">\\'\\n            + escape(badge) + \\'</span></div>\\' + (\\'<p class=\"h3-note\">\\' + escape(note) + \\'</p>\\' if note else \"\")\\n            + (\\'<div class=\"h3-fields\">\\' + values + \\'</div>\\' if fields else \"\") + \"</section>\")\\n\\n\\ndef render_dashboard(context, activity=None):\\n    \"\"\"Render supplied observations only. This pure function performs no host I/O.\"\"\"\\n    escape = lambda value: html.escape(_short(value), quote=True)\\n    state = context.get(\\'state\\') or {}\\n    stale = bool(state.get(\\'observation_stale\\'))\\n    failed_read = bool(context.get(\\'observation_error\\'))\\n    phase = state.get(\\'phase\\')\\n    if context.get(\\'placeholder\\'):\\n        headline, next_step, tone = \\'等待首次读取\\', \\'运行「刷新看板」查看本次状态；此处是界面占位，没有实时观察。\\', \\'idle\\'\\n    elif failed_read:\\n        headline, next_step, tone = \\'状态读取失败\\', \\'重新刷新看板；如仍失败，在日志区查看原因。\\', \\'error\\'\\n    elif stale:\\n        headline, next_step, tone = \\'状态需要刷新\\', \\'当前观察已过期；刷新后再判断可用能力。\\', \\'running\\'\\n    elif phase == \\'stopped\\' and state.get(\\'cleanup_complete\\'):\\n        headline, next_step, tone = \\'本次服务已停止\\', \\'确认结果已保存后，可在控制面板释放 Colab 实例。\\', \\'idle\\'\\n    elif phase == \\'stopping\\':\\n        headline, next_step, tone = \\'正在停止与回收\\', \\'等待受管进程退出并确认清理完成；此时不要重复启动。\\', \\'running\\'\\n    elif state.get(\\'error\\') or phase in {\\'failed\\', \\'degraded\\'}:\\n        headline, next_step, tone = \\'有模块需要处理\\', \\'先看下方可用能力；具体原因在日志区，控制面板仍可查询或停止。\\', \\'error\\'\\n    elif state.get(\\'draining\\'):\\n        headline, next_step, tone = \\'已暂停接收新任务\\', \\'已接收的队列继续执行；可恢复接收，也可停止服务。\\', \\'idle\\'\\n    elif state.get(\\'ready\\'):\\n        headline, next_step, tone = \\'可以生成\\', \\'在控制面板提交新内容，或按任务 ID 查询已有任务。\\', \\'success\\'\\n    elif state.get(\\'api_ready\\'):\\n        accepting = (state.get(\\'queue\\') or {}).get(\\'admission_open\\') is True\\n        headline, next_step, tone = (\\'API 可用 · 生成尚未就绪\\',\\n            (\\'可先查询或排队；\\' if accepting else \\'可先查询；\\') + \\'模型、公网的当前能力分别见下方。\\', \\'running\\')\\n    elif state:\\n        headline, next_step, tone = \\'服务正在准备\\', \\'刷新看板观察进展；不要重复启动。\\', \\'running\\'\\n    elif not context.get(\\'preflight_ok\\'):\\n        headline, next_step, tone = \\'尚未检查资源\\', \\'在控制面板先运行「资源与驻留方案」。\\', \\'idle\\'\\n    elif not context.get(\\'install_ok\\'):\\n        headline, next_step, tone = \\'资源检查通过\\', \\'在控制面板运行「安装与检查」。\\', \\'idle\\'\\n    else:\\n        headline, next_step, tone = \\'准备工作已完成\\', \\'在控制面板选择是否开放公网，再启动服务。\\', \\'idle\\'\\n\\n    def module(name, alive_key, ready_key=None):\\n        alive, ready = state.get(alive_key), state.get(ready_key) if ready_key else None\\n        if not state:\\n            status, detail = (\\'尚未读取\\' if context.get(\\'placeholder\\') else \\'未启动\\'), \\'尚无运行观察\\'\\n        elif ready is True:\\n            status, detail = \\'可用\\', \\'进程运行中\\' if alive is True else \\'存活状态未确认\\'\\n        elif alive is True:\\n            status, detail = (\\'运行中\\', \\'调度与控制\\') if ready_key is None else (\\'准备中\\', \\'进程运行，能力未就绪\\')\\n        elif alive is False:\\n            status, detail = \\'已停止\\', \\'进程未运行\\'\\n        else:\\n            status, detail = \\'未确认\\', \\'缺少当前观察\\'\\n        if stale or failed_read:\\n            status, detail = \\'待刷新\\', \\'不据旧状态判断就绪\\'\\n        return (\\'<div class=\"h3-module\"><span class=\"h3-label\">\\' + escape(name) + \\'</span><strong>\\'\\n                + escape(status) + \\'</strong><div class=\"h3-subtle\">\\' + escape(detail) + \\'</div></div>\\')\\n\\n    if stale or failed_read:\\n        public = \\'待刷新\\'\\n    elif not state:\\n        public = \\'尚未观察\\'\\n    elif not state.get(\\'public_requested\\'):\\n        public = \\'未启用\\'\\n    elif state.get(\\'public_api_ready\\'):\\n        public = \\'API 探测通过\\'\\n    elif state.get(\\'tunnel_connected\\'):\\n        public = \\'隧道已连接 · API 待验证\\'\\n    else:\\n        public = \\'准备中\\'\\n    queue = state.get(\\'queue\\') or {}\\n    summary = [(\\'公网\\', public)]\\n    if queue and not stale and not failed_read:\\n        summary += [(\\'任务\\', f\"排队 {queue.get(\\'queued\\', \\'—\\')} · 执行 {queue.get(\\'running\\', \\'—\\')}\")]\\n        if queue.get(\\'admission_open\\') is False:\\n            summary.append((\\'接收任务\\', \\'已暂停\\'))\\n    resources = context.get(\\'resource_report\\') or {}\\n    if resources:\\n        summary += [(\\'GPU\\', resources.get(\\'gpu\\', \\'未记录\\')),\\n                    (\\'可用内存\\', str(resources.get(\\'available_ram_gib\\', \\'—\\')) + \\' GiB（预检）\\')]\\n    resource_text = \\'\\'.join(\\'<span><span class=\"h3-label\">\\' + escape(k) + \\'</span>\\' + escape(v) + \\'</span>\\' for k, v in summary)\\n    stamp = state.get(\\'observed_at\\')\\n    if isinstance(stamp, (int, float)):\\n        try:\\n            stamp = datetime.fromtimestamp(stamp, timezone(timedelta(hours=8))).strftime(\\'%m-%d %H:%M:%S 北京时间\\')\\n        except (OverflowError, OSError, ValueError):\\n            stamp = \\'未记录\\'\\n    else:\\n        stamp = \\'尚无服务快照\\'\\n    body = (STYLE + \\'<section class=\"h3-card h3-board\" data-tone=\"\\' + tone + \\'\" aria-label=\"运行看板\">\\'\\n            \\'<div class=\"h3-kicker\">当前状态</div><h2>\\' + escape(headline) + \\'</h2>\\'\\n            \\'<div class=\"h3-next\"><b>下一步</b>\\u3000\\' + escape(next_step) + \\'</div><div class=\"h3-modules\">\\'\\n            + module(\\'总管理\\', \\'manager_alive\\') + module(\\'API 后台\\', \\'server_alive\\', \\'api_ready\\')\\n            + module(\\'大模型容器\\', \\'model_alive\\', \\'model_ready\\') + \\'</div>\\'\\n            \\'<div class=\"h3-summary\">\\' + resource_text + \\'</div>\\')\\n    if activity:\\n        activity_tone = activity.get(\\'tone\\', \\'idle\\')\\n        if activity_tone not in {\\'idle\\', \\'running\\', \\'success\\', \\'error\\'}:\\n            activity_tone = \\'idle\\'\\n        body += (\\'<div class=\"h3-activity\" data-tone=\"\\' + activity_tone + \\'\"><div class=\"h3-label\">最近操作</div>\\'\\n                 \\'<div class=\"h3-head\"><span class=\"h3-title\">\\' + escape(activity.get(\\'title\\', \\'\\'))\\n                 + \\'</span><span class=\"h3-badge\">\\' + escape(activity.get(\\'badge\\', \\'\\')) + \\'</span></div>\\')\\n        if activity.get(\\'note\\'):\\n            body += \\'<div class=\"h3-note\">\\' + escape(activity[\\'note\\']) + \\'</div>\\'\\n        fields = activity.get(\\'fields\\') or ()\\n        if fields:\\n            body += \\'<div class=\"h3-fields\">\\' + \\'\\'.join(\\'<div><span class=\"h3-label\">\\' + escape(k)\\n                + \\'</span><span class=\"h3-value\">\\' + escape(v) + \\'</span></div>\\' for k, v in fields[:4]) + \\'</div>\\'\\n        body += \\'</div>\\'\\n    return body + \\'<div class=\"h3-stamp\">服务观察：\\' + escape(stamp) + \\' · 按需刷新，不执行控制命令</div></section>\\'\\n\\n\\nclass Dashboard:\\n    def __init__(self, context_reader):\\n        self.context_reader = context_reader\\n        self.activity = None\\n        self._handle = None\\n\\n    def refresh(self):\\n        from IPython.display import HTML, display\\n        global _known_secrets\\n        context = dict(self.context_reader())\\n        host = context.pop(\\'host\\', None)\\n        if host is not None:\\n            key = getattr(host, \\'api_key\\', None)\\n            if key:\\n                _known_secrets = tuple(set((*_known_secrets[-3:], str(key))))\\n            try:\\n                context[\\'state\\'] = host.snapshot()\\n            except Exception as error:\\n                context[\\'state\\'] = {}\\n                context[\\'observation_error\\'] = True\\n                _remember(\\'看板状态读取失败\\', str(error))\\n        rendered = HTML(render_dashboard(context, self.activity))\\n        if self._handle is None:\\n            self._handle = display(rendered, display_id=\\'h3-dashboard\\')\\n        else:\\n            self._handle.update(rendered)\\n        return context\\n\\n\\ndef mount_dashboard(context_reader):\\n    global _dashboard\\n    _dashboard = Dashboard(context_reader)\\n    _dashboard.refresh()\\n    return _dashboard\\n\\n\\nclass StatusCard:\\n    def __init__(self, title, **kwargs):\\n        self._handle = None\\n        self.update(title, **kwargs)\\n\\n    def update(self, title, **kwargs):\\n        from IPython.display import HTML, display\\n        activity = _activity(title, kwargs)\\n        if _dashboard is not None:\\n            _dashboard.activity = activity\\n            _dashboard.refresh()\\n        elif self._handle is None:\\n            self._handle = display(HTML(card_html(**activity)), display_id=True)\\n        else:\\n            self._handle.update(HTML(card_html(**activity)))\\n\\n\\ndef elapsed_text(seconds):\\n    seconds = max(0, int(seconds))\\n    return f\"{seconds // 60}分{seconds % 60:02d}秒\" if seconds >= 60 else f\"{seconds}秒\"\\n\\n\\ndef log_tail(path, limit=6000):\\n    path = Path(path)\\n    if not path.is_file():\\n        return \"\"\\n    with path.open(\"rb\") as source:\\n        source.seek(max(0, path.stat().st_size - limit))\\n        text = source.read().decode(\"utf-8\", errors=\"replace\")\\n    return re.sub(r\"\\\\x1b\\\\[[0-?]*[ -/]*[@-~]\", \"\", text).replace(\"\\\\r\", \"\\\\n\")\\n\\n\\ndef latest_stage(path):\\n    lines = [line.strip() for line in log_tail(path).splitlines() if line.strip()]\\n    for line in reversed(lines):\\n        if \"BF16 staged:\" in line:\\n            return line.split(\"BF16 staged:\", 1)[1].strip()[:145]\\n        if \"status=\" in line or \"API_SMOKE_TEST_PASSED\" in line:\\n            return line[:145]\\n    return lines[-1][:145] if lines else \"进程已启动，等待首条日志\"\\n\\n\\ndef run_logged(command, log_path, *, title, cwd=None, env=None, card=None, status_reader=None):\\n    \"\"\"Run a real child process; persist logs and update a bounded status card.\"\"\"\\n    path = Path(log_path)\\n    path.parent.mkdir(parents=True, exist_ok=True)\\n    status = card or StatusCard(title, badge=\"执行中\", tone=\"running\", note=\"完整输出写入日志。\")\\n    started = time.monotonic()\\n    with path.open(\"a\", encoding=\"utf-8\") as output:\\n        output.write(\"\\\\n--- \" + title + \" ---\\\\n\")\\n        output.flush()\\n        process = subprocess.Popen(command, cwd=cwd, env=env, stdout=output, stderr=subprocess.STDOUT)\\n        observer = _process_observer\\n        if observer is not None:\\n            observer.process_started(process)\\n        try:\\n            while process.poll() is None:\\n                if observer is not None:\\n                    observer.process_progress(process)\\n                current = []\\n                if status_reader is not None:\\n                    try:\\n                        current = status_reader()\\n                    except (OSError, ValueError):\\n                        pass\\n                status.update(title, badge=\"执行中\", tone=\"running\", fields=\\n                    [(\"已用时间\", elapsed_text(time.monotonic() - started))]\\n                    + current)\\n                time.sleep(2)\\n        except BaseException:\\n            process.terminate()\\n            try:\\n                process.wait(timeout=15)\\n            except subprocess.TimeoutExpired:\\n                process.kill()\\n                process.wait()\\n            status.update(title, badge=\"已中断\", tone=\"error\", note=\"操作进程已停止；已提交的远程任务可能仍在执行。\", fields=[(\"日志\", str(path))])\\n            raise\\n        finally:\\n            if observer is not None:\\n                observer.process_finished(process)\\n    if process.returncode:\\n        status.update(title, badge=\"未完成\", tone=\"error\", note=\"查看日志中的实际错误后再重试。\",\\n                      fields=[(\"日志\", str(path))], details=log_tail(path), details_label=\"展开最后的错误日志\")\\n        raise RuntimeError(f\"{title}退出码 {process.returncode}；完整日志：{path}\")\\n    status.update(title, badge=\"完成\", tone=\"success\", fields=[\\n        (\"已用时间\", elapsed_text(time.monotonic() - started)), (\"完整日志\", str(path)),\\n    ])\\n    return process.returncode\\n\\n\\ndef json_probe(command, log_path, *, cwd=None, env=None, card=None):\\n    \"\"\"Capture a short JSON-producing check without dumping full notebook output.\"\"\"\\n    process = subprocess.Popen(command, cwd=cwd, env=env, text=True,\\n                               stdout=subprocess.PIPE, stderr=subprocess.PIPE)\\n    observer = _process_observer\\n    try:\\n        if observer is not None:\\n            observer.process_started(process)\\n        stdout, stderr = process.communicate(timeout=180)\\n    except BaseException:\\n        if process.poll() is None:\\n            process.kill()\\n            process.communicate(timeout=10)\\n        raise\\n    finally:\\n        if observer is not None:\\n            observer.process_finished(process)\\n    with Path(log_path).open(\"a\", encoding=\"utf-8\") as log:\\n        log.write(stdout + \"\\\\n\" + stderr + \"\\\\n\")\\n    if process.returncode:\\n        if card is not None:\\n            card.update(\"依赖检查未通过\", badge=\"需要处理\", tone=\"error\", note=\"检查日志中的版本或导入错误后再继续。\",\\n                        fields=[(\"日志\", str(log_path))], details=stderr[-4000:], details_label=\"展开检查错误\")\\n        raise RuntimeError(f\"依赖检查失败；请在日志区查看：{log_path}\")\\n    return json.loads(stdout.strip().splitlines()[-1])\\n', 'pipeline_backend.py': '\"\"\"CPU prepare -> exclusive GPU inference -> CPU encoding, with per-job ownership.\\n\\nReference/codec behavior follows Diffusers v0.43 references.py/export_utils.py.\\nIts encode_video has no thread-budget argument; this local PyAV writer sets\\ncodec thread_count explicitly and avoids stacking every output frame again.\\nResource numbers are conservative admission estimates, not calibrated optima.\\n\"\"\"\\nfrom __future__ import annotations\\n\\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\\nfrom contextlib import contextmanager, nullcontext\\nfrom dataclasses import dataclass\\nfrom fractions import Fraction\\nimport json\\nimport gc\\nimport math\\nimport os\\nfrom pathlib import Path\\n\\nfrom runtime_options import RuntimeSupport, measured_generation\\nfrom generation_options import requested_options, validate_generation_options, effective_options\\nfrom adapter_config import select_reference_setup, select_loaded_adapters\\n\\nMIB, GIB = 1024**2, 1024**3\\n\\n\\n@dataclass\\nclass Prepared:\\n    parameters: dict\\n    references: list\\n    normalized: list\\n    metrics: object\\n    cpu_threads: int = 1\\n    cleaned: bool = False\\n\\n\\n@dataclass\\nclass CPUResult:\\n    video: list\\n    audio: object\\n    sampling_rate: int\\n    metrics: object\\n    cpu_threads: int\\n    cpu_handoff_complete: bool = False\\n    cleaned: bool = False\\n\\n\\ndef _audio_from_container(av, container, stream):\\n    import numpy as np\\n    import torch\\n    stream.codec_context.thread_count = 1\\n    rate = int(stream.codec_context.sample_rate)\\n    if not 0 < rate <= 96000 or len(stream.layout.channels) > 2:\\n        raise ValueError(\"Reference soundtrack exceeds 96 kHz / stereo\")\\n    resampler = av.AudioResampler(format=\"fltp\", layout=stream.layout, rate=rate)\\n    chunks, samples = [], 0\\n    def append(frames):\\n        nonlocal samples\\n        for item in frames:\\n            value = item.to_ndarray()\\n            samples += value.shape[-1]\\n            if samples > math.ceil(15.1 * rate):\\n                raise ValueError(\"Decoded reference soundtrack exceeds 15 seconds\")\\n            chunks.append(value)\\n    for frame in container.decode(stream):\\n        append(resampler.resample(frame))\\n    append(resampler.resample(None))\\n    if not chunks:\\n        raise ValueError(\"Reference soundtrack is empty\")\\n    return torch.from_numpy(np.concatenate(chunks, axis=-1).astype(np.float32, copy=False)), rate\\n\\n\\ndef decode_reference(kind, path, classes):\\n    \"\"\"CPU-only decoding with one native codec thread and decoded-size guards.\"\"\"\\n    if kind == \"image\":\\n        return classes[kind].from_file(str(path))\\n    import av\\n    import numpy as np\\n    with av.open(str(path)) as container:\\n        if kind == \"audio\":\\n            audio, rate = _audio_from_container(av, container, container.streams.audio[0])\\n            return classes[kind](audio=audio, sample_rate=rate)\\n        stream = container.streams.video[0]\\n        stream.codec_context.thread_count = 1\\n        frames = []\\n        for frame in container.decode(stream):\\n            if len(frames) >= 362 or frame.width * frame.height > 960 * 544:\\n                raise ValueError(\"Normalized reference exceeds bounded decoded geometry\")\\n            frames.append(frame.to_ndarray(format=\"rgb24\"))\\n        if not frames:\\n            raise ValueError(\"Reference video is empty\")\\n        fps = float(stream.average_rate or stream.guessed_rate)\\n        audio, rate = None, None\\n        if container.streams.audio:\\n            container.seek(0)\\n            audio, rate = _audio_from_container(av, container, container.streams.audio[0])\\n        return classes[kind](frames=np.stack(frames), fps=fps, audio=audio, sample_rate=rate)\\n\\n\\ndef cpu_media(video, audio, sampling_rate, torch):\\n    \"\"\"Copy outputs into CPU-owned numpy buffers; never retain PipelineState.\"\"\"\\n    import numpy as np\\n    def array(value):\\n        if isinstance(value, torch.Tensor):\\n            value = value.detach().to(device=\"cpu\", copy=True)\\n            if value.is_floating_point():\\n                value = value.float()\\n            value = value.numpy()\\n        return np.array(value, copy=True)\\n    frames = []\\n    for frame in video:\\n        pixels = array(frame)\\n        if pixels.ndim != 3 or pixels.shape[-1] != 3:\\n            raise ValueError(\"Expected HWC RGB video output\")\\n        if pixels.dtype != np.uint8:\\n            if not np.isfinite(pixels).all() or pixels.min() < 0 or pixels.max() > 1:\\n                raise ValueError(\"Float video output must be finite and normalized\")\\n            pixels = (pixels * 255).round().astype(np.uint8)\\n        frames.append(pixels)\\n    waveform = array(audio).astype(np.float32, copy=False)\\n    if waveform.ndim != 2 or waveform.shape[0] != 2 or not np.isfinite(waveform).all():\\n        raise ValueError(\"Expected finite stereo audio output\")\\n    if not frames or not 0 < int(sampling_rate) <= 96000:\\n        raise ValueError(\"Invalid output media\")\\n    return frames, waveform, int(sampling_rate)\\n\\n\\ndef encode_cpu_media(result, output_path):\\n    \"\"\"Same H.264/AAC formats as official exporter, explicitly bounded threads.\"\"\"\\n    import av\\n    import numpy as np\\n    if not result.cpu_handoff_complete or result.cleaned:\\n        raise RuntimeError(\"Encoding requires a completed CPU ownership handoff\")\\n    with av.open(str(output_path), mode=\"w\") as container:\\n        stream = container.add_stream(\"libx264\", rate=24)\\n        stream.width, stream.height = result.video[0].shape[1], result.video[0].shape[0]\\n        stream.pix_fmt = \"yuv420p\"\\n        stream.codec_context.thread_count = result.cpu_threads\\n        audio_stream = container.add_stream(\"aac\", rate=result.sampling_rate)\\n        cc = audio_stream.codec_context\\n        cc.sample_rate, cc.layout = result.sampling_rate, \"stereo\"\\n        cc.time_base, cc.thread_count = Fraction(1, result.sampling_rate), 1\\n        for pixels in result.video:\\n            frame = av.VideoFrame.from_ndarray(pixels, format=\"rgb24\")\\n            for packet in stream.encode(frame):\\n                container.mux(packet)\\n        for packet in stream.encode():\\n            container.mux(packet)\\n        samples = (np.clip(result.audio.T, -1, 1) * 32767).astype(np.int16)\\n        audio_frame = av.AudioFrame.from_ndarray(np.ascontiguousarray(samples).reshape(1, -1), format=\"s16\", layout=\"stereo\")\\n        audio_frame.sample_rate = result.sampling_rate\\n        resampler = av.AudioResampler(format=cc.format or \"fltp\", layout=cc.layout or \"stereo\", rate=cc.sample_rate)\\n        next_pts = 0\\n        for frame in resampler.resample(audio_frame) + resampler.resample(None):\\n            if frame.pts is None:\\n                frame.pts = next_pts\\n            next_pts += frame.samples\\n            frame.sample_rate = result.sampling_rate\\n            for packet in audio_stream.encode(frame):\\n                container.mux(packet)\\n        for packet in audio_stream.encode():\\n            container.mux(packet)\\n    if not Path(output_path).is_file() or not Path(output_path).stat().st_size:\\n        raise RuntimeError(\"Encoder produced no video\")\\n\\n\\nclass PipelineBackendSupport(RuntimeSupport):\\n    pipeline_model_peak_ram_bytes = 144 * GIB\\n    resource_residency = \"resident\"\\n\\n    def validate_generation_request(self, *, steps, attention_backend=None, acceleration_lora=None):\\n        values = {\"steps\": steps}\\n        if attention_backend is not None:\\n            values[\"attention_backend\"] = attention_backend\\n        if acceleration_lora is not None:\\n            values[\"acceleration_lora\"] = acceleration_lora\\n        return validate_generation_options(requested_options(values), self.adapter_settings)\\n\\n    def _apply_generation_transformer(self, effective, *, audit=True):\\n        transformer = getattr(self.pipe, \"transformer_ref\", None)\\n        if transformer is None:\\n            raise RuntimeError(\"The generation transformer is unavailable\")\\n        # Always set native explicitly, so forced Flash never leaks into auto.\\n        transformer.set_attention_backend(effective[\"attention_backend\"])\\n        select_loaded_adapters(self.pipe, self.adapter_settings, effective[\"acceleration_lora\"])\\n        if audit and self._active_metrics is not None:\\n            self._active_metrics.data[\"generation_options\"][\"effective\"] = dict(effective)\\n\\n    @contextmanager\\n    def generation_context(self, prepared):\\n        \"\"\"Mutate and restore shared model state only inside infer\\'s GPU lease.\\n\\n        CPU preparation can overlap other jobs; it must not change adapters,\\n        attention processors, reference setup, or scheduler state. Staged\\n        residency applies the same choices after its transformer is loaded.\\n        \"\"\"\\n        if getattr(self, \"_active_generation_options\", None) is not None:\\n            raise RuntimeError(\"Generation configuration already owns the GPU lease\")\\n        requested = requested_options(prepared.parameters)\\n        validate_generation_options(requested, self.adapter_settings)\\n        effective = effective_options(requested, self.adapter_settings, self.runtime_options)\\n        prepared.metrics.data.setdefault(\"generation_options\", {\"requested\": dict(requested), \"effective\": None})\\n        original = self.pipe.blocks.sub_blocks[\"before_encode\"]\\n        self._active_generation_options = effective\\n        try:\\n            select_reference_setup(self.pipe, requested[\"acceleration_lora\"])\\n            if getattr(self.pipe, \"transformer_ref\", None) is not None:\\n                self._apply_generation_transformer(effective)\\n            yield\\n        finally:\\n            try:\\n                self.pipe.blocks.sub_blocks[\"before_encode\"] = original\\n                if getattr(self.pipe, \"transformer_ref\", None) is not None:\\n                    defaults = effective_options({\"attention_backend\": \"auto\",\\n                        \"acceleration_lora\": self.adapter_settings.acceleration, \"steps\": requested[\"steps\"]},\\n                        self.adapter_settings, self.runtime_options)\\n                    self._apply_generation_transformer(defaults, audit=False)\\n            finally:\\n                self._active_generation_options = None\\n\\n    def configure_cpu_budget(self, gpu_threads):\\n        \"\"\"Configure native CPU pools exactly once, before any model is loaded.\\n\\n        GPU work also occupies host CPU capacity. CPU preparation/encoding use\\n        bounded codecs and numpy copies, not multithreaded torch/BLAS operators.\\n        Environment defaults cover libraries imported later; the caller can\\n        audit again after load without changing any process-wide setting.\\n        \"\"\"\\n        if isinstance(gpu_threads, bool) or not isinstance(gpu_threads, int) or gpu_threads < 1:\\n            raise ValueError(\"GPU host CPU reservation must be a positive integer\")\\n        previous = getattr(self, \"_native_cpu_requested\", None)\\n        if previous is not None:\\n            if previous != gpu_threads:\\n                raise RuntimeError(\"Native CPU pools cannot be reconfigured during this model lifetime\")\\n            return self.cpu_budget_snapshot()\\n        if self._loaded or self.pipe is not None:\\n            raise RuntimeError(\"Native CPU pools must be configured before model loading\")\\n        # Keep the hardware gate before torch imports/downloads, including the\\n        # real Windows CPU integration\\'s explicit Linux/NVIDIA rejection.\\n        from preflight import check_resources\\n        check_resources(residency=self.resource_residency)\\n        environment = {name: str(gpu_threads) for name in (\\n            \"OMP_NUM_THREADS\", \"MKL_NUM_THREADS\", \"OPENBLAS_NUM_THREADS\",\\n            \"BLIS_NUM_THREADS\", \"VECLIB_MAXIMUM_THREADS\", \"NUMEXPR_NUM_THREADS\")}\\n        environment.update(OMP_MAX_ACTIVE_LEVELS=\"1\", OMP_DYNAMIC=\"FALSE\", MKL_DYNAMIC=\"FALSE\",\\n                           TOKENIZERS_PARALLELISM=\"false\", RAYON_NUM_THREADS=str(gpu_threads))\\n        os.environ.update(environment)\\n        import numpy  # Load the CPU pools we use before applying/readback.\\n        import torch\\n        from threadpoolctl import threadpool_limits\\n        torch.set_num_threads(gpu_threads)\\n        interop_note = \"set_before_load\"\\n        try:\\n            torch.set_num_interop_threads(1)\\n        except RuntimeError:\\n            if torch.get_num_interop_threads() != 1:\\n                raise RuntimeError(\"Cannot enforce one torch interop thread before model loading\") from None\\n            interop_note = \"already_initialized_at_one\"\\n        self._native_cpu_limiter = threadpool_limits(limits=gpu_threads)\\n        self._native_cpu_requested = gpu_threads\\n        self._native_cpu_environment = environment\\n        self._native_cpu_interop_note = interop_note\\n        try:\\n            return self.cpu_budget_snapshot()\\n        except BaseException:\\n            self._native_cpu_requested = None\\n            raise\\n\\n    def cpu_budget_snapshot(self):\\n        \"\"\"Read and validate real pool limits; never change them in running jobs.\"\"\"\\n        requested = getattr(self, \"_native_cpu_requested\", None)\\n        if requested is None:\\n            raise RuntimeError(\"Native CPU budget has not been configured\")\\n        import torch\\n        from threadpoolctl import threadpool_info\\n        pools = [{key: pool.get(key) for key in (\"user_api\", \"internal_api\", \"prefix\", \"version\", \"num_threads\")}\\n                 for pool in threadpool_info()]\\n        actual = torch.get_num_threads()\\n        interop = torch.get_num_interop_threads()\\n        if actual != requested or interop != 1:\\n            raise RuntimeError(f\"Torch CPU budget differs from reservation: intra={actual}, interop={interop}, reserved={requested}\")\\n        for pool in pools:\\n            threads = pool[\"num_threads\"]\\n            if isinstance(threads, bool) or not isinstance(threads, int) or not 1 <= threads <= requested:\\n                raise RuntimeError(f\"Native pool CPU limit is not confirmed: {pool[\\'internal_api\\']}={threads}, reserved={requested}\")\\n        return {\"configured\": True, \"configured_before_load\": True, \"gpu_host_cpu_threads\": requested,\\n                \"torch_num_threads\": actual, \"torch_num_interop_threads\": interop,\\n                \"interop_configuration\": self._native_cpu_interop_note,\\n                \"native_pools\": pools, \"environment_defaults\": dict(self._native_cpu_environment),\\n                \"scope\": \"observed native CPU pools; codec lanes have separate explicit thread budgets\"}\\n\\n    @property\\n    def pipeline_model_headroom_bytes(self):\\n        import psutil\\n        return max(0, self.pipeline_model_peak_ram_bytes - psutil.Process().memory_info().rss)\\n\\n    def estimate_resources(self, parameters):\\n        \"\"\"Bounds retained media + decode/transfer/encode copies; excludes model.\"\"\"\\n        from PIL import Image\\n        references = parameters[\"references\"]\\n        durations, retained, source_bytes, normalized_bytes, pipeline_media = [], 0, 0, 0, 0\\n        frames = self._aligned_frames(parameters[\"seconds\"])\\n        for item in references:\\n            path, kind = Path(item[\"path\"]), item[\"kind\"]\\n            duration = self._reference_probe(path, kind)\\n            durations.append((kind, duration))\\n            source_bytes += path.stat().st_size\\n            if kind == \"image\":\\n                with Image.open(path) as image:\\n                    retained += image.width * image.height * 4\\n                    # Official conditioning upscales even tiny images to a 2048\\n                    # short edge. Reserve resized RGB plus float/temporary copies.\\n                    ratio = max(image.width, image.height) / min(image.width, image.height)\\n                    pipeline_media += 2048 * (math.ceil(2048 * ratio / 32) * 32) * 20\\n            elif kind == \"video\":\\n                size = (math.ceil(duration * 24) + 2) * 960 * 544 * 3 + math.ceil(duration * 32000) * 2 * 4\\n                retained += size\\n                normalized_bytes += size + MIB\\n                # The GPU workflow can resize reference video again to the\\n                # official 1344*768 canvas; it is not a CPU preparation stage.\\n                pipeline_media += min(frames, math.ceil(duration * 24) + 2) * 1344 * 768 * 3 * 8\\n            elif kind == \"audio\":\\n                retained += math.ceil(duration * 96000) * 2 * 4\\n            else:\\n                raise ValueError(\"Unknown reference modality\")\\n        for kind in (\"video\", \"audio\"):\\n            if sum(d for k, d in durations if k == kind) > 15:\\n                raise ValueError(\"Total reference duration per modality must be <=15 seconds\")\\n        output = frames * parameters[\"width\"] * parameters[\"height\"] * 3 + math.ceil(frames / 24 * 96000) * 2 * 4\\n        return {\"ram_bytes\": 3 * retained + 4 * output + pipeline_media + 256 * MIB,\\n                \"cpu_threads\": 1, \"disk_bytes\": source_bytes + normalized_bytes + output + 4 * MIB,\\n                \"reference_retained_bytes\": retained, \"output_retained_bytes\": output,\\n                \"pipeline_reference_workspace_bytes\": pipeline_media,\\n                \"estimate_kind\": \"conservative decoded-media admission estimate; not calibrated physical optimum\"}\\n\\n    def prepare(self, *, prompt, references, seconds, width, height, steps, seed, cpu_threads=1,\\n                attention_backend=None, acceleration_lora=None):\\n        options = {}\\n        if attention_backend is not None:\\n            options[\"attention_backend\"] = attention_backend\\n        if acceleration_lora is not None:\\n            options[\"acceleration_lora\"] = acceleration_lora\\n        self.validate_request(steps=steps, **options)\\n        if self.pipe is None:\\n            raise RuntimeError(\"The model has not loaded\")\\n        if isinstance(cpu_threads, bool) or not isinstance(cpu_threads, int) or cpu_threads < 1:\\n            raise ValueError(\"cpu_threads must be a positive reserved CPU budget\")\\n        from diffusers.modular_pipelines.minimax_h3 import MiniMaxH3ImageReference, MiniMaxH3VideoReference, MiniMaxH3AudioReference\\n        classes = {\"image\": MiniMaxH3ImageReference, \"video\": MiniMaxH3VideoReference, \"audio\": MiniMaxH3AudioReference}\\n        parameters = dict(prompt=prompt, seconds=seconds, width=width, height=height, steps=steps, seed=seed, **options)\\n        metrics = self._active_metrics or self._new_metrics(\"generation\")\\n        metrics.data[\"timing\"] = \"host_wall_seconds; inference synchronizes at CPU handoff\"\\n        metrics.data[\"pipeline_stage_contract\"] = \"cpu_prepare / exclusive_gpu_infer / cpu_encode_validate\"\\n        metrics.data[\"generation_options\"] = {\"requested\": requested_options(parameters), \"effective\": None}\\n        prepared = Prepared(parameters, [], [], metrics, cpu_threads)\\n        try:\\n            with self.metrics_context(metrics), self._stage(\"references.prepare\"):\\n                durations = [self._reference_probe(Path(item[\"path\"]), item[\"kind\"]) for item in references]\\n                for kind in (\"video\", \"audio\"):\\n                    if sum(d for item, d in zip(references, durations) if item[\"kind\"] == kind) > 15:\\n                        raise ValueError(\"Total reference duration per modality must be <=15 seconds\")\\n                normalized_targets = {}\\n                for index, item in enumerate(references):\\n                    if item[\"kind\"] == \"video\":\\n                        path = Path(item[\"path\"])\\n                        target = path.with_name(path.stem + f\"_ref{index}_24fps.mp4\")\\n                        prepared.normalized.append(target)\\n                        normalized_targets[index] = target\\n                def decode(index):\\n                    item = references[index]\\n                    with metrics.stage(f\"child.prepare.{index}\"):\\n                        path = Path(item[\"path\"])\\n                        if item[\"kind\"] == \"video\":\\n                            path = self._normalize_reference(path, target=normalized_targets[index])\\n                        return decode_reference(item[\"kind\"], path, classes)\\n                prepared.references = [None] * len(references)\\n                lanes = min(cpu_threads, len(references))\\n                metrics.record_schedule({\"phase\": \"prepare\", \"workers\": lanes, \"child_count\": len(references),\\n                                         \"reason\": \"explicit CPU budget; each native decoder/normalizer uses one thread\"})\\n                if lanes <= 1:\\n                    for index in range(len(references)):\\n                        prepared.references[index] = decode(index)\\n                else:\\n                    with ThreadPoolExecutor(max_workers=lanes, thread_name_prefix=\"h3-reference\") as pool:\\n                        futures = {pool.submit(decode, i): i for i in range(len(references))}\\n                        for future in as_completed(futures):\\n                            prepared.references[futures[future]] = future.result()\\n            return prepared\\n        except BaseException as error:\\n            metrics.finish(error)\\n            self.cleanup(prepared=prepared)\\n            raise\\n\\n    def infer(self, prepared):\\n        import torch\\n        if prepared.cleaned:\\n            raise RuntimeError(\"Prepared references have already been released\")\\n        raw = None\\n        try:\\n            with self.metrics_context(prepared.metrics), self._stage(\"pipeline\"), torch.inference_mode():\\n                configuration = self.generation_context(prepared) if hasattr(self, \"adapter_settings\") else nullcontext()\\n                with configuration:\\n                    try:\\n                        raw = self._infer_raw(prepared)\\n                        video, audio, rate = cpu_media(raw[\"videos\"][0], raw[\"audio\"][0], raw[\"sampling_rate\"], torch)\\n                        result = CPUResult(video, audio, rate, prepared.metrics, prepared.cpu_threads)\\n                    finally:\\n                        raw = None\\n                        prepared.references.clear()\\n                        # Synchronize before restoring adapters and attention.\\n                        # CPU encoding never changes model or CUDA state.\\n                        gc.collect()\\n                        torch.cuda.synchronize()\\n                        torch.cuda.empty_cache()\\n                result.cpu_handoff_complete = True\\n                return result\\n        except BaseException as err