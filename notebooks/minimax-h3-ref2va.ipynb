orary = path.with_suffix(\".tmp\")\\\\n            temporary.write_text(json.dumps(state, indent=2), encoding=\"utf-8\")\\\\n            temporary.replace(path)\\\\n\\\\n    process = None\\\\n    registered = set()\\\\n    publish()\\\\n    try:\\\\n        # A loading origin may not be listening yet. Transport installation and\\\\n        # registration do not depend on its /health response.\\\\n        binary = cloudflared_binary(install)\\\\n        process = subprocess.Popen(\\\\n            [binary, \"tunnel\", \"--no-autoupdate\", \"--url\", f\"http://127.0.0.1:{port}\"],\\\\n            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1,\\\\n        )\\\\n        publish(pid=process.pid)\\\\n        for line in process.stdout:\\\\n            match = re.search(r\"https://[a-z0-9-]+\\\\\\\\.trycloudflare\\\\\\\\.com\", line)\\\\n            if match and not state[\"url\"]:\\\\n                publish(url=match.group(0))\\\\n                print(f\"PUBLIC_API_URL={match.group(0)}\", flush=True)\\\\n                print(\"Candidate URL allocated; application readiness still requires the live join.\", flush=True)\\\\n            connection = re.search(r\"connIndex=(\\\\\\\\d+)\", line)\\\\n            connection_id = connection.group(1) if connection else \"default\"\\\\n            if \"Registered tunnel connection\" in line:\\\\n                registered.add(connection_id)\\\\n                publish(phase=\"registered\", connected=True)\\\\n            elif any(marker in line for marker in (\\\\n                \"Unregistered tunnel connection\", \"Connection terminated\",\\\\n                \"failed to serve tunnel connection\", \"Serve tunnel error\",\\\\n            )):\\\\n                if connection:\\\\n                    registered.discard(connection_id)\\\\n                else:\\\\n                    registered.clear()  # No connection identity: revoke conservatively.\\\\n                publish(phase=\"registered\" if registered else \"reconnecting\", connected=bool(registered))\\\\n            print(line, end=\"\", flush=True)\\\\n        if process.wait() != 0:\\\\n            raise RuntimeError(\"cloudflared stopped; see the tunnel log above\")\\\\n    except KeyboardInterrupt:\\\\n        publish(phase=\"stopping\", connected=False)\\\\n        raise\\\\n    except BaseException as error:\\\\n        publish(phase=\"failed\", connected=False, error=type(error).__name__)\\\\n        raise\\\\n    finally:\\\\n        if process is not None and process.poll() is None:\\\\n            process.terminate()\\\\n            try:\\\\n                process.wait(timeout=10)\\\\n            except subprocess.TimeoutExpired:\\\\n                process.kill()\\\\n                process.wait()\\\\n        publish(phase=\"failed\" if state[\"phase\"] == \"failed\" else \"stopped\", connected=False)\\\\n\\\\n\\\\nif __name__ == \"__main__\":\\\\n    signal.signal(signal.SIGTERM, lambda *_: (_ for _ in ()).throw(KeyboardInterrupt()))\\\\n    watch_owner(os.environ.get(\"H3_PARENT_PID\"))\\\\n    parser = argparse.ArgumentParser(description=__doc__)\\\\n    parser.add_argument(\"--port\", type=int, default=8000)\\\\n    parser.add_argument(\"--install\", action=\"store_true\", help=\"Download official cloudflared if missing, checking GitHub release SHA-256\")\\\\n    parser.add_argument(\"--status-file\", type=Path, help=\"Atomic transport state checkpoint owned by the startup supervisor\")\\\\n    parser.add_argument(\"--instance-id\", help=\"Owning startup session ID; never an API credential\")\\\\n    args = parser.parse_args()\\\\n    try:\\\\n        run_tunnel(args.port, args.install, status_file=args.status_file, instance_id=args.instance_id)\\\\n    except KeyboardInterrupt:\\\\n        print(\"Tunnel stopped. Local GPU server remains running until you stop it.\")\\\\n\\', \\'client.py\\': \\'\"\"\"Submit ordered references to the ref2va API, poll, and download the MP4.\"\"\"\\\\nfrom __future__ import annotations\\\\n\\\\nimport argparse\\\\nfrom contextlib import ExitStack\\\\nimport json\\\\nimport mimetypes\\\\nimport os\\\\nfrom pathlib import Path\\\\nimport time\\\\nimport requests\\\\n\\\\n\\\\nclass ReferenceAction(argparse.Action):\\\\n    def __call__(self, parser, namespace, value, option_string=None):\\\\n        items = list(getattr(namespace, self.dest, None) or [])\\\\n        items.append((option_string.removeprefix(\"--\"), Path(value)))\\\\n        setattr(namespace, self.dest, items)\\\\n\\\\n\\\\ndef main() -> None:\\\\n    parser = argparse.ArgumentParser(description=__doc__)\\\\n    parser.add_argument(\"url\", help=\"API base URL, e.g. https://example.trycloudflare.com\")\\\\n    parser.add_argument(\"--prompt\", required=True)\\\\n    for kind in (\"image\", \"video\", \"audio\"):\\\\n        parser.add_argument(\"--\" + kind, dest=\"references\", action=ReferenceAction, metavar=\"FILE\")\\\\n    parser.add_argument(\"--output\", type=Path, default=Path(\"result.mp4\"))\\\\n    parser.add_argument(\"--seconds\", type=float, default=5)\\\\n    parser.add_argument(\"--width\", type=int, default=960)\\\\n    parser.add_argument(\"--height\", type=int, default=544)\\\\n    parser.add_argument(\"--steps\", type=int, default=50)\\\\n    parser.add_argument(\"--seed\", type=int, default=42)\\\\n    parser.add_argument(\"--timeout\", type=int, default=7200, help=\"Maximum poll time in seconds\")\\\\n    args = parser.parse_args()\\\\n    key = os.environ.get(\"H3_API_KEY\")\\\\n    if not key:\\\\n        parser.error(\"Set H3_API_KEY in the caller\\\\\\'s environment first\")\\\\n    if not args.references:\\\\n        parser.error(\"At least one --image or --video reference is required\")\\\\n    if args.output.exists():\\\\n        parser.error(\"Output file already exists; choose another --output path\")\\\\n    base = args.url.rstrip(\"/\")\\\\n    if not (base.startswith(\"https://\") or base.startswith(\"http://127.0.0.1:\")):\\\\n        parser.error(\"Use HTTPS for public endpoints, or HTTP on 127.0.0.1 for local testing\")\\\\n    headers = {\"Authorization\": \"Bearer \" + key}\\\\n    with ExitStack() as stack:\\\\n        files = [(\"files\", (path.name, stack.enter_context(path.open(\"rb\")), mimetypes.guess_type(path.name)[0] or \"application/octet-stream\"))\\\\n                 for _, path in args.references]\\\\n        response = requests.post(\\\\n            base + \"/v1/jobs\", headers=headers, files=files,\\\\n            data={\"kinds\": json.dumps([kind for kind, _ in args.references]), \"prompt\": args.prompt,\\\\n                  \"seconds\": args.seconds, \"width\": args.width, \"height\": args.height,\\\\n                  \"steps\": args.steps, \"seed\": args.seed}, timeout=120,\\\\n        )\\\\n    response.raise_for_status()\\\\n    job_id = response.json()[\"id\"]\\\\n    print(\"Job:\", job_id, flush=True)\\\\n    deadline = time.monotonic() + args.timeout\\\\n    while True:\\\\n        response = requests.get(base + f\"/v1/jobs/{job_id}\", headers=headers, timeout=30)\\\\n        response.raise_for_status()\\\\n        job = response.json()\\\\n        print(job[\"status\"], flush=True)\\\\n        if job[\"status\"] == \"failed\":\\\\n            raise RuntimeError(json.dumps(job, ensure_ascii=False))\\\\n        if job[\"status\"] == \"succeeded\":\\\\n            break\\\\n        if time.monotonic() >= deadline:\\\\n            raise TimeoutError(f\"Polling timed out. Job {job_id} may still be running; query it later.\")\\\\n        time.sleep(min(30, max(0, deadline - time.monotonic())))\\\\n    args.output.parent.mkdir(parents=True, exist_ok=True)\\\\n    partial = args.output.with_suffix(args.output.suffix + \".part\")\\\\n    created_partial = False\\\\n    try:\\\\n        with requests.get(base + f\"/v1/jobs/{job_id}/file\", headers=headers, timeout=120, stream=True) as response:\\\\n            response.raise_for_status()\\\\n            with partial.open(\"xb\") as output:\\\\n                created_partial = True\\\\n                for chunk in response.iter_content(1024 * 1024):\\\\n                    output.write(chunk)\\\\n        partial.replace(args.output)\\\\n    finally:\\\\n        if created_partial:\\\\n            partial.unlink(missing_ok=True)\\\\n    print(\"Saved:\", args.output.resolve())\\\\n\\\\n\\\\nif __name__ == \"__main__\":\\\\n    main()\\\\n\\', \\'README.md\\': \\'# MiniMax-H3 ref2va 参考运行时 · API 0.4.0\\\\n\\\\n这里保存已验收的专用实现：总管理、API 后台、大模型容器三个受管进程，独立的可选公网隧道与 Colab 控制台。模型容器是模型运行时进程，不把 GPU 硬件本身称为容器。\\\\n\\\\n- 当前模型：MiniMax-H3，仅 ref2va；至少图片或视频参考，可附加音频。\\\\n- A100 原生 BF16 主干与 LoRA，保留官方 FP32 例外，不启用权重量化。\\\\n- 任务分为 CPU 预处理、独占 GPU 推理、CPU 编码校验；按真实依赖及资源预算调度。\\\\n- 队列无固定条数上限，可指定 ID 取消；资源不足、未知提交和运行中取消各自有真实状态。\\\\n- API 可先于模型就绪接收排队。生成、产物完整校验、任务清理、服务进程退出和云平台释放分别确认。\\\\n- 每任务控制 attention_backend、acceleration_lora、steps；Turbo 要显式 steps=5，对应4次模型评估。预加载不等于当前任务启用。\\\\n\\\\n仓库内的[运行说明](../../docs/operations.md)、[架构](../../docs/architecture.md)、[验证边界](../../docs/validation.md)提供当前入口。此 README 进入自包含 notebook 时，仓库相对链接仅用于源码导航；云端实际操作使用面板与日志。\\\\n\\\\n```bash\\\\npython run.py --help\\\\npython smoke_test.py --help\\\\n```\\\\n\\\\n历史 A100 实测不是当前机器的一次新运行。源码来源与精度/配置/任务/释放证据见仓库 evidence。真实生成验收每次必须是全新内容；未知结果按原 ID 对账，不自动重新生成。\\\\n\\', \\'notebook_ui.py\\': \\'\"\"\"Read-only dashboard and separate diagnostics for the notebook control panel.\"\"\"\\\\nfrom __future__ import annotations\\\\n\\\\nimport html\\\\nimport json\\\\nfrom collections import deque\\\\nfrom datetime import datetime, timedelta, timezone\\\\nfrom pathlib import Path\\\\nimport re\\\\nimport subprocess\\\\nimport time\\\\n\\\\nSTYLE = \"\"\"\\\\n<style>\\\\n.h3-card{--bg:#f8fafc;--ink:#172033;--muted:#627086;--line:#dbe3ec;--accent:#187c72;box-sizing:border-box;background:var(--bg);color:var(--ink);border:1px solid var(--line);border-left:4px solid var(--accent);border-radius:12px;padding:17px 20px;margin:8px 0;font:14px/1.55 system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;max-width:980px}\\\\n.h3-card *{box-sizing:border-box}.h3-card[data-tone=\"error\"]{--accent:#ba4242}.h3-card[data-tone=\"idle\"]{--accent:#7b8797}.h3-card[data-tone=\"running\"]{--accent:#bd7c16}\\\\n.h3-head{display:flex;gap:12px;justify-content:space-between;align-items:center;flex-wrap:wrap}.h3-title{font-size:17px;font-weight:650;letter-spacing:-.2px}.h3-badge{font-size:11px;font-weight:650;letter-spacing:.3px;color:var(--accent);border:1px solid var(--line);padding:3px 9px;border-radius:99px;white-space:nowrap}.h3-note{color:var(--muted);margin:5px 0 0}\\\\n.h3-fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px 18px;margin-top:13px}.h3-label{display:block;color:var(--muted);font-size:11px;letter-spacing:.25px;margin-bottom:2px}.h3-value{font-size:14px;font-weight:550;overflow-wrap:anywhere}.h3-card details{margin-top:12px;border-top:1px solid var(--line);padding-top:10px}.h3-card summary{cursor:pointer;color:var(--muted);font-size:12px}.h3-card pre{white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.55 ui-monospace,SFMono-Regular,Consolas,monospace;margin:9px 0 0;max-height:280px;overflow:auto}.h3-card a{color:var(--accent);text-decoration:none}.h3-card a:hover{text-decoration:underline}\\\\n.h3-board{border-left-width:1px;padding:22px 24px}.h3-board h2{font-size:23px;line-height:1.3;margin:4px 0 8px}.h3-kicker{font-size:12px;color:var(--muted)}.h3-next{margin:12px 0 21px;padding:11px 14px;border-radius:8px;background:color-mix(in srgb,var(--accent) 8%,var(--bg));font-size:15px}.h3-modules{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:12px 0 19px}.h3-module{padding:12px 14px;border:1px solid var(--line);border-radius:8px}.h3-module strong{font-weight:650;display:block;font-size:16px;margin-top:4px}.h3-subtle{color:var(--muted);font-size:12px;margin-top:4px}.h3-summary{display:flex;flex-wrap:wrap;gap:8px 22px;margin:12px 0}.h3-activity{border-top:1px solid var(--line);margin-top:18px;padding-top:13px}.h3-activity .h3-title{font-size:14px}.h3-activity .h3-fields{margin-top:8px;gap:8px 18px}.h3-stamp{font-size:11px;color:var(--muted);margin-top:17px}.h3-logs{border-left-width:1px}.h3-logs pre{max-height:360px;margin:14px 0 0}.h3-logs pre:focus{outline:2px solid var(--accent);outline-offset:3px}\\\\n@media(max-width:620px){.h3-board{padding:17px 15px}.h3-modules{grid-template-columns:1fr;gap:8px}.h3-module{padding:9px 12px;display:grid;grid-template-columns:95px 1fr;align-items:center}.h3-module strong{margin:0}.h3-module .h3-subtle{grid-column:2}.h3-board h2{font-size:21px}.h3-fields{grid-template-columns:1fr}}\\\\n@media(prefers-color-scheme:dark){.h3-card{--bg:#17202d;--ink:#e4ebf4;--muted:#a5b3c6;--line:#344358;--accent:#67cdbb}.h3-card[data-tone=\"error\"]{--accent:#ff9696}.h3-card[data-tone=\"running\"]{--accent:#e4ba6d}.h3-card[data-tone=\"idle\"]{--accent:#b5bfcb}}\\\\n</style>\\\\n\"\"\"\\\\n\\\\n_dashboard = None\\\\n_diagnostics = deque(maxlen=20)\\\\n_known_secrets = ()\\\\n_process_observer = None\\\\n_DIAGNOSTIC_LIMIT = 12000\\\\n\\\\n\\\\ndef redact_text(text, secrets=()):\\\\n    \"\"\"Redact known credentials and common authorization/key assignments before display.\"\"\"\\\\n    text = str(text)\\\\n    for secret in sorted({str(s) for s in (*_known_secrets, *secrets) if s}, key=len, reverse=True):\\\\n        text = text.replace(secret, \\\\\\'[已隐藏]\\\\\\')\\\\n    text = re.sub(r\\\\\\'(?i)(\\\\\\\\bBearer\\\\\\\\s+)[^\\\\\\\\s\\\\\\\\\"\\\\\\\\\\\\\\'<>;,]+\\\\\\', r\\\\\\'\\\\\\\\1[已隐藏]\\\\\\', text)\\\\n    text = re.sub(r\\\\\\'\\\\\\'\\\\\\'(?ix)([\"\\\\\\']?(?:H3_API_KEY|API_KEY|api[-_]?key|access_token|authorization)[\"\\\\\\']?\\\\\\\\s*[:=]\\\\\\\\s*)([\"\\\\\\'])(.*?)(\\\\\\\\2)\\\\\\'\\\\\\'\\\\\\',\\\\n                  lambda match: match.group(1) + match.group(2) + \\\\\\'[已隐藏]\\\\\\' + match.group(2), text)\\\\n    text = re.sub(r\\\\\\'(?i)(\\\\\\\\b(?:H3_API_KEY|API_KEY|api[-_]?key|access_token)\\\\\\\\s*[:=]\\\\\\\\s*)[^\\\\\\\\s\\\\\\\\\"\\\\\\\\\\\\\\'<>;,]+\\\\\\', r\\\\\\'\\\\\\\\1[已隐藏]\\\\\\', text)\\\\n    return text\\\\n\\\\n\\\\ndef _remember(title, text):\\\\n    if text:\\\\n        _diagnostics.append(redact_text(str(title) + \\\\\\'\\\\\\\\n\\\\\\' + str(text))[-_DIAGNOSTIC_LIMIT:])\\\\n\\\\n\\\\ndef last_diagnostics():\\\\n    return \\\\\\'\\\\\\\\n\\\\\\\\n\\\\\\'.join(_diagnostics)[-_DIAGNOSTIC_LIMIT:]\\\\n\\\\n\\\\ndef diagnostics_html(title, text, *, secrets=()):\\\\n    \"\"\"A bounded, keyboard-scrollable log view; never embedded in dashboard cards.\"\"\"\\\\n    value = redact_text(text, secrets=secrets)\\\\n    truncated = len(value) > _DIAGNOSTIC_LIMIT\\\\n    value = value[-_DIAGNOSTIC_LIMIT:]\\\\n    note = \\\\\\'仅显示最后 12,000 个字符；完整记录保留在日志文件。\\\\\\' if truncated else \\\\\\'只读日志 · 敏感凭据已隐藏\\\\\\'\\\\n    return (STYLE + \\\\\\'<section class=\"h3-card h3-logs\" aria-label=\"日志\"><div class=\"h3-title\">\\\\\\'\\\\n            + html.escape(redact_text(title), quote=True) + \\\\\\'</div><p class=\"h3-note\">\\\\\\' + note\\\\n            + \\\\\\'</p><pre tabindex=\"0\" aria-label=\"日志内容\">\\\\\\' + html.escape(value or \\\\\\'暂无记录。\\\\\\', quote=True)\\\\n            + \\\\\\'</pre></section>\\\\\\')\\\\n\\\\n\\\\ndef _short(value, maximum=160):\\\\n    text = redact_text(value).replace(\\\\\\'\\\\\\\\n\\\\\\', \\\\\\' \\\\\\').replace(\\\\\\'\\\\\\\\r\\\\\\', \\\\\\' \\\\\\')\\\\n    return text if len(text) <= maximum else text[:maximum - 1] + \\\\\\'…\\\\\\'\\\\n\\\\n\\\\ndef _activity(title, kwargs):\\\\n    _remember(title, kwargs.get(\\\\\\'details\\\\\\'))\\\\n    fields = [(label, value) for label, value in kwargs.get(\\\\\\'fields\\\\\\', ())\\\\n              if not any(word in str(label) for word in (\\\\\\'日志\\\\\\', \\\\\\'路径\\\\\\', \\\\\\'密钥\\\\\\', \\\\\\'当前记录\\\\\\'))]\\\\n    return {\\\\\\'title\\\\\\': _short(title, 70), \\\\\\'badge\\\\\\': _short(kwargs.get(\\\\\\'badge\\\\\\', \\\\\\'\\\\\\'), 35),\\\\n            \\\\\\'note\\\\\\': _short(kwargs.get(\\\\\\'note\\\\\\', \\\\\\'\\\\\\')), \\\\\\'tone\\\\\\': kwargs.get(\\\\\\'tone\\\\\\', \\\\\\'idle\\\\\\'),\\\\n            \\\\\\'fields\\\\\\': [(str(k), _short(v, 95)) for k, v in fields[:4]]}\\\\n\\\\n\\\\ndef card_html(title, *, badge=\"\", note=\"\", fields=(), tone=\"idle\", details=None, details_label=\"查看详情\"):\\\\n    escape = lambda value: html.escape(_short(value), quote=True)\\\\n    if tone not in {\"idle\", \"running\", \"success\", \"error\"}:\\\\n        tone = \"idle\"\\\\n    values = \"\".join(\\\\n        \\\\\\'<div><span class=\"h3-label\">\\\\\\' + escape(label) + \\\\\\'</span><span class=\"h3-value\">\\\\\\'\\\\n        + escape(value) + \\\\\\'</span></div>\\\\\\' for label, value in fields\\\\n    )\\\\n    return (STYLE + \\\\\\'<section class=\"h3-card\" data-tone=\"\\\\\\' + tone + \\\\\\'\"><div class=\"h3-head\">\\\\\\'\\\\n            + \\\\\\'<div class=\"h3-title\">\\\\\\' + escape(title) + \\\\\\'</div><span class=\"h3-badge\">\\\\\\'\\\\n            + escape(badge) + \\\\\\'</span></div>\\\\\\' + (\\\\\\'<p class=\"h3-note\">\\\\\\' + escape(note) + \\\\\\'</p>\\\\\\' if note else \"\")\\\\n            + (\\\\\\'<div class=\"h3-fields\">\\\\\\' + values + \\\\\\'</div>\\\\\\' if fields else \"\") + \"</section>\")\\\\n\\\\n\\\\ndef render_dashboard(context, activity=None):\\\\n    \"\"\"Render supplied observations only. This pure function performs no host I/O.\"\"\"\\\\n    escape = lambda value: html.escape(_short(value), quote=True)\\\\n    state = context.get(\\\\\\'state\\\\\\') or {}\\\\n    stale = bool(state.get(\\\\\\'observation_stale\\\\\\'))\\\\n    failed_read = bool(context.get(\\\\\\'observation_error\\\\\\'))\\\\n    phase = state.get(\\\\\\'phase\\\\\\')\\\\n    if context.get(\\\\\\'placeholder\\\\\\'):\\\\n        headline, next_step, tone = \\\\\\'等待首次读取\\\\\\', \\\\\\'运行「刷新看板」查看本次状态；此处是界面占位，没有实时观察。\\\\\\', \\\\\\'idle\\\\\\'\\\\n    elif failed_read:\\\\n        headline, next_step, tone = \\\\\\'状态读取失败\\\\\\', \\\\\\'重新刷新看板；如仍失败，在日志区查看原因。\\\\\\', \\\\\\'error\\\\\\'\\\\n    elif stale:\\\\n        headline, next_step, tone = \\\\\\'状态需要刷新\\\\\\', \\\\\\'当前观察已过期；刷新后再判断可用能力。\\\\\\', \\\\\\'running\\\\\\'\\\\n    elif phase == \\\\\\'stopped\\\\\\' and state.get(\\\\\\'cleanup_complete\\\\\\'):\\\\n        headline, next_step, tone = \\\\\\'本次服务已停止\\\\\\', \\\\\\'确认结果已保存后，可在控制面板释放 Colab 实例。\\\\\\', \\\\\\'idle\\\\\\'\\\\n    elif phase == \\\\\\'stopping\\\\\\':\\\\n        headline, next_step, tone = \\\\\\'正在停止与回收\\\\\\', \\\\\\'等待受管进程退出并确认清理完成；此时不要重复启动。\\\\\\', \\\\\\'running\\\\\\'\\\\n    elif state.get(\\\\\\'error\\\\\\') or phase in {\\\\\\'failed\\\\\\', \\\\\\'degraded\\\\\\'}:\\\\n        headline, next_step, tone = \\\\\\'有模块需要处理\\\\\\', \\\\\\'先看下方可用能力；具体原因在日志区，控制面板仍可查询或停止。\\\\\\', \\\\\\'error\\\\\\'\\\\n    elif state.get(\\\\\\'draining\\\\\\'):\\\\n        headline, next_step, tone = \\\\\\'已暂停接收新任务\\\\\\', \\\\\\'已接收的队列继续执行；可恢复接收，也可停止服务。\\\\\\', \\\\\\'idle\\\\\\'\\\\n    elif state.get(\\\\\\'ready\\\\\\'):\\\\n        headline, next_step, tone = \\\\\\'可以生成\\\\\\', \\\\\\'在控制面板提交新内容，或按任务 ID 查询已有任务。\\\\\\', \\\\\\'success\\\\\\'\\\\n    elif state.get(\\\\\\'api_ready\\\\\\'):\\\\n        accepting = (state.get(\\\\\\'queue\\\\\\') or {}).get(\\\\\\'admission_open\\\\\\') is True\\\\n        headline, next_step, tone = (\\\\\\'API 可用 · 生成尚未就绪\\\\\\',\\\\n            (\\\\\\'可先查询或排队；\\\\\\' if accepting else \\\\\\'可先查询；\\\\\\') + \\\\\\'模型、公网的当前能力分别见下方。\\\\\\', \\\\\\'running\\\\\\')\\\\n    elif state:\\\\n        headline, next_step, tone = \\\\\\'服务正在准备\\\\\\', \\\\\\'刷新看板观察进展；不要重复启动。\\\\\\', \\\\\\'running\\\\\\'\\\\n    elif not context.get(\\\\\\'preflight_ok\\\\\\'):\\\\n        headline, next_step, tone = \\\\\\'尚未检查资源\\\\\\', \\\\\\'在控制面板先运行「资源与驻留方案」。\\\\\\', \\\\\\'idle\\\\\\'\\\\n    elif not context.get(\\\\\\'install_ok\\\\\\'):\\\\n        headline, next_step, tone = \\\\\\'资源检查通过\\\\\\', \\\\\\'在控制面板运行「安装与检查」。\\\\\\', \\\\\\'idle\\\\\\'\\\\n    else:\\\\n        headline, next_step, tone = \\\\\\'准备工作已完成\\\\\\', \\\\\\'在控制面板选择是否开放公网，再启动服务。\\\\\\', \\\\\\'idle\\\\\\'\\\\n\\\\n    def module(name, alive_key, ready_key=None):\\\\n        alive, ready = state.get(alive_key), state.get(ready_key) if ready_key else None\\\\n        if not state:\\\\n            status, detail = (\\\\\\'尚未读取\\\\\\' if context.get(\\\\\\'placeholder\\\\\\') else \\\\\\'未启动\\\\\\'), \\\\\\'尚无运行观察\\\\\\'\\\\n        elif ready is True:\\\\n            status, detail = \\\\\\'可用\\\\\\', \\\\\\'进程运行中\\\\\\' if alive is True else \\\\\\'存活状态未确认\\\\\\'\\\\n        elif alive is True:\\\\n            status, detail = (\\\\\\'运行中\\\\\\', \\\\\\'调度与控制\\\\\\') if ready_key is None else (\\\\\\'准备中\\\\\\', \\\\\\'进程运行，能力未就绪\\\\\\')\\\\n        elif alive is False:\\\\n            status, detail = \\\\\\'已停止\\\\\\', \\\\\\'进程未运行\\\\\\'\\\\n        else:\\\\n            status, detail = \\\\\\'未确认\\\\\\', \\\\\\'缺少当前观察\\\\\\'\\\\n        if stale or failed_read:\\\\n            status, detail = \\\\\\'待刷新\\\\\\', \\\\\\'不据旧状态判断就绪\\\\\\'\\\\n        return (\\\\\\'<div class=\"h3-module\"><span class=\"h3-label\">\\\\\\' + escape(name) + \\\\\\'</span><strong>\\\\\\'\\\\n                + escape(status) + \\\\\\'</strong><div class=\"h3-subtle\">\\\\\\' + escape(detail) + \\\\\\'</div></div>\\\\\\')\\\\n\\\\n    if stale or failed_read:\\\\n        public = \\\\\\'待刷新\\\\\\'\\\\n    elif not state:\\\\n        public = \\\\\\'尚未观察\\\\\\'\\\\n    elif not state.get(\\\\\\'public_requested\\\\\\'):\\\\n        public = \\\\\\'未启用\\\\\\'\\\\n    elif state.get(\\\\\\'public_api_ready\\\\\\'):\\\\n        public = \\\\\\'API 探测通过\\\\\\'\\\\n    elif state.get(\\\\\\'tunnel_connected\\\\\\'):\\\\n        public = \\\\\\'隧道已连接 · API 待验证\\\\\\'\\\\n    else:\\\\n        public = \\\\\\'准备中\\\\\\'\\\\n    queue = state.get(\\\\\\'queue\\\\\\') or {}\\\\n    summary = [(\\\\\\'公网\\\\\\', public)]\\\\n    if queue and not stale and not failed_read:\\\\n        summary += [(\\\\\\'任务\\\\\\', f\"排队 {queue.get(\\\\\\'queued\\\\\\', \\\\\\'—\\\\\\')} · 执行 {queue.get(\\\\\\'running\\\\\\', \\\\\\'—\\\\\\')}\")]\\\\n        if queue.get(\\\\\\'admission_open\\\\\\') is False:\\\\n            summary.append((\\\\\\'接收任务\\\\\\', \\\\\\'已暂停\\\\\\'))\\\\n    resources = context.get(\\\\\\'resource_report\\\\\\') or {}\\\\n    if resources:\\\\n        summary += [(\\\\\\'GPU\\\\\\', resources.get(\\\\\\'gpu\\\\\\', \\\\\\'未记录\\\\\\')),\\\\n                    (\\\\\\'可用内存\\\\\\', str(resources.get(\\\\\\'available_ram_gib\\\\\\', \\\\\\'—\\\\\\')) + \\\\\\' GiB（预检）\\\\\\')]\\\\n    resource_text = \\\\\\'\\\\\\'.join(\\\\\\'<span><span class=\"h3-label\">\\\\\\' + escape(k) + \\\\\\'</span>\\\\\\' + escape(v) + \\\\\\'</span>\\\\\\' for k, v in summary)\\\\n    stamp = state.get(\\\\\\'observed_at\\\\\\')\\\\n    if isinstance(stamp, (int, float)):\\\\n        try:\\\\n            stamp = datetime.fromtimestamp(stamp, timezone(timedelta(hours=8))).strftime(\\\\\\'%m-%d %H:%M:%S 北京时间\\\\\\')\\\\n        except (OverflowError, OSError, ValueError):\\\\n            stamp = \\\\\\'未记录\\\\\\'\\\\n    else:\\\\n        stamp = \\\\\\'尚无服务快照\\\\\\'\\\\n    body = (STYLE + \\\\\\'<section class=\"h3-card h3-board\" data-tone=\"\\\\\\' + tone + \\\\\\'\" aria-label=\"运行看板\">\\\\\\'\\\\n            \\\\\\'<div class=\"h3-kicker\">当前状态</div><h2>\\\\\\' + escape(headline) + \\\\\\'</h2>\\\\\\'\\\\n            \\\\\\'<div class=\"h3-next\"><b>下一步</b>\\\\u3000\\\\\\' + escape(next_step) + \\\\\\'</div><div class=\"h3-modules\">\\\\\\'\\\\n            + module(\\\\\\'总管理\\\\\\', \\\\\\'manager_alive\\\\\\') + module(\\\\\\'API 后台\\\\\\', \\\\\\'server_alive\\\\\\', \\\\\\'api_ready\\\\\\')\\\\n            + module(\\\\\\'大模型容器\\\\\\', \\\\\\'model_alive\\\\\\', \\\\\\'model_ready\\\\\\') + \\\\\\'</div>\\\\\\'\\\\n            \\\\\\'<div class=\"h3-summary\">\\\\\\' + resource_text + \\\\\\'</div>\\\\\\')\\\\n    if activity:\\\\n        activity_tone = activity.get(\\\\\\'tone\\\\\\', \\\\\\'idle\\\\\\')\\\\n        if activity_tone not in {\\\\\\'idle\\\\\\', \\\\\\'running\\\\\\', \\\\\\'success\\\\\\', \\\\\\'error\\\\\\'}:\\\\n            activity_tone = \\\\\\'idle\\\\\\'\\\\n        body += (\\\\\\'<div class=\"h3-activity\" data-tone=\"\\\\\\' + activity_tone + \\\\\\'\"><div class=\"h3-label\">最近操作</div>\\\\\\'\\\\n                 \\\\\\'<div class=\"h3-head\"><span class=\"h3-title\">\\\\\\' + escape(activity.get(\\\\\\'title\\\\\\', \\\\\\'\\\\\\'))\\\\n                 + \\\\\\'</span><span class=\"h3-badge\">\\\\\\' + escape(activity.get(\\\\\\'badge\\\\\\', \\\\\\'\\\\\\')) + \\\\\\'</span></div>\\\\\\')\\\\n        if activity.get(\\\\\\'note\\\\\\'):\\\\n            body += \\\\\\'<div class=\"h3-note\">\\\\\\' + escape(activity[\\\\\\'note\\\\\\']) + \\\\\\'</div>\\\\\\'\\\\n        fields = activity.get(\\\\\\'fields\\\\\\') or ()\\\\n        if fields:\\\\n            body += \\\\\\'<div class=\"h3-fields\">\\\\\\' + \\\\\\'\\\\\\'.join(\\\\\\'<div><span class=\"h3-label\">\\\\\\' + escape(k)\\\\n                + \\\\\\'</span><span class=\"h3-value\">\\\\\\' + escape(v) + \\\\\\'</span></div>\\\\\\' for k, v in fields[:4]) + \\\\\\'</div>\\\\\\'\\\\n        body += \\\\\\'</div>\\\\\\'\\\\n    return body + \\\\\\'<div class=\"h3-stamp\">服务观察：\\\\\\' + escape(stamp) + \\\\\\' · 按需刷新，不执行控制命令</div></section>\\\\\\'\\\\n\\\\n\\\\nclass Dashboard:\\\\n    def __init__(self, context_reader):\\\\n        self.context_reader = context_reader\\\\n        self.activity = None\\\\n        self._handle = None\\\\n\\\\n    def refresh(self):\\\\n        from IPython.display import HTML, display\\\\n        global _known_secrets\\\\n        context = dict(self.context_reader())\\\\n        host = context.pop(\\\\\\'host\\\\\\', None)\\\\n        if host is not None:\\\\n            key = getattr(host, \\\\\\'api_key\\\\\\', None)\\\\n            if key:\\\\n                _known_secrets = tuple(set((*_known_secrets[-3:], str(key))))\\\\n            try:\\\\n                context[\\\\\\'state\\\\\\'] = host.snapshot()\\\\n            except Exception as error:\\\\n                context[\\\\\\'state\\\\\\'] = {}\\\\n                context[\\\\\\'observation_error\\\\\\'] = True\\\\n                _remember(\\\\\\'看板状态读取失败\\\\\\', str(error))\\\\n        rendered = HTML(render_dashboard(context, self.activity))\\\\n        if self._handle is None:\\\\n            self._handle = display(rendered, display_id=\\\\\\'h3-dashboard\\\\\\')\\\\n        else:\\\\n            self._handle.update(rendered)\\\\n        return context\\\\n\\\\n\\\\ndef mount_dashboard(context_reader):\\\\n    global _dashboard\\\\n    _dashboard = Dashboard(context_reader)\\\\n    _dashboard.refresh()\\\\n    return _dashboard\\\\n\\\\n\\\\nclass StatusCard:\\\\n    def __init__(self, title, **kwargs):\\\\n        self._handle = None\\\\n        self.update(title, **kwargs)\\\\n\\\\n    def update(self, title, **kwargs):\\\\n        from IPython.display import HTML, display\\\\n        activity = _activity(title, kwargs)\\\\n        if _dashboard is not None:\\\\n            _dashboard.activity = activity\\\\n            _dashboard.refresh()\\\\n        elif self._handle is None:\\\\n            self._handle = display(HTML(card_html(**activity)), display_id=True)\\\\n        else:\\\\n            self._handle.update(HTML(card_html(**activity)))\\\\n\\\\n\\\\ndef elapsed_text(seconds):\\\\n    seconds = max(0, int(seconds))\\\\n    return f\"{seconds // 60}分{seconds % 60:02d}秒\" if seconds >= 60 else f\"{seconds}秒\"\\\\n\\\\n\\\\ndef log_tail(path, limit=6000):\\\\n    path = Path(path)\\\\n    if not path.is_file():\\\\n        return \"\"\\\\n    with path.open(\"rb\") as source:\\\\n        source.seek(max(0, path.stat().st_size - limit))\\\\n        text = source.read().decode(\"utf-8\", errors=\"replace\")\\\\n    return re.sub(r\"\\\\\\\\x1b\\\\\\\\[[0-?]*[ -/]*[@-~]\", \"\", text).replace(\"\\\\\\\\r\", \"\\\\\\\\n\")\\\\n\\\\n\\\\ndef latest_stage(path):\\\\n    lines = [line.strip() for line in log_tail(path).splitlines() if line.strip()]\\\\n    for line in reversed(lines):\\\\n        if \"BF16 staged:\" in line:\\\\n            return line.split(\"BF16 staged:\", 1)[1].strip()[:145]\\\\n        if \"status=\" in line or \"API_SMOKE_TEST_PASSED\" in line:\\\\n            return line[:145]\\\\n    return lines[-1][:145] if lines else \"进程已启动，等待首条日志\"\\\\n\\\\n\\\\ndef run_logged(command, log_path, *, title, cwd=None, env=None, card=None, status_reader=None):\\\\n    \"\"\"Run a real child process; persist logs and update a bounded status card.\"\"\"\\\\n    path = Path(log_path)\\\\n    path.parent.mkdir(parents=True, exist_ok=True)\\\\n    status = card or StatusCard(title, badge=\"执行中\", tone=\"running\", note=\"完整输出写入日志。\")\\\\n    started = time.monotonic()\\\\n    with path.open(\"a\", encoding=\"utf-8\") as output:\\\\n        output.write(\"\\\\\\\\n--- \" + title + \" ---\\\\\\\\n\")\\\\n        output.flush()\\\\n        process = subprocess.Popen(command, cwd=cwd, env=env, stdout=output, stderr=subprocess.STDOUT)\\\\n        observer = _process_observer\\\\n        if observer is not None:\\\\n            observer.process_started(process)\\\\n        try:\\\\n            while process.poll() is None:\\\\n                if observer is not None:\\\\n                    observer.process_progress(process)\\\\n                current = []\\\\n                if status_reader is not None:\\\\n                    try:\\\\n                        current = status_reader()\\\\n                    except (OSError, ValueError):\\\\n                        pass\\\\n                status.update(title, badge=\"执行中\", tone=\"running\", fields=\\\\n                    [(\"已用时间\", elapsed_text(time.monotonic() - started))]\\\\n                    + current)\\\\n                time.sleep(2)\\\\n        except BaseException:\\\\n            process.terminate()\\\\n            try:\\\\n                process.wait(timeout=15)\\\\n            except subprocess.TimeoutExpired:\\\\n                process.kill()\\\\n                process.wait()\\\\n            status.update(title, badge=\"已中断\", tone=\"error\", note=\"操作进程已停止；已提交的远程任务可能仍在执行。\", fields=[(\"日志\", str(path))])\\\\n            raise\\\\n        finally:\\\\n            if observer is not None:\\\\n                observer.process_finished(process)\\\\n    if process.returncode:\\\\n        status.update(title, badge=\"未完成\", tone=\"error\", note=\"查看日志中的实际错误后再重试。\",\\\\n                      fields=[(\"日志\", str(path))], details=log_tail(path), details_label=\"展开最后的错误日志\")\\\\n        raise RuntimeError(f\"{title}退出码 {process.returncode}；完整日志：{path}\")\\\\n    status.update(title, badge=\"完成\", tone=\"success\", fields=[\\\\n        (\"已用时间\", elapsed_text(time.monotonic() - started)), (\"完整日志\", str(path)),\\\\n    ])\\\\n    return process.returncode\\\\n\\\\n\\\\ndef json_probe(command, log_path, *, cwd=None, env=None, card=None):\\\\n    \"\"\"Capture a short JSON-producing check without dumping full notebook output.\"\"\"\\\\n    process = subprocess.Popen(command, cwd=cwd, env=env, text=True,\\\\n                               stdout=subprocess.PIPE, stderr=subprocess.PIPE)\\\\n    observer = _process_observer\\\\n    try:\\\\n        if observer is not None:\\\\n            observer.process_started(process)\\\\n        stdout, stderr = process.communicate(timeout=180)\\\\n    except BaseException:\\\\n        if process.poll() is None:\\\\n            process.kill()\\\\n            process.communicate(timeout=10)\\\\n        raise\\\\n    finally:\\\\n        if observer is not None:\\\\n            observer.process_finished(process)\\\\n    with Path(log_path).open(\"a\", encoding=\"utf-8\") as log:\\\\n        log.write(stdout + \"\\\\\\\\n\" + stderr + \"\\\\\\\\n\")\\\\n    if process.returncode:\\\\n        if card is not None:\\\\n            card.update(\"依赖检查未通过\", badge=\"需要处理\", tone=\"error\", note=\"检查日志中的版本或导入错误后再继续。\",\\\\n                        fields=[(\"日志\", str(log_path))], details=stderr[-4000:], details_label=\"展开检查错误\")\\\\n        raise RuntimeError(f\"依赖检查失败；请在日志区查看：{log_path}\")\\\\n    return json.loads(stdout.strip().splitlines()[-1])\\\\n\\', \\'pipeline_backend.py\\': \\'\"\"\"CPU prepare -> exclusive GPU inference -> CPU encoding, with per-job ownership.\\\\n\\\\nReference/codec behavior follows Diffusers v0.43 references.py/export_utils.py.\\\\nIts encode_video has no thread-budget argument; this local PyAV writer sets\\\\ncodec thread_count explicitly and avoids stacking every output frame again.\\\\nResource numbers are conservative admission estimates, not calibrated optima.\\\\n\"\"\"\\\\nfrom __future__ import annotations\\\\n\\\\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\\\\nfrom contextlib import contextmanager, nullcontext\\\\nfrom dataclasses import dataclass\\\\nfrom fractions import Fraction\\\\nimport json\\\\nimport gc\\\\nimport math\\\\nimport os\\\\nfrom pathlib import Path\\\\n\\\\nfrom runtime_options import RuntimeSupport, measured_generation\\\\nfrom generation_options import requested_options, validate_generation_options, effective_options\\\\nfrom adapter_config import select_reference_setup, select_loaded_adapters\\\\n\\\\nMIB, GIB = 1024**2, 1024**3\\\\n\\\\n\\\\n@dataclass\\\\nclass Prepared:\\\\n    parameters: dict\\\\n    references: list\\\\n    normalized: list\\\\n    metrics: object\\\\n    cpu_threads: int = 1\\\\n    cleaned: bool = False\\\\n\\\\n\\\\n@dataclass\\\\nclass CPUResult:\\\\n    video: list\\\\n    audio: object\\\\n    sampling_rate: int\\\\n    metrics: object\\\\n    cpu_threads: int\\\\n    cpu_handoff_complete: bool = False\\\\n    cleaned: bool = False\\\\n\\\\n\\\\ndef _audio_from_container(av, container, stream):\\\\n    import numpy as np\\\\n    import torch\\\\n    stream.codec_context.thread_count = 1\\\\n    rate = int(stream.codec_context.sample_rate)\\\\n    if not 0 < rate <= 96000 or len(stream.layout.channels) > 2:\\\\n        raise ValueError(\"Reference soundtrack exceeds 96 kHz / stereo\")\\\\n    resampler = av.AudioResampler(format=\"fltp\", layout=stream.layout, rate=rate)\\\\n    chunks, samples = [], 0\\\\n    def append(frames):\\\\n        nonlocal samples\\\\n        for item in frames:\\\\n            value = item.to_ndarray()\\\\n            samples += value.shape[-1]\\\\n            if samples > math.ceil(15.1 * rate):\\\\n                raise ValueError(\"Decoded reference soundtrack exceeds 15 seconds\")\\\\n            chunks.append(value)\\\\n    for frame in container.decode(stream):\\\\n        append(resampler.resample(frame))\\\\n    append(resampler.resample(None))\\\\n    if not chunks:\\\\n        raise ValueError(\"Reference soundtrack is empty\")\\\\n    return torch.from_numpy(np.concatenate(chunks, axis=-1).astype(np.float32, copy=False)), rate\\\\n\\\\n\\\\ndef decode_reference(kind, path, classes):\\\\n    \"\"\"CPU-only decoding with one native codec thread and decoded-size guards.\"\"\"\\\\n    if kind == \"image\":\\\\n        return classes[kind].from_file(str(path))\\\\n    import av\\\\n    import numpy as np\\\\n    with av.open(str(path)) as container:\\\\n        if kind == \"audio\":\\\\n            audio, rate = _audio_from_container(av, container, container.streams.audio[0])\\\\n            return classes[kind](audio=audio, sample_rate=rate)\\\\n        stream = container.streams.video[0]\\\\n        stream.codec_context.thread_count = 1\\\\n        frames = []\\\\n        for frame in container.decode(stream):\\\\n            if len(frames) >= 362 or frame.width * frame.height > 960 * 544:\\\\n                raise ValueError(\"Normalized reference exceeds bounded decoded geometry\")\\\\n            frames.append(frame.to_ndarray(format=\"rgb24\"))\\\\n        if not frames:\\\\n            raise ValueError(\"Reference video is empty\")\\\\n        fps = float(stream.average_rate or stream.guessed_rate)\\\\n        audio, rate = None, None\\\\n        if container.streams.audio:\\\\n            container.seek(0)\\\\n            audio, rate = _audio_from_container(av, container, container.streams.audio[0])\\\\n        return classes[kind](frames=np.stack(frames), fps=fps, audio=audio, sample_rate=rate)\\\\n\\\\n\\\\ndef cpu_media(video, audio, sampling_rate, torch):\\\\n    \"\"\"Copy outputs into CPU-owned numpy buffers; never retain PipelineState.\"\"\"\\\\n    import numpy as np\\\\n    def array(value):\\\\n        if isinstance(value, torch.Tensor):\\\\n            value = value.detach().to(device=\"cpu\", copy=True)\\\\n            if value.is_floating_point():\\\\n                value = value.float()\\\\n            value = value.numpy()\\\\n        return np.array(value, copy=True)\\\\n    frames = []\\\\n    for frame in video:\\\\n        pixels = array(frame)\\\\n        if pixels.ndim != 3 or pixels.shape[-1] != 3:\\\\n            raise ValueError(\"Expected HWC RGB video output\")\\\\n        if pixels.dtype != np.uint8:\\\\n            if not np.isfinite(pixels).all() or pixels.min() < 0 or pixels.max() > 1:\\\\n                raise ValueError(\"Float video output must be finite and normalized\")\\\\n            pixels = (pixels * 255).round().astype(np.uint8)\\\\n        frames.append(pixels)\\\\n    waveform = array(audio).astype(np.float32, copy=False)\\\\n    if waveform.ndim != 2 or waveform.shape[0] != 2 or not np.isfinite(waveform).all():\\\\n        raise ValueError(\"Expected finite stereo audio output\")\\\\n    if not frames or not 0 < int(sampling_rate) <= 96000:\\\\n        raise ValueError(\"Invalid output media\")\\\\n    return frames, waveform, int(sampling_rate)\\\\n\\\\n\\\\ndef encode_cpu_media(result, output_path):\\\\n    \"\"\"Same H.264/AAC formats as official exporter, explicitly bounded threads.\"\"\"\\\\n    import av\\\\n    import numpy as np\\\\n    if not result.cpu_handoff_complete or result.cleaned:\\\\n        raise RuntimeError(\"Encoding requires a completed CPU ownership handoff\")\\\\n    with av.open(str(output_path), mode=\"w\") as container:\\\\n        stream = container.add_stream(\"libx264\", rate=24)\\\\n        stream.width, stream.height = result.video[0].shape[1], result.video[0].shape[0]\\\\n        stream.pix_fmt = \"yuv420p\"\\\\n        stream.codec_context.thread_count = result.cpu_threads\\\\n        audio_stream = container.add_stream(\"aac\", rate=result.sampling_rate)\\\\n        cc = audio_stream.codec_context\\\\n        cc.sample_rate, cc.layout = result.sampling_rate, \"stereo\"\\\\n        cc.time_base, cc.thread_count = Fraction(1, result.sampling_rate), 1\\\\n        for pixels in result.video:\\\\n            frame = av.VideoFrame.from_ndarray(pixels, format=\"rgb24\")\\\\n            for packet in stream.encode(frame):\\\\n                container.mux(packet)\\\\n        for packet in stream.encode():\\\\n            container.mux(packet)\\\\n        samples = (np.clip(result.audio.T, -1, 1) * 32767).astype(np.int16)\\\\n        audio_frame = av.AudioFrame.from_ndarray(np.ascontiguousarray(samples).reshape(1, -1), format=\"s16\", layout=\"stereo\")\\\\n        audio_frame.sample_rate = result.sampling_rate\\\\n        resampler = av.AudioResampler(format=cc.format or \"fltp\", layout=cc.layout or \"stereo\", rate=cc.sample_rate)\\\\n        next_pts = 0\\\\n        for frame in resampler.resample(audio_frame) + resampler.resample(None):\\\\n            if frame.pts is None:\\\\n                frame.pts = next_pts\\\\n            next_pts += frame.samples\\\\n            frame.sample_rate = result.sampling_rate\\\\n            for packet in audio_stream.encode(frame):\\\\n                container.mux(packet)\\\\n        for packet in audio_stream.encode():\\\\n            container.mux(packet)\\\\n    if not Path(output_path).is_file() or not Path(output_path).stat().st_size:\\\\n        raise RuntimeError(\"Encoder produced no video\")\\\\n\\\\n\\\\nclass PipelineBackendSupport(RuntimeSupport):\\\\n    pipeline_model_peak_ram_bytes = 144 * GIB\\\\n    resource_residency = \"resident\"\\\\n\\\\n    def validate_generation_request(self, *, steps, attention_backend=None, acceleration_lora=None):\\\\n        values = {\"steps\": steps}\\\\n        if attention_backend is not None:\\\\n            values[\"attention_backend\"] = attention_backend\\\\n        if acceleration_lora is not None:\\\\n            values[\"acceleration_lora\"] = acceleration_lora\\\\n        return validate_generation_options(requested_options(values), self.adapter_settings)\\\\n\\\\n    def _apply_generation_transformer(self, effective, *, audit=True):\\\\n        transformer = getattr(self.pipe, \"transformer_ref\", None)\\\\n        if transformer is None:\\\\n            raise RuntimeError(\"The generation transformer is unavailable\")\\\\n        # Always set native explicitly, so forced Flash never leaks into auto.\\\\n        transformer.set_attention_backend(effective[\"attention_backend\"])\\\\n        select_loaded_adapters(self.pipe, self.adapter_settings, effective[\"acceleration_lora\"])\\\\n        if audit and self._active_metrics is not None:\\\\n            self._active_metrics.data[\"generation_options\"][\"effective\"] = dict(effective)\\\\n\\\\n    @contextmanager\\\\n    def generation_context(self, prepared):\\\\n        \"\"\"Mutate and restore shared model state only inside infer\\\\\\'s GPU lease.\\\\n\\\\n        CPU preparation can overlap other jobs; it must not change adapters,\\\\n        attention processors, reference setup, or scheduler state. Staged\\\\n        residency applies the same choices after its transformer is loaded.\\\\n        \"\"\"\\\\n        if getattr(self, \"_active_generation_options\", None) is not None:\\\\n            raise RuntimeError(\"Generation configuration already owns the GPU lease\")\\\\n        requested = requested_options(prepared.parameters)\\\\n        validate_generation_options(requested, self.adapter_settings)\\\\n        effective = effective_options(requested, self.adapter_settings, self.runtime_options)\\\\n        prepared.metrics.data.setdefault(\"generation_options\", {\"requested\": dict(requested), \"effective\": None})\\\\n        original = self.pipe.blocks.sub_blocks[\"before_encode\"]\\\\n        self._active_generation_options = effective\\\\n        try:\\\\n            select_reference_setup(self.pipe, requested[\"acceleration_lora\"])\\\\n            if getattr(self.pipe, \"transformer_ref\", None) is not None:\\\\n                self._apply_generation_transformer(effective)\\\\n            yield\\\\n        finally:\\\\n            try:\\\\n                self.pipe.blocks.sub_blocks[\"before_encode\"] = original\\\\n                if getattr(self.pipe, \"transformer_ref\", None) is not None:\\\\n                    defaults = effective_options({\"attention_backend\": \"auto\",\\\\n                        \"acceleration_lora\": self.adapter_settings.acceleration, \"steps\": requested[\"steps\"]},\\\\n                        self.adapter_settings, self.runtime_options)\\\\n                    self._apply_generation_transformer(defaults, audit=False)\\\\n            finally:\\\\n                self._active_generation_options = None\\\\n\\\\n    def configure_cpu_budget(self, gpu_threads):\\\\n        \"\"\"Configure native CPU pools exactly once, before any model is loaded.\\\\n\\\\n        GPU work also occupies host CPU capacity. CPU preparation/encoding use\\\\n        bounded codecs and numpy copies, not multithreaded torch/BLAS operators.\\\\n        Environment defaults cover libraries imported later; the caller can\\\\n        audit again after load without changing any process-wide setting.\\\\n        \"\"\"\\\\n        if isinstance(gpu_threads, bool) or not isinstance(gpu_threads, int) or gpu_threads < 1:\\\\n            raise ValueError(\"GPU host CPU reservation must be a positive integer\")\\\\n        previous = getattr(self, \"_native_cpu_requested\", None)\\\\n        if previous is not None:\\\\n            if previous != gpu_threads:\\\\n                raise RuntimeError(\"Native CPU pools cannot be reconfigured during this model lifetime\")\\\\n            return self.cpu_budget_snapshot()\\\\n        if self._loaded or self.pipe is not None:\\\\n            raise RuntimeError(\"Native CPU pools must be configured before model loading\")\\\\n        # Keep the hardware gate before torch imports/downloads, including the\\\\n        # real Windows CPU integration\\\\\\'s explicit Linux/NVIDIA rejection.\\\\n        from preflight import check_resources\\\\n        check_resources(residency=self.resource_residency)\\\\n        environment = {name: str(gpu_threads) for name in (\\\\n            \"OMP_NUM_THREADS\", \"MKL_NUM_THREADS\", \"OPENBLAS_NUM_THREADS\",\\\\n            \"BLIS_NUM_THREADS\", \"VECLIB_MAXIMUM_THREADS\", \"NUMEXPR_NUM_THREADS\")}\\\\n        environment.update(OMP_MAX_ACTIVE_LEVELS=\"1\", OMP_DYNAMIC=\"FALSE\", MKL_DYNAMIC=\"FALSE\",\\\\n                           TOKENIZERS_PARALLELISM=\"false\", RAYON_NUM_THREADS=str(gpu_threads))\\\\n        os.environ.update(environment)\\\\n        import numpy  # Load the CPU pools we use before applying/readback.\\\\n        import torch\\\\n        from threadpoolctl import threadpool_limits\\\\n        torch.set_num_threads(gpu_threads)\\\\n        interop_note = \"set_before_load\"\\\\n        try:\\\\n            torch.set_num_interop_threads(1)\\\\n        except RuntimeError:\\\\n            if torch.get_num_interop_threads() != 1:\\\\n                raise RuntimeError(\"Cannot enforce one torch interop thread before model loading\") from None\\\\n            interop_note = \"already_initialized_at_one\"\\\\n        self._native_cpu_limiter = threadpool_limits(limits=gpu_threads)\\\\n        self._native_cpu_requested = gpu_threads\\\\n        self._native_cpu_environment = environment\\\\n        self._native_cpu_interop_note = interop_note\\\\n        try:\\\\n            return self.cpu_budget_snapshot()\\\\n        except BaseException:\\\\n            self._native_cpu_requested = None\\\\n            raise\\\\n\\\\n    def cpu_budget_snapshot(self):\\\\n        \"\"\"Read and validate real pool limits; never change them in running jobs.\"\"\"\\\\n        requested = getattr(self, \"_native_cpu_requested\", None)\\\\n        if requested is None:\\\\n            raise RuntimeError(\"Native CPU budget has not been configured\")\\\\n        import torch\\\\n        from threadpoolctl import threadpool_info\\\\n        pools = [{key: pool.get(key) for key in (\"user_api\", \"internal_api\", \"prefix\", \"version\", \"num_threads\")}\\\\n                 for pool in threadpool_info()]\\\\n        actual = torch.get_num_threads()\\\\n        interop = torch.get_num_interop_threads()\\\\n        if actual != requested or interop != 1:\\\\n            raise RuntimeError(f\"Torch CPU budget differs from reservation: intra={actual}, interop={interop}, reserved={requested}\")\\\\n        for pool in pools:\\\\n            threads = pool[\"num_threads\"]\\\\n            if isinstance(threads, bool) or not isinstance(threads, int) or not 1 <= threads <= requested:\\\\n                raise RuntimeError(f\"Native pool CPU limit is not confirmed: {pool[\\\\\\'internal_api\\\\\\']}={threads}, reserved={requested}\")\\\\n        return {\"configured\": True, \"configured_before_load\": True, \"gpu_host_cpu_threads\": requested,\\\\n                \"torch_num_threads\": actual, \"torch_num_interop_threads\": interop,\\\\n                \"interop_configuration\": self._native_cpu_interop_note,\\\\n                \"native_pools\": pools, \"environment_defaults\": dict(self._native_cpu_environment),\\\\n                \"scope\": \"observed native CPU pools; codec lanes have separate explicit thread budgets\"}\\\\n\\\\n    @property\\\\n    def pipeline_model_headroom_bytes(self):\\\\n        import psutil\\\\n        return max(0, self.pipeline_model_peak_ram_bytes - psutil.Process().memory_info().rss)\\\\n\\\\n    def estimate_resources(self, parameters):\\\\n        \"\"\"Bounds retained media + decode/transfer/encode copies; excludes model.\"\"\"\\\\n        from PIL import Image\\\\n        references = parameters[\"references\"]\\\\n        durations, retained, source_bytes, normalized_bytes, pipeline_media = [], 0, 0, 0, 0\\\\n        frames = self._aligned_frames(parameters[\"seconds\"])\\\\n        for item in references:\\\\n            path, kind = Path(item[\"path\"]), item[\"kind\"]\\\\n            duration = self._reference_probe(path, kind)\\\\n            durations.append((kind, duration))\\\\n            source_bytes += path.stat().st_size\\\\n            if kind == \"image\":\\\\n                with Image.open(path) as image:\\\\n                    retained += image.width * image.height * 4\\\\n                    # Official conditioning upscales even tiny images to a 2048\\\\n                    # short edge. Reserve resized RGB plus float/temporary copies.\\\\n                    ratio = max(image.width, image.height) / min(image.width, image.height)\\\\n                    pipeline_media += 2048 * (math.ceil(2048 * ratio / 32) * 32) * 20\\\\n            elif kind == \"video\":\\\\n                size = (math.ceil(duration * 24) + 2) * 960 * 544 * 3 + math.ceil(duration * 32000) * 2 * 4\\\\n                retained += size\\\\n                normalized_bytes += size + MIB\\\\n                # The GPU workflow can resize reference video again to the\\\\n                # official 1344*768 canvas; it is not a CPU preparation stage.\\\\n                pipeline_media += min(frames, math.ceil(duration * 24) + 2) * 1344 * 768 * 3 * 8\\\\n            elif kind == \"audio\":\\\\n                retained += math.ceil(duration * 96000) * 2 * 4\\\\n            else:\\\\n                raise ValueError(\"Unknown reference modality\")\\\\n        for kind in (\"video\", \"audio\"):\\\\n            if sum(d for k, d in durations if k == kind) > 15:\\\\n                raise ValueError(\"Total reference duration per modality must be <=15 seconds\")\\\\n        output = frames * parameters[\"width\"] * parameters[\"height\"] * 3 + math.ceil(frames / 24 * 96000) * 2 * 4\\\\n        return {\"ram_bytes\": 3 * retained + 4 * output + pipeline_media + 256 * MIB,\\\\n                \"cpu_threads\": 1, \"disk_bytes\": source_bytes + normalized_bytes + output + 4 * MIB,\\\\n                \"reference_retained_bytes\": retained, \"output_retained_bytes\": output,\\\\n                \"pipeline_reference_workspace_bytes\": pipeline_media,\\\\n                \"estimate_kind\": \"conservative decoded-media admission estimate; not calibrated physical optimum\"}\\\\n\\\\n    def prepare(self, *, prompt, references, seconds, width, height, steps, seed, cpu_threads=1,\\\\n                attention_backend=None, acceleration_lora=None):\\\\n        options = {}\\\\n        if attention_backend is not None:\\\\n            options[\"attention_backend\"] = attention_backend\\\\n        if acceleration_lora is not None:\\\\n            options[\"acceleration_lora\"] = acceleration_lora\\\\n        self.validate_request(steps=steps, **options)\\\\n        if self.pipe is None:\\\\n            raise RuntimeError(\"The model has not loaded\")\\\\n        if isinstance(cpu_threads, bool) or not isinstance(cpu_threads, int) or cpu_threads < 1:\\\\n            raise ValueError(\"cpu_threads must be a positive reserved CPU budget\")\\\\n        from diffusers.modular_pipelines.minimax_h3 import MiniMaxH3ImageReference, MiniMaxH3VideoReference, MiniMaxH3AudioReference\\\\n        classes = {\"image\": MiniMaxH3ImageReference, \"video\": MiniMaxH3VideoReference, \"audio\": MiniMaxH3AudioReference}\\\\n        parameters = dict(prompt=prompt, seconds=seconds, width=width, height=height, steps=steps, seed=seed, **options)\\\\n        metrics = self._active_metrics or self._new_metrics(\"generation\")\\\\n        metrics.data[\"timing\"] = \"host_wall_seconds; inference synchronizes at CPU handoff\"\\\\n        metrics.data[\"pipeline_stage_contract\"] = \"cpu_prepare / exclusive_gpu_infer / cpu_encode_validate\"\\\\n        metrics.data[\"generation_options\"] = {\"requested\": requested_options(parameters), \"effective\": None}\\\\n        prepared = Prepared(parameters, [], [], metrics, cpu_threads)\\\\n        try:\\\\n            with self.metrics_context(metrics), self._stage(\"references.prepare\"):\\\\n                durations = [self._reference_probe(Path(item[\"path\"]), item[\"kind\"]) for item in references]\\\\n                for kind in (\"video\", \"audio\"):\\\\n                    if sum(d for item, d in zip(references, durations) if item[\"kind\"] == kind) > 15:\\\\n                        raise ValueError(\"Total reference duration per modality must be <=15 seconds\")\\\\n                normalized_targets = {}\\\\n                for index, item in enumerate(references):\\\\n                    if item[\"kind\"] == \"video\":\\\\n                        path = Path(item[\"path\"])\\\\n                        target = path.with_name(path.stem + f\"_ref{index}_24fps.mp4\")\\\\n                        prepared.normalized.append(target)\\\\n                        normalized_targets[index] = target\\\\n                def decode(index):\\\\n                    item = references[index]\\\\n                    with metrics.stage(f\"child.prepare.{index}\"):\\\\n                        path = Path(item[\"path\"])\\\\n                        if item[\"kind\"] == \"video\":\\\\n                            path = self._normalize_reference(path, target=normalized_targets[index])\\\\n                        return decode_reference(item[\"kind\"], path, classes)\\\\n                prepared.references = [None] * len(references)\\\\n                lanes = min(cpu_threads, len(references))\\\\n                metrics.record_schedule({\"phase\": \"prepare\", \"workers\": lanes, \"child_count\": len(references),\\\\n                                         \"reason\": \"explicit CPU budget; each native decoder/normalizer uses one thread\"})\\\\n                if lanes <= 1:\\\\n                    for index in range(len(references)):\\\\n                        prepared.references[index] = decode(index)\\\\n                else:\\\\n                    with ThreadPoolExecutor(max_workers=lanes, thread_name_prefix=\"h3-reference\") as pool:\\\\n                        futures = {pool.submit(decode, i): i for i in range(len(references))}\\\\n                        for future in as_completed(futures):\\\\n                            prepared.references[futures[future]] = future.result()\\\\n            return prepared\\\\n        except BaseException as error:\\\\n            metrics.finish(error)\\\\n            self.cleanup(prepared=prepared)\\\\n            raise\\\\n\\\\n    def infer(self, prepared):\\\\n        import torch\\\\n        if prepared.cleaned:\\\\n            raise RuntimeError(\"Prepared references have already been released\")\\\\n        raw = None\\\\n        try:\\\\n            with self.metrics_context(prepared.metrics), self._stage(\"pipeline\"), torch.inference_mode():\\\\n                configuration = self.generation_context(prepared) if hasattr(self, \"adapter_settings\") else nullcontext()\\\\n                with configuration:\\\\n                    try:\\\\n                        raw = self._infer_raw(prepared)\\\\n                        video, audio, rate = cpu_media(raw[\"videos\"][0], raw[\"audio\"][0], raw[\"sampling_rate\"], torch)\\\\n                        result = CPUResult(video, audio, rate, prepared.metrics, prepared.cpu_threads)\\\\n                    finally:\\\\n                        raw = None\\\\n                        prepared.references.clear()\\\\n                        # Synchronize before restoring adapters and attention.\\\\n                        # CPU encoding never changes model or CUDA state.\\\\n                        gc.collect()\\\\n                        torch.cuda.synchronize()\\\\n                        torch.cuda.empty_cache()\\\\n                result.cpu_handoff_complete = True\\\\n                return result\\\\n        except BaseException as error:\\\\n            prepared.metrics.finish(error)\\\\n            raise\\\\n        finally:\\\\n            raw = None\\\\n\\\\n    def encode(self, result, output_path):\\\\n        path = Path(output_path)\\\\n        error = None\\\\n        try:\\\\n            with self.metrics_context(result.metrics), self._stage(\"encode_mp4\"):\\\\n                encode_cpu_media(result, path)\\\\n        except BaseException as caught:\\\\n            error = caught\\\\n            raise\\\\n        finally:\\\\n            metrics = result.metrics.finish(error)\\\\n            self.last_metrics = metrics\\\\n            sidecar = path.with_suffix(\".metrics.json\")\\\\n            temporary = sidecar.with_suffix(sidecar.suffix + \".tmp\")\\\\n            try:\\\\n                temporary.write_text(json.dumps(metrics, ensure_ascii=False, indent=2) + \"\\\\\\\\n\", encoding=\"utf-8\")\\\\n                temporary.replace(sidecar)\\\\n            except OSError as write_error:\\\\n                metrics[\"metrics_write_error\"] = type(write_error).__name__\\\\n        return metrics\\\\n\\\\n    def cleanup(self, prepared=None, result=None):\\\\n        \"\"\"CPU ownership only: never collect globally or touch CUDA from this lane.\"\"\"\\\\n        if prepared is not None and not prepared.cleaned:\\\\n            prepared.references.clear()\\\\n            for path in prepared.normalized:\\\\n                Path(path).unlink(missing_ok=True)\\\\n            prepared.normalized.clear()\\\\n            prepared.cleaned = True\\\\n        if result is not None and not result.cleaned:\\\\n            result.video.clear()\\\\n            result.audio = None\\\\n            result.cleaned = True\\\\n\\\\n    @measured_generation\\\\n    def generate(self, prompt, references, output_path, seconds, width, height, steps, seed,\\\\n                 attention_backend=None, acceleration_lora=None):\\\\n        \"\"\"Standalone compatibility: the same stages, called sequentially.\"\"\"\\\\n        prepared = result = None\\\\n        try:\\\\n            prepared = self.prepare(prompt=prompt, references=references, seconds=seconds,\\\\n                                    width=width, height=height, steps=steps, seed=seed,\\\\n                                    attention_backend=attention_backend, acceleration_lora=acceleration_lora)\\\\n            result = self.infer(prepared)\\\\n            return self.encode(result, output_path)\\\\n        finally:\\\\n            self.cleanup(prepared=prepared, result=result)\\\\n\\', \\'pipeline_scheduler.py\\': \\'\"\"\"Per-job working-set admission and stage leases; no global job-count cap.\"\"\"\\\\nfrom __future__ import annotations\\\\n\\\\nfrom contextlib import contextmanager\\\\nfrom collections import OrderedDict, deque\\\\nimport copy\\\\nimport hashlib\\\\nimport json\\\\nimport math\\\\nimport os\\\\nfrom pathlib import Path\\\\nimport shutil\\\\nimport sys\\\\nimport threading\\\\nimport time\\\\nimport uuid\\\\n\\\\nimport psutil\\\\n\\\\nfrom condition_guard import evaluate_gate, negate_observation\\\\n\\\\nGiB = 1024 ** 3\\\\n\\\\n\\\\ndef cgroup_cpu_quotas(root=Path(\\\\\\'/sys/fs/cgroup\\\\\\'), membership=Path(\\\\\\'/proc/self/cgroup\\\\\\')):\\\\n    \"\"\"Read v1/v2 quota limits, including stricter visible parent cgroups.\"\"\"\\\\n    root = Path(root).resolve()\\\\n    candidates = {(root, \\\\\\'v2\\\\\\'), (root / \\\\\\'cpu\\\\\\', \\\\\\'v1\\\\\\'), (root / \\\\\\'cpu,cpuacct\\\\\\', \\\\\\'v1\\\\\\')}\\\\n    try:\\\\n        records = Path(membership).read_text().splitlines()\\\\n    except OSError:\\\\n        records = []\\\\n    for record in records:\\\\n        parts = record.split(\\\\\\':\\\\\\', 2)\\\\n        if len(parts) != 3:\\\\n            continue\\\\n        controllers, relative = parts[1], parts[2].lstrip(\\\\\\'/\\\\\\')\\\\n        bases = [(root, \\\\\\'v2\\\\\\')] if not controllers else (\\\\n            [(root / \\\\\\'cpu\\\\\\', \\\\\\'v1\\\\\\'), (root / \\\\\\'cpu,cpuacct\\\\\\', \\\\\\'v1\\\\\\')] if \\\\\\'cpu\\\\\\' in controllers.split(\\\\\\',\\\\\\') else [])\\\\n        for base, version in bases:\\\\n            leaf = (base / relative).resolve()\\\\n            if not leaf.is_relative_to(base):\\\\n                continue\\\\n            for directory in (leaf, *leaf.parents):\\\\n                if not directory.is_relative_to(base):\\\\n                    break\\\\n                candidates.add((directory, version))\\\\n    limits = []\\\\n    for directory, version in sorted(candidates):\\\\n        try:\\\\n            if version == \\\\\\'v2\\\\\\':\\\\n                filename = directory / \\\\\\'cpu.max\\\\\\'\\\\n                quota, period = filename.read_text().split()\\\\n                if quota == \\\\\\'max\\\\\\':\\\\n                    continue\\\\n            else:\\\\n                filename = directory / \\\\\\'cpu.cfs_quota_us\\\\\\'\\\\n                quota = filename.read_text().strip()\\\\n                period = (directory / \\\\\\'cpu.cfs_period_us\\\\\\').read_text().strip()\\\\n            quota, period = int(quota), int(period)\\\\n            if quota > 0 and period > 0:\\\\n                limits.append({\\\\\\'source\\\\\\': str(filename), \\\\\\'cores\\\\\\': quota / period})\\\\n        except (OSError, ValueError):\\\\n            continue\\\\n    return limits\\\\n\\\\n\\\\ndef detect_cpu_capacity():\\\\n    logical = max(1, os.cpu_count() or 1)\\\\n    affinity = None\\\\n    try:\\\\n        affinity = len(os.sched_getaffinity(0))\\\\n    except (AttributeError, OSError):\\\\n        try:\\\\n            affinity = len(psutil.Process().cpu_affinity())\\\\n        except (AttributeError, psutil.Error):\\\\n            pass\\\\n    quota_limits = cgroup_cpu_quotas() if sys.platform.startswith(\\\\\\'linux\\\\\\') else []\\\\n    effective = min([logical] + ([affinity] if affinity else []) + [value[\\\\\\'cores\\\\\\'] for value in quota_limits])\\\\n    return {\\\\\\'logical_cpus\\\\\\': logical, \\\\\\'affinity_cpus\\\\\\': affinity, \\\\\\'cgroup_quotas\\\\\\': quota_limits,\\\\n            \\\\\\'effective_cpu_cores\\\\\\': effective, \\\\\\'usable_cpu_threads\\\\\\': max(1, math.floor(effective)),\\\\n            \\\\\\'fractional_quota_note\\\\\\': \\\\\\'A quota below one CPU uses one throttled lane, not one full CPU\\\\\\'}\\\\n\\\\n\\\\nclass BudgetUnavailable(Exception):\\\\n    def __init__(self, reason, permanent=False):\\\\n        super().__init__(reason)\\\\n        self.permanent = permanent\\\\n\\\\n\\\\nclass PipelineBudget:\\\\n    def __init__(self, root, *, limits=None, model_peak_ram_bytes=0):\\\\n        self.root = Path(root)\\\\n        self._condition = threading.Condition()\\\\n        self._reservations = {}\\\\n        self._reservation_ids = {}\\\\n        self._cancellations = {}\\\\n        self._result_bytes = {}\\\\n        self._cpu_used = 0\\\\n        self._gpu_owner = None\\\\n        self._model_peak = int(model_peak_ram_bytes)\\\\n        self._system_checks = limits is None\\\\n        self._cpu_capacity = detect_cpu_capacity()\\\\n        self._os_reserve = int(os.environ.get(\"H3_PIPELINE_OS_RESERVE_MIB\", \"2048\")) * 1024 ** 2\\\\n        defaults = {\\\\n            \"ram_bytes\": int(os.environ.get(\"H3_PIPELINE_RAM_MIB\", \"8192\")) * 1024 ** 2,\\\\n            \"disk_bytes\": max(0, shutil.disk_usage(self.root).free - GiB),\\\\n            \"cpu_threads\": int(os.environ.get(\"H3_PIPELINE_CPU_THREADS\", str(self._cpu_capacity[\\\\\\'usable_cpu_threads\\\\\\']))),\\\\n        }\\\\n        self.limits = defaults if limits is None else {**defaults, **limits}\\\\n        if any(type(value) is not int or value <= 0 for value in self.limits.values()):\\\\n            raise ValueError(\"Pipeline budgets must be positive integers\")\\\\n        self._requested_cpu_threads = self.limits[\\\\\\'cpu_threads\\\\\\']\\\\n        self.limits[\\\\\\'cpu_threads\\\\\\'] = min(self.limits[\\\\\\'cpu_threads\\\\\\'], self._cpu_capacity[\\\\\\'usable_cpu_threads\\\\\\'])\\\\n        self._requested_gpu_cpu_threads = int(os.environ.get(\\\\\\'H3_PIPELINE_GPU_CPU_THREADS\\\\\\', \\\\\\'1\\\\\\'))\\\\n        if self._requested_gpu_cpu_threads < 1:\\\\n            raise ValueError(\\\\\\'GPU host CPU reservation must be positive\\\\\\')\\\\n        self.gpu_host_cpu_threads = min(self._requested_gpu_cpu_threads, self.limits[\\\\\\'cpu_threads\\\\\\'])\\\\n        self.native_cpu_status = {\\\\\\'configured\\\\\\': False, \\\\\\'reason\\\\\\': \\\\\\'Backend native CPU configuration pending\\\\\\'}\\\\n        self.instance_id = uuid.uuid4().hex\\\\n        self._source_sha256 = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()\\\\n        self._last_gates = {}\\\\n        self._attempt_gates = OrderedDict()\\\\n        self._active_leases = {}\\\\n        self._released_leases = OrderedDict()\\\\n        self._lease_history = deque(maxlen=512)\\\\n        self._lease_event_count = 0\\\\n\\\\n    def _capacity_version(self):\\\\n        payload = {\\\\\\'limits\\\\\\': self.limits, \\\\\\'gpu_host_cpu_threads\\\\\\': self.gpu_host_cpu_threads}\\\\n        return hashlib.sha256(json.dumps(payload, sort_keys=True).encode()).hexdigest()\\\\n\\\\n    def _gate(self, identity, kind, observations, context=None):\\\\n        # Called with our Condition held. No callbacks into other ownership domains.\\\\n        receipt = evaluate_gate(\\\\\\'pipeline.\\\\\\' + kind, list(observations), observations,\\\\n                                {**(context or {}), \\\\\\'budget_instance_id\\\\\\': self.instance_id,\\\\n                                 \\\\\\'attempt_id\\\\\\': identity, \\\\\\'resource_kind\\\\\\': kind,\\\\n                                 \\\\\\'reservation_id\\\\\\': self._reservation_ids.get(identity),\\\\n                                 \\\\\\'capacity_version\\\\\\': self._capacity_version(),\\\\n                                 \\\\\\'source_file\\\\\\': \\\\\\'pipeline_scheduler.py\\\\\\',\\\\n                                 \\\\\\'source_sha256\\\\\\': self._source_sha256})\\\\n        self._last_gates[receipt[\\\\\\'gate_id\\\\\\']] = receipt\\\\n        key = (identity, kind)\\\\n        self._attempt_gates[key] = receipt\\\\n        self._attempt_gates.move_to_end(key)\\\\n        while len(self._attempt_gates) > 128:\\\\n            self._attempt_gates.popitem(last=False)\\\\n        return receipt\\\\n\\\\n    def gate_receipt(self, identity, kind):\\\\n        with self._condition:\\\\n            return copy.deepcopy(self._attempt_gates.get((identity, kind)))\\\\n\\\\n    def reservation_witness(self, identity):\\\\n        with self._condition:\\\\n            return {\\\\\\'owned\\\\\\': identity in self._reservations,\\\\n                    \\\\\\'budget_instance_id\\\\\\': self.instance_id, \\\\\\'attempt_id\\\\\\': identity,\\\\n                    \\\\\\'reservation_id\\\\\\': self._reservation_ids.get(identity),\\\\n                    \\\\\\'resources\\\\\\': copy.deepcopy(self._reservations.get(identity)),\\\\n                    \\\\\\'capacity_version\\\\\\': self._capacity_version()}\\\\n\\\\n    def lease_witness(self, identity, kind):\\\\n        with self._condition:\\\\n            return copy.deepcopy(next((lease for lease in self._active_leases.values()\\\\n                                       if lease[\\\\\\'attempt_id\\\\\\'] == identity and lease[\\\\\\'kind\\\\\\'] == kind), None))\\\\n\\\\n    def release_witness(self, lease_id):\\\\n        with self._condition:\\\\n            return copy.deepcopy(self._released_leases.get(lease_id))\\\\n\\\\n    def set_cancelled(self, identity, observation):\\\\n        \"\"\"Update cancellation evidence in the same domain as budget grants.\\\\n\\\\n        Model cancellation also owns its Event and rechecks under its own lock.\\\\n        Updating this ledger does not interrupt a lease already granted.\\\\n        \"\"\"\\\\n        with self._condition:\\\\n            if identity not in self._reservations:\\\\n                return False\\\\n            self._cancellations[identity] = copy.deepcopy(observation)\\\\n            self._condition.notify_all()\\\\n            return True\\\\n\\\\n    def _lease_event(self, event_type, lease):\\\\n        self._lease_event_count += 1\\\\n        event = {key: copy.deepcopy(lease[key]) for key in\\\\n                 (\\\\\\'lease_id\\\\\\', \\\\\\'budget_instance_id\\\\\\', \\\\\\'attempt_id\\\\\\', \\\\\\'kind\\\\\\', \\\\\\'cpu_threads\\\\\\',\\\\n                  \\\\\\'capacity_version\\\\\\', \\\\\\'decision_id\\\\\\', \\\\\\'reservation_id\\\\\\')}\\\\n        event.update(event_id=uuid.uuid4().hex, sequence=self._lease_event_count,\\\\n                     type=event_type, observed_at=time.time(), monotonic_ns=time.monotonic_ns(),\\\\n                     cpu_threads_in_use=self._cpu_used, gpu_attempt_id=self._gpu_owner,\\\\n                     limits=dict(self.limits))\\\\n        self._lease_history.append(event)\\\\n        return event\\\\n\\\\n    def _used(self, name):\\\\n        return sum(value[name] for value in self._reservations.values()) + (\\\\n            sum(self._result_bytes.values()) if name == \"ram_bytes\" else 0)\\\\n\\\\n    def reserve(self, identity, resources):\\\\n        if type(identity) is not str or not 1 <= len(identity) <= 256:\\\\n            raise BudgetUnavailable(\\\\\\'invalid_attempt_identity\\\\\\', permanent=True)\\\\n        charge = {name: resources[name] for name in (\"ram_bytes\", \"disk_bytes\", \"cpu_threads\")}\\\\n        if any(type(value) is not int or value <= 0 for value in charge.values()):\\\\n            raise BudgetUnavailable(\"invalid_backend_resource_estimate\", permanent=True)\\\\n        with self._condition:\\\\n            if identity in self._reservations:\\\\n                same = self._reservations[identity] == charge\\\\n                self._gate(identity, \\\\\\'reserve.existing\\\\\\', {\\\\\\'reservation_matches\\\\\\': same})\\\\n                if not same:\\\\n                    raise BudgetUnavailable(\\\\\\'reservation_identity_conflict\\\\\\', permanent=True)\\\\n                return\\\\n            fits = all(charge[name] <= self.limits[name] for name in charge)\\\\n            room = all(self._used(name) + charge[name] <= self.limits[name]\\\\n                       for name in (\\\\\\'ram_bytes\\\\\\', \\\\\\'disk_bytes\\\\\\'))\\\\n            host_available = disk_available = True\\\\n            if self._system_checks:\\\\n                try:\\\\n                    # Existing task memory is not part of the resident model.\\\\n                    rss = psutil.Process().memory_info().rss\\\\n                    resident_model = max(0, rss - self._used(\\\\\\'ram_bytes\\\\\\'))\\\\n                    future_model = max(0, self._model_peak - resident_model)\\\\n                    host_available = psutil.virtual_memory().available >= (\\\\n                        future_model + self._os_reserve + self._used(\\\\\\'ram_bytes\\\\\\') + charge[\\\\\\'ram_bytes\\\\\\'])\\\\n                    disk_available = shutil.disk_usage(self.root).free >= GiB + self._used(\\\\\\'disk_bytes\\\\\\') + charge[\\\\\\'disk_bytes\\\\\\']\\\\n                except (OSError, psutil.Error):\\\\n                    host_available = disk_available = None\\\\n            receipt = self._gate(identity, \\\\\\'reserve\\\\\\', {\\\\n                \\\\\\'estimate_within_limits\\\\\\': fits, \\\\\\'working_set_available\\\\\\': room,\\\\n                \\\\\\'host_memory_available\\\\\\': host_available, \\\\\\'disk_available\\\\\\': disk_available,\\\\n                \\\\\\'result_identity_unused\\\\\\': identity not in self._result_bytes})\\\\n            if not fits:\\\\n                raise BudgetUnavailable(\"request_exceeds_working_set_budget\", permanent=True)\\\\n            if not room:\\\\n                raise BudgetUnavailable(\"resource_budget_exhausted\")\\\\n            if host_available is False:\\\\n                raise BudgetUnavailable(\\\\\\'live_host_memory_pressure\\\\\\')\\\\n            if disk_available is False:\\\\n                raise BudgetUnavailable(\\\\\\'live_disk_pressure\\\\\\')\\\\n            if not receipt[\\\\\\'allowed\\\\\\']:\\\\n                raise BudgetUnavailable(\\\\\\'reservation_conditions_unconfirmed\\\\\\')\\\\n            self._reservations[identity] = charge\\\\n            self._reservation_ids[identity] = uuid.uuid4().hex\\\\n            self._cancellations[identity] = False\\\\n\\\\n    def finish(self, identity, result_bytes=0):\\\\n        with self._condition:\\\\n            if any(lease[\\\\\\'attempt_id\\\\\\'] == identity for lease in self._active_leases.values()):\\\\n                raise BudgetUnavailable(\\\\\\'attempt_still_holds_stage_lease\\\\\\')\\\\n            self._reservations.pop(identity, None)\\\\n            self._reservation_ids.pop(identity, None)\\\\n            self._cancellations.pop(identity, None)\\\\n            if result_bytes:\\\\n                self._result_bytes[identity] = result_bytes\\\\n            self._condition.notify_all()\\\\n\\\\n    def acknowledge(self, identity):\\\\n        with self._condition:\\\\n            self._result_bytes.pop(identity, None)\\\\n            self._condition.notify_all()\\\\n\\\\n    @contextmanager\\\\n    def stage(self, identity, kind, *, cpu_threads=1, cancelled=lambda: False,\\\\n              cancellation_event=None, context=None):\\\\n        if kind not in {\\\\\\'cpu\\\\\\', \\\\\\'gpu\\\\\\'}:\\\\n            raise ValueError(\\\\\\'Unknown resource stage\\\\\\')\\\\n        charge = self.gpu_host_cpu_threads if kind == \\\\\\'gpu\\\\\\' else cpu_threads\\\\n        if type(charge) is not int or not 1 <= charge <= self.limits[\\\\\\'cpu_threads\\\\\\']:\\\\n            raise ValueError(\\\\\\'Stage CPU requirement exceeds the available CPU budget\\\\\\')\\\\n        acquired = False\\\\n        lease_id = None\\\\n        with self._condition:\\\\n            reservation_id = self._reservation_ids.get(identity)\\\\n        while True:\\\\n            # Legacy arbitrary callbacks may take a model lock, so never invoke\\\\n            # them while holding the budget lock. Their sampled state does not\\\\n            # claim global atomicity; the model rechecks before actual effects.\\\\n            cancellation = None\\\\n            if cancellation_event is None:\\\\n                try:\\\\n                    cancellation = cancelled()\\\\n                except Exception:\\\\n                    pass\\\\n            with self._condition:\\\\n                if cancellation_event is not None:\\\\n                    # Event.is_set is a local flag read, never a foreign callback.\\\\n                    cancellation = (threading.Event.is_set(cancellation_event)\\\\n                                    if type(cancellation_event) is threading.Event else None)\\\\n                observations = {\\\\n                    \\\\\\'reservation_owned\\\\\\': reservation_id is not None and self._reservation_ids.get(identity) == reservation_id,\\\\n                    \\\\\\'cancellation_clear\\\\\\': negate_observation(self._cancellations.get(identity)),\\\\n                    \\\\\\'not_cancelled\\\\\\': negate_observation(cancellation),\\\\n                    \\\\\\'attempt_stage_idle\\\\\\': not any(lease[\\\\\\'attempt_id\\\\\\'] == identity for lease in self._active_leases.values()),\\\\n                    \\\\\\'cpu_grant_available\\\\\\': self._cpu_used + charge <= self.limits[\\\\\\'cpu_threads\\\\\\'],\\\\n                }\\\\n                if kind == \\\\\\'gpu\\\\\\':\\\\n                    observations[\\\\\\'gpu_grant_available\\\\\\'] = self._gpu_owner is None\\\\n                receipt = self._gate(identity, \\\\\\'stage.\\\\\\' + kind, observations, context)\\\\n                if receipt[\\\\\\'allowed\\\\\\']:\\\\n                    # The declaration and its resource effect share this lock.\\\\n                    self._cpu_used += charge\\\\n                    if kind == \\\\\\'gpu\\\\\\':\\\\n                        self._gpu_owner = identity\\\\n                    lease_id = uuid.uuid4().hex\\\\n                    lease = {\\\\\\'owned\\\\\\': True, \\\\\\'lease_id\\\\\\': lease_id, \\\\\\'attempt_id\\\\\\': identity, \\\\\\'kind\\\\\\': kind,\\\\n                             \\\\\\'budget_instance_id\\\\\\': self.instance_id, \\\\\\'reservation_id\\\\\\': reservation_id,\\\\n                             \\\\\\'cpu_threads\\\\\\': charge, \\\\\\'capacity_version\\\\\\': receipt[\\\\\\'context\\\\\\'][\\\\\\'capacity_version\\\\\\'],\\\\n                             \\\\\\'decision_id\\\\\\': receipt[\\\\\\'decision_id\\\\\\'], \\\\\\'grant_receipt\\\\\\': receipt,\\\\n                             \\\\\\'granted_at\\\\\\': time.time(), \\\\\\'granted_monotonic_ns\\\\\\': time.monotonic_ns()}\\\\n                    self._active_leases[lease_id] = lease\\\\n                    self._lease_event(\\\\\\'lease.acquired\\\\\\', lease)\\\\n                    acquired = True\\\\n                    break\\\\n                if any(receipt[\\\\\\'conditions\\\\\\'][name] != \\\\\\'true\\\\\\' for name in\\\\n                       (\\\\\\'reservation_owned\\\\\\', \\\\\\'cancellation_clear\\\\\\', \\\\\\'not_cancelled\\\\\\')):\\\\n                    break\\\\n                # Only actual contention waits; wait releases the lock and thus\\\\n                # cannot serialize unrelated CPU/GPU releases or admissions.\\\\n                self._condition.wait(.05)\\\\n        try:\\\\n            yield acquired\\\\n        finally:\\\\n            if acquired:\\\\n                with self._condition:\\\\n                    lease = self._active_leases.get(lease_id)\\\\n                    if lease is None or lease[\\\\\\'attempt_id\\\\\\'] != identity or lease[\\\\\\'kind\\\\\\'] != kind:\\\\n                        raise RuntimeError(\\\\\\'Stage lease ownership was lost\\\\\\')\\\\n                    if kind == \"gpu\":\\\\n                        if self._gpu_owner != identity:\\\\n                            raise RuntimeError(\\\\\\'GPU lease ownership was lost\\\\\\')\\\\n                        self._gpu_owner = None\\\\n                    self._cpu_used -= charge\\\\n                    self._active_leases.pop(lease_id)\\\\n                    lease = {**lease, \\\\\\'owned\\\\\\': False, \\\\\\'released_at\\\\\\': time.time(),\\\\n                             \\\\\\'released_monotonic_ns\\\\\\': time.monotonic_ns()}\\\\n                    self._released_leases[lease_id] = lease\\\\n                    while len(self._released_leases) > 256:\\\\n                        self._released_leases.popitem(last=False)\\\\n                    self._lease_event(\\\\\\'lease.released\\\\\\', lease)\\\\n                    self._condition.notify_all()\\\\n\\\\n    def snapshot(self):\\\\n        with self._condition:\\\\n            used = {name: self._used(name) for name in (\"ram_bytes\", \"disk_bytes\")}\\\\n            return {\"limits\": dict(self.limits), \"reserved\": used,\\\\n                    \\\\\\'budget_instance_id\\\\\\': self.instance_id,\\\\n                    \\\\\\'capacity_version\\\\\\': self._capacity_version(),\\\\n                    \\\\\\'last_gate_receipts\\\\\\': copy.deepcopy(self._last_gates),\\\\n                    \\\\\\'active_leases\\\\\\': copy.deepcopy(list(self._active_leases.values())),\\\\n                    \\\\\\'lease_history\\\\\\': {\\\\\\'capacity\\\\\\': self._lease_history.maxlen,\\\\n                                      \\\\\\'events\\\\\\': copy.deepcopy(list(self._lease_history)),\\\\n                                      \\\\\\'count\\\\\\': self._lease_event_count,\\\\n                                      \\\\\\'dropped\\\\\\': self._lease_event_count - len(self._lease_history),\\\\n                                      \\\\\\'history_complete\\\\\\': self._lease_event_count == len(self._lease_history)},\\\\n                    \"free\": {name: self.limits[name] - used[name] for name in used},\\\\n                    \"cpu_threads_in_use\": self._cpu_used, \"gpu_attempt_id\": self._gpu_owner,\\\\n                    \"gpu_host_cpu_threads_in_use\": self.gpu_host_cpu_threads if self._gpu_owner else 0,\\\\n                    \"cpu_stage_threads_in_use\": self._cpu_used - (self.gpu_host_cpu_threads if self._gpu_owner else 0),\\\\n                    \"cpu_count_scope\": \"Reserved native execution lanes; not sampled CPU utilization\",\\\\n                    \"gpu_host_cpu_threads\": self.gpu_host_cpu_threads,\\\\n                    \"requested_cpu_threads\": self._requested_cpu_threads,\\\\n                    \"requested_gpu_host_cpu_threads\": self._requested_gpu_cpu_threads,\\\\n                    \"cpu_capacity\": self._cpu_capacity, \\\\\\'native_cpu\\\\\\': self.native_cpu_status,\\\\n                    \"io_budget\": {\"scope\": \"disk_capacity_only\", \"bandwidth_calibrated\": False,\\\\n                                  \"bytes_per_second_limit\": None,\\\\n                                  \"optimality\": \"Conservative admission estimates; no mathematical optimum claimed\"},\\\\n                    \"admitted_attempts\": len(self._reservations),\\\\n                    \"unacknowledged_result_bytes\": sum(self._result_bytes.values()),\\\\n                    \"model_peak_ram_bytes\": self._model_peak,\\\\n                    \"os_reserve_bytes\": self._os_reserve,\\\\n                    \"live_pressure_checks\": self._system_checks}\\\\n\\\\n    def has_capacity(self):\\\\n        state = self.snapshot()\\\\n        return all(value > 0 for value in state[\"free\"].values())\\\\n\\', \\'pipeline_smoke_test.py\\': \\'\"\"\"Real public-API queue/cancel/two-content acceptance. No model or fake video.\\\\n\\\\nStart while the model is loading: accept eight jobs, cancel six queued jobs,\\\\nthen fetch the two distinct survivors. --resume only queries existing identities.\\\\nStage overlap and GPU-release proofs are checked separately from the cloud audit.\\\\n\"\"\"\\\\nfrom __future__ import annotations\\\\nimport argparse\\\\nfrom concurrent.futures import ThreadPoolExecutor\\\\nfrom datetime import datetime, timezone\\\\nimport hashlib\\\\nimport json\\\\nimport os\\\\nfrom pathlib import Path\\\\nimport time\\\\nimport uuid\\\\nfrom urllib.parse import urlsplit\\\\n\\\\n\\\\ndef require(ok, message):\\\\n    if not ok:\\\\n        raise RuntimeError(message)\\\\n\\\\n\\\\ndef now():\\\\n    return datetime.now(timezone.utc).isoformat()\\\\n\\\\n\\\\ndef digest(path):\\\\n    return hashlib.sha256(path.read_bytes()).hexdigest()\\\\n\\\\n\\\\ndef checkpoint(folder, report):\\\\n    temporary = folder / \\\\\\'pipeline_report.json.tmp\\\\\\'\\\\n    temporary.write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding=\\\\\\'utf-8\\\\\\')\\\\n    temporary.replace(folder / \\\\\\'pipeline_report.json\\\\\\')\\\\n\\\\n\\\\ndef download_ranges(base, key, job, folder):\\\\n    import requests\\\\n    artifact = job[\\\\\\'artifact\\\\\\']\\\\n    size = artifact[\\\\\\'bytes\\\\\\']\\\\n    require(isinstance(size, int) and 0 < size <= 128 * 1024**2, \\\\\\'Unexpected output size\\\\\\')\\\\n    require(artifact.get(\\\\\\'media\\\\\\', {}).get(\\\\\\'full_decode_passed\\\\\\') is True, \\\\\\'Server did not validate the complete video\\\\\\')\\\\n    url = base + \\\\\\'/v1/jobs/\\\\\\' + job[\\\\\\'id\\\\\\'] + \\\\\\'/file\\\\\\'\\\\n    def part(bounds):\\\\n        start, end = bounds\\\\n        records = []\\\\n        for number in range(1, 4):\\\\n            record = {\\\\\\'attempt\\\\\\': number, \\\\\\'start\\\\\\': start, \\\\\\'end\\\\\\': end}\\\\n            records.append(record)\\\\n            try:\\\\n                with requests.get(url, headers={\\\\\\'Authorization\\\\\\': \\\\\\'Bearer \\\\\\'+key,\\\\n                        \\\\\\'Range\\\\\\': f\\\\\\'bytes={start}-{end}\\\\\\', \\\\\\'Accept-Encoding\\\\\\': \\\\\\'identity\\\\\\'},\\\\n                        timeout=(15, 25), allow_redirects=False, stream=True) as response:\\\\n                    record.update(http_status=response.status_code,\\\\n                                  content_range=response.headers.get(\\\\\\'Content-Range\\\\\\'))\\\\n                    require(response.status_code == 206, \\\\\\'Range request was not accepted\\\\\\')\\\\n                    require(record[\\\\\\'content_range\\\\\\'] == f\\\\\\'bytes {start}-{end}/{size}\\\\\\', \\\\\\'Incorrect Content-Range\\\\\\')\\\\n                    data = response.raw.read(end-start+2)\\\\n                    record[\\\\\\'bytes\\\\\\'] = len(data)\\\\n                    require(len(data) == end-start+1, \\\\\\'Truncated range\\\\\\')\\\\n                record[\\\\\\'passed\\\\\\'] = True\\\\n                return data, records\\\\n            except Exception as error:\\\\n                record.update(passed=False, error_type=type(error).__name__)\\\\n        return None, records\\\\n    bounds = [(start, min(size-1, start+65535)) for start in range(0, size, 65536)]\\\\n    with ThreadPoolExecutor(max_workers=3) as pool:\\\\n        parts = list(pool.map(part, bounds))\\\\n    result = {\\\\\\'job_id\\\\\\': job[\\\\\\'id\\\\\\'], \\\\\\'ranges\\\\\\': [records for _, records in parts], \\\\\\'passed\\\\\\': False}\\\\n    (folder / (job[\\\\\\'id\\\\\\']+\\\\\\'-download.json\\\\\\')).write_text(json.dumps(result,indent=2),encoding=\\\\\\'utf-8\\\\\\')\\\\n    require(all(data is not None for data,_ in parts), \\\\\\'File transfer exhausted bounded range retries; resume without generating again\\\\\\')\\\\n    content = b\\\\\\'\\\\\\'.join(data for data,_ in parts)\\\\n    actual = hashlib.sha256(content).hexdigest()\\\\n    require(len(content)==size and actual==artifact[\\\\\\'sha256\\\\\\'], \\\\\\'External file differs from committed artifact\\\\\\')\\\\n    path = folder / (job[\\\\\\'id\\\\\\']+\\\\\\'.mp4\\\\\\')\\\\n    path.write_bytes(content)\\\\n    result.update(passed=True, bytes=size, sha256=actual, path=str(path),\\\\n                  full_decode_basis=\\\\\\'Server full audiovisual decode, with exact external byte count and SHA256 match\\\\\\')\\\\n    (folder / (job[\\\\\\'id\\\\\\']+\\\\\\'-download.json\\\\\\')).write_text(json.dumps(result,indent=2),encoding=\\\\\\'utf-8\\\\\\')\\\\n    return result\\\\n\\\\n\\\\ndef get_json(base, key, route, *, authenticated=True, records=None):\\\\n    \"\"\"Bounded read retries never submit or replace an existing generation.\"\"\"\\\\n    import requests\\\\n    for attempt in range(1, 4):\\\\n        record = {\\\\\\'route\\\\\\': route, \\\\\\'attempt\\\\\\': attempt, \\\\\\'observed_at\\\\\\': now()}\\\\n        if records is not None:\\\\n            records.append(record)\\\\n        try:\\\\n            response = requests.get(base+route,\\\\n                headers={\\\\\\'Authorization\\\\\\': \\\\\\'Bearer \\\\\\'+key} if authenticated else {},\\\\n                timeout=(10,20), allow_redirects=False)\\\\n            record[\\\\\\'http_status\\\\\\'] = response.status_code\\\\n            if response.status_code == 200:\\\\n                return response.json()\\\\n            require(response.status_code in (429,502,503,504),\\\\n                    \\\\\\'GET \\\\\\'+route+\\\\\\' returned HTTP \\\\\\'+str(response.status_code))\\\\n        except requests.RequestException as error:\\\\n            record[\\\\\\'error_type\\\\\\'] = type(error).__name__\\\\n        if attempt < 3:\\\\n            time.sleep(attempt)\\\\n    raise RuntimeError(\\\\\\'GET \\\\\\'+route+\\\\\\' exhausted bounded read retries; resume existing task identities\\\\\\')\\\\n\\\\n\\\\ndef _run(args):\\\\n    import requests\\\\n    key = os.environ.get(\\\\\\'H3_API_KEY\\\\\\', \\\\\\'\\\\\\')\\\\n    require(len(key)>=32, \\\\\\'Set H3_API_KEY without placing it in command-line arguments\\\\\\')\\\\n    base = args.url.rstrip(\\\\\\'/\\\\\\')\\\\n    parsed = urlsplit(base)\\\\n    require(parsed.scheme in {\\\\\\'http\\\\\\',\\\\\\'https\\\\\\'} and parsed.hostname and not any(\\\\n        (parsed.username, parsed.password, parsed.query, parsed.fragment)), \\\\\\'Invalid API base URL\\\\\\')\\\\n    args.outputdir.mkdir(parents=True, exist_ok=True)\\\\n    target = args.outputdir/\\\\\\'pipeline_report.json\\\\\\'\\\\n    headers = {\\\\\\'Authorization\\\\\\':\\\\\\'Bearer \\\\\\'+key}\\\\n    reads = []\\\\n    def get(route, authenticated=True):\\\\n        return get_json(base,key,route,authenticated=authenticated,records=reads)\\\\n    if args.resume:\\\\n        report = json.loads(target.read_text(encoding=\\\\\\'utf-8\\\\\\'))\\\\n        require(report[\\\\\\'api_base_url\\\\\\']==base and len(report.get(\\\\\\'jobs\\\\\\',[]))==8,\\\\n                \\\\\\'Resume needs the original API URL and all eight recorded job identities\\\\\\')\\\\n        require(all(job.get(\\\\\\'id\\\\\\') for job in report[\\\\\\'jobs\\\\\\']), \\\\\\'Resolve uncertain submission identities before resume\\\\\\')\\\\n        reads = report.setdefault(\\\\\\'read_attempts\\\\\\', [])\\\\n        report[\\\\\\'resumed_at\\\\\\'] = now()\\\\n        args._active_report = True\\\\n    else:\\\\n        require(not target.exists(), \\\\\\'Existing test report: use --resume; never resubmit an existing run\\\\\\')\\\\n        require(args.reference_a and args.reference_b and args.prompt_a and args.prompt_b,\\\\n                \\\\\\'Two fresh reference images and distinct explicit prompts are required\\\\\\')\\\\n        refs = [args.reference_a.resolve(),args.reference_b.resolve()]\\\\n        require(all(p.is_file() for p in refs), \\\\\\'Reference files do not exist\\\\\\')\\\\n        hashes = [digest(p) for p in refs]\\\\n        require(hashes[0]!=hashes[1] and args.prompt_a.strip()!=args.prompt_b.strip(),\\\\n                \\\\\\'The two survivors must use different references and prompts\\\\\\')\\\\n        report = {\\\\\\'schema_version\\\\\\':1, \\\\\\'run_id\\\\\\':uuid.uuid4().hex, \\\\\\'started_at\\\\\\':now(), \\\\\\'api_base_url\\\\\\':base,\\\\n                  \\\\\\'passed\\\\\\':False, \\\\\\'jobs\\\\\\':[], \\\\\\'downloads\\\\\\':[], \\\\\\'observations\\\\\\':[], \\\\\\'read_attempts\\\\\\':reads,\\\\n                  \\\\\\'scope\\\\\\':\\\\\\'Eight durable queued jobs; six queued cancellations; two new-content real generations. Stage overlap and shutdown are independently audited.\\\\\\'}\\\\n        checkpoint(args.outputdir,report)\\\\n        args._active_report = True\\\\n        deadline=time.monotonic()+args.startup_timeout\\\\n        while True:\\\\n            try:\\\\n                system=get(\\\\\\'/v1/system\\\\\\')\\\\n                if system.get(\\\\\\'api_ready\\\\\\') and not system.get(\\\\\\'observation_stale\\\\\\'):\\\\n                    break\\\\n            except Exception:\\\\n                pass\\\\n            require(time.monotonic()<deadline, \\\\\\'API did not become queryable\\\\\\')\\\\n            time.sleep(3)\\\\n        require(system.get(\\\\\\'model_ready\\\\\\') is False, \\\\\\'Run queue admission/cancel test during cold loading, before any GPU job can start\\\\\\')\\\\n        report[\\\\\\'instance_id\\\\\\']=system[\\\\\\'instance_id\\\\\\']\\\\n        report[\\\\\\'system_before_submission\\\\\\']=system\\\\n        from smoke_test import register_content\\\\n        registry=args.content_history or args.outputdir.parent/\\\\\\'content-history.json\\\\\\'\\\\n        report[\\\\\\'content_reservations\\\\\\']=[]\\\\n        for index,prompt in enumerate((args.prompt_a,args.prompt_b)):\\\\n            report[\\\\\\'content_reservations\\\\\\'].append(register_content(registry,hashes[index],prompt,\\\\n                outputdir=args.outputdir,api_base_url=base))\\\\n            checkpoint(args.outputdir,report)\\\\n        unauth=requests.get(base+\\\\\\'/v1/system\\\\\\',timeout=15,allow_redirects=False)\\\\n        report[\\\\\\'unauthorized_system_http_status\\\\\\']=unauth.status_code\\\\n        require(unauth.status_code==401,\\\\\\'Unauthorized query was not rejected\\\\\\')\\\\n        for index in range(8):\\\\n            survivor=index in (0,2)\\\\n            content_index=1 if index==2 else 0\\\\n            prompt=(args.prompt_a,args.prompt_b)[content_index]\\\\n            if not survivor:\\\\n                prompt+=f\\\\\\' Alternate cancelled queue test {index}: a new viewpoint with slow lateral camera motion.\\\\\\'\\\\n            entry={\\\\\\'index\\\\\\':index,\\\\\\'survivor\\\\\\':survivor,\\\\\\'reference\\\\\\':str(refs[content_index]),\\\\n                   \\\\\\'reference_sha256\\\\\\':hashes[content_index], \\\\\\'prompt\\\\\\':prompt,\\\\n                   \\\\\\'idempotency_key\\\\\\':report[\\\\\\'run_id\\\\\\']+\\\\\\'-\\\\\\'+str(index), \\\\\\'submission_attempts\\\\\\':[]}\\\\n            report[\\\\\\'jobs\\\\\\'].append(entry)\\\\n            checkpoint(args.outputdir,report)\\\\n            for attempt in range(1,4):\\\\n                try:\\\\n                    with refs[content_index].open(\\\\\\'rb\\\\\\') as media:\\\\n                        response=requests.post(base+\\\\\\'/v1/jobs\\\\\\',headers={**headers,\\\\\\'Idempotency-Key\\\\\\':entry[\\\\\\'idempotency_key\\\\\\']},\\\\n                            data={\\\\\\'prompt\\\\\\':prompt,\\\\\\'kinds\\\\\\':\\\\\\'[\"image\"]\\\\\\',\\\\\\'seconds\\\\\\':5,\\\\\\'width\\\\\\':512,\\\\\\'height\\\\\\':288,\\\\\\'steps\\\\\\':8,\\\\\\'seed\\\\\\':42+index},\\\\n                            files=[(\\\\\\'files\\\\\\',(refs[content_index].name,media,\\\\\\'image/png\\\\\\'))],\\\\n                            timeout=(15,90),allow_redirects=False)\\\\n                    entry[\\\\\\'submission_attempts\\\\\\'].append({\\\\\\'attempt\\\\\\':attempt,\\\\\\'http_status\\\\\\':response.status_code})\\\\n                    if response.status_code==202:\\\\n                        value=response.json()\\\\n                        entry.update(id=value[\\\\\\'id\\\\\\'],submitted_status=value[\\\\\\'status\\\\\\'],receipt=value)\\\\n                        break\\\\n                    require(response.status_code in (429,502,503,504), \\\\\\'Submission definitively rejected: HTTP \\\\\\'+str(response.status_code))\\\\n                except requests.RequestException as error:\\\\n                    entry[\\\\\\'submission_attempts\\\\\\'].append({\\\\\\'attempt\\\\\\':attempt,\\\\\\'error_type\\\\\\':type(error).__name__})\\\\n                finally:\\\\n                    checkpoint(args.outputdir,report)\\\\n                time.sleep(1)\\\\n            require(entry.get(\\\\\\'id\\\\\\'), \\\\\\'Submission uncertain: keep this report and idempotency key; do not start a new run\\\\\\')\\\\n            require(entry[\\\\\\'submitted_status\\\\\\']==\\\\\\'queued\\\\\\',\\\\\\'Model started before queue cancellation acceptance window\\\\\\')\\\\n            print(\\\\\\'accepted\\\\\\',index,entry[\\\\\\'id\\\\\\'],flush=True)\\\\n        report[\\\\\\'all_eight_accepted_before_cancellation\\\\\\']=True\\\\n        checkpoint(args.outputdir,report)\\\\n    try:\\\\n        require(get(\\\\\\'/v1/system\\\\\\')[\\\\\\'instance_id\\\\\\']==report[\\\\\\'instance_id\\\\\\'],\\\\\\'Manager instance changed; do not replay generation\\\\\\')\\\\n        # Repeating cancellation for the recorded identities is idempotent, including on resume.\\\\n        for entry in report[\\\\\\'jobs\\\\\\']:\\\\n            if not entry[\\\\\\'survivor\\\\\\']:\\\\n                before=get(\\\\\\'/v1/jobs/\\\\\\'+entry[\\\\\\'id\\\\\\'])\\\\n                require(before[\\\\\\'status\\\\\\'] in {\\\\\\'queued\\\\\\',\\\\\\'cancelled\\\\\\'},\\\\\\'Cancellation target already began executing; preserve failure evidence\\\\\\')\\\\n                response=requests.post(base+\\\\\\'/v1/jobs/\\\\\\'+entry[\\\\\\'id\\\\\\']+\\\\\\'/cancel\\\\\\',headers=headers,timeout=30,allow_redirects=False)\\\\n                require(response.status_code==202,\\\\\\'Cancellation request was not accepted\\\\\\')\\\\n                after=get(\\\\\\'/v1/jobs/\\\\\\'+entry[\\\\\\'id\\\\\\'])\\\\n                entry[\\\\\\'cancel_receipt\\\\\\']=response.json()\\\\n                entry[\\\\\\'terminal\\\\\\']=after\\\\n                require(after[\\\\\\'status\\\\\\']==\\\\\\'cancelled\\\\\\' and after.get(\\\\\\'started_at\\\\\\') is None,\\\\n                        \\\\\\'Queued cancellation did not complete before dispatch\\\\\\')\\\\n                checkpoint(args.outputdir,report)\\\\n        deadline=time.monotonic()+args.generation_timeout\\\\n        previous=None\\\\n        while True:\\\\n            survivors=[entry for entry in report[\\\\\\'jobs\\\\\\'] if entry[\\\\\\'survivor\\\\\\']]\\\\n            for entry in survivors:\\\\n                entry[\\\\\\'terminal\\\\\\']=get(\\\\\\'/v1/jobs/\\\\\\'+entry[\\\\\\'id\\\\\\'])\\\\n            summary=[{\\\\\\'id\\\\\\':entry[\\\\\\'id\\\\\\'],\\\\\\'status\\\\\\':entry[\\\\\\'terminal\\\\\\'][\\\\\\'status\\\\\\'],\\\\n                      \\\\\\'stage\\\\\\':entry[\\\\\\'terminal\\\\\\'].get(\\\\\\'active_phase\\\\\\')} for entry in survivors]\\\\n            signature=json.dumps(summary,sort_keys=True)\\\\n            if signature!=previous:\\\\n                observation={\\\\\\'observed_at\\\\\\':now(),\\\\\\'jobs\\\\\\':summary}\\\\n                report[\\\\\\'observations\\\\\\'].append(observation)\\\\n                print(json.dumps(observation),flush=True)\\\\n                previous=signature\\\\n            checkpoint(args.outputdir,report)\\\\n            require(all(entry[\\\\\\'terminal\\\\\\'][\\\\\\'status\\\\\\'] not in {\\\\\\'failed\\\\\\',\\\\\\'cancelled\\\\\\'} for entry in survivors),\\\\n                    \\\\\\'A generation did not succeed; inspect the retained report and model log\\\\\\')\\\\n            if all(entry[\\\\\\'terminal\\\\\\'][\\\\\\'status\\\\\\']==\\\\\\'succeeded\\\\\\' for entry in survivors):\\\\n                break\\\\n            require(time.monotonic()<deadline,\\\\\\'Generation deadline exceeded; query or cancel existing IDs without resubmitting\\\\\\')\\\\n            time.sleep(args.poll_seconds)\\\\n        for entry in survivors:\\\\n            report[\\\\\\'downloads\\\\\\'].append(download_ranges(base,key,entry[\\\\\\'terminal\\\\\\'],args.outputdir))\\\\n            checkpoint(args.outputdir,report)\\\\n        report.update(passed=True,finished_at=now())\\\\n        checkpoint(args.outputdir,report)\\\\n        print(\\\\\\'QUEUE_CANCEL_TWO_GENERATIONS_PASSED\\\\\\',flush=True)\\\\n        return report\\\\n    except Exception as error:\\\\n        report.update(passed=False,error_type=type(error).__name__,error=str(error),last_updated_at=now())\\\\n        checkpoint(args.outputdir,report)\\\\n        raise\\\\n\\\\n\\\\ndef run(args):\\\\n    \"\"\"Checkpoint failures during admission as well as during generation polling.\"\"\"\\\\n    args._active_report = False\\\\n    try:\\\\n        return _run(args)\\\\n    except Exception as error:\\\\n        target = args.outputdir/\\\\\\'pipeline_report.json\\\\\\'\\\\n        if args._active_report and target.is_file():\\\\n            try:\\\\n                report = json.loads(target.read_text(encoding=\\\\\\'utf-8\\\\\\'))\\\\n                message = str(error)\\\\n                key = os.environ.get(\\\\\\'H3_API_KEY\\\\\\')\\\\n                if key:\\\\n                    message = message.replace(key, \\\\\\'[REDACTED]\\\\\\')\\\\n                report.update(passed=False,error_type=type(error).__name__,error=message,last_updated_at=now())\\\\n                checkpoint(args.outputdir,report)\\\\n            except (OSError, ValueError, TypeError):\\\\n                pass  # Preserve the original error and any earlier durable identities.\\\\n        raise\\\\n\\\\n\\\\ndef main():\\\\n    parser=argparse.ArgumentParser(description=__doc__)\\\\n    parser.add_argument(\\\\\\'--url\\\\\\',required=True)\\\\n    parser.add_argument(\\\\\\'--outputdir\\\\\\',type=Path,required=True)\\\\n    parser.add_argument(\\\\\\'--reference-a\\\\\\',type=Path)\\\\n    parser.add_argument(\\\\\\'--reference-b\\\\\\',type=Path)\\\\n    parser.add_argument(\\\\\\'--prompt-a\\\\\\')\\\\n    parser.add_argument(\\\\\\'--prompt-b\\\\\\')\\\\n    parser.add_argument(\\\\\\'--resume\\\\\\',action=\\\\\\'store_true\\\\\\')\\\\n    parser.add_argument(\\\\\\'--content-history\\\\\\',type=Path)\\\\n    parser.add_argument(\\\\\\'--startup-timeout\\\\\\',type=float,default=300)\\\\n    parser.add_argument(\\\\\\'--generation-timeout\\\\\\',type=float,default=5400)\\\\n    parser.add_argument(\\\\\\'--poll-seconds\\\\\\',type=float,default=10)\\\\n    run(parser.parse_args())\\\\n\\\\n\\\\nif __name__==\\\\\\'__main__\\\\\\':\\\\n    main()\\\\n\\', \\'notebook_console.py\\': \\'\"\"\"Owned notebook UI bridge. It observes the manager; it is not a GPU scheduler.\"\"\"\\\\nfrom __future__ import annotations\\\\n\\\\nimport ast\\\\nimport base64\\\\nfrom concurrent.futures import ThreadPoolExecutor\\\\nimport hashlib\\\\nimport json\\\\nimport math\\\\nimport os\\\\nimport secrets\\\\nfrom pathlib import Path\\\\nimport threading\\\\nimport sys\\\\nimport time\\\\nimport traceback\\\\nimport uuid\\\\n\\\\nimport notebook_ui as ui\\\\n\\\\n\\\\nACTION_TITLES = {\\\\\\'bootstrap\\\\\\': \\\\\\'一键启动\\\\\\', \\\\\\'preflight\\\\\\': \\\\\\'资源检查\\\\\\', \\\\\\'install\\\\\\': \\\\\\'安装依赖\\\\\\', \\\\\\'start\\\\\\': \\\\\\'启动服务\\\\\\',\\\\n                 \\\\\\'generate\\\\\\': \\\\\\'生成验收\\\\\\', \\\\\\'stop\\\\\\': \\\\\\'停止服务\\\\\\', \\\\\\'release\\\\\\': \\\\\\'释放实例\\\\\\', \\\\\\'control\\\\\\': \\\\\\'组件控制\\\\\\'}\\\\nSTARTUP_LABELS = {\\\\n    \\\\\\'preflight\\\\\\': \\\\\\'检查资源\\\\\\',\\\\n    \\\\\\'install\\\\\\': \\\\\\'安装依赖\\\\\\',\\\\n    \\\\\\'start\\\\\\': \\\\\\'启动独立服务\\\\\\',\\\\n    \\\\\\'awaiting_api\\\\\\': \\\\\\'等待 API 及所选公网可达\\\\\\',\\\\n    \\\\\\'awaiting_model\\\\\\': \\\\\\'API 已可接收排队任务；等待模型完整加载\\\\\\',\\\\n    \\\\\\'ready\\\\\\': \\\\\\'模型与 API 已就绪；排队任务由总管理自动调度\\\\\\',\\\\n    \\\\\\'failed\\\\\\': \\\\\\'启动未完成，查看实际错误；已启动的后台仍可查询和停止\\\\\\',\\\\n    \\\\\\'cancelled\\\\\\': \\\\\\'启动已取消\\\\\\',\\\\n}\\\\nLOG_NAMES = {\\\\\\'model\\\\\\': \\\\\\'server_log\\\\\\', \\\\\\'api\\\\\\': \\\\\\'api_log\\\\\\', \\\\\\'manager\\\\\\': \\\\\\'manager_log\\\\\\', \\\\\\'tunnel\\\\\\': \\\\\\'tunnel_log\\\\\\'}\\\\nBOOLS = {\\\\\\'staged\\\\\\', \\\\\\'cached\\\\\\', \\\\\\'public\\\\\\', \\\\\\'force\\\\\\'}\\\\nSTRINGS = {\\\\\\'reference_file\\\\\\', \\\\\\'prompt\\\\\\', \\\\\\'resume_job_id\\\\\\', \\\\\\'endpoint\\\\\\', \\\\\\'acceleration\\\\\\', \\\\\\'style\\\\\\',\\\\n           \\\\\\'attention\\\\\\', \\\\\\'offload\\\\\\', \\\\\\'action\\\\\\', \\\\\\'command_id\\\\\\', \\\\\\'request_id\\\\\\', \\\\\\'source\\\\\\', \\\\\\'credential_id\\\\\\'}\\\\nCHOICES = {\\\\\\'endpoint\\\\\\': {\\\\\\'public\\\\\\', \\\\\\'local\\\\\\'}, \\\\\\'acceleration\\\\\\': {\\\\\\'none\\\\\\', \\\\\\'lightx2v-ref2va-4step\\\\\\'},\\\\n           \\\\\\'style\\\\\\': {\\\\\\'none\\\\\\', \\\\\\'fal-realism-people\\\\\\'}, \\\\\\'attention\\\\\\': {\\\\\\'auto\\\\\\', \\\\\\'native\\\\\\', \\\\\\'_native_flash\\\\\\'},\\\\n           \\\\\\'offload\\\\\\': {\\\\\\'stream\\\\\\', \\\\\\'sync\\\\\\'}}\\\\nSAFE_STATE = {\\\\\\'instance_id\\\\\\', \\\\\\'phase\\\\\\', \\\\\\'ready\\\\\\', \\\\\\'api_ready\\\\\\', \\\\\\'model_ready\\\\\\', \\\\\\'public_requested\\\\\\',\\\\n              \\\\\\'public_api_ready\\\\\\', \\\\\\'public_ready\\\\\\', \\\\\\'tunnel_connected\\\\\\', \\\\\\'server_alive\\\\\\', \\\\\\'model_alive\\\\\\',\\\\n              \\\\\\'manager_alive\\\\\\', \\\\\\'tunnel_alive\\\\\\', \\\\\\'cleanup_complete\\\\\\', \\\\\\'observed_at\\\\\\', \\\\\\'observation_stale\\\\\\',\\\\n              \\\\\\'elapsed_seconds\\\\\\', \\\\\\'draining\\\\\\', \\\\\\'queue\\\\\\'}\\\\n\\\\n\\\\nclass OperationCancelled(RuntimeError):\\\\n    pass\\\\n\\\\n\\\\ndef validated(payload):\\\\n    if not isinstance(payload, dict) or len(json.dumps(payload)) > 65536:\\\\n        raise ValueError(\\\\\\'控制参数必须是有限的对象。\\\\\\')\\\\n    result = {}\\\\n    for key, value in payload.items():\\\\n        if key in BOOLS:\\\\n            if type(value) is not bool:\\\\n                raise ValueError(f\\\\\\'{key} 必须为布尔值。\\\\\\')\\\\n        elif key in STRINGS:\\\\n            if not isinstance(value, str) or len(value) > (6000 if key == \\\\\\'prompt\\\\\\' else 2048):\\\\n                raise ValueError(f\\\\\\'{key} 不是有效的短文本。\\\\\\')\\\\n        elif key == \\\\\\'style_scale\\\\\\':\\\\n            if type(value) not in (int, float) or not .1 <= value <= 1:\\\\n                raise ValueError(\\\\\\'风格强度应在 0.1 与 1 之间。\\\\\\')\\\\n        elif key in {\\\\\\'cursor\\\\\\'}:\\\\n            continue\\\\n        else:\\\\n            raise ValueError(f\\\\\\'未知控制字段：{key}\\\\\\')\\\\n        if key in CHOICES and value not in CHOICES[key]:\\\\n            raise ValueError(f\\\\\\'{key} 选项无效。\\\\\\')\\\\n        result[key] = value\\\\n    return result\\\\n\\\\n\\\\ndef action_code(source, parameters):\\\\n    \"\"\"Replace only known top-level notebook defaults, never execute browser-supplied code.\"\"\"\\\\n    tree = ast.parse(source)\\\\n    found = set()\\\\n    for node in tree.body:\\\\n        if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):\\\\n            name = node.targets[0].id\\\\n            if name in parameters:\\\\n                node.value = ast.Constant(parameters[name])\\\\n                found.add(name)\\\\n    if found != set(parameters):\\\\n        raise ValueError(\\\\\\'操作参数与冻结的操作代码不匹配。\\\\\\')\\\\n\\\\n    class NoAutomaticDownloads(ast.NodeTransformer):\\\\n        def visit_Expr(self, node):\\\\n            call = node.value\\\\n            if (isinstance(call, ast.Call) and isinstance(call.func, ast.Attribute)\\\\n                    and isinstance(call.func.value, ast.Name) and call.func.value.id == \\\\\\'files\\\\\\'\\\\n                    and call.func.attr == \\\\\\'download\\\\\\'):\\\\n                return ast.copy_location(ast.Pass(), node)\\\\n            return self.generic_visit(node)\\\\n    tree = NoAutomaticDownloads().visit(tree)\\\\n    return compile(ast.fix_missing_locations(tree), \\\\\\'owned-notebook-operation\\\\\\', \\\\\\'exec\\\\\\')\\\\n\\\\n\\\\nclass ConsoleController:\\\\n    def __init__(self, directory, programs, scope=None, release_callback=None):\\\\n        self.directory = Path(directory)\\\\n        self.directory.mkdir(parents=True, exist_ok=True)\\\\n        self.programs = dict(programs)\\\\n        self.scope = scope if scope is not None else {}\\\\n        self.scope[\\\\\\'PROJECT_DIR\\\\\\'] = self.directory\\\\n        self.scope[\\\\\\'dashboard\\\\\\'] = self\\\\n        self.scope[\\\\\\'print\\\\\\'] = self._print\\\\n        self.scope.update(StatusCard=ui.StatusCard, elapsed_text=ui.elapsed_text, log_tail=ui.log_tail,\\\\n                          run_logged=ui.run_logged, json_probe=ui.json_probe, os=os, sys=sys, json=json, Path=Path)\\\\n        self.lock = threading.RLock()\\\\n        self.executor = ThreadPoolExecutor(max_workers=3, thread_name_prefix=\\\\\\'h3-console\\\\\\')\\\\n        self.operations = {}\\\\n        self.active = {}\\\\n        self.finished = {}\\\\n        self.cancel_startup = threading.Event()\\\\n        self.startup_stage = None\\\\n        self.startup_delivery = None\\\\n        self._bootstrap_hosts = {}\\\\n        self.requested_options = {}\\\\n        self.processes = {}\\\\n        self.process_owners = {}\\\\n        self.closed = False\\\\n        self.epoch = None\\\\n        self.activity = None\\\\n        self._last_activity = None\\\\n        self.notice = None\\\\n        self.release_callback = release_callback\\\\n        self.audit_path = self.directory / \\\\\\'console-events.jsonl\\\\\\'\\\\n        self.log_path = self.directory / \\\\\\'console.log\\\\\\'\\\\n        ui._dashboard = self\\\\n        ui._process_observer = self\\\\n\\\\n    def _secrets(self):\\\\n        host = self.scope.get(\\\\\\'startup_host\\\\\\')\\\\n        return [getattr(host, \\\\\\'api_key\\\\\\', \\\\\\'\\\\\\'), getattr(host, \\\\\\'_control_key\\\\\\', \\\\\\'\\\\\\'), self.scope.get(\\\\\\'API_KEY\\\\\\', \\\\\\'\\\\\\') or \\\\\\'\\\\\\',\\\\n                self.scope.get(\\\\\\'BOOTSTRAP_API_KEY\\\\\\', \\\\\\'\\\\\\') or \\\\\\'\\\\\\']\\\\n\\\\n    def _clean(self, value):\\\\n        return ui.redact_text(str(value), secrets=self._secrets())\\\\n\\\\n    def _sanitize(self, value):\\\\n        if isinstance(value, str):\\\\n            return self._clean(value)\\\\n        if isinstance(value, dict):\\\\n            return {key: self._sanitize(item) for key, item in value.items()}\\\\n        if isinstance(value, (list, tuple)):\\\\n            return [self._sanitize(item) for item in value]\\\\n        return value\\\\n\\\\n    def _event(self, kind, **values):\\\\n        record = {\\\\\\'type\\\\\\': kind, \\\\\\'observed_at\\\\\\': time.time(), **values}\\\\n        with self.lock:\\\\n            with self.audit_path.open(\\\\\\'a\\\\\\', encoding=\\\\\\'utf-8\\\\\\') as stream:\\\\n                stream.write(self._clean(json.dumps(record, ensure_ascii=False)) + \\\\\\'\\\\\\\\n\\\\\\')\\\\n\\\\n    def _print(self, *values, sep=\\\\\\' \\\\\\', end=\\\\\\'\\\\\\\\n\\\\\\', **kwargs):\\\\n        text = self._clean(sep.join(str(v) for v in values))\\\\n        stamp = time.strftime(\\\\\\'%m-%d %H:%M:%S\\\\\\', time.gmtime(time.time() + 8 * 3600))\\\\n        with self.lock:\\\\n            with self.log_path.open(\\\\\\'a\\\\\\', encoding=\\\\\\'utf-8\\\\\\') as stream:\\\\n                stream.write(\\\\\\'[\\\\\\' + stamp + \\\\\\' 北京时间] \\\\\\' + text + end)\\\\n\\\\n    def refresh(self):\\\\n        \"\"\"StatusCard sink: update data and log, never create a notebook output.\"\"\"\\\\n        item = self.activity or {}\\\\n        marker = json.dumps(item, sort_keys=True, ensure_ascii=False)\\\\n        if marker != self._last_activity:\\\\n            self._last_activity = marker\\\\n            self._print(item.get(\\\\\\'title\\\\\\', \\\\\\'\\\\\\'), item.get(\\\\\\'badge\\\\\\', \\\\\\'\\\\\\'), item.get(\\\\\\'note\\\\\\', \\\\\\'\\\\\\'))\\\\n\\\\n    def process_started(self, process):\\\\n        owner = None\\\\n        if type(getattr(process, \\\\\\'pid\\\\\\', None)) is int:\\\\n            from process_owner import ProcessOwner\\\\n            owner = ProcessOwner(process)\\\\n        with self.lock:\\\\n            self.processes[threading.get_ident()] = process\\\\n            if owner is not None:\\\\n                self.process_owners[id(process)] = (owner, threading.get_ident())\\\\n            cancelled = any(record.get(\\\\\\'thread_id\\\\\\') == threading.get_ident()\\\\n                            and (record.get(\\\\\\'cancel_monitor\\\\\\') or record.get(\\\\\\'cancel_requested\\\\\\'))\\\\n                            for record in self.active.values())\\\\n        if cancelled:\\\\n            self._terminate_client_process(process)\\\\n\\\\n    def process_progress(self, process):\\\\n        with self.lock:\\\\n            entry = self.process_owners.get(id(process))\\\\n        if entry:\\\\n            entry[0].observe()  # Capture descendants before wrappers exit.\\\\n\\\\n    def process_finished(self, process):\\\\n        with self.lock:\\\\n            entry = self.process_owners.get(id(process))\\\\n        if entry:\\\\n            state = entry[0].observe()\\\\n            if not state[\\\\\\'cleanup_complete\\\\\\']:\\\\n                state = entry[0].terminate_all(timeout=10)\\\\n            self._event(\\\\\\'client.process_cleanup\\\\\\', **state)\\\\n            if not state[\\\\\\'cleanup_complete\\\\\\']:\\\\n                raise RuntimeError(\\\\\\'安装或客户端的子进程树尚未确认退出；请停止后检查日志。\\\\\\')\\\\n        with self.lock:\\\\n            self.process_owners.pop(id(process), None)\\\\n            if self.processes.get(threading.get_ident()) is process:\\\\n                self.processes.pop(threading.get_ident(), None)\\\\n\\\\n    def _terminate_client_process(self, process):\\\\n        with self.lock:\\\\n            entry = self.process_owners.get(id(process))\\\\n        if entry:\\\\n            state = entry[0].terminate_all(timeout=10)\\\\n            self._event(\\\\\\'client.process_cleanup\\\\\\', **state)\\\\n            if not state[\\\\\\'cleanup_complete\\\\\\']:\\\\n                raise RuntimeError(\\\\\\'子进程树仍未退出；未声明停止或释放完成。\\\\\\')\\\\n        elif process.poll() is None:\\\\n            process.terminate()\\\\n            try:\\\\n                process.wait(timeout=10)\\\\n            except Exception:\\\\n                process.kill()\\\\n                process.wait(timeout=5)\\\\n\\\\n    def _stop_client_monitor(self):\\\\n        with self.lock:\\\\n            active = self.active.get(\\\\\\'generate\\\\\\')\\\\n            if active:\\\\n                active[\\\\\\'cancel_monitor\\\\\\'] = True\\\\n            process = self.processes.get(active.get(\\\\\\'thread_id\\\\\\')) if active else None\\\\n        if process is not None and process.poll() is None:\\\\n            self._terminate_client_process(process)\\\\n            self._event(\\\\\\'client.monitor_stopped\\\\\\', request_id=active[\\\\\\'request_id\\\\\\'])\\\\n\\\\n    def _execute(self, name, parameters=None):\\\\n        exec(action_code(self.programs[name], parameters or {}), self.scope)\\\\n\\\\n    def _configuration(self, payload):\\\\n        self.requested_options = {name: payload.get(name, \\\\\\'none\\\\\\') for name in (\\\\\\'acceleration\\\\\\', \\\\\\'style\\\\\\')}\\\\n        self._execute(\\\\\\'advanced\\\\\\', {\\\\\\'ACCELERATION_LORA\\\\\\': payload.get(\\\\\\'acceleration\\\\\\', \\\\\\'none\\\\\\'),\\\\n            \\\\\\'STYLE_LORA\\\\\\': payload.get(\\\\\\'style\\\\\\', \\\\\\'none\\\\\\'), \\\\\\'STYLE_LORA_SCALE\\\\\\': payload.get(\\\\\\'style_scale\\\\\\', 1.0),\\\\n            \\\\\\'ATTENTION_BACKEND\\\\\\': payload.get(\\\\\\'attention\\\\\\', \\\\\\'auto\\\\\\'), \\\\\\'DENOISER_OFFLOAD\\\\\\': payload.get(\\\\\\'offload\\\\\\', \\\\\\'stream\\\\\\')})\\\\n\\\\n    def _check_startup_cancelled(self):\\\\n        if self.cancel_startup.is_set():\\\\n            raise OperationCancelled(\\\\\\'启动已取消；不再进入后续阶段。\\\\\\')\\\\n\\\\n    def _startup_stage(self, stage):\\\\n        if self.startup_stage != stage:\\\\n            self.startup_stage = stage\\\\n            self._event(\\\\\\'startup.stage\\\\\\', stage=stage)\\\\n            self._print(STARTUP_LABELS.get(stage, stage))\\\\n\\\\n    def _await_bootstrap(self, host, public):\\\\n        deadline = time.monotonic() + float(getattr(host, \\\\\\'startup_timeout\\\\\\', 3600))\\\\n        interval = max(.01, min(2, float(getattr(host, \\\\\\'poll_interval\\\\\\', 1))))\\\\n        while True:\\\\n            self._check_startup_cancelled()\\\\n            state = host.snapshot()\\\\n            fresh = not state.get(\\\\\\'observation_stale\\\\\\', False)\\\\n            if state.get(\\\\\\'phase\\\\\\') in {\\\\\\'failed\\\\\\', \\\\\\'stopped\\\\\\', \\\\\\'stopping\\\\\\'} or (fresh and state.get(\\\\\\'error\\\\\\')):\\\\n                raise RuntimeError(state.get(\\\\\\'error\\\\\\') or \\\\\\'服务准备未完成；API 可用时仍可查询与取消任务。\\\\\\')\\\\n            api = fresh and state.get(\\\\\\'api_ready\\\\\\') is True and (not public or state.get(\\\\\\'public_api_ready\\\\\\') is True)\\\\n            if api and state.get(\\\\\\'model_ready\\\\\\') is True and state.get(\\\\\\'ready\\\\\\') is True:\\\\n                self._startup_stage(\\\\\\'ready\\\\\\')\\\\n                return\\\\n            self._startup_stage(\\\\\\'awaiting_model\\\\\\' if api else \\\\\\'awaiting_api\\\\\\')\\\\n            if time.monotonic() >= deadline:\\\\n                raise TimeoutError(\\\\\\'等待服务就绪超时；请查看日志。已有任务和后台保留，可查询、取消或停止。\\\\\\')\\\\n            self.cancel_startup.wait(interval)\\\\n\\\\n    def _bootstrap(self, payload):\\\\n        payload = dict(payload, public=payload.get(\\\\\\'public\\\\\\', True))\\\\n        self._check_startup_cancelled()\\\\n        host = self.scope.get(\\\\\\'startup_host\\\\\\')\\\\n        state = host.snapshot() if host else {}\\\\n        public = payload.get(\\\\\\'public\\\\\\', True)\\\\n        if host and any(state.get(name) for name in (\\\\\\'manager_alive\\\\\\', \\\\\\'server_alive\\\\\\', \\\\\\'model_alive\\\\\\', \\\\\\'tunnel_alive\\\\\\')):\\\\n            # A repeated start observes the owned instance; it cannot reinstall or rotate its token.\\\\n            if bool(getattr(host, \\\\\\'public\\\\\\', False)) != public or bool(getattr(host, \\\\\\'staged\\\\\\', False)) != payload.get(\\\\\\'staged\\\\\\', False):\\\\n                raise RuntimeError(\\\\\\'现有实例配置不同；请先停止，再以新配置启动。\\\\\\')\\\\n            self._bind_bootstrap_host(payload[\\\\\\'request_id\\\\\\'], host)\\\\n            return self._await_bootstrap(host, public)\\\\n        clean_terminal = (state.get(\\\\\\'phase\\\\\\') in {\\\\\\'failed\\\\\\', \\\\\\'stopped\\\\\\'} and state.get(\\\\\\'cleanup_complete\\\\\\') is True\\\\n                          and all(state.get(name) is False for name in (\\\\\\'manager_alive\\\\\\', \\\\\\'server_alive\\\\\\', \\\\\\'model_alive\\\\\\', \\\\\\'tunnel_alive\\\\\\'))\\\\n                          and not state.get(\\\\\\'process_observation_errors\\\\\\'))\\\\n        if host and not clean_terminal and (state.get(\\\\\\'observation_stale\\\\\\') or state.get(\\\\\\'phase\\\\\\') != \\\\\\'new\\\\\\'):\\\\n            raise RuntimeError(\\\\\\'旧生命周期尚未确认清理完成；先停止并检查状态。\\\\\\')\\\\n        self.scope.pop(\\\\\\'startup_host\\\\\\', None)\\\\n        self.scope.update(PREFLIGHT_OK=False, INSTALL_OK=False, RESOURCE_REPORT={})\\\\n        self.requested_options = {name: payload.get(name, \\\\\\'none\\\\\\') for name in (\\\\\\'acceleration\\\\\\', \\\\\\'style\\\\\\')}\\\\n        self.scope[\\\\\\'BOOTSTRAP_API_KEY\\\\\\'] = secrets.token_urlsafe(32)\\\\n        self.scope[\\\\\\'API_KEY\\\\\\'] = self.scope[\\\\\\'BOOTSTRAP_API_KEY\\\\\\']\\\\n        self.scope[\\\\\\'BOOTSTRAP_PUBLIC\\\\\\'] = public\\\\n        self._event(\\\\\\'credential.generated\\\\\\', purpose=\\\\\\'public_api\\\\\\')\\\\n        for stage in (\\\\\\'preflight\\\\\\', \\\\\\'install\\\\\\', \\\\\\'start\\\\\\'):\\\\n            self._check_startup_cancelled()\\\\n            self._startup_stage(stage)\\\\n            self._operate(stage, payload)\\\\n            self._check_startup_cancelled()\\\\n            if stage == \\\\\\'preflight\\\\\\' and self.scope.get(\\\\\\'PREFLIGHT_OK\\\\\\') is not True:\\\\n                raise RuntimeError(\\\\\\'资源检查没有提供通过凭据，停止启动。\\\\\\')\\\\n            if stage == \\\\\\'install\\\\\\' and self.scope.get(\\\\\\'INSTALL_OK\\\\\\') is not True:\\\\n                raise RuntimeError(\\\\\\'依赖检查没有提供通过凭据，停止启动。\\\\\\')\\\\n        host = self.scope.get(\\\\\\'startup_host\\\\\\')\\\\n        if not host:\\\\n            raise RuntimeError(\\\\\\'总管理未创建，停止启动。\\\\\\')\\\\n        self._bind_bootstrap_host(payload[\\\\\\'request_id\\\\\\'], host)\\\\n        return self._await_bootstrap(host, public)\\\\n\\\\n    def _bind_bootstrap_host(self, request_id, host):\\\\n        \"\"\"Bind observations to the owner accepted by this bootstrap request.\"\"\"\\\\n        instance_id = getattr(host, \\\\\\'instance_id\\\\\\', None)\\\\n        with self.lock:\\\\n            operation = self.operations.get(request_id)\\\\n            if not instance_id or not operation or operation.get(\\\\\\'action\\\\\\') != \\\\\\'bootstrap\\\\\\':\\\\n                raise RuntimeError(\\\\\\'启动请求与实例绑定无效。\\\\\\')\\\\n            previous = self._bootstrap_hosts.get(request_id)\\\\n            if previous and (previous[0] is not host or previous[1] != instance_id):\\\\n                raise RuntimeError(\\\\\\'启动请求不能更换已绑定实例。\\\\\\')\\\\n            self._bootstrap_hosts[request_id] = (host, instance_id)\\\\n            operation[\\\\\\'instance_id\\\\\\'] = instance_id\\\\n        self._event(\\\\\\'startup.host_bound\\\\\\', request_id=request_id, instance_id=instance_id)\\\\n\\\\n    def _cancel_bootstrap_and_wait(self):\\\\n        with self.lock:\\\\n            record = self.active.get(\\\\\\'setup\\\\\\')\\\\n            if not record or record[\\\\\\'action\\\\\\'] != \\\\\\'bootstrap\\\\\\':\\\\n                return\\\\n            record[\\\\\\'cancel_requested\\\\\\'] = True\\\\n            self.cancel_startup.set()\\\\n            process = self.processes.get(record.get(\\\\\\'thread_id\\\\\\'))\\\\n            finished = self.finished[record[\\\\\\'request_id\\\\\\']]\\\\n        self._event(\\\\\\'startup.cancel_requested\\\\\\', request_id=record[\\\\\\'request_id\\\\\\'])\\\\n        if process is not None:\\\\n            self._terminate_client_process(process)\\\\n        # Join before stopping the owner: a late start must not resurrect a released service.\\\\n        if not finished.wait(60):\\\\n            raise TimeoutError(\\\\\\'启动步骤尚未退出；未声明停止或释放完成，请检查日志后重试。\\\\\\')\\\\n\\\\n    def begin_startup_delivery(self, request_id, timeout):\\\\n        \"\"\"Observe delivery on the calling cell; never schedule dependent work.\"\"\"\\\\n        if isinstance(timeout, bool) or not isinstance(timeout, (int, float)) or not math.isfinite(timeout) or not 0 < timeout <= 600:\\\\n            raise ValueError(\\\\\\'启动交付观察时间须为 0 到 600 秒之间的有限数值。\\\\\\')\\\\n        with self.lock:\\\\n            self.startup_delivery = {\\\\\\'request_id\\\\\\': request_id, \\\\\\'status\\\\\\': \\\\\\'observing\\\\\\', \\\\\\'active\\\\\\': True,\\\\n                \\\\\\'started_at\\\\\\': time.time(), \\\\\\'deadline_at\\\\\\': time.time() + timeout, \\\\\\'timeout_seconds\\\\\\': timeout,\\\\n                \\\\\\'instance_id\\\\\\': None, \\\\\\'last_observed_at\\\\\\': None, \\\\\\'api_ready\\\\\\': False, \\\\\\'model_ready\\\\\\': False,\\\\n                \\\\\\'cleanup_complete\\\\\\': None}\\\\n        self._event(\\\\\\'startup.delivery_started\\\\\\', request_id=request_id, timeout_seconds=timeout,\\\\n                    dependency=\\\\\\'current_instance_api_and_selected_public_api; model_ready_not_required\\\\\\')\\\\n        self._print(\\\\\\'正在交付独立 API；最多观察\\\\\\', timeout,\\\\n                    \\\\\\'秒，不等待模型。观察期间请用 Colab 本单元的停止按钮取消，程序会回收已启动进程。\\\\\\')\\\\n\\\\n    def wait_startup_delivery(self, request_id, *, publish=None):\\\\n        \"\"\"A bounded foreground handoff, independent from model preparation.\\\\n\\\\n        Expiry only ends observation and retains the worker/owner. Interrupting\\\\n        the cell explicitly cancels startup, joins it, then reclaims its owned\\\\n        processes through the same audited stop path as the control panel.\\\\n        \"\"\"\\\\n        delivery = self.startup_delivery\\\\n        if not delivery or delivery[\\\\\\'request_id\\\\\\'] != request_id or not delivery[\\\\\\'active\\\\\\']:\\\\n            raise RuntimeError(\\\\\\'启动交付观察身份不匹配。\\\\\\')\\\\n        deadline = time.monotonic() + delivery[\\\\\\'timeout_seconds\\\\\\']\\\\n        status, error, last_publish = \\\\\\'observation_failed\\\\\\', None, -float(\\\\\\'inf\\\\\\')\\\\n        def update():\\\\n            nonlocal last_publish\\\\n            if publish:\\\\n                try:\\\\n                    publish()\\\\n                except Exception as caught:\\\\n                    self._print(\\\\\\'启动快照显示未更新：\\\\\\', type(caught).__name__)\\\\n            last_publish = time.monotonic()\\\\n        try:\\\\n            while True:\\\\n                with self.lock:\\\\n                    record = dict(self.operations.get(request_id) or {})\\\\n                    binding = self._bootstrap_hosts.get(request_id)\\\\n                if self.cancel_startup.is_set() or record.get(\\\\\\'status\\\\\\') == \\\\\\'cancelled\\\\\\':\\\\n                    status = \\\\\\'cancelled\\\\\\'\\\\n                    break\\\\n                host, expected = binding if binding else (None, None)\\\\n                # An upgraded controller can still hold a clean, stopped host\\\\n                # while its new worker validates and replaces it. That previous\\\\n                # owner\\\\\\'s terminal state cannot finish this request\\\\\\'s handoff.\\\\n                if (host is not None and self.scope.get(\\\\\\'startup_host\\\\\\') is host\\\\n                        and getattr(host, \\\\\\'instance_id\\\\\\', None) == expected):\\\\n                    state = host.snapshot()\\\\n                    same = bool(expected and state.get(\\\\\\'instance_id\\\\\\') == expected)\\\\n                    fresh = same and state.get(\\\\\\'observation_stale\\\\\\') is False\\\\n                    selected_public = bool(getattr(host, \\\\\\'public\\\\\\', False))\\\\n                    with self.lock:\\\\n                        delivery.update(instance_id=expected, last_observed_at=state.get(\\\\\\'observed_at\\\\\\'),\\\\n                                        api_ready=bool(fresh and state.get(\\\\\\'api_ready\\\\\\') is True),\\\\n                                        model_ready=bool(fresh and state.get(\\\\\\'model_ready\\\\\\') is True))\\\\n                    if fresh and state.get(\\\\\\'api_ready\\\\\\') is True and (not selected_public or state.get(\\\\\\'public_api_ready\\\\\\') is True):\\\\n                        status = \\\\\\'api_ready\\\\\\'\\\\n                        break\\\\n                    if same and state.get(\\\\\\'phase\\\\\\') in {\\\\\\'failed\\\\\\', \\\\\\'stopped\\\\\\', \\\\\\'stopping\\\\\\'}:\\\\n                        status, error = \\\\\\'failed\\\\\\', state.get(\\\\\\'error\\\\\\') or \\\\\\'启动生命周期已结束\\\\\\'\\\\n                        break\\\\n                if record.get(\\\\\\'status\\\\\\') == \\\\\\'failed\\\\\\':\\\\n                    status, error = \\\\\\'failed\\\\\\', record.get(\\\\\\'error\\\\\\') or \\\\\\'启动未完成\\\\\\'\\\\n                    break\\\\n                if time.monotonic() >= deadline:\\\\n                    status = \\\\\\'observation_expired\\\\\\'\\\\n                    break\\\\n                if time.monotonic() - last_publish >= 2:\\\\n                    update()\\\\n                self.cancel_startup.wait(min(.2, max(0, deadline - time.monotonic())))\\\\n        except KeyboardInterrupt:\\\\n            status, error = self._interrupt_delivery(delivery, publish=update)\\\\n            raise\\\\n        except Exception as caught:\\\\n            error = str(caught)\\\\n            self._print(\\\\\\'启动交付观察未完成；后台所有权保留：\\\\\\', caught)\\\\n        finally:\\\\n            with self.lock:\\\\n                delivery.update(status=status, active=False, finished_at=time.time())\\\\n                if error:\\\\n                    delivery[\\\\\\'error\\\\\\'] = self._clean(error)[:500]\\\\n            self._event(\\\\\\'startup.delivery_finished\\\\\\', **dict(delivery))\\\\n            messages = {\\\\\\'api_ready\\\\\\': \\\\\\'API 交付已确认；模型可继续下载，任务按实际就绪条件处理。\\\\\\',\\\\n                        \\\\\\'observation_expired\\\\\\': \\\\\\'前台观察到期；后台仍受管，面板可继续查询、取消启动或停止。\\\\\\',\\\\n                        \\\\\\'cancelled\\\\\\': \\\\\\'启动交付观察已取消；进程清理以停止回执为准。\\\\\\',\\\\n                        \\\\\\'failed\\\\\\': \\\\\\'启动未完成；控制器及已有后台保留，查看日志后处理。\\\\\\',\\\\n                        \\\\\\'interrupted\\\\\\': \\\\\\'启动已中断，所拥有进程清理已确认。\\\\\\',\\\\n                        \\\\\\'interrupted_cleanup_unconfirmed\\\\\\': \\\\\\'启动已中断，但清理未确认；继续保留所有权。\\\\\\'}\\\\n            self._print(messages.get(status, \\\\\\'前台观察已结束；继续通过面板查询实际状态。\\\\\\'))\\\\n            update()\\\\n        return dict(delivery)\\\\n\\\\n    def _interrupt_delivery(self, delivery, *, publish=None):\\\\n        self.cancel_startup.set()\\\\n        with self.lock:\\\\n            delivery.update(status=\\\\\\'cancelling\\\\\\', deadline_at=time.time() + 90)\\\\n        self._event(\\\\\\'startup.delivery_interrupted\\\\\\', request_id=delivery[\\\\\\'request_id\\\\\\'])\\\\n        self._print(\\\\\\'收到停止本单元请求，正在取消启动并回收已拥有的进程。\\\\\\')\\\\n        try:\\\\n            if publish:\\\\n                publish()\\\\n        except BaseException:\\\\n            pass  # Another interrupt/display failure must not skip cleanup.\\\\n        try:\\\\n            self._operate(\\\\\\'stop\\\\\\', {})\\\\n            with self.lock:\\\\n                delivery[\\\\\\'cleanup_complete\\\\\\'] = True\\\\n            return \\\\\\'interrupted\\\\\\', None\\\\n        except BaseException as caught:\\\\n            with self.lock:\\\\n                delivery[\\\\\\'cleanup_complete\\\\\\'] = False\\\\n            self._print(\\\\\\'启动中断后的清理尚未确认；保留控制器，请继续查询或停止：\\\\\\', caught)\\\\n            return \\\\\\'interrupted_cleanup_unconfirmed\\\\\\', str(caught)\\\\n\\\\n    def _operate(self, action, payload):\\\\n        if action == \\\\\\'bootstrap\\\\\\':\\\\n            return self._bootstrap(payload)\\\\n        if action == \\\\\\'preflight\\\\\\':\\\\n            return self._execute(\\\\\\'preflight\\\\\\', {\\\\\\'STAGED_BF16\\\\\\': payload.get(\\\\\\'staged\\\\\\', False),\\\\n                                             \\\\\\'MODEL_ALREADY_CACHED\\\\\\': payload.get(\\\\\\'cached\\\\\\', False)})\\\\n        if action == \\\\\\'install\\\\\\':\\\\n            self._configuration(payload)\\\\n            return self._execute(\\\\\\'install\\\\\\')\\\\n        if action == \\\\\\'start\\\\\\':\\\\n            self._configuration(payload)\\\\n            return self._execute(\\\\\\'start\\\\\\', {\\\\\\'START_GPU_API\\\\\\': True, \\\\\\'OPEN_PUBLIC_API\\\\\\': payload.get(\\\\\\'public\\\\\\', False)})\\\\n        if action == \\\\\\'generate\\\\\\':\\\\n            host = self.scope.get(\\\\\\'startup_host\\\\\\')\\\\n            state = host.snapshot() if host else {}\\\\n            self.scope[\\\\\\'PUBLIC_API_URL\\\\\\'] = state.get(\\\\\\'public_url\\\\\\') if state.get(\\\\\\'public_api_ready\\\\\\') else None\\\\n            return self._execute(\\\\\\'generate\\\\\\', {\\\\\\'RUN_SMOKE_TEST\\\\\\': True,\\\\n                \\\\\\'验收接口\\\\\\': \\\\\\'本机API\\\\\\' if payload.get(\\\\\\'endpoint\\\\\\') == \\\\\\'local\\\\\\' else \\\\\\'临时公网\\\\\\',\\\\n                \\\\\\'RESUME_JOB_ID\\\\\\': payload.get(\\\\\\'resume_job_id\\\\\\', \\\\\\'\\\\\\').strip(),\\\\n                \\\\\\'TEST_REFERENCE_FILE\\\\\\': payload.get(\\\\\\'reference_file\\\\\\', \\\\\\'\\\\\\'), \\\\\\'TEST_PROMPT\\\\\\': payload.get(\\\\\\'prompt\\\\\\', \\\\\\'\\\\\\')})\\\\n        if action in {\\\\\\'stop\\\\\\', \\\\\\'release\\\\\\'}:\\\\n            self._cancel_bootstrap_and_wait()\\\\n            self._stop_client_monitor()\\\\n            with self.lock:\\\\n                remaining = list(self.process_owners.values())\\\\n            for owner, _ in remaining:\\\\n                state = owner.terminate_all(timeout=10)\\\\n                self._event(\\\\\\'client.process_cleanup\\\\\\', **state)\\\\n                if not state[\\\\\\'cleanup_complete\\\\\\']:\\\\n                    raise RuntimeError(\\\\\\'仍有客户端子进程，不能声明停止或释放完成。\\\\\\')\\\\n                with self.lock:\\\\n                    self.process_owners.pop(id(owner.process), None)\\\\n            self._execute(\\\\\\'stop\\\\\\', {\\\\\\'STOP_SERVER\\\\\\': True, \\\\\\'RELEASE_COLAB_RUNTIME\\\\\\': False})\\\\n            if action == \\\\\\'release\\\\\\':\\\\n                self._event(\\\\\\'runtime.release_requested\\\\\\')\\\\n                if self.release_callback:\\\\n                    self.release_callback()\\\\n                else:\\\\n                    from google.colab import runtime\\\\n                    runtime.unassign()\\\\n            return\\\\n        if action == \\\\\\'control\\\\\\':\\\\n            host = self.scope.get(\\\\\\'startup_host\\\\\\')\\\\n            if not host:\\\\n                raise RuntimeError(\\\\\\'尚未启动总管理。\\\\\\')\\\\n            command = payload.get(\\\\\\'action\\\\\\')\\\\n            if command == \\\\\\'query\\\\\\':\\\\n                if not payload.get(\\\\\\'command_id\\\\\\', \\\\\\'\\\\\\').strip():\\\\n                    raise ValueError(\\\\\\'先填写命令 ID。\\\\\\')\\\\n                result = host.command(payload[\\\\\\'command_id\\\\\\'].strip())\\\\n            elif command in {\\\\\\'drain\\\\\\', \\\\\\'resume\\\\\\', \\\\\\'stop_model\\\\\\', \\\\\\'start_model\\\\\\', \\\\\\'stop_api\\\\\\', \\\\\\'start_api\\\\\\'}:\\\\n                result = host.control(command, force=payload.get(\\\\\\'force\\\\\\', False))\\\\n            else:\\\\n                raise ValueError(\\\\\\'组件控制动作无效。\\\\\\')\\\\n            self._print(json.dumps(result, ensure_ascii=False))\\\\n            return result\\\\n        raise ValueError(\\\\\\'未知操作。\\\\\\')\\\\n\\\\n    def _worker(self, record, lane, action, payload):\\\\n        with self.lock:\\\\n            record.update(status=\\\\\\'running\\\\\\', started_at=time.time(), thread_id=threading.get_ident())\\\\n        self._event(\\\\\\'operation.started\\\\\\', action=action, request_id=record[\\\\\\'request_id\\\\\\'])\\\\n        try:\\\\n            result = self._operate(action, payload)\\\\n            if action == \\\\\\'bootstrap\\\\\\':\\\\n                self._check_startup_cancelled()\\\\n            with self.lock:\\\\n                record.update(status=\\\\\\'succeeded\\\\\\', finished_at=time.time())\\\\n                if isinstance(result, dict):\\\\n                    record[\\\\\\'command\\\\\\'] = {k: result[k] for k in (\\\\\\'command_id\\\\\\', \\\\\\'status\\\\\\') if k in result}\\\\n                message = (\\\\\\'已发起平台释放；是否完成以 Colab 断开为准。\\\\\\' if action == \\\\\\'release\\\\\\'\\\\n                           else \\\\\\'操作已完成。\\\\\\' if action != \\\\\\'control\\\\\\' else \\\\\\'命令回执已记录；接收不等于执行完成。\\\\\\')\\\\n                self.notice = None\\\\n                self._print(ACTION_TITLES[action], message)\\\\n        except BaseException as error:\\\\n            cancelled = action == \\\\\\'bootstrap\\\\\\' and self.cancel_startup.is_set()\\\\n            if action == \\\\\\'bootstrap\\\\\\':\\\\n                self._startup_stage(\\\\\\'cancelled\\\\\\' if cancelled else \\\\\\'failed\\\\\\')\\\\n            self._print(str(error) if cancelled else traceback.format_exc())\\\\n            with self.lock:\\\\n                record.update(status=\\\\\\'cancelled\\\\\\' if cancelled else \\\\\\'failed\\\\\\', finished_at=time.time(), error=self._clean(error)[:500])\\\\n                if not cancelled:\\\\n                    self.notice = {\\\\\\'id\\\\\\': record[\\\\\\'request_id\\\\\\'], \\\\\\'kind\\\\\\': \\\\\\'error\\\\\\', \\\\\\'title\\\\\\': ACTION_TITLES[action] + \\\\\\'未完成\\\\\\',\\\\n                                   \\\\\\'message\\\\\\': self._clean(error)[:500]}\\\\n        finally:\\\\n            self._event(\\\\\\'operation.finished\\\\\\', action=action, request_id=record[\\\\\\'request_id\\\\\\'], status=record[\\\\\\'status\\\\\\'])\\\\n            with self.lock:\\\\n                self.active.pop(lane, None)\\\\n                self.processes.pop(threading.get_ident(), None)\\\\n                self.finished[record[\\\\\\'request_id\\\\\\']].set()\\\\n\\\\n    def submit(self, action, payload):\\\\n        request_id = payload.get(\\\\\\'request_id\\\\\\')\\\\n        if not request_id or len(request_id) > 128:\\\\n            raise ValueError(\\\\\\'操作必须携带唯一 request_id。\\\\\\')\\\\n        fingerprint = hashlib.sha256(json.dumps([action, payload], sort_keys=True).encode()).hexdigest()\\\\n        lane = \\\\\\'generate\\\\\\' if action == \\\\\\'generate\\\\\\' else \\\\\\'control\\\\\\' if action in {\\\\\\'stop\\\\\\', \\\\\\'release\\\\\\', \\\\\\'control\\\\\\'} else \\\\\\'setup\\\\\\'\\\\n        with self.lock:\\\\n            if self.closed:\\\\n                raise RuntimeError(\\\\\\'控制台已关闭。\\\\\\')\\\\n            previous = self.operations.get(request_id)\\\\n            if previous:\\\\n                if previous[\\\\\\'fingerprint\\\\\\'] != fingerprint:\\\\n                    raise ValueError(\\\\\\'同一请求 ID 的内容发生变化。\\\\\\')\\\\n                return dict(previous)\\\\n            setup = self.active.get(\\\\\\'setup\\\\\\')\\\\n            setup_allows_control = setup and setup[\\\\\\'action\\\\\\'] == \\\\\\'bootstrap\\\\\\' and (\\\\n                action in {\\\\\\'stop\\\\\\', \\\\\\'release\\\\\\'} or self.startup_stage in {\\\\\\'awaiting_api\\\\\\', \\\\\\'awaiting_model\\\\\\', \\\\\\'ready\\\\\\'})\\\\n            if lane in self.active or (setup and not setup_allows_control) or (lane == \\\\\\'setup\\\\\\' and self.active):\\\\n                raise RuntimeError(\\\\\\'相关操作尚在执行；可继续观察日志，不重复提交。\\\\\\')\\\\n            if action == \\\\\\'bootstrap\\\\\\':\\\\n                self.cancel_startup.clear()\\\\n                self.notice = None\\\\n            record = {\\\\\\'request_id\\\\\\': request_id, \\\\\\'action\\\\\\': action, \\\\\\'status\\\\\\': \\\\\\'accepted\\\\\\',\\\\n                      \\\\\\'accepted_at\\\\\\': time.time(), \\\\\\'fingerprint\\\\\\': fingerprint}\\\\n            self.operations[request_id] = record\\\\n            self.active[lane] = record\\\\n            self.finished[request_id] = threading.Event()\\\\n            self._event(\\\\\\'operation.accepted\\\\\\', action=action, request_id=request_id, fingerprint=fingerprint)\\\\n            self.executor.submit(self._worker, record, lane, action, payload)\\\\n            return dict(record)\\\\n\\\\n    def _connection_context(self, state=None):\\\\n        host = self.scope.get(\\\\\\'startup_host\\\\\\')\\\\n        with self.lock:\\\\n            preparing = (self.startup_stage in {\\\\\\'preflight\\\\\\', \\\\\\'install\\\\\\', \\\\\\'start\\\\\\'}\\\\n                         and any(r[\\\\\\'action\\\\\\'] == \\\\\\'bootstrap\\\\\\' for r in self.active.values()))\\\\n        if preparing:\\\\n            host, state = None, {}\\\\n        if state is None:\\\\n            state = host.snapshot() if host else {}\\\\n        if state.get(\\\\\\'instance_id\\\\\\') and state[\\\\\\'instance_id\\\\\\'] != getattr(host, \\\\\\'instance_id\\\\\\', None):\\\\n            state = {}  # A read raced with replacement of the owned lifecycle.\\\\n        key = getattr(host, \\\\\\'api_key\\\\\\', None) or self.scope.get(\\\\\\'BOOTSTRAP_API_KEY\\\\\\')\\\\n        public = bool(state.get(\\\\\\'public_requested\\\\\\', self.scope.get(\\\\\\'BOOTSTRAP_PUBLIC\\\\\\', False)))\\\\n        fresh = not state.get(\\\\\\'observation_stale\\\\\\', False)\\\\n        api_ready = state.get(\\\\\\'api_ready\\\\\\') is True and fresh\\\\n        public_ready = api_ready and state.get(\\\\\\'public_api_ready\\\\\\') is True\\\\n        local = \\\\\\'http://127.0.0.1:\\\\\\' + str(getattr(host, \\\\\\'port\\\\\\', 8000)) if api_ready else None\\\\n        candidate = state.get(\\\\\\'public_url\\\\\\') if public else None\\\\n        url = candidate if public_ready else local if not public else None\\\\n        connection = {\\\\\\'url\\\\\\': url, \\\\\\'candidate_url\\\\\\': candidate, \\\\\\'local_url\\\\\\': local,\\\\n                      \\\\\\'api_ready\\\\\\': api_ready, \\\\\\'public_requested\\\\\\': public,\\\\n                      \\\\\\'public_api_ready\\\\\\': public_ready,\\\\n                      \\\\\\'model_ready\\\\\\': state.get(\\\\\\'model_ready\\\\\\') is True and fresh,\\\\n                      \\\\\\'observation_stale\\\\\\': not fresh, \\\\\\'key_available\\\\\\': bool(key),\\\\n                      \\\\\\'credential_id\\\\\\': hashlib.sha256(key.encode()).hexdigest()[:16] if key else None,\\\\n                      \\\\\\'instance_id\\\\\\': getattr(host, \\\\\\'instance_id\\\\\\', None)}\\\\n        return connection, key\\\\n\\\\n    def _downloads(self, state):\\\\n        progress = state.get(\\\\\\'downloads\\\\\\')\\\\n        if isinstance(progress, dict) and progress.get(\\\\\\'schema_version\\\\\\') == 1:\\\\n            return progress\\\\n        items = {}\\\\n        for name, variable in ((\\\\\\'model\\\\\\', None), (\\\\\\'acceleration\\\\\\', \\\\\\'ACCELERATION_LORA\\\\\\'), (\\\\\\'style\\\\\\', \\\\\\'STYLE_LORA\\\\\\')):\\\\n            selection = self.requested_options.get(name, self.scope.get(variable, \\\\\\'none\\\\\\')) if variable else None\\\\n            phase = \\\\\\'waiting\\\\\\' if name == \\\\\\'model\\\\\\' or selection != \\\\\\'none\\\\\\' else \\\\\\'disabled\\\\\\'\\\\n            items[name] = {\\\\\\'phase\\\\\\': phase, \\\\\\'bytes_completed\\\\\\': 0, \\\\\\'bytes_total\\\\\\': None, \\\\\\'percent\\\\\\': None,\\\\n                           \\\\\\'files_completed\\\\\\': 0, \\\\\\'files_total\\\\\\': None, \\\\\\'active_files\\\\\\': 0,\\\\n                           \\\\\\'scope\\\\\\': \\\\\\'observed_transfers\\\\\\' if name == \\\\\\'model\\\\\\' else \\\\\\'asset\\\\\\',\\\\n                           \\\\\\'detail\\\\\\': \\\\\\'等待模型容器提供真实进度\\\\\\' if phase == \\\\\\'waiting\\\\\\' else \\\\\\'未启用\\\\\\'}\\\\n        return {\\\\\\'schema_version\\\\\\': 1, \\\\\\'model_instance_id\\\\\\': None, \\\\\\'observed_at\\\\\\': None,\\\\n                \\\\\\'observation_stale\\\\\\': False, \\\\\\'model_ready\\\\\\': False, \\\\\\'lifecycle\\\\\\': \\\\\\'not_started\\\\\\', \\\\\\'items\\\\\\': items}\\\\n\\\\n    def snapshot(self, source=\\\\\\'diagnostics\\\\\\', *, observe_host=True):\\\\n        host = self.scope.get(\\\\\\'startup_host\\\\\\')\\\\n        for key in self._secrets():\\\\n            if key and key not in ui._known_secrets:\\\\n                ui._known_secrets = (*ui._known_secrets[-4:], key)\\\\n        try:\\\\n            # Mounting the panel must not depend on an API/model RPC response.\\\\n            # The browser requests a fresh observation after the cell returns.\\\\n            state = (host.snapshot() if observe_host else {\\\\\\'observation_stale\\\\\\': True}) if host else {}\\\\n        except Exception as error:\\\\n            state = {\\\\\\'observation_stale\\\\\\': True, \\\\\\'phase\\\\\\': \\\\\\'unavailable\\\\\\'}\\\\n            self._print(\\\\\\'状态读取失败：\\\\\\', error)\\\\n        safe = {k: state[k] for k in SAFE_STATE if k in state}\\\\n        if state.get(\\\\\\'error\\\\\\'):\\\\n            safe[\\\\\\'error\\\\\\'] = self._clean(state[\\\\\\'error\\\\\\'])[:300]\\\\n        if source == \\\\\\'events\\\\\\':\\\\n            text = json.dumps(host.events(limit=35), ensure_ascii=False, indent=2) if host else \\\\\\'尚无运行实例。\\\\\\'\\\\n        elif source in LOG_NAMES:\\\\n            text = ui.log_tail(getattr(host, LOG_NAMES[source]), 16000) if host else \\\\\\'尚无运行实例。\\\\\\'\\\\n        elif source == \\\\\\'install\\\\\\':\\\\n            text = ui.log_tail(self.directory / \\\\\\'install.log\\\\\\', 16000)\\\\n        elif source == \\\\\\'preflight\\\\\\':\\\\n            text = ui.log_tail(self.directory / \\\\\\'preflight.log\\\\\\', 16000)\\\\n        elif source == \\\\\\'state\\\\\\':\\\\n            text = json.dumps(self._sanitize(safe), ensure_ascii=False, indent=2, sort_keys=True) if host else \\\\\\'尚无运行实例。\\\\\\'\\\\n        elif source == \\\\\\'smoke\\\\\\':\\\\n            smoke_log = self.scope.get(\\\\\\'smoke_log\\\\\\')\\\\n            text = (ui.log_tail(smoke_log, 16000) if smoke_log else \\\\\\'\\\\\\') or \\\\\\'暂无生成验收日志。\\\\\\'\\\\n        else:\\\\n            text = ui.log_tail(self.log_path, 10000) + \\\\\\'\\\\\\\\n\\\\\\' + ui.last_diagnostics()[-4000:]\\\\n        with self.lock:\\\\n            active = [{k: v for k, v in record.items() if k not in {\\\\\\'fingerprint\\\\\\', \\\\\\'thread_id\\\\\\'}} for record in self.active.values()]\\\\n            notice = dict(self.notice) if self.notice else None\\\\n        resource = self.scope.get(\\\\\\'RESOURCE_REPORT\\\\\\') or {}\\\\n        bundle = self.scope.get(\\\\\\'bundle\\\\\\')\\\\n        connection, _ = self._connection_context(state)\\\\n        return self._sanitize({\\\\\\'state\\\\\\': safe, \\\\\\'resources\\\\\\': {k: resource[k] for k in (\\\\\\'gpu\\\\\\', \\\\\\'available_ram_gib\\\\\\', \\\\\\'residency\\\\\\') if k in resource},\\\\n                \\\\\\'connection\\\\\\': connection,\\\\n                \\\\\\'downloads\\\\\\': self._downloads(state),\\\\n                \\\\\\'ui\\\\\\': {\\\\\\'connected\\\\\\': not self.closed, \\\\\\'closed\\\\\\': self.closed, \\\\\\'busy\\\\\\': bool(active),\\\\n                       \\\\\\'operation\\\\\\': \\\\\\', \\\\\\'.join(ACTION_TITLES.get(r[\\\\\\'action\\\\\\'], r[\\\\\\'action\\\\\\']) for r in active),\\\\n                       \\\\\\'operations\\\\\\': active, \\\\\\'preflight_ok\\\\\\': self.scope.get(\\\\\\'PREFLIGHT_OK\\\\\\', False),\\\\n                       \\\\\\'install_ok\\\\\\': self.scope.get(\\\\\\'INSTALL_OK\\\\\\', False),\\\\n                       \\\\\\'startup_stage\\\\\\': self.startup_stage,\\\\n                       \\\\\\'startup_delivery\\\\\\': dict(self.startup_delivery) if self.startup_delivery else None,\\\\n                       \\\\\\'bootstrap_running\\\\\\': any(r[\\\\\\'action\\\\\\'] == \\\\\\'bootstrap\\\\\\' for r in active),\\\\n                       \\\\\\'connection_available\\\\\\': connection[\\\\\\'key_available\\\\\\']},\\\\n                \\\\\\'logs\\\\\\': {\\\\\\'text\\\\\\': self._clean(text)[-16000:], \\\\\\'source\\\\\\': source, \\\\\\'observed_at\\\\\\': time.time()},\\\\n                \\\\\\'notice\\\\\\': notice, \\\\\\'result\\\\\\': {\\\\\\'available\\\\\\': bool(bundle and Path(bundle).is_file())}})\\\\n\\\\n    def _download(self, action):\\\\n        if action == \\\\\\'export_connection\\\\\\':\\\\n            connection, key = self._connection_context()\\\\n            if not key:\\\\n                raise RuntimeError(\\\\\\'密钥尚未生成；先执行一键启动。\\\\\\')\\\\n            data = json.dumps({**connection, \\\\\\'api_key\\\\\\': key,\\\\n                               \\\\\\'note\\\\\\': \\\\\\'url 为空时尚不可连接；API 可达后重新导出。模型未就绪时任务只排队。\\\\\\'}, ensure_ascii=False).encode()\\\\n            name, mime = \\\\\\'api-connection.private.json\\\\\\', \\\\\\'application/json\\\\\\'\\\\n        else:\\\\n            path = self.scope.get(\\\\\\'bundle\\\\\\')\\\\n            if not path or not Path(path).is_file():\\\\n                raise RuntimeError(\\\\\\'本次尚无已验证结果包。\\\\\\')\\\\n            path = Path(path)\\\\n            if path.stat().st_size > 32 * 1024**2:\\\\n                raise ValueError(\\\\\\'结果包超过内联下载上限；请使用 Colab 文件栏下载。\\\\\\')\\\\n            data, name, mime = path.read_bytes(), path.name, \\\\\\'application/zip\\\\\\'\\\\n        return {\\\\\\'name\\\\\\': name, \\\\\\'mime\\\\\\': mime, \\\\\\'data_base64\\\\\\': base64.b64encode(data).decode(\\\\\\'ascii\\\\\\')}\\\\n\\\\n    def dispatch(self, action, payload=None):\\\\n        try:\\\\n            payload = validated(payload or {})\\\\n            if self.closed:\\\\n                return {\\\\\\'ui\\\\\\': {\\\\\\'connected\\\\\\': False, \\\\\\'closed\\\\\\': True}, \\\\\\'error\\\\\\': \\\\\\'控制台已关闭。\\\\\\'}\\\\n            if action in {\\\\\\'snapshot\\\\\\', \\\\\\'refresh_board\\\\\\'}:\\\\n                return self.snapshot(payload.get(\\\\\\'source\\\\\\', \\\\\\'diagnostics\\\\\\'))\\\\n            if action == \\\\\\'reveal_connection\\\\\\':\\\\n                result = self.snapshot(payload.get(\\\\\\'source\\\\\\', \\\\\\'diagnostics\\\\\\'))\\\\n                connection, key = self._connection_context()\\\\n                if not key:\\\\n                    raise RuntimeError(\\\\\\'密钥尚未生成；先执行一键启动。\\\\\\')\\\\n                if payload.get(\\\\\\'credential_id\\\\\\') != connection[\\\\\\'credential_id\\\\\\']:\\\\n                    raise RuntimeError(\\\\\\'连接凭据已改变；请刷新看板后重新显示或复制。\\\\\\')\\\\n                result[\\\\\\'connection\\\\\\'] = self._sanitize(connection)\\\\n                # This dedicated user-triggered response is never embedded into saved HTML or logs.\\\\n                result[\\\\\\'connection_secret\\\\\\'] = {\\\\\\'api_key\\\\\\': key, \\\\\\'credential_id\\\\\\': connection[\\\\\\'credential_id\\\\\\']}\\\\n                self._event(\\\\\\'credential.revealed\\\\\\', credential_id=connection[\\\\\\'credential_id\\\\\\'])\\\\n                return result\\\\n            if action in {\\\\\\'export_connection\\\\\\', \\\\\\'download_result\\\\\\'}:\\\\n                result = self.snapshot(payload.get(\\\\\\'source\\\\\\', \\\\\\'diagnostics\\\\\\'))\\\\n                result[\\\\\\'download\\\\\\'] = self._download(action)\\\\n                self._event(\\\\\\'download.prepared\\\\\\', action=action)\\\\n                return result\\\\n            if action not in ACTION_TITLES:\\\\n                raise ValueError(\\\\\\'未知控制动作。\\\\\\')\\\\n            receipt = self.submit(action, payload)\\\\n            return {\\\\\\'accepted\\\\\\': True, \\\\\\'operation\\\\\\': {k: v for k, v in receipt.items() if k not in {\\\\\\'fingerprint\\\\\\', \\\\\\'thread_id\\\\\\'}}}\\\\n        except Exception as error:\\\\n            return {\\\\\\'error\\\\\\': self._clean(error)[:500], \\\\\\'notice\\\\\\': {\\\\\\'id\\\\\\': uuid.uuid4().hex,\\\\n                \\\\\\'kind\\\\\\': \\\\\\'error\\\\\\', \\\\\\'title\\\\\\': \\\\\\'操作未执行\\\\\\', \\\\\\'message\\\\\\': self._clean(error)[:500]}}\\\\n\\\\n    def close(self):\\\\n        with self.lock:\\\\n            if self.active or self.process_owners:\\\\n                raise RuntimeError(\\\\\\'仍有受管操作，不能丢弃控制器。\\\\\\')\\\\n            self.closed = True\\\\n            self.epoch = None\\\\n        self.executor.shutdown(wait=True, cancel_futures=True)\\\\n        if ui._dashboard is self:\\\\n            ui._dashboard = None\\\\n        if getattr(ui, \\\\\\'_process_observer\\\\\\', None) is self:\\\\n            ui._process_observer = None\\\\n        self._event(\\\\\\'console.closed\\\\\\')\\\\n\\\\n\\\\ndef render_console(template, callback_name=\\\\\\'\\\\\\', initial=None):\\\\n    state = initial or {\\\\\\'ui\\\\\\': {\\\\\\'connected\\\\\\': False, \\\\\\'offline\\\\\\': True}, \\\\\\'state\\\\\\': {}, \\\\\\'resources\\\\\\': {},\\\\n                        \\\\\\'logs\\\\\\': {\\\\\\'text\\\\\\': \\\\\\'尚未连接控制台。运行本单元后，日志在这里持续更新。\\\\\\', \\\\\\'source\\\\\\': \\\\\\'diagnostics\\\\\\'}}\\\\n    safe_json = lambda data: json.dumps(data, ensure_ascii=False).replace(\\\\\\'<\\\\\\', \\\\\\'\\\\\\\\\\\\\\\\u003c\\\\\\').replace(\\\\\\'>\\\\\\', \\\\\\'\\\\\\\\\\\\\\\\u003e\\\\\\').replace(\\\\\\'&\\\\\\', \\\\\\'\\\\\\\\\\\\\\\\u0026\\\\\\')\\\\n    return template.replace(\\\\\\'__CALLBACK_NAME__\\\\\\', safe_json(callback_name)).replace(\\\\\\'__INITIAL_STATE__\\\\\\', safe_json(state))\\\\n\\\\n\\\\ndef mount_console(directory, programs, scope=None, *, auto_start=False, bootstrap_payload=None,\\\\n                  foreground_bootstrap_timeout=None):\\\\n    \"\"\"Display the unchanged panel, optionally holding the cell until API delivery.\\\\n\\\\n    The owner still runs independent startup branches concurrently. The finite\\\\n    foreground observer never waits for the model or treats expiry as failure.\\\\n    \"\"\"\\\\n    from google.colab import output\\\\n    from IPython.display import HTML, JSON, display\\\\n    scope = scope if scope is not None else {}\\\\n    controller = scope.get(\\\\\\'h3_console\\\\\\')\\\\n    created = False\\\\n    if not isinstance(controller, ConsoleController) or controller.closed:\\\\n        controller = ConsoleController(directory, programs, scope)\\\\n        scope[\\\\\\'h3_console\\\\\\'] = controller\\\\n        created = True\\\\n    controller.epoch = uuid.uuid4().hex\\\\n    epoch = controller.epoch\\\\n    name = \\\\\\'h3.console.\\\\\\' + epoch\\\\n    def callback(action, payload=None):\\\\n        if controller.epoch != epoch:\\\\n            return JSON({\\\\\\'ui\\\\\\': {\\\\\\'connected\\\\\\': False, \\\\\\'closed\\\\\\': True}, \\\\\\'error\\\\\\': \\\\\\'旧面板已停用。\\\\\\'})\\\\n        return JSON(controller.dispatch(action, payload))\\\\n    output.register_callback(name, callback)\\\\n    template = (Path(directory) / \\\\\\'console.html\\\\\\').read_text(encoding=\\\\\\'utf-8\\\\\\')\\\\n    request_id = \\\\\\'mount-\\\\\\' + epoch\\\\n    foreground = created and auto_start and foreground_bootstrap_timeout is not None\\\\n    active_delivery = lambda: foreground and bool(controller.startup_delivery and controller.startup_delivery.get(\\\\\\'active\\\\\\'))\\\\n    try:\\\\n        if foreground:\\\\n            controller.begin_startup_delivery(request_id, foreground_bootstrap_timeout)\\\\n        initial = HTML(render_console(template, name, controller.snapshot(observe_host=False)))\\\\n        handle = display(initial, display_id=True) if foreground else display(initial)\\\\n        if created and auto_start:\\\\n            payload = {\\\\\\'public\\\\\\': True, **(bootstrap_payload or {}), \\\\\\'request_id\\\\\\': request_id}\\\\n            receipt = controller.dispatch(\\\\\\'bootstrap\\\\\\', payload)\\\\n            if foreground:\\\\n                def publish():\\\\n                    if callable(getattr(handle, \\\\\\'update\\\\\\', None)):\\\\n                        handle.update(HTML(render_console(template, name, controller.snapshot())))\\\\n                if receipt.get(\\\\\\'accepted\\\\\\') is not True:\\\\n                    with controller.lock:\\\\n                        controller.startup_delivery.update(active=False, status=\\\\\\'failed\\\\\\',\\\\n                            error=receipt.get(\\\\\\'error\\\\\\', \\\\\\'启动未被接收\\\\\\'), finished_at=time.time())\\\\n                    publish()\\\\n                else:\\\\n                    controller.wait_startup_delivery(request_id, publish=publish)\\\\n    except KeyboardInterrupt:\\\\n        # Cover the display/dispatch window before wait_startup_delivery owns\\\\n        # interrupts. Its own handler sets active=False, preventing double stop.\\\\n        if active_delivery():\\\\n            status, error = controller._interrupt_delivery(controller.startup_delivery)\\\\n            controller.startup_delivery.update(status=status, error=error, active=False, finished_at=time.time())\\\\n            controller._event(\\\\\\'startup.delivery_finished\\\\\\', **dict(controller.startup_delivery))\\\\n        raise\\\\n    finally:\\\\n        if active_delivery():\\\\n            controller.startup_delivery.update(status=\\\\\\'observation_failed\\\\\\', active=False, finished_at=time.time())\\\\n            controller._event(\\\\\\'startup.delivery_finished\\\\\\', **dict(controller.startup_delivery))\\\\n    return controller\\\\n\\', \\'console.html\\': \\'<!doctype html>\\\\n<html lang=\"zh-CN\">\\\\n<head>\\\\n<meta charset=\"utf-8\">\\\\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\\\\n<title>MiniMax-H3 控制台</title>\\\\n<style>\\\\n:root {\\\\n  color-scheme: light dark;\\\\n  --canvas: #f1f2f5;\\\\n  --panel: #fff;\\\\n  --surface: #f5f5f7;\\\\n  --input: #f7f7f9;\\\\n  --toolbar: #fafafc;\\\\n  --ink: #1d1d1f;\\\\n  --muted: #5f636d;\\\\n  --line: #dedfe5;\\\\n  --edge: #2226341a;\\\\n  --accent: #0065d8;\\\\n  --accent-hover: #005bc4;\\\\n  --tint: #eaf2ff;\\\\n  --ready: #187641;\\\\n  --danger: #b32634;\\\\n  --warn: #80540e;\\\\n  --log: #f7f8fb;\\\\n  --scroll-thumb: #bfc1ca;\\\\n  --shadow: 0 1px 2px #20283a08, 0 5px 14px #20283a0b;\\\\n  --mono: ui-monospace, \"SFMono-Regular\", Consolas, \"Microsoft YaHei\", monospace;\\\\n}\\\\n\\\\n@media (prefers-color-scheme: dark) {\\\\n  :root {\\\\n    --canvas: #16171b;\\\\n    --panel: #222327;\\\\n    --surface: #2b2c31;\\\\n    --input: #292a30;\\\\n    --toolbar: #25262b;\\\\n    --ink: #f2f2f5;\\\\n    --muted: #b3b5bf;\\\\n    --line: #3c3e46;\\\\n    --edge: #ffffff20;\\\\n    --accent: #78b6ff;\\\\n    --accent-hover: #9ac9ff;\\\\n    --tint: #263953;\\\\n    --ready: #73d69a;\\\\n    --danger: #ff9398;\\\\n    --warn: #edc278;\\\\n    --log: #1c1d22;\\\\n    --scroll-thumb: #646773;\\\\n    --shadow: 0 1px 2px #0004, 0 5px 14px #0003;\\\\n  }\\\\n}\\\\n\\\\n* { box-sizing: border-box; }\\\\nbody {\\\\n  margin: 0;\\\\n  color: var(--ink);\\\\n  font: 13px/1.5 -apple-system, BlinkMacSystemFont, \"Segoe UI Variable Text\", \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", system-ui, sans-serif;\\\\n}\\\\nh1, h2, p { margin: 0; }\\\\nbutton, input, textarea, select { font: inherit; }\\\\nbutton, input[type=\"checkbox\"], select, summary { cursor: pointer; }\\\\nbutton {\\\\n  min-height: 33px;\\\\n  padding: 5px 10px;\\\\n  border: 1px solid var(--edge);\\\\n  border-radius: 9px;\\\\n  background: var(--panel);\\\\n  color: var(--ink);\\\\n  font-weight: 600;\\\\n  overflow-wrap: anywhere;\\\\n}\\\\nbutton:hover:not(:disabled) { background: var(--surface); }\\\\nbutton:active:not(:disabled) { box-shadow: inset 0 1px 3px #0002; }\\\\nbutton:disabled { cursor: default; color: var(--muted); opacity: .8; }\\\\nbutton.primary { border-color: transparent; background: var(--accent); color: light-dark(#fff, #102640); }\\\\nbutton.primary:hover:not(:disabled) { background: var(--accent-hover); }\\\\nbutton.primary:disabled { background: var(--tint); color: var(--accent); opacity: 1; }\\\\nbutton.danger { color: var(--danger); }\\\\n:is(button, input, textarea, select, summary, a, .board, .control, .log-viewport):focus-visible {\\\\n  outline: 2px solid var(--accent);\\\\n  outline-offset: 2px;\\\\n}\\\\n:is(.board, .control, .log-viewport):focus-visible { outline-offset: -3px; }\\\\ninput:not([type=\"checkbox\"]), textarea, select {\\\\n  width: 100%;\\\\n  min-width: 0;\\\\n  min-height: 34px;\\\\n  padding: 5px 8px;\\\\n  border: 1px solid var(--line);\\\\n  border-radius: 8px;\\\\n  background: var(--input);\\\\n  color: var(--ink);\\\\n}\\\\ninput::placeholder, textarea::placeholder { color: var(--muted); opacity: 1; }\\\\ntextarea { min-height: 52px; max-height: 112px; resize: vertical; }\\\\ninput[type=\"checkbox\"] {\\\\n  width: 15px;\\\\n  height: 15px;\\\\n  flex: 0 0 auto;\\\\n  margin: 0;\\\\n  accent-color: var(--accent);\\\\n}\\\\nlabel { display: block; color: var(--muted); font-size: 12px; }\\\\nlabel > :is(input, textarea, select) { margin-top: 4px; }\\\\n\\\\n.app {\\\\n  display: grid;\\\\n  grid-template-columns: repeat(2, minmax(0, 1fr));\\\\n  gap: 12px;\\\\n  width: 100%;\\\\n  height: 686px;\\\\n  padding: 10px;\\\\n  border-radius: 22px;\\\\n  background: var(--canvas);\\\\n}\\\\n.left {\\\\n  display: grid;\\\\n  grid-template-rows: 392px minmax(0, 1fr);\\\\n  gap: 12px;\\\\n  min-width: 0;\\\\n  min-height: 0;\\\\n}\\\\n.panel {\\\\n  min-width: 0;\\\\n  min-height: 0;\\\\n  overflow: hidden;\\\\n  border: 1px solid var(--edge);\\\\n  border-radius: 16px;\\\\n  background: var(--panel);\\\\n  box-shadow: var(--shadow);\\\\n}\\\\n.panel-head {\\\\n  display: flex;\\\\n  align-items: center;\\\\n  justify-content: space-between;\\\\n  gap: 8px;\\\\n  flex-shrink: 0;\\\\n  padding: 11px 15px;\\\\n  border-bottom: 1px solid var(--line);\\\\n}\\\\n.panel-head h2 { font-size: 16px; line-height: 1.3; font-weight: 650; }\\\\n.eyebrow { color: var(--muted); font-size: 11px; font-weight: 550; }\\\\n:is(.board, .control, .log-viewport, .notice-zone) {\\\\n  scrollbar-width: thin;\\\\n  scrollbar-color: var(--scroll-thumb) transparent;\\\\n}\\\\n\\\\n.board {\\\\n  display: flex;\\\\n  flex-direction: column;\\\\n  padding: 12px 15px 10px;\\\\n  overflow-y: auto;\\\\n  overscroll-behavior: contain;\\\\n  scrollbar-gutter: stable;\\\\n}\\\\n.board-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }\\\\n.board-top > div { min-width: 0; }\\\\n.board h1 { margin-top: 1px; font-size: 22px; line-height: 1.25; font-weight: 650; overflow-wrap: anywhere; }\\\\n.board[data-tone=\"error\"] h1 { color: var(--danger); }\\\\n.board[data-tone=\"warn\"] h1 { color: var(--warn); }\\\\n.board[data-tone=\"ready\"] h1 { color: var(--ready); }\\\\n.board-refresh { min-height: 26px; padding: 3px 8px; flex-shrink: 0; font-size: 11px; }\\\\n.board-message { color: var(--muted); font-size: 11px; overflow-wrap: anywhere; }\\\\n.capabilities {\\\\n  display: grid;\\\\n  grid-template-columns: repeat(4, minmax(0, 1fr));\\\\n  gap: 1px;\\\\n  flex-shrink: 0;\\\\n  margin: 9px 0;\\\\n  overflow: hidden;\\\\n  border: 1px solid var(--line);\\\\n  border-radius: 10px;\\\\n  background: var(--line);\\\\n}\\\\n.capability { min-width: 0; padding: 5px 8px; background: var(--surface); overflow-wrap: anywhere; }\\\\n.capability span { display: block; color: var(--muted); font-size: 10px; line-height: 1.4; }\\\\n.capability strong { display: block; font-size: 12px; line-height: 1.4; font-weight: 650; }\\\\n.connection-box { flex-shrink: 0; }\\\\n.connection-row {\\\\n  display: grid;\\\\n  grid-template-columns: 53px minmax(0, 1fr) auto;\\\\n  gap: 5px;\\\\n  align-items: center;\\\\n  margin-bottom: 4px;\\\\n}\\\\n.connection-row.key-row { grid-template-columns: 53px minmax(0, 1fr) auto auto; }\\\\n.connection-row label { font-size: 11px; white-space: nowrap; }\\\\n.connection-row input { height: 27px; min-height: 27px; padding: 3px 7px; font: 11px/1.3 var(--mono); }\\\\n.connection-row button { min-height: 27px; padding: 3px 7px; font-size: 11px; }\\\\n.connection-hint { color: var(--muted); font-size: 10px; overflow-wrap: anywhere; }\\\\n.transfers { flex-shrink: 0; margin: 7px 0 6px; border-top: 1px solid var(--line); }\\\\n.transfer-row {\\\\n  position: relative;\\\\n  display: grid;\\\\n  grid-template-columns: 69px minmax(0, 1fr) 40px;\\\\n  gap: 0 5px;\\\\n  min-height: 34px;\\\\n  padding: 4px 0;\\\\n  border-bottom: 1px solid var(--line);\\\\n  overflow-wrap: anywhere;\\\\n}\\\\n.transfer-name { grid-row: 1 / 3; align-self: center; font-size: 11px; font-weight: 650; }\\\\n.transfer-phase { font-size: 11px; line-height: 1.35; }\\\\n.transfer-number { color: var(--muted); font-size: 10px; text-align: right; font-variant-numeric: tabular-nums; }\\\\n.transfer-detail { grid-column: 2 / 4; color: var(--muted); font-size: 10px; line-height: 1.35; }\\\\n.transfer-row progress {\\\\n  appearance: none;\\\\n  position: absolute;\\\\n  inset: auto 0 0;\\\\n  width: 100%;\\\\n  height: 3px;\\\\n  overflow: hidden;\\\\n  border: 0;\\\\n  border-radius: 99px;\\\\n  background: var(--line);\\\\n}\\\\n.transfer-row progress::-webkit-progress-bar { background: var(--line); }\\\\n.transfer-row progress::-webkit-progress-value { background: var(--accent); }\\\\n.transfer-row progress::-moz-progress-bar { background: var(--accent); }\\\\n.transfer-row[data-phase=\"failed\"] .transfer-phase { color: var(--danger); }\\\\n.transfer-row[data-phase=\"disabled\"] .transfer-phase { color: var(--muted); }\\\\n#resources { font-size: 10px; overflow-wrap: anywhere; }\\\\n.board-bottom {\\\\n  display: flex;\\\\n  justify-content: space-between;\\\\n  align-items: center;\\\\n  flex: 0 0 auto;\\\\n  flex-wrap: wrap;\\\\n  gap: 4px 8px;\\\\n  margin-top: auto;\\\\n  padding-top: 5px;\\\\n  font-size: 10px;\\\\n}\\\\n.queue { padding: 2px 7px; border-radius: 99px; background: var(--surface); font-variant-numeric: tabular-nums; }\\\\n.stamp { color: var(--muted); }\\\\n\\\\n.control {\\\\n  overflow: auto;\\\\n  overscroll-behavior: contain;\\\\n  scrollbar-gutter: stable;\\\\n}\\\\n.control-actions {\\\\n  display: grid;\\\\n  gap: 6px;\\\\n  padding: 8px 12px;\\\\n}\\\\n.control-actions button { min-height: 31px; padding: 4px 6px; font-size: 12px; }\\\\n.control-body { padding: 4px 12px 13px; }\\\\n.button-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }\\\\n.button-row.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }\\\\n.checkline { display: flex; align-items: center; gap: 8px; margin: 3px 0 10px; color: var(--ink); }\\\\n.checkline input { margin: 0; }\\\\n#public {\\\\n  appearance: none;\\\\n  position: relative;\\\\n  width: 31px;\\\\n  height: 18px;\\\\n  border: 1px solid var(--line);\\\\n  border-radius: 99px;\\\\n  background: var(--surface);\\\\n}\\\\n#public::before {\\\\n  position: absolute;\\\\n  inset: 2px auto 2px 2px;\\\\n  aspect-ratio: 1;\\\\n  border-radius: 50%;\\\\n  background: #fff;\\\\n  box-shadow: 0 1px 3px #0004;\\\\n  content: \"\";\\\\n}\\\\n#public:checked { border-color: transparent; background: var(--accent); }\\\\n#public:checked::before { inset-inline: auto 2px; }\\\\n@media (forced-colors: active) {\\\\n  #public { appearance: auto; width: 15px; height: 15px; }\\\\n  #public::before { content: none; }\\\\n}\\\\n.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }\\\\n.full { grid-column: 1 / -1; }\\\\n.field-note { margin-top: 5px; color: var(--muted); font-size: 11px; overflow-wrap: anywhere; }\\\\n#download-result { margin-top: 9px; }\\\\n.advanced { margin-top: 10px; border-top: 1px solid var(--line); }\\\\n.advanced summary { padding: 8px 0 4px; font-size: 12px; font-weight: 650; }\\\\n.advanced h3 { margin: 10px 0 6px; font-size: 12px; font-weight: 650; }\\\\n.advanced .checkline { margin: 8px 0; }\\\\n\\\\n.right { display: flex; flex-direction: column; }\\\\n.right .panel-head > span { padding: 3px 8px; border-radius: 99px; background: var(--surface); }\\\\n.status-dot { display: inline-block; width: 7px; height: 7px; margin-right: 6px; border-radius: 50%; background: var(--muted); }\\\\n.status-dot.live { background: var(--ready); }\\\\n.log-controls {\\\\n  display: flex;\\\\n  flex: 0 0 auto;\\\\n  flex-wrap: wrap;\\\\n  align-items: center;\\\\n  gap: 6px;\\\\n  padding: 8px 12px;\\\\n  border-bottom: 1px solid var(--line);\\\\n  background: var(--toolbar);\\\\n}\\\\n.log-controls :is(button, select) { min-height: 30px; padding: 4px 8px; font-size: 12px; }\\\\n.log-controls .log-source { flex: 1 1 9rem; min-width: 0; max-width: 16rem; }\\\\n.log-controls .log-lines { flex: 0 1 auto; width: auto; max-width: 100%; }\\\\n.follow { display: flex; align-items: center; gap: 5px; margin-left: auto; white-space: nowrap; font-size: 11px; }\\\\n.follow input { margin: 0; }\\\\n.notice-zone { flex: 0 0 auto; max-height: 150px; padding: 0 12px; overflow: auto; overscroll-behavior: contain; }\\\\n.notice { margin-top: 9px; padding: 9px 11px; border: 1px solid var(--line); border-left: 3px solid var(--accent); border-radius: 9px; background: var(--tint); }\\\\n.notice[data-kind=\"error\"] { border-left-color: var(--danger); background: var(--surface); }\\\\n.notice[data-kind=\"warning\"] { border-left-color: var(--warn); background: var(--surface); }\\\\n.notice-title { font-size: 12px; font-weight: 650; }\\\\n.notice-message { margin-top: 4px; color: var(--muted); font-size: 12px; white-space: pre-wrap; overflow-wrap: anywhere; }\\\\n.notice-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 7px; margin-top: 7px; }\\\\n.notice-actions :is(button, a) { min-height: 30px; padding: 4px 9px; font-size: 12px; }\\\\n.notice-actions a { border: 1px solid var(--line); border-radius: 8px; color: var(--accent); background: var(--panel); text-decoration: none; }\\\\n.notice-actions a:hover { text-decoration: underline; }\\\\n.log-viewport {\\\\n  flex: 1;\\\\n  min-height: 0;\\\\n  margin: 10px 12px 0;\\\\n  overflow: auto;\\\\n  overscroll-behavior: contain;\\\\n  scrollbar-gutter: stable;\\\\n  border: 1px solid var(--line);\\\\n  border-radius: 11px;\\\\n  background: var(--log);\\\\n}\\\\n.log-intro { padding: 12px 13px; border-bottom: 1px solid var(--line); background: var(--toolbar); font-size: 12px; overflow-wrap: anywhere; }\\\\n.log-intro h3 { margin: 0 0 4px; font-size: 14px; font-weight: 650; }\\\\n.log-intro p { color: var(--muted); }\\\\n.log-viewport pre { margin: 0; padding: 11px 13px; color: var(--muted); font: 12px/1.65 var(--mono); white-space: pre-wrap; overflow-wrap: anywhere; }\\\\n.log-footer { display: flex; justify-content: space-between; flex: 0 0 auto; flex-wrap: wrap; gap: 4px 8px; padding: 8px 13px; color: var(--muted); font-size: 10px; }\\\\n.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }\\\\n\\\\n@media (max-width: 920px) {\\\\n  .follow { margin-left: 0; }\\\\n  .capability { padding-inline: 5px; }\\\\n}\\\\n@media (max-width: 759px) {\\\\n  .app { height: auto; grid-template-columns: minmax(0, 1fr); padding: 8px; gap: 10px; }\\\\n  .left { grid-template-rows: auto 390px; gap: 10px; }\\\\n  .board { scrollbar-gutter: auto; }\\\\n  .right { height: 440px; }\\\\n  .log-controls .log-source { max-width: none; }\\\\n}\\\\n@media (max-width: 379px) {\\\\n  .capabilities, .control-actions .button-row, .advanced .button-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }\\\\n  .form-grid { grid-template-columns: minmax(0, 1fr); }\\\\n}\\\\n</style>\\\\n</head>\\\\n<body>\\\\n<main class=\"app\" id=\"h3-console\" aria-label=\"MiniMax-H3 控制台\">\\\\n  <div class=\"left\">\\\\n    <section class=\"panel board\" id=\"board\" aria-labelledby=\"headline\" tabindex=\"0\">\\\\n      <div class=\"board-top\"><div><p class=\"eyebrow\">消息看板</p><h1 id=\"headline\">尚未读取状态</h1></div><button type=\"button\" class=\"board-refresh\" id=\"refresh-board\" title=\"只刷新状态，不执行控制命令\">刷新</button></div>\\\\n      <p class=\"board-message\" id=\"next-step\">运行控制台单元后显示本次观察。</p>\\\\n      <div class=\"capabilities\" aria-label=\"独立能力\">\\\\n        <div class=\"capability\"><span>总管理</span><strong id=\"manager-state\">尚未读取</strong></div>\\\\n        <div class=\"capability\"><span>API 后台</span><strong id=\"api-state\">尚未读取</strong></div>\\\\n        <div class=\"capability\"><span>模型容器</span><strong id=\"model-state\">尚未读取</strong></div>\\\\n        <div class=\"capability\"><span>公网 API</span><strong id=\"public-state\">尚未读取</strong></div>\\\\n      </div>\\\\n      <div class=\"connection-box\" aria-label=\"API 连接信息\">\\\\n        <div class=\"connection-row\"><label for=\"api-url\">API URL</label><input id=\"api-url\" readonly value=\"尚未分配\" autocomplete=\"off\" spellcheck=\"false\" aria-describedby=\"connection-hint\"><button type=\"button\" id=\"copy-url\" disabled aria-label=\"复制 API URL\">复制</button></div>\\\\n        <div class=\"connection-row key-row\"><label for=\"api-key\">API 密钥</label><input id=\"api-key\" readonly value=\"尚未生成\" autocomplete=\"off\" spellcheck=\"false\" aria-label=\"API 密钥\"><button type=\"button\" id=\"toggle-key\" disabled aria-label=\"显示 API 密钥\">显示</button><button type=\"button\" id=\"copy-key\" disabled aria-label=\"复制 API 密钥\">复制</button></div>\\\\n        <p class=\"connection-hint\" id=\"connection-hint\">API 可达后可复制地址；密钥按需显示。</p>\\\\n      </div>\\\\n      <div class=\"transfers\" aria-label=\"模型与 LoRA 下载进度\">\\\\n        <div class=\"transfer-row\" id=\"transfer-model\"><span class=\"transfer-name\">模型</span><span class=\"transfer-phase\" id=\"model-download-phase\">尚未观察</span><span class=\"transfer-number\" id=\"model-download-number\">—</span><span class=\"transfer-detail\" id=\"model-download-detail\">下载与加载分别显示</span><progress id=\"model-download-progress\" max=\"100\" aria-label=\"模型下载进度\"></progress></div>\\\\n        <div class=\"transfer-row\" id=\"transfer-acceleration\"><span class=\"transfer-name\">加速 LoRA</span><span class=\"transfer-phase\" id=\"acceleration-download-phase\">尚未观察</span><span class=\"transfer-number\" id=\"acceleration-download-number\">—</span><span class=\"transfer-detail\" id=\"acceleration-download-detail\">未启用时不下载</span><progress id=\"acceleration-download-progress\" max=\"100\" aria-label=\"加速 LoRA 下载进度\"></progress></div>\\\\n        <div class=\"transfer-row\" id=\"transfer-style\"><span class=\"transfer-name\">风格 LoRA</span><span class=\"transfer-phase\" id=\"style-download-phase\">尚未观察</span><span class=\"transfer-number\" id=\"style-download-number\">—</span><span class=\"transfer-detail\" id=\"style-download-detail\">未启用时不下载</span><progress id=\"style-download-progress\" max=\"100\" aria-label=\"风格 LoRA 下载进度\"></progress></div>\\\\n      </div>\\\\n      <p class=\"eyebrow\" id=\"resources\">配置：A100 · 原生 BF16</p>\\\\n      <div class=\"board-bottom\"><span class=\"queue\" id=\"queue-state\">排队 —\\\\u3000执行 —</span><span class=\"stamp\" id=\"board-stamp\">尚无服务观察</span></div>\\\\n    </section>\\\\n    <section class=\"panel control\" id=\"control-scroll\" aria-labelledby=\"control-heading\" tabindex=\"0\">\\\\n      <header class=\"panel-head\"><h2 id=\"control-heading\">常用控制</h2><span class=\"eyebrow\">启动后自动推进</span></header>\\\\n      <div class=\"control-actions\">\\\\n        <div class=\"button-row two\"><button type=\"button\" data-action=\"bootstrap\" class=\"primary\">一键启动</button><button type=\"button\" data-action=\"export_connection\">导出 API 连接</button></div>\\\\n        <div class=\"button-row\"><button type=\"button\" data-action=\"generate\">提交 / 查询任务</button><button type=\"button\" data-action=\"stop\">停止服务</button><button type=\"button\" class=\"danger\" data-action=\"release\">释放云实例</button></div>\\\\n      </div>\\\\n      <div class=\"control-body\">\\\\n        <label class=\"checkline\"><input id=\"public\" type=\"checkbox\" checked>开放临时公网 API</label>\\\\n        <div class=\"form-grid\">\\\\n          <label class=\"full\">本次参考图路径<input id=\"reference_file\" placeholder=\"/content/本次新参考图.png\" autocomplete=\"off\"></label>\\\\n          <label class=\"full\">本次视频描述<textarea id=\"prompt\" rows=\"2\" placeholder=\"描述本次全新内容；按已有任务 ID 恢复时可留空\"></textarea></label>\\\\n          <label>已有任务 ID<input id=\"resume_job_id\" placeholder=\"留空则创建新任务\" autocomplete=\"off\"></label>\\\\n          <label>验收接口<select id=\"endpoint\"><option value=\"public\">临时公网</option><option value=\"local\">本机 API</option></select></label>\\\\n        </div>\\\\n        <button type=\"button\" data-action=\"download_result\" id=\"download-result\" disabled>下载最近结果</button>\\\\n        <details class=\"advanced\" id=\"advanced-controls\"><summary>高级控制 · 不常用时收起</summary><div class=\"advanced-body\">\\\\n          <h3>分步维护</h3>\\\\n          <div class=\"button-row\"><button type=\"button\" data-action=\"preflight\">检查资源</button><button type=\"button\" data-action=\"install\">安装依赖</button><button type=\"button\" data-action=\"start\">单独启动</button></div>\\\\n          <p class=\"field-note\">正常使用只需一键启动；检查、安装或启动失败时在日志区处理。</p>\\\\n          <label class=\"checkline\"><input id=\"staged\" type=\"checkbox\">使用 40GB 分阶段驻留</label>\\\\n          <label class=\"checkline\"><input id=\"cached\" type=\"checkbox\">权重已完整缓存</label>\\\\n          <h3>性能与 LoRA</h3>\\\\n          <div class=\"form-grid\">\\\\n            <label>加速 LoRA<select id=\"acceleration\"><option value=\"none\">不启用</option><option value=\"lightx2v-ref2va-4step\">Ref2VA Turbo · 实验</option></select></label>\\\\n            <label>风格 LoRA<select id=\"style\"><option value=\"none\">不启用</option><option value=\"fal-realism-people\">人物写实 · 实验</option></select></label>\\\\n            <label>风格强度<input id=\"style_scale\" type=\"number\" min=\"0.1\" max=\"1\" step=\"0.1\" value=\"1\"></label>\\\\n            <label>注意力后端<select id=\"attention\"><option value=\"auto\">自动</option><option value=\"native\">原生</option><option value=\"_native_flash\">原生 Flash · 实验</option></select></label>\\\\n            <label>去噪卸载<select id=\"offload\"><option value=\"stream\">流式</option><option value=\"sync\">同步 · 实验</option></select></label>\\\\n          </div><p class=\"field-note\">高级参数在安装与启动前设置；保持 BF16，LoRA 默认关闭。</p>\\\\n          <h3>组件控制</h3>\\\\n          <div class=\"form-grid\"><label>操作<select id=\"component-action\"><option value=\"drain\">暂停接收新任务</option><option value=\"resume\">恢复接收新任务</option><option value=\"stop_model\">停止模型</option><option value=\"start_model\">启动模型</option><option value=\"stop_api\">停止 API</option><option value=\"start_api\">启动 API</option></select></label><label>命令 ID<input id=\"command_id\" placeholder=\"查询已有命令\" autocomplete=\"off\"></label></div>\\\\n          <label class=\"checkline\"><input id=\"force\" type=\"checkbox\">强制停止模型</label>\\\\n          <div class=\"button-row two\"><button type=\"button\" id=\"send-control\">执行组件操作</button><button type=\"button\" id=\"query-command\">查询命令</button></div>\\\\n          <p class=\"field-note\">暂停接收时，已有队列继续执行。命令接收不等于执行完成。</p>\\\\n          <h3>客户端连接</h3><p class=\"field-note\">启动时自动生成 API 密钥，可用上方按钮导出。地址为空表示尚不可连接；API 可达后重新导出，密钥不变。模型准备期间接受排队，完整就绪后自动处理。</p>\\\\n        </div></details>\\\\n      </div>\\\\n    </section>\\\\n  </div>\\\\n  <section class=\"panel right\" aria-labelledby=\"logs-heading\">\\\\n    <header class=\"panel-head\"><h2 id=\"logs-heading\">动态日志</h2><span class=\"eyebrow\"><i class=\"status-dot\" id=\"live-dot\" aria-hidden=\"true\"></i><span id=\"connection-state\">等待连接</span></span></header>\\\\n    <div class=\"log-controls\">\\\\n      <label class=\"sr-only\" for=\"log-source\">日志来源</label>\\\\n      <select id=\"log-source\" class=\"log-source\">\\\\n        <option value=\"diagnostics\">操作与诊断</option><option value=\"preflight\">资源检查</option>\\\\n        <option value=\"install\">安装依赖</option><option value=\"model\">模型容器</option>\\\\n        <option value=\"api\">API 后台</option><option value=\"manager\">全局管理</option>\\\\n        <option value=\"tunnel\">公网隧道</option><option value=\"events\">调度事件</option>\\\\n        <option value=\"state\">状态详情</option><option value=\"smoke\">最近验收</option>\\\\n      </select>\\\\n      <label class=\"sr-only\" for=\"log-lines\">最新日志行数</label>\\\\n      <select id=\"log-lines\" class=\"log-lines\">\\\\n        <option value=\"20\">20 行</option><option value=\"40\">40 行</option><option value=\"60\">60 行</option>\\\\n        <option value=\"80\">80 行</option><option value=\"100\" selected>100 行</option><option value=\"120\">120 行</option>\\\\n        <option value=\"140\">140 行</option><option value=\"160\">160 行</option><option value=\"180\">180 行</option>\\\\n        <option value=\"200\">200 行</option>\\\\n      </select>\\\\n      <button type=\"button\" id=\"toggle-logs\">暂停</button><button type=\"button\" id=\"refresh-logs\">刷新</button>\\\\n      <label class=\"follow\"><input type=\"checkbox\" id=\"follow-logs\" checked>跟随新日志</label>\\\\n    </div>\\\\n    <div class=\"notice-zone\" id=\"notice-zone\" aria-live=\"polite\" aria-atomic=\"false\"></div>\\\\n    <div class=\"log-viewport\" id=\"log-viewport\" tabindex=\"0\" aria-label=\"日志内容，可独立滚动\">\\\\n      <header class=\"log-intro\" id=\"log-intro\">\\\\n        <h3>MiniMax-H3 · 参考生视频</h3>\\\\n        <p>A100 原生 BF16 · 仅 ref2va。点击 Colab「一键启动」单元的运行箭头后，自动检查资源、安装依赖并启动 API、公网和模型。API 可达后即可排队，模型就绪后自动处理。</p>\\\\n      </header>\\\\n      <pre id=\"log-text\">尚无本次运行日志。</pre>\\\\n    </div>\\\\n    <footer class=\"log-footer\"><span id=\"log-stamp\">只读 · 有限尾部 · 凭据脱敏</span><span id=\"log-mode\">每 2 秒读取</span></footer>\\\\n  </section>\\\\n</main>\\\\n<script>\\\\n(() => {\\\\n  \\\\\\'use strict\\\\\\';\\\\n  const CALLBACK_NAME = __CALLBACK_NAME__;\\\\n  const INITIAL_STATE = __INITIAL_STATE__;\\\\n  const $ = id => document.getElementById(id);\\\\n  const actionButtons = [...document.querySelectorAll(\\\\\\'[data-action]\\\\\\')];\\\\n  const activeActions = new Set();\\\\n  const uncertainRequests = new Map();\\\\n  const knownNotices = new Set();\\\\n  const blobUrls = new Set();\\\\n  let current = INITIAL_STATE && typeof INITIAL_STATE === \\\\\\'object\\\\\\' ? INITIAL_STATE : {};\\\\n  let timer = null, polling = false, paused = false, disposed = false;\\\\n  let connectionLost = false, localNotice = null, shownNoticeId = null, failures = 0;\\\\n  let lastText = \\\\\\'\\\\\\', lastSource = \\\\\\'\\\\\\', lastLogs = null, pendingConfirmation = null;\\\\n  let revealedKey = \\\\\\'\\\\\\', keyVisible = false, secretBusy = false, secretEpoch = 0;\\\\n  let observedCredentialId = null, observedInstanceId = null;\\\\n  const hasTransport = () => typeof window.H3_TRANSPORT === \\\\\\'function\\\\\\' || typeof window.google?.colab?.kernel?.invokeFunction === \\\\\\'function\\\\\\';\\\\n  const offline = () => current.ui?.offline === true || !hasTransport();\\\\n  const closed = () => current.ui?.closed === true;\\\\n  const delivering = () => current.ui?.startup_delivery?.active === true &&\\\\n    Date.now() < Number(current.ui.startup_delivery.deadline_at || 0) * 1000 + 5000;\\\\n  const text = (id, value) => { $(id).textContent = String(value ?? \\\\\\'—\\\\\\'); };\\\\n  const nowText = value => {\\\\n    if (!value) return \\\\\\'未记录\\\\\\';\\\\n    const date = typeof value === \\\\\\'number\\\\\\' ? new Date(value * 1000) : new Date(value);\\\\n    if (!Number.isFinite(date.getTime())) return \\\\\\'未记录\\\\\\';\\\\n    return new Intl.DateTimeFormat(\\\\\\'zh-CN\\\\\\', {timeZone:\\\\\\'Asia/Shanghai\\\\\\', hour:\\\\\\'2-digit\\\\\\', minute:\\\\\\'2-digit\\\\\\', second:\\\\\\'2-digit\\\\\\', hour12:false}).format(date) + \\\\\\' 北京时间\\\\\\';\\\\n  };\\\\n  const safeText = value => String(value ?? \\\\\\'\\\\\\').replace(/\\\\\\\\x1b\\\\\\\\[[0-?]*[ -/]*[@-~]/g, \\\\\\'\\\\\\').replace(/\\\\\\\\bBearer\\\\\\\\s+[^\\\\\\\\s\"\\\\\\'<>;,]+/gi,\\\\\\'Bearer [已隐藏]\\\\\\').replace(/([\"\\\\\\']?(?:H3_API_KEY|API_KEY|api[-_]?key|access_token)[\"\\\\\\']?\\\\\\\\s*[:=]\\\\\\\\s*)([\"\\\\\\'])(.*?)\\\\\\\\2/gi,\\\\\\'$1$2[已隐藏]$2\\\\\\');\\\\n  const payload = () => ({staged:$(\\\\\\'staged\\\\\\').checked,cached:$(\\\\\\'cached\\\\\\').checked,public:$(\\\\\\'public\\\\\\').checked,\\\\n    reference_file:$(\\\\\\'reference_file\\\\\\').value.trim(),prompt:$(\\\\\\'prompt\\\\\\').value.trim(),resume_job_id:$(\\\\\\'resume_job_id\\\\\\').value.trim(),\\\\n    endpoint:$(\\\\\\'endpoint\\\\\\').value,acceleration:$(\\\\\\'acceleration\\\\\\').value,style:$(\\\\\\'style\\\\\\').value,style_scale:Number($(\\\\\\'style_scale\\\\\\').value),\\\\n    attention:$(\\\\\\'attention\\\\\\').value,offload:$(\\\\\\'offload\\\\\\').value});\\\\n  function uuid() {\\\\n    if (window.crypto?.randomUUID) return window.crypto.randomUUID();\\\\n    const bytes = new Uint8Array(16); window.crypto.getRandomValues(bytes);\\\\n    return [...bytes].map(value=>value.toString(16).padStart(2,\\\\\\'0\\\\\\')).join(\\\\\\'\\\\\\');\\\\n  }\\\\n  function setButtons() {\\\\n    const unavailable = offline() || closed() || delivering();\\\\n    const busy = current.ui?.busy === true;\\\\n    const operations = current.ui?.operations || [];\\\\n    const generationBusy = operations.some(item=>item.action===\\\\\\'generate\\\\\\');\\\\n    const stopping = current.state?.phase===\\\\\\'stopping\\\\\\' || operations.some(item=>[\\\\\\'stop\\\\\\',\\\\\\'release\\\\\\'].includes(item.action));\\\\n    const apiUsable = current.state?.api_ready===true && current.state?.observation_stale!==true && !connectionLost;\\\\n    const connectionAvailable = current.ui?.connection_available===true || apiUsable;\\\\n    for (const button of actionButtons) {\\\\n      const action = button.dataset.action;\\\\n      const setupBlocked = (busy || current.ui?.bootstrap_running===true) && [\\\\\\'bootstrap\\\\\\',\\\\\\'preflight\\\\\\',\\\\\\'install\\\\\\',\\\\\\'start\\\\\\'].includes(action);\\\\n      const generationBlocked = action===\\\\\\'generate\\\\\\' && (stopping || generationBusy || (busy && !apiUsable));\\\\n      button.disabled = unavailable || activeActions.has(action) || setupBlocked || generationBlocked || (action===\\\\\\'export_connection\\\\\\' && !connectionAvailable) || (action===\\\\\\'download_result\\\\\\' && !current.result?.available);\\\\n    }\\\\n    $(\\\\\\'send-control\\\\\\').disabled = unavailable || activeActions.has(\\\\\\'control\\\\\\');\\\\n    $(\\\\\\'query-command\\\\\\').disabled = unavailable || activeActions.has(\\\\\\'control\\\\\\');\\\\n    $(\\\\\\'refresh-board\\\\\\').disabled = unavailable || polling;\\\\n    $(\\\\\\'refresh-logs\\\\\\').disabled = unavailable || polling;\\\\n    $(\\\\\\'toggle-logs\\\\\\').disabled = unavailable;\\\\n    const connection=current.connection||{};\\\\n    const secretUnavailable=unavailable || connectionLost || document.hidden || !connection.key_available || !connection.credential_id;\\\\n    $(\\\\\\'toggle-key\\\\\\').disabled=secretUnavailable || secretBusy;\\\\n    $(\\\\\\'copy-key\\\\\\').disabled=secretUnavailable || secretBusy;\\\\n    $(\\\\\\'copy-url\\\\\\').disabled=unavailable || connectionLost || current.state?.observation_stale===true || !usableUrl(connection.url);\\\\n  }\\\\n  function usableUrl(value) {\\\\n    if(typeof value!==\\\\\\'string\\\\\\'||!value)return null;\\\\n    try {const url=new URL(value);return [\\\\\\'http:\\\\\\',\\\\\\'https:\\\\\\'].includes(url.protocol)&&!url.username&&!url.password?value:null;}catch{return null;}\\\\n  }\\\\n  function clearSecret() {\\\\n    revealedKey=\\\\\\'\\\\\\';keyVisible=false;secretEpoch++;\\\\n    $(\\\\\\'api-key\\\\\\').value=current.connection?.key_available?\\\\\\'••••••••••••••••\\\\\\':\\\\\\'尚未生成\\\\\\';\\\\n    text(\\\\\\'toggle-key\\\\\\',\\\\\\'显示\\\\\\');$(\\\\\\'toggle-key\\\\\\').setAttribute(\\\\\\'aria-label\\\\\\',\\\\\\'显示 API 密钥\\\\\\');\\\\n  }\\\\n  function renderConnection() {\\\\n    const connection=current.connection||{};\\\\n    const credentialId=connection.credential_id||null, instanceId=current.state?.instance_id||null;\\\\n    if(credentialId!==observedCredentialId || instanceId!==observedInstanceId || offline() || closed() || connectionLost || document.hidden){\\\\n      clearSecret();observedCredentialId=credentialId;observedInstanceId=instanceId;\\\\n    }\\\\n    const stale=current.state?.observation_stale===true;\\\\n    const readyUrl=stale?null:usableUrl(connection.url), candidate=usableUrl(connection.candidate_url)||(stale?usableUrl(connection.url):null);\\\\n    const local=usableUrl(connection.local_url);\\\\n    $(\\\\\\'api-url\\\\\\').value=readyUrl||candidate||(offline()?\\\\\\'尚未连接运行时\\\\\\':\\\\\\'等待分配地址\\\\\\');\\\\n    $(\\\\\\'api-url\\\\\\').title=readyUrl||candidate||\\\\\\'\\\\\\';\\\\n    let hint=\\\\\\'密钥在启动初期生成；按需显示或复制。\\\\\\';\\\\n    if(offline()||closed())hint=\\\\\\'当前为离线界面，没有本次连接或密钥。\\\\\\';\\\\n    else if(connectionLost)hint=\\\\\\'连接中断；上次地址不代表当前可用，密钥已隐藏。\\\\\\';\\\\n    else if(readyUrl)hint=(connection.public_requested?\\\\\\'公网 API 已通过探测\\\\\\':\\\\\\'本机 API 已可达\\\\\\')+\\\\\\' · 密钥默认隐藏\\\\\\';\\\\n    else if(candidate)hint=\\\\\\'地址已分配 · 尚未验证／当前不可用\\\\\\'+(local?\\\\\\' · 本机 API 可用\\\\\\':\\\\\\'\\\\\\');\\\\n    else if(connection.public_requested&&local)hint=\\\\\\'公网地址准备中 · 本机 API 已可用\\\\\\';\\\\n    else if(current.ui?.bootstrap_running)hint=\\\\\\'正在准备 API；密钥生成后即可显示或复制。\\\\\\';\\\\n    text(\\\\\\'connection-hint\\\\\\',hint);$(\\\\\\'connection-hint\\\\\\').title=hint+(local?\\\\\\'\\\\\\\\n本机 API：\\\\\\'+local:\\\\\\'\\\\\\');\\\\n    $(\\\\\\'api-key\\\\\\').value=keyVisible&&revealedKey?revealedKey:connection.key_available?\\\\\\'••••••••••••••••\\\\\\':\\\\\\'尚未生成\\\\\\';\\\\n    text(\\\\\\'toggle-key\\\\\\',keyVisible?\\\\\\'隐藏\\\\\\':\\\\\\'显示\\\\\\');\\\\n    $(\\\\\\'toggle-key\\\\\\').setAttribute(\\\\\\'aria-label\\\\\\',keyVisible?\\\\\\'隐藏 API 密钥\\\\\\':\\\\\\'显示 API 密钥\\\\\\');\\\\n  }\\\\n  function bytesText(value) {\\\\n    if(typeof value!==\\\\\\'number\\\\\\'||!Number.isFinite(value)||value<0)return \\\\\\'—\\\\\\';\\\\n    const units=[\\\\\\'B\\\\\\',\\\\\\'KiB\\\\\\',\\\\\\'MiB\\\\\\',\\\\\\'GiB\\\\\\',\\\\\\'TiB\\\\\\'];let amount=value,index=0;\\\\n    while(amount>=1024&&index<units.length-1){amount/=1024;index++;}\\\\n    return (index?amount.toFixed(1):Math.round(amount))+\\\\\\' \\\\\\'+units[index];\\\\n  }\\\\n  function renderTransfers() {\\\\n    const downloads=current.downloads||{}, items=downloads.items||{};\\\\n    const stale=downloads.observation_stale===true || connectionLost || current.state?.observation_stale===true;\\\\n    const phases={waiting:\\\\\\'等待下载\\\\\\',downloading:\\\\\\'下载中\\\\\\',verifying:\\\\\\'校验中\\\\\\',loading:\\\\\\'加载中\\\\\\',loaded:\\\\\\'已加载\\\\\\',disabled:\\\\\\'未启用\\\\\\',failed:\\\\\\'准备失败\\\\\\'};\\\\n    for(const name of [\\\\\\'model\\\\\\',\\\\\\'acceleration\\\\\\',\\\\\\'style\\\\\\']) {\\\\n      const item=items[name], row=$(\\\\\\'transfer-\\\\\\'+name), progress=$(name+\\\\\\'-download-progress\\\\\\');\\\\n      let phase=\\\\\\'尚未观察\\\\\\', detail=name===\\\\\\'model\\\\\\'?\\\\\\'下载与加载分别显示\\\\\\':\\\\\\'未启用时不下载\\\\\\', percent=null;\\\\n      if(item&&typeof item===\\\\\\'object\\\\\\') {\\\\n        phase=phases[item.phase]||\\\\\\'等待可测进度\\\\\\';\\\\n        if(name===\\\\\\'model\\\\\\'&&item.phase===\\\\\\'loaded\\\\\\')phase=\\\\\\'已加载 · 等待就绪检查\\\\\\';\\\\n        if(name===\\\\\\'model\\\\\\'&&current.state?.model_ready===true&&!stale)phase=\\\\\\'可推理\\\\\\';\\\\n        const bytesKnown=typeof item.bytes_completed===\\\\\\'number\\\\\\'&&Number.isFinite(item.bytes_completed)&&item.bytes_completed>=0;\\\\n        const totalKnown=typeof item.bytes_total===\\\\\\'number\\\\\\'&&Number.isFinite(item.bytes_total)&&item.bytes_total>0;\\\\n        const parts=[];\\\\n        if(bytesKnown)parts.push((item.scope===\\\\\\'observed_transfers\\\\\\'?\\\\\\'已观察 \\\\\\':\\\\\\'\\\\\\')+bytesText(item.bytes_completed)+(totalKnown?\\\\\\' / \\\\\\'+bytesText(item.bytes_total):\\\\\\' · 总量未知\\\\\\'));\\\\n        if(Number.isInteger(item.files_completed)&&item.files_completed>=0)parts.push(\\\\\\'文件 \\\\\\'+item.files_completed+\\\\\\' / \\\\\\'+(Number.isInteger(item.files_total)&&item.files_total>=0?item.files_total:\\\\\\'?\\\\\\'));\\\\n        detail=parts.join(\\\\\\' · \\\\\\')||item.detail||\\\\\\'等待可测进度\\\\\\';\\\\n        if(bytesKnown&&item.scope===\\\\\\'observed_transfers\\\\\\')detail+=\\\\\\'（含续传）\\\\\\';\\\\n        if(item.phase===\\\\\\'disabled\\\\\\')detail=\\\\\\'不下载，不占用加载资源\\\\\\';\\\\n        else if(item.detail&&[\\\\\\'loaded\\\\\\',\\\\\\'loading\\\\\\',\\\\\\'verifying\\\\\\',\\\\\\'failed\\\\\\'].includes(item.phase))detail=item.detail;\\\\n        if(!stale&&totalKnown&&typeof item.percent===\\\\\\'number\\\\\\'&&Number.isFinite(item.percent)&&item.percent>=0&&item.percent<=100)percent=item.percent;\\\\n        if([\\\\\\'stopped\\\\\\',\\\\\\'stopping\\\\\\',\\\\\\'failed\\\\\\'].includes(downloads.lifecycle)&&item.phase!==\\\\\\'disabled\\\\\\'){\\\\n          phase=({stopped:\\\\\\'已停止\\\\\\',stopping:\\\\\\'正在停止\\\\\\',failed:\\\\\\'已失败\\\\\\'})[downloads.lifecycle]+\\\\\\' · 上次\\\\\\'+phase;\\\\n          detail=\\\\\\'保留记录：\\\\\\'+detail;percent=null;\\\\n        } else if(stale&&item.phase!==\\\\\\'disabled\\\\\\'){phas